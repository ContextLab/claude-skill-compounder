#!/usr/bin/env bash
# skillinsight: the batched weekly review over the captured skill-candidate queue.
#
#   skillinsight list    [--week <ISO-week>] [--source <source>]
#   skillinsight review  [--week <ISO-week>]
#   skillinsight decline <hash> [--why <reason>]
#   skillinsight pending [--project <dir>] [--format tsv|text]
#   skillinsight snooze  [<days>] | --clear
#   skillinsight reindex
#   skillinsight stats
#   skillinsight prune   --older-than <weeks>
#   skillinsight --help
#
# The queue is written by hooks/insight-capture.sh on Stop, one JSONL file per ISO
# week under ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/insights/.
#
# WHY THIS IS BATCHED AND WEEKLY, NOT PER TURN. The queue fills at roughly 30 unique
# candidates per week (busiest measured 7-day window: 115), and only 4.8% of turns
# produce one at all. A per-turn model call to triage them would be about 100 calls a
# day, 95% of which would look at nothing. One pass over a week's queue costs one call.
# Numbers: notes/research/insight-capture.md sections 4 and 7.
#
# WHY THERE IS NO AUTOMATIC UNIVERSAL/LOCAL CLASSIFIER HERE. One was built and
# measured. The rule (does the candidate name identifiers that exist in the current
# repo's `git ls-files`?) scored 7/14 against hand-read labels, which is chance on a
# binary label, and a further 34% of records could not be scored at all because the
# recorded cwd was a worktree or a scratchpad. Its errors ran LOCAL -> UNIVERSAL,
# the direction that pollutes the global skill set. It was dropped for that reason.
# What replaces it is kernel extraction, performed by the reviewing session during
# `review`: rewrite the lesson with repo-specific names stripped, and see what is
# left. Evidence: notes/research/insight-capture.md section 6.
#
# WHY `decline` EXISTS AND WHY IT NEVER DELETES. A `session-audit` record is written
# by the hook without asking anyone, so most of them will be judged not worth a skill.
# Judging one has to be recordable, or the queue re-presents the same record every
# week and the reviewer learns to skim past the whole source. But a reviewer who can
# make a record disappear can also make an inconvenient one disappear, and the
# disappearance would leave nothing behind. So a decline is an APPEND to
# declined.jsonl carrying the reason: `review` stops presenting the record, `list`
# still shows it marked, `stats` counts it, and the original line is never touched.
# Declining is visible; disregarding is what leaves the record standing.
set -uo pipefail
# ------------------------------------------------------------------------------------
# THE ENTIRE BODY OF THIS SCRIPT IS ONE BRACE GROUP, AND THE `}` AT THE END OF THE FILE
# IS WHAT CLOSES IT. It is not style and it is not decoration.
#
# bash reads a script LAZILY, by byte offset, and resumes at that offset in whatever the
# file holds AT THAT MOMENT. Every file in this package is executed by absolute path out
# of the checkout -- the installer writes those paths into settings.json and symlinks the
# CLIs into ~/bin -- so one `git pull`, `git checkout` or `sed -i` rewrites the bytes of
# a run that is already in flight. Measured on GNU bash 5.3.3(1): prepending forty lines
# to a live 25-line script produced `line 4: non-transferable: command not found` and
# then a second execution of the body; truncating it produced `unexpected EOF` and
# exit 2. It cost a real, paid-for `claude -p` dispatch on 2026-08-25.
#
# A brace group is a single compound command, so bash must find the matching `}` before
# it may run any part of it: the file goes through the parser in ONE pass and nothing
# written to disk afterwards can be executed. A file truncated badly enough to break the
# parse then runs NOTHING, which is also the answer we want here -- half a run is worse
# than no run.
#
# THE `exit` BEFORE THE CLOSING `}` IS LOAD-BEARING TOO. A brace group protects its body
# and nothing past it: measured, a wrapped script that fell off its end had bash resume
# at the offset just past `}`, find prepended text sitting there, and run the whole body
# a SECOND time. So the group is not sufficient on its own. It is a BARE `exit` and not
# `exit 0` because the `case` this ends in has arms that exit non-zero on purpose
# (an unknown subcommand is exit 2, and see the exit-code table above); a bare `exit`
# reuses `$?` and preserves every one of them, while `exit 0` would silently erase them.
#
# Consequences when editing:
#   - the closing `}` must stay the last line, and `bash -n` is what proves it.
#   - the last statement inside the group must be an `exit`. tests/test_script_wrapping.py
#     checks that across every shipped script and reproduces the hazard against a live
#     process.
#   - `exit` still exits the script, traps are still global, and functions and variables
#     defined inside are still global. Nothing about the semantics changes.
#
# The incident this came out of, and the reproduction, are in docs/DESIGN.md under
# "Never edit a script that may still be running".
# ------------------------------------------------------------------------------------
{


# HOME can be unset (cron, a stripped env, a container). Under `set -u` reading it then
# aborts the script non-zero before it has printed anything.
: "${HOME:=/tmp}"
STATE_ROOT="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}"
DIR="$STATE_ROOT/insights"
REVIEWS="$STATE_ROOT/reviews"
# Same default and same override as bin/skillreport. `reindex` needs it to recover the
# project a lost review belonged to: a stage-1 answer records the id of the session the
# MODEL ran in, never the id of the session it reviewed, so the only place the reviewed
# session's working directory survives is that session's own transcript.
TRANSCRIPTS="${SKILL_COMPOUNDER_TRANSCRIPTS:-$HOME/.claude/projects}"

command -v jq >/dev/null 2>&1 || { echo "skillinsight: jq is required" >&2; exit 1; }

die() { echo "skillinsight: $*" >&2; exit 2; }

now="${INSIGHT_NOW:-${CI_NOW:-$(date -u +%s 2>/dev/null)}}"
case "$now" in ''|*[!0-9]*) die "clock is unreadable" ;; esac

# BSD date wants -r <seconds>, GNU date wants -d @<seconds>. Try both, in that order.
week_of() { date -u -r "$1" +%G-W%V 2>/dev/null || date -u -d "@$1" +%G-W%V 2>/dev/null; }

usage() {
  cat <<'USAGE'
skillinsight: review the captured skill-candidate queue.

  skillinsight list    [--week <ISO-week>] [--source <src>]
                                            one line per candidate (default: this week)
  skillinsight review  [--week <ISO-week>]   the full reviewable batch, with instructions
  skillinsight decline <hash> [--why <why>]  record that a candidate was judged and
                                             declined; the record is kept, not deleted
  skillinsight decline --source <src> [--week <ISO-week>] [--why <why>] [--dry-run]
                                            the same judgement over every undeclined
                                            record from one source, in one pass
  skillinsight promote <hash> --to note|reminder
                       [--scope project|global|memory] [--project <dir>]
                       [--text <text>] [--why <why>]
                       [--keyword <k>]... [--path <glob>]... [--command <cmd>]...
                                            write the candidate down where it will be
                                            read, through bin/skillnote, and take it
                                            out of the queue. The note and its reminder
                                            are stamped with this record's lineage id
                                            (c<first 8 of the hash>), so every later
                                            delivery, forge and verdict joins back here.
  skillinsight promote --verdict <session-id> --to note|reminder [...]
                                            the same, for a CANDIDATE verdict listed by
                                            `skillinsight reviews`. `promote-review
                                            <session-id>` is the same command.
  skillinsight pending [--project <dir>] [--format tsv|text]
                                            what is queued and undeclined right now,
                                            and the one record most worth reading first
  skillinsight snooze  [<days>] | --clear   stop announcing the queue for a while
                                            without judging anything in it
  skillinsight reviews [--show <n>] [--all]  the automatic session reviews written by
                                            hooks/session-review.sh, newest first;
                                            --show <n> prints the nth newest in full
  skillinsight reindex                      index any paid-for session review whose
                                            verdict was never recorded, from the
                                            stage-1 answer it left behind
  skillinsight stats                        queue size, weeks covered, duplicates skipped
  skillinsight prune   --older-than <weeks>  archive week files older than the cutoff
  skillinsight --help

The queue is appended by the Stop hook (hooks/insight-capture.sh) from two signals:

  1. An explicit marker the session writes when it means it, which is the primary
     signal because it survives any output style:
         ★ Skill candidate: <the lesson>
         SKILL-CANDIDATE: <the lesson>
     The marker plus the rest of its paragraph is captured.

  2. `★ Insight` blocks, an opportunistic feeder. These come from the
     learning-output-style plugin, so their absence is normal.

  3. `session-audit` records, written by the hook itself once a session crosses a
     mechanical edit threshold. Nothing is asked of the session and nothing is
     classified: the record states edits counted, files touched, checkpoints fired
     and forges started, and leaves the "were these the same kind of fix?" question
     to this review, which is the only place it can be answered from outside the
     session. A session that disregards every reminder still leaves one of these.

Nothing in the queue is ever forged automatically. `review` produces a batch for a
session to judge; survivors go through the existing skill-compounder threshold and
its builder/red-team loop.

HOW THE QUEUE GETS READ. A queue nobody opens is the same as no queue. The reminder
hook (hooks/compound-improvement.sh, UserPromptSubmit) asks `pending --format tsv` on
the FIRST prompt of a session -- the moment a person is present and has not yet
committed to a task -- and surfaces one line if, and only if, there is something
undeclined AND either the queue has grown or it has been a fortnight since it was last
mentioned. Two ways to make it stop, and both are honest about what they mean:

  decline <hash>   this record was judged and is not worth a skill. Permanent, kept,
                   and visible in `list`. Decline them all and the count reaches zero
                   and the nudge stops by itself.
  promote <hash>   this record IS worth carrying forward, but a note or a reminder is
                   the right size for it, not a skill. It is written through
                   bin/skillnote and stops being pending, exactly as a decline does.
  snooze <days>    nothing was judged; do not raise it for a while. Expires on its own.

Set CI_QUEUE_NUDGE=0 to switch the announcement off entirely.

Environment:
  SKILL_COMPOUNDER_STATE   queue root (default ~/.claude/skill-compounder)
  SKILL_COMPOUNDER_TRANSCRIPTS
                           where session transcripts live, which is where `reindex`
                           recovers a lost review's project from
                           (default ~/.claude/projects)
  INSIGHT_NOW / CI_NOW     pin the clock, so the current ISO week is deterministic
  INSIGHT_PENDING_WINDOW   week files `pending` reads, newest first (default 8)
USAGE
}

# A DOTFILE, deliberately. `all_files()`, `prune` and the capture hook's dedup grep all
# glob "$DIR"/*.jsonl, which does not match a leading dot. Named without one, this file
# would be counted as a week of candidates by `stats`, archived by `prune`, and -- worst
# -- matched by the hook's `grep -F "\"hash\":\"$h\""`, since a decline record carries
# exactly that string. Declining a candidate would then silently blocklist its hash.
DECLINED="$DIR/.declined.jsonl"
# A DOTFILE for the identical reason, and the reason bites harder here: a promote record
# carries a `"hash":"..."` string too, so under a non-dotted name the capture hook's
# `grep -F "\"hash\":\"$h\""` dedup would read it as "this candidate is already
# queued" and promoting a candidate would silently blocklist its hash for good.
PROMOTED="$DIR/.promoted.jsonl"
# Where hooks/compound-improvement.sh keeps a session's live file list. A session-audit
# record snapshots that list at the moment the threshold was crossed, and the session
# usually keeps editing afterwards, so `review` re-reads it when it is still there.
REMINDERS="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/reminders"

# The verdict rules, WORD FOR WORD THE ONES IN `parse_verdict` IN
# hooks/session-review.sh: the verdict is the FIRST line that STARTS WITH `VERDICT:`,
# and nothing else. That anchoring is not fussiness. It was a substring test there,
# `case "$result" in *"VERDICT: NONE"*)`, and it broke on the first reviewer that
# exercised it: the prompt ORDERS the model to quote its evidence verbatim, the evidence
# is a transcript digest, and a transcript from this repository contains the literal
# string "VERDICT: NONE" constantly -- so a well-formed CANDIDATE whose EVIDENCE block
# quoted such a line was recorded as NONE.
#
# Reimplemented here rather than sourced from the hook: this CLI is symlinked into the
# user's PATH and has to work with nothing but itself on disk, and `reindex` is the one
# command that runs when the dispatcher has already proved it can die mid-run. Two copies
# of one rule need a CHECK that they agree, not a comment claiming they do:
# tests/test_insights.py drives this command and `hooks/session-review.sh --verdict-of`
# over the same answers and compares the two verdicts.
#
# Prints "<verdict>TAB<name>". An answer with no `VERDICT:` line prints an empty verdict;
# the caller decides what that means, because the hook's answer depends on something only
# the caller knows -- an empty verdict over a NON-EMPTY answer is UNPARSED (the call ran
# and was paid for, the shape was wrong), and over nothing at all it is ERROR.
verdict_of() { # $1 = the model's answer
  vo_line=""
  [ -n "${1:-}" ] && vo_line="$(printf '%s\n' "$1" | grep -m1 '^VERDICT:' || true)"
  vo_v=""
  vo_n=""
  case "$vo_line" in
    "VERDICT: NONE"*) vo_v="NONE" ;;
    "VERDICT: CANDIDATE"*)
      vo_n="$(printf '%s' "$vo_line" | sed -n 's/^VERDICT: CANDIDATE[[:space:]]*\([A-Za-z0-9][A-Za-z0-9-]*\).*/\1/p')"
      if [ -n "$vo_n" ]; then vo_v="CANDIDATE"; else vo_v="UNPARSED"; vo_n=""; fi
      ;;
  esac
  printf '%s\t%s\n' "$vo_v" "$vo_n"
}

# NEWEST FIRST MEANS BY TIMESTAMP, NOT BY POSITION IN THE FILE. Reversing the file was
# the same thing for exactly as long as the only writer was the dispatcher, which appends
# a row the moment it earns it. `reindex` ends that: it recovers an answer that came back
# weeks ago and appends it today, so the OLDEST review lands at the bottom of the file and
# therefore at the TOP of a listing whose header promises the newest and whose `--show 1`
# promises the same thing. Sorting on the field that carries the time is the only spelling
# that stays true for both writers.
#
# One jq, slurped. `-R -s` with `fromjson?` survives the half-written last line the
# dispatcher leaves behind while appending from another process with no lock, where a
# plain stream read aborts and loses every row BEFORE the torn one. It also replaces a
# `tail -r`, else `tac`, else `awk` reversal, one arm of which was BSD-only.
reviews_newest_first() { # $1 = index.jsonl -> one compact JSON object per line
  jq -R -s -c '[ split("\n")[] | select(length > 0) | (fromjson? // empty)
                 | select(type == "object") ]
               | sort_by(.ts // "") | reverse | .[]' "$1" 2>/dev/null
}

files_for_week() { # $1 = ISO week
  [ -f "$DIR/$1.jsonl" ] && printf '%s\n' "$DIR/$1.jsonl"
}

# Every declined hash, as a JSON array, for jq to test membership against. Read once
# per command rather than grepped per record. A malformed line is skipped, not fatal:
# a corrupt decline log must not make the queue unreadable.
declined_json() {
  if [ ! -f "$DECLINED" ]; then printf '[]'; return 0; fi
  jq -R -r '(fromjson? // empty) | .hash // empty' "$DECLINED" 2>/dev/null \
    | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null || printf '[]'
}

# Every promoted hash, same shape and same tolerance as declined_json.
promoted_json() {
  if [ ! -f "$PROMOTED" ]; then printf '[]'; return 0; fi
  jq -R -r '(fromjson? // empty) | .hash // empty' "$PROMOTED" 2>/dev/null \
    | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null || printf '[]'
}

# JUDGED = DECLINED OR PROMOTED, and every surface that used to ask "is this declined?"
# has to ask this instead. A promoted candidate has been dealt with more thoroughly than
# a declined one -- it is written into a CLAUDE.md or the reminder store -- so a queue
# that kept offering it would teach the reader that promoting changes nothing, which is
# precisely how `decline` was nearly made pointless before it excluded its own records.
# The union, never a negation: `.claude/CLAUDE.md` on the ledger says the same thing
# about selecting events by name, and the failure mode is the same one.
judged_json() {
  jj_d="$(declined_json)"
  jj_p="$(promoted_json)"
  # Falling back to the declines alone, not to `[]`: if jq cannot merge the two lists the
  # honest answer is the smaller exclusion, which shows a record again rather than hiding
  # one that was never judged.
  printf '%s\n%s\n' "$jj_d" "$jj_p" | jq -c -s 'add // []' 2>/dev/null \
    || printf '%s' "$jj_d"
}

all_files() {
  [ -d "$DIR" ] || return 0
  # The glob stays literal when nothing matches; the existence test drops that one word.
  for af_f in "$DIR"/*.jsonl; do
    [ -e "$af_f" ] || [ -L "$af_f" ] || continue
    printf '%s\n' "$af_f"
  done | sort
}

# bin/skillnote, which owns every decision about where a note lands and what it looks
# like. Beside $0 first: the installer symlinks both CLIs into the same directory, so
# that holds in the checkout and in ~/bin alike. Then PATH, then the directory $0's
# symlink points into, for a bin dir holding only this one.
skillnote_bin() {
  sb_d="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
  if [ -n "$sb_d" ] && [ -x "$sb_d/skillnote" ]; then printf '%s' "$sb_d/skillnote"; return 0; fi
  sb_p="$(command -v skillnote 2>/dev/null)"
  if [ -n "$sb_p" ] && [ -x "$sb_p" ]; then printf '%s' "$sb_p"; return 0; fi
  sb_l="$(readlink "$0" 2>/dev/null)"
  if [ -n "$sb_l" ]; then
    case "$sb_l" in /*) ;; *) sb_l="$sb_d/$sb_l" ;; esac
    sb_r="$(cd "$(dirname "$sb_l")" 2>/dev/null && pwd)"
    if [ -n "$sb_r" ] && [ -x "$sb_r/skillnote" ]; then printf '%s' "$sb_r/skillnote"; return 0; fi
  fi
  return 1
}

# A hash or a unique prefix -> the full hash, in $RESOLVED. Dies, naming the cause.
#
# IT SETS A GLOBAL AND IS NOT CALLED IN A COMMAND SUBSTITUTION, and that is the whole
# reason it is shaped this way: `die` is an `exit`, and an `exit` inside `$(...)` ends
# the SUBSHELL. The caller would carry on with an empty variable and a zero status,
# which for `promote` means writing a note for a candidate that does not exist.
# ------------------------------------------------------------------- the lineage id
#
# ONE ID PER LINEAGE, AND IT IS DERIVED RATHER THAN MINTED. A queue record already
# carries the only stable name it will ever have: `hash`, the digest of its normalised
# text, computed identically by hooks/insight-capture.sh and hooks/precompact.sh so that
# whichever hook sees the sentence first, both look the record up under the same name.
# Minting a fresh random id at capture would have needed BOTH hooks changed and would
# have given one sentence two ids depending on which hook won the race.
#
# The prefix says which store the key came from -- `c` a queue candidate, `v` a session
# review verdict -- and the key is its first eight characters, which is the length this
# CLI already prints and accepts everywhere else (`decline`, `promote`, `pending`). A
# record queued before any of this existed therefore HAS a lineage id already; nothing
# has to be backfilled.
lineage_of() { # <prefix char> <full key>
  printf '%s%s' "$1" "$(printf '%s' "$2" | cut -c1-8)"
}

resolve_hash() { # $1 = hash or prefix
  # One jq per file, driven by a read loop. `jq ... $(all_files)` word-splits, so a
  # state directory containing a space made every decline fail -- and fail as "no
  # queued candidate has a hash starting ...", which reads as a mistyped hash rather
  # than as a broken command.
  rh_full="$(all_files | while IFS= read -r qf; do
      [ -n "$qf" ] || continue
      jq -r --arg h "$1" 'select((.hash // "") | startswith($h)) | .hash' "$qf" 2>/dev/null
    done | sort -u)"
  rh_n="$(printf '%s' "$rh_full" | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
  case "$rh_n" in ''|*[!0-9]*) rh_n=0 ;; esac
  [ "$rh_n" -eq 0 ] && die "no queued candidate has a hash starting '$1'"
  [ "$rh_n" -gt 1 ] && die "'$1' matches $rh_n candidates; use more of the hash"
  RESOLVED="$rh_full"
  return 0
}

# ------------------------------------------------------------ surfacing the queue
#
# WHY THIS EXISTS AT ALL. Everything above this line writes a queue. Nothing above
# this line makes anyone read it. `review` is a command a human has to remember to
# type, and the whole point of the capture arm is that remembering is exactly what
# fails -- a session that disregarded three checkpoints in a row is not going to
# remember a fourth thing. So the queue has to announce itself.
#
# It announces itself through the reminder hook, which asks this CLI (never the
# other way round) for one line of TSV:
#
#   <undeclined-count> TAB <age-in-days-of-the-oldest> TAB <week-of-the-pick>
#     TAB <first-8-of-the-pick's-hash> TAB <epoch-of-the-NEWEST-undeclined-record>
#     TAB <one-line-headline-for-the-pick>
#
# Six fields, one line, headline last so `cut -f6-` cannot be broken by a headline
# that contains anything. No trailing prose, so a shell can `cut -f` it.
#
# THE FIFTH FIELD IS THE WATERMARK, AND IT IS A TIMESTAMP RATHER THAN A COUNT ON
# PURPOSE. The caller has to answer "has anything arrived that I have not mentioned?",
# and a count cannot answer it, because `decline` makes the count go DOWN. Measured:
# announce a queue of 10, review it, decline 9, then let 8 genuinely new records
# arrive -- the count is 9, which is less than the 10 last announced, so a count
# comparison reads eight new candidates as "no growth" and stays silent for eleven
# days. Doing the right thing muted the mechanism. The newest record's timestamp only
# ever moves forward, so it cannot be defeated that way. The count and
# the age are the "should I care" signal -- two fresh records and thirty going back a
# month are not the same queue, and a bare count cannot tell them apart. The pick is
# the "care about what" signal: a count alone tells nobody anything, so one concrete
# record is named. The pick is the OLDEST undeclined record, preferring one from the
# directory the caller names, because a record about the repo you are standing in is
# actionable now and one about a repo you last touched in June is not.
#
# Declined records are excluded here, which is what makes `decline` the off switch:
# judge every record and the count reaches zero and the nudge goes silent on its own.
# `snooze` is the other off switch, for "not now" rather than "not this".
NUDGE_STAMP="$DIR/.nudge"
SNOOZE="$DIR/.nudge-snooze"
# Bounded on purpose. This runs inside a hook with a 10-second budget, once per
# session, and an unpruned queue directory grows without limit. Eight weeks is longer
# than the review cadence by a wide margin and keeps the read to a few hundred lines.
PENDING_WINDOW="${INSIGHT_PENDING_WINDOW:-8}"
case "$PENDING_WINDOW" in ''|*[!0-9]*) PENDING_WINDOW=8 ;; esac
[ "$PENDING_WINDOW" -lt 1 ] && PENDING_WINDOW=1
# Bounding the FILE COUNT is not bounding the READ. A week file has no size limit --
# a session-audit record carries a file list, and `insight-capture.sh` caps no
# record's text -- so eight files can still be hundreds of megabytes. Measured: eight
# 55 MB week files took 8.63 s against a hook's 10-second budget, and one of them cost
# jq 397 MB resident. Week files are append-only, so the tail is the newest records;
# `fromjson?` below drops the part-line the cut leaves at the front.
PENDING_BYTES="${INSIGHT_PENDING_BYTES:-262144}"
case "$PENDING_BYTES" in ''|*[!0-9]*) PENDING_BYTES=262144 ;; esac
[ "$PENDING_BYTES" -lt 4096 ] && PENDING_BYTES=4096

# $1 = a directory whose records to prefer, or "" for no preference.
# Always prints exactly one line, including on every failure path: a caller in a hook
# must be able to parse the answer without also having to handle silence.
pending_tsv() {
  if [ ! -d "$DIR" ]; then printf '0\t0\t\t\t0\t\n'; return 0; fi
  pt_proj=""
  if [ -n "${1:-}" ]; then
    # Records store the git toplevel when there is one (see the capture hook), so the
    # caller's cwd has to be resolved the same way or a session started in a
    # subdirectory never matches its own project.
    pt_proj="$(cd "$1" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)"
    [ -z "$pt_proj" ] && pt_proj="$1"
  fi
  # `cat` in a read loop rather than `jq f1 f2 ...`: a state directory containing a
  # space word-splits the second form, and the failure is silent.
  pt_out="$(all_files | tail -n "$PENDING_WINDOW" | while IFS= read -r qf; do
      [ -n "$qf" ] && tail -c "$PENDING_BYTES" "$qf" 2>/dev/null
    done | jq -R -r -s --argjson dec "$(judged_json)" --arg proj "$pt_proj" \
                       --argjson now "$now" '
    def clean: gsub("[\t\n\r]"; " ") | gsub("  +"; " ");
    # capture() raises on no match; `?` turns that into no output, and `// null` turns
    # no output into one null. A record whose wording changed then renders "?" for that
    # number instead of making the whole line unbuildable.
    def num($re): ((((.text // "") | capture($re)?) // null)
                   | if . == null then "?" else .n end);
    def headline:
      (((.project // "") | split("/") | map(select(length > 0)) | last) // "?") as $p
      | if (.source // "") == "session-audit" then
          $p + " - " + num("file edits counted[ ]+(?<n>[0-9]+)") + " edits across "
             + num("distinct files touched[ ]+(?<n>[0-9]+)") + " files, "
             + num("checkpoints fired[ ]+(?<n>[0-9]+)") + " checkpoints fired"
        else
          $p + " - " + ((.text // "") | clean | .[0:120])
        end;
    # `index(.hash)` would evaluate `.hash` against $dec, the ARRAY -- jq applies a
    # function argument to the input of the function it was passed to, so that form
    # raises "cannot index array with string" and, behind the 2>/dev/null this runs
    # under, silently reports an empty queue. Bind the hash first.
    [ split("\n")[] | select(length > 0) | (fromjson? // empty)
      | select(type == "object")
      | select((.hash // "") as $h | ($dec | index($h)) | not) ]
    | sort_by(.ts // "")
    | if length == 0 then "0\t0\t\t\t0\t"
      else . as $all
        | (($all | map(select((.project // "") == $proj)) | first) // ($all | first)) as $pick
        | (($all | first | .ts // "") | (fromdateiso8601? // $now)) as $t0
        | (($all | last  | .ts // "") | (fromdateiso8601? // $now)) as $t1
        | [ ($all | length | tostring),
            (((($now - $t0) / 86400) | floor | if . < 0 then 0 else . end) | tostring),
            ($pick.week // ""),
            (($pick.hash // "")[0:8]),
            ($t1 | floor | tostring),
            ($pick | headline | clean) ] | join("\t")
      end' 2>/dev/null)"
  # One line, always. jq is constrained to a single line above, but a caller doing
  # `cut -f1` on an unexpected second line would read a count that is not a number,
  # so the guarantee is enforced here rather than assumed.
  pt_out="$(printf '%s' "$pt_out" | head -n 1)"
  [ -z "$pt_out" ] && pt_out="$(printf '0\t0\t\t\t0\t')"
  printf '%s\n' "$pt_out"
  return 0
}

# The nudge stamp: "<epoch-last-announced> <watermark-epoch>", one line, where the
# watermark is the timestamp of the newest record the user has been told about.
# The reminder hook writes both fields; `review` writes only the first, and that
# asymmetry is the fix for a measured misfire.
#
# `review` has to touch the stamp at all, because a queue that was just read should not
# be announced again an hour later. But it must NOT claim the watermark. Measured:
# `skillinsight review --week 2025-W30` over a week holding one declined record printed
# "0 candidates" and, when it also advanced the watermark, silenced twenty-five live
# candidates in another week for a fortnight. Reviewing nothing must not count as
# reading everything. So review resets the floor and leaves the watermark alone: three
# days of quiet, and then whatever is still undeclined is raised again.
record_nudge() {
  mkdir -p "$DIR" 2>/dev/null || return 0
  rn_mark=0
  if [ -f "$NUDGE_STAMP" ]; then
    rn_mark="$(awk '{print $2; exit}' "$NUDGE_STAMP" 2>/dev/null)"
    case "$rn_mark" in ''|*[!0-9]*) rn_mark=0 ;; esac
  fi
  # Subshell, so a failed redirect cannot reach the terminal: the shell reports it
  # before applying the 2>/dev/null on the same command.
  ( printf '%s %s\n' "$now" "$rn_mark" > "$NUDGE_STAMP" ) 2>/dev/null || true
  return 0
}

# Echoes the ISO week named by --week, or the current one. Runs in a command
# substitution, so it must never print anything else: --help is handled by the
# caller before this is reached.
parse_week_flag() {
  w=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --week) shift; w="${1:-}"; [ -z "$w" ] && die "--week needs an ISO week, e.g. 2026-W34" ;;
      --week=*) w="${1#--week=}" ;;
      *) die "unexpected argument '$1'" ;;
    esac
    shift
  done
  [ -z "$w" ] && w="$(week_of "$now")"
  printf '%s' "$w"
}

wants_help() {
  while [ "$#" -gt 0 ]; do
    case "$1" in -h|--help) return 0 ;; esac
    shift
  done
  return 1
}

cmd="${1:-}"; shift 2>/dev/null || true

case "$cmd" in
  ""|-h|--help|help) usage; exit 0 ;;

  list)
    wants_help "$@" && { usage; exit 0; }
    # --source is stripped before the week parser sees it: that parser rejects anything
    # it does not know, which is the behaviour that keeps a typo from being ignored.
    src=""
    wk=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --source) shift; src="${1:-}"; [ -z "$src" ] && die "--source needs a source name" ;;
        --source=*) src="${1#--source=}" ;;
        *) wk="$wk $1" ;;
      esac
      shift
    done
    # shellcheck disable=SC2086
    week="$(parse_week_flag $wk)" || exit $?
    f="$(files_for_week "$week")"
    if [ -z "$f" ]; then
      echo "skillinsight: nothing queued for $week"
      exit 0
    fi
    shown="$(jq -r --argjson dec "$(declined_json)" --argjson pro "$(promoted_json)" \
                 --arg src "$src" '
      select($src == "" or .source == $src)
      | (.hash) as $h
      | (if ($dec | index($h)) then "  [declined]"
         elif ($pro | index($h)) then "  [promoted]"
         else "" end) as $d
      | (.source) + "  " + (.ts) + "  " + (.project) + $d
        + "\n    " + ((.text | gsub("\\s+"; " "))[0:110])' "$f" 2>/dev/null \
      | awk '/^[a-z]/ {n++; printf "%3d  %s\n", n, $0; next} {print}')"
    # Counted from the records, never from the rendered text. Counting rendered lines
    # with `grep -c '^ *[0-9]'` also counts a wrapped candidate that happens to begin
    # with a digit ("12 factor config..."), so the header claimed three candidates
    # above a list of two.
    count="$(jq -r --arg src "$src" 'select($src == "" or .source == $src) | .hash' "$f" 2>/dev/null \
      | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
    if [ -n "$src" ]; then
      echo "queue for $week (source=$src: $count of $(wc -l < "$f" | tr -d ' ') candidates)"
    else
      echo "queue for $week ($count candidates)"
    fi
    [ "$count" -gt 0 ] && printf '%s\n' "$shown"
    ;;

  decline)
    wants_help "$@" && { usage; exit 0; }
    why=""
    dc_bulk=0; dc_src=""; dc_week=""; dc_dry=0
    case "${1:-}" in --source|--source=*) dc_bulk=1 ;; esac

    if [ "$dc_bulk" = "1" ]; then
      # THE BULK FORM, AND WHY ONE HASH AT A TIME WAS NOT ENOUGH. The queue's second
      # feeder is not ours: `★ Insight` blocks come from an output-style plugin, and on
      # 2026-09-02 they were 46 of the 57 rows in the live queue -- prose about code the
      # session had just written, not candidates anybody would forge. Judging those one
      # hash at a time is 46 commands, and the thing a reader reaches for instead is
      # `snooze`, or CI_QUEUE_NUDGE=0, which buries the eleven real rows with them.
      #
      # It is still a decline in every other respect: append-only, nothing deleted,
      # every record still listed (marked) and still counted by `stats`. And a source
      # matching nothing REFUSES, for the same reason an unknown hash does -- a typo
      # that judges nothing silently leaves the reviewer believing the queue is handled.
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --source) shift; dc_src="${1:-}"; [ -z "$dc_src" ] && die "--source needs a source name" ;;
          --source=*) dc_src="${1#--source=}" ;;
          --week) shift; dc_week="${1:-}"; [ -z "$dc_week" ] && die "--week needs an ISO week, e.g. 2026-W34" ;;
          --week=*) dc_week="${1#--week=}" ;;
          --why) shift; why="${1:-}" ;;
          --why=*) why="${1#--why=}" ;;
          --dry-run) dc_dry=1 ;;
          *) die "unexpected argument '$1'" ;;
        esac
        shift
      done
      [ -n "$dc_src" ] || die "decline --source needs a source name"
      if [ -n "$dc_week" ]; then dc_files="$(files_for_week "$dc_week")"; else dc_files="$(all_files)"; fi
      dc_where="the queue"
      [ -n "$dc_week" ] && dc_where="$dc_week"
      dc_all="$(printf '%s\n' "$dc_files" | while IFS= read -r qf; do
          [ -n "$qf" ] || continue
          jq -r --arg s "$dc_src" 'select((.source // "") == $s) | .hash // empty' "$qf" 2>/dev/null
        done | sort -u | grep '[^[:space:]]')"
      dc_have="$(declined_json | jq -r '.[]' 2>/dev/null)"
      ts="$(date -u -r "$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
      dc_new=0; dc_old=0
      [ "$dc_dry" = "1" ] || mkdir -p "$DIR" 2>/dev/null || die "cannot write to $DIR"
      while IFS= read -r dc_h; do
        [ -n "$dc_h" ] || continue
        if printf '%s\n' "$dc_have" | grep -Fxq "$dc_h"; then
          dc_old=$(( dc_old + 1 ))
          continue
        fi
        dc_new=$(( dc_new + 1 ))
        if [ "$dc_dry" = "1" ]; then
          echo "               would decline $(printf '%s' "$dc_h" | cut -c1-8)"
          continue
        fi
        rec="$(jq -c -n --arg hash "$dc_h" --arg ts "$ts" --arg why "$why" \
          '{hash:$hash, ts:$ts, why:$why}' 2>/dev/null)"
        [ -z "$rec" ] && die "could not build the decline record for $dc_h"
        printf '%s\n' "$rec" >> "$DECLINED" || die "cannot append to $DECLINED"
      done <<DECLINE_EOF
$dc_all
DECLINE_EOF
      if [ "$(( dc_new + dc_old ))" -eq 0 ]; then
        die "no queued candidate in $dc_where has source '$dc_src'; \`skillinsight stats\` lists the sources present"
      fi
      if [ "$dc_dry" = "1" ]; then
        echo "skillinsight: would decline $dc_new record(s) with source '$dc_src' in $dc_where"
      else
        echo "skillinsight: declined $dc_new record(s) with source '$dc_src' in $dc_where"
      fi
      if [ "$dc_old" -gt 0 ]; then
        echo "               $dc_old already declined and left alone"
      fi
      if [ -n "$why" ]; then
        echo "               why: $why"
      fi
      echo "               nothing was deleted; \`skillinsight list\` still shows them, marked"
      exit 0
    fi

    h="${1:-}"; [ -z "$h" ] && die "usage: skillinsight decline <hash> [--why <reason>] | decline --source <src>"
    case "$h" in -*) die "usage: skillinsight decline <hash> [--why <reason>] | decline --source <src>" ;; esac
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --why) shift; why="${1:-}" ;;
        --why=*) why="${1#--why=}" ;;
        *) die "unexpected argument '$1'" ;;
      esac
      shift
    done
    # The hash has to name a real record, or a typo silently declines nothing and the
    # reviewer believes the queue is handled. Prefix matching is allowed because
    # `review` prints only the first eight characters.
    resolve_hash "$h"
    full="$RESOLVED"
    ts="$(date -u -r "$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    rec="$(jq -c -n --arg hash "$full" --arg ts "$ts" --arg why "$why" \
      '{hash:$hash, ts:$ts, why:$why}' 2>/dev/null)"
    [ -z "$rec" ] && die "could not build the decline record"
    mkdir -p "$DIR" 2>/dev/null || die "cannot write to $DIR"
    printf '%s\n' "$rec" >> "$DECLINED" || die "cannot append to $DECLINED"
    # Appended, never deleted. The queued line stays exactly where it was; `list` still
    # shows it, marked, so a decline is inspectable rather than a disappearance.
    echo "skillinsight: declined ${full}"
    if [ -n "$why" ]; then
      echo "               why: $why"
    fi
    ;;

  promote|promote-review)
    wants_help "$@" && { usage; exit 0; }
    # WHY THIS EXISTS. The queue and the review index are both READ surfaces: everything
    # in them is a lesson somebody still has to retype somewhere else before it can ever
    # fire again, and nobody does. Two paid-for CANDIDATE verdicts produced no artifact
    # at all for exactly that reason. `promote` is the one command between a queued
    # candidate and the cheapest tier that does get read. It writes NOTHING itself: the
    # text goes to bin/skillnote, which owns the marker block, the backup, the atomic
    # write and the id, and a second implementation of any of those here would be a
    # second set of rules that drifts from the first.
    #
    # IT DERIVES NOTHING IT WAS NOT GIVEN. `--to reminder` refuses without an explicit
    # --keyword/--path/--command and never mines the record's prose for keywords. A
    # reminder built from guessed keywords fires on the wrong turns, and the cost of one
    # that cries wolf is that the next real one is disregarded too.
    pr_hash=""; pr_sid=""; pr_to=""; pr_scope="project"; pr_proj=""
    pr_text=""; pr_why=""; pr_kw=""; pr_pg=""; pr_cm=""
    if [ "$cmd" = "promote-review" ]; then
      case "${1:-}" in
        ""|-*) : ;;
        *) pr_sid="$1"; shift ;;
      esac
    fi
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --verdict) shift; pr_sid="${1:-}"; [ -z "$pr_sid" ] && die "--verdict needs a session id" ;;
        --verdict=*) pr_sid="${1#--verdict=}" ;;
        --to) shift; pr_to="${1:-}"; [ -z "$pr_to" ] && die "--to needs 'note' or 'reminder'" ;;
        --to=*) pr_to="${1#--to=}" ;;
        --scope) shift; pr_scope="${1:-}"; [ -z "$pr_scope" ] && die "--scope needs a value" ;;
        --scope=*) pr_scope="${1#--scope=}" ;;
        --project) shift; pr_proj="${1:-}"; [ -z "$pr_proj" ] && die "--project needs a directory" ;;
        --project=*) pr_proj="${1#--project=}" ;;
        --text) shift; pr_text="${1:-}"; [ -z "$pr_text" ] && die "--text needs the note text" ;;
        --text=*) pr_text="${1#--text=}" ;;
        --why) shift; pr_why="${1:-}" ;;
        --why=*) pr_why="${1#--why=}" ;;
        --keyword) shift; [ -n "${1:-}" ] || die "--keyword needs a value"
                   pr_kw="$pr_kw$1
" ;;
        --keyword=*) pr_kw="$pr_kw${1#--keyword=}
" ;;
        --path) shift; [ -n "${1:-}" ] || die "--path needs a glob"
                pr_pg="$pr_pg$1
" ;;
        --path=*) pr_pg="$pr_pg${1#--path=}
" ;;
        --command) shift; [ -n "${1:-}" ] || die "--command needs a command"
                   pr_cm="$pr_cm$1
" ;;
        --command=*) pr_cm="$pr_cm${1#--command=}
" ;;
        -*) die "unexpected argument '$1'" ;;
        *) [ -n "$pr_hash" ] && die "promote takes one hash; got '$pr_hash' and '$1'"
           pr_hash="$1" ;;
      esac
      shift
    done

    [ -n "$pr_to" ] || die "promote needs --to note or --to reminder"
    case "$pr_to" in note|reminder) ;; *) die "--to takes 'note' or 'reminder'" ;; esac
    case "$pr_scope" in
      project|global|memory) ;;
      *) die "unknown --scope '$pr_scope'. The three are: project, global, memory." ;;
    esac
    [ -n "$pr_hash" ] && [ -n "$pr_sid" ] && \
      die "promote takes a queue hash or --verdict <session-id>, not both"
    [ -n "$pr_hash$pr_sid" ] || \
      die "promote needs a candidate hash, or --verdict <session-id> for a review verdict"
    if [ "$pr_to" = "reminder" ] && [ -z "$pr_kw$pr_pg$pr_cm" ]; then
      die "--to reminder needs at least one --keyword, --path or --command. They are never derived from the record's prose: a reminder matched on guessed keywords fires on the wrong turns, and one that cries wolf gets the next real one disregarded too."
    fi

    sn="$(skillnote_bin)" || \
      die "skillnote is neither beside $0 nor on PATH. promote writes through it and will not reimplement it."

    if [ -n "$pr_hash" ]; then
      resolve_hash "$pr_hash"
      pr_key="$RESOLVED"
      pr_rec="$(all_files | while IFS= read -r qf; do
          [ -n "$qf" ] || continue
          jq -c --arg h "$pr_key" 'select((.hash // "") == $h)' "$qf" 2>/dev/null
        done | head -n 1)"
      [ -n "$pr_rec" ] || die "could not read the queued record for $pr_key"
      pr_store="$PROMOTED"; pr_field="hash"; pr_source="session"
      # First line, whitespace squeezed, capped at 200. The cap is done in jq, on
      # CODEPOINTS: `cut -c` is locale-dependent for multibyte text and would cut a
      # candidate's ★ in half.
      if [ -z "$pr_text" ]; then
        pr_text="$(printf '%s' "$pr_rec" | jq -r '
          ((.text // "") | split("\n")[0] | gsub("[\t\r]"; " ")
           | gsub("^ +"; "") | gsub(" +$"; "") | gsub("  +"; " "))[0:200]' 2>/dev/null)"
      fi
      [ -n "$pr_text" ] || \
        die "the record's text is empty; give the note text yourself with --text \"<one line>\""
      [ -z "$pr_proj" ] && pr_proj="$(printf '%s' "$pr_rec" | jq -r '.project // ""' 2>/dev/null)"
      if [ -z "$pr_why" ]; then
        pr_why="skillinsight promote $(printf '%s' "$pr_key" | cut -c1-8): queued $(printf '%s' "$pr_rec" | jq -r '.ts // "?"' 2>/dev/null) from $(printf '%s' "$pr_rec" | jq -r '.source // "?"' 2>/dev/null)"
      fi
      pr_label="$(printf '%s' "$pr_key" | cut -c1-8)"
    else
      # THE OTHER QUEUE. hooks/session-review.sh spends real money to produce these and
      # writes them into a session nobody is in; a CANDIDATE row that nobody turns into
      # anything is the same waste as an unread queue record, and it has already
      # happened twice.
      pr_idx="$REVIEWS/index.jsonl"
      [ -f "$pr_idx" ] || die "no automatic session reviews on disk yet ($pr_idx)"
      pr_n="$(reviews_newest_first "$pr_idx" \
        | jq -r --arg s "$pr_sid" 'select((.session // "") | startswith($s)) | .session' 2>/dev/null \
        | sort -u | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
      case "$pr_n" in ''|*[!0-9]*) pr_n=0 ;; esac
      [ "$pr_n" -eq 0 ] && die "no session review has a session id starting '$pr_sid'"
      [ "$pr_n" -gt 1 ] && die "'$pr_sid' matches $pr_n reviews; use more of the session id"
      pr_row="$(reviews_newest_first "$pr_idx" \
        | jq -c --arg s "$pr_sid" 'select((.session // "") | startswith($s))' 2>/dev/null | head -n 1)"
      [ -n "$pr_row" ] || die "could not read the review row for '$pr_sid'"
      pr_v="$(printf '%s' "$pr_row" | jq -r '.verdict // ""' 2>/dev/null)"
      [ "$pr_v" = "CANDIDATE" ] || \
        die "that review's verdict is '${pr_v:-unrecorded}', not CANDIDATE; there is nothing in it to promote"
      pr_name="$(printf '%s' "$pr_row" | jq -r '.name // ""' 2>/dev/null)"
      pr_key="$(printf '%s' "$pr_row" | jq -r '.session // ""' 2>/dev/null)"
      pr_store="$REVIEWS/.promoted.jsonl"; pr_field="session"; pr_source="verdict"
      [ -z "$pr_text" ] && pr_text="session review: candidate '$pr_name'"
      [ -z "$pr_proj" ] && pr_proj="$(printf '%s' "$pr_row" | jq -r '.project // ""' 2>/dev/null)"
      [ -z "$pr_why" ] && pr_why="see $(printf '%s' "$pr_row" | jq -r '.report // "the report"' 2>/dev/null)"
      pr_label="$pr_name"
    fi

    # Already promoted TO THIS TIER? A note and a reminder are different stores with
    # different ids and are meant to coexist, so the key is the record AND the tier.
    pr_prev="$(jq -R -r --arg k "$pr_key" --arg to "$pr_to" --arg f "$pr_field" '
        (fromjson? // empty) | select(type == "object")
        | select((.[$f] // "") == $k and (.to // "") == $to) | .id // ""' \
        "$pr_store" 2>/dev/null | head -n 1)"

    # An argv of variable length with no arrays: nothing else in this package uses one,
    # and `set --` is how the rest of it carries a list. The text goes last, after `--`,
    # so a lesson that begins with a dash is text and not an option.
    # The lineage id, derived from the key of whichever store this came out of. It is
    # passed rather than recomputed downstream: bin/skillnote writes it onto the ledger
    # note row and onto the reminder row, hooks/remind.sh carries it into every delivery,
    # and bin/skillreport's FUNNEL is that chain read back as a join.
    if [ "$pr_field" = "hash" ]; then
      pr_lineage="$(lineage_of c "$pr_key")"
    else
      pr_lineage="$(lineage_of v "$pr_key")"
    fi

    # WHERE THIS LANDS, SAID FIRST AND OUT LOUD. The target is the CANDIDATE's own
    # project, not the caller's cwd -- that is where the finding applies and it is
    # deliberate -- but until this line a promote run from a scratch directory wrote a
    # note into a repository the caller was not in and reported only "promoted". The
    # path is asked of bin/skillnote rather than recomputed here: a second copy of the
    # four scope resolutions is the drift .claude/CLAUDE.md warns about, and this one
    # would be invisible because both halves would still print something.
    if [ "$pr_to" = "reminder" ]; then pr_wscope="remind"; else pr_wscope="$pr_scope"; fi
    if [ -n "$pr_proj" ]; then
      pr_target="$("$sn" where --scope "$pr_wscope" --project "$pr_proj" 2>/dev/null)"
    else
      pr_target="$("$sn" where --scope "$pr_wscope" 2>/dev/null)"
    fi
    [ -n "$pr_target" ] || die "skillnote could not say where a $pr_to would be written"
    echo "skillinsight: target $pr_target"
    # AND REFUSED IF IT IS NOWHERE. skillnote creates the `.claude/` directory but not
    # the project above it, so a candidate recorded against a project that has since
    # been deleted or moved would otherwise have that whole tree created for it and a
    # note written where nobody will read it. `--project <dir>` is the way out.
    case "$pr_wscope" in
      project) pr_need="${pr_target%/.claude/CLAUDE.md}" ;;
      global)  pr_need="$(dirname "$pr_target")" ;;
      *)       pr_need="" ;;
    esac
    if [ -n "$pr_need" ] && [ ! -d "$pr_need" ]; then
      die "the $pr_wscope directory for this candidate does not exist: $pr_need -- nothing was promoted. Pass --project <dir> to write it somewhere that does."
    fi

    set -- add --scope "$pr_scope" --source "$pr_source" --why "$pr_why"
    if [ -n "$pr_lineage" ]; then set -- "$@" --candidate "$pr_lineage"; fi
    if [ -n "$pr_proj" ]; then set -- "$@" --project "$pr_proj"; fi
    if [ "$pr_to" = "reminder" ]; then
      set -- "$@" --remind
      while IFS= read -r pr_i; do
        if [ -n "$pr_i" ]; then set -- "$@" --keyword "$pr_i"; fi
      done <<PROMOTE_KW_EOF
$pr_kw
PROMOTE_KW_EOF
      while IFS= read -r pr_i; do
        if [ -n "$pr_i" ]; then set -- "$@" --path "$pr_i"; fi
      done <<PROMOTE_PG_EOF
$pr_pg
PROMOTE_PG_EOF
      while IFS= read -r pr_i; do
        if [ -n "$pr_i" ]; then set -- "$@" --command "$pr_i"; fi
      done <<PROMOTE_CM_EOF
$pr_cm
PROMOTE_CM_EOF
    fi
    set -- "$@" -- "$pr_text"

    # skillnote's exit code is carried through unchanged: 2 is a refusal the caller can
    # fix, 3 is an environment they must (a memory slug that does not exist). Collapsing
    # both into this CLI's own 2 would tell a caller to retype a flag when the real
    # answer is that Claude Code has never opened that directory.
    pr_out="$("$sn" "$@" 2>&1)"
    pr_rc=$?
    if [ "$pr_rc" -ne 0 ]; then
      printf '%s\n' "$pr_out" >&2
      echo "skillinsight: skillnote refused (exit $pr_rc); nothing was promoted and no promote record was written" >&2
      exit "$pr_rc"
    fi
    printf '%s\n' "$pr_out"

    pr_id="$(printf '%s' "$pr_out" | sed -n 's/.*(\(n[0-9][0-9]*x[0-9][0-9]*\)).*/\1/p' | head -n 1)"
    if [ -z "$pr_id" ]; then
      echo "skillinsight: skillnote reported no id; the promote record is written without one" >&2
    fi
    ts="$(date -u -r "$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    if [ -n "$pr_prev" ]; then
      # skillnote was still called: `add` is idempotent by id, so a second run is free
      # and it puts the line back if someone deleted it out of the CLAUDE.md by hand.
      echo "skillinsight: already promoted to a $pr_to ($pr_prev); the record was not marked twice"
    else
      pr_json="$(jq -c -n --arg k "$pr_key" --arg f "$pr_field" --arg ts "$ts" \
        --arg to "$pr_to" --arg id "$pr_id" --arg scope "$pr_scope" \
        --arg cand "$pr_lineage" \
        '{($f): $k, ts: $ts, to: $to, id: $id, scope: $scope}
         + (if $cand == "" then {} else {candidate: $cand} end)' 2>/dev/null)"
      [ -n "$pr_json" ] || die "could not build the promote record"
      mkdir -p "$(dirname "$pr_store")" 2>/dev/null || die "cannot write to $(dirname "$pr_store")"
      printf '%s\n' "$pr_json" >> "$pr_store" || die "cannot append to $pr_store"
      echo "skillinsight: promoted $pr_label to a $pr_to"
      echo "               recorded in $pr_store"
    fi
    if [ "$pr_field" = "hash" ]; then
      echo "               it is no longer offered by \`skillinsight pending\`; \`list\` still shows it, marked"
    fi
    [ -n "$pr_lineage" ] && echo "               lineage $pr_lineage"
    exit 0
    ;;

  review)
    wants_help "$@" && { usage; exit 0; }
    week="$(parse_week_flag "$@")" || exit $?
    f="$(files_for_week "$week")"
    if [ -z "$f" ]; then
      echo "skillinsight: nothing queued for $week"
      exit 0
    fi
    dec="$(judged_json)"
    n="$(jq -r --argjson dec "$dec" '. as $r | select(($dec | index($r.hash)) | not) | .hash' "$f" 2>/dev/null \
      | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    # Counted apart, and reported apart. A promoted record and a declined one are both
    # out of the batch, but they are opposite judgements -- one was written down where
    # it will be read, the other was judged not worth writing down -- and one number
    # covering both would say neither.
    dskip="$(jq -r --argjson dec "$(declined_json)" '. as $r | select($dec | index($r.hash)) | .hash' "$f" 2>/dev/null \
      | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
    case "$dskip" in ''|*[!0-9]*) dskip=0 ;; esac
    skipped="$(( $(wc -l < "$f" | tr -d ' ') - n ))"
    pskip="$(( skipped - dskip ))"
    [ "$pskip" -lt 0 ] && pskip=0
    cat <<INSTRUCTIONS
==============================================================================
SKILL CANDIDATE REVIEW  |  $week  |  $n candidates
==============================================================================

Instructions for the reviewing session. Do all of this yourself, in this turn.

1. KERNEL EXTRACTION, first, for every candidate. Rewrite the lesson with every
   repo-specific name replaced by the role it plays. A path becomes "a second
   validator module". A function name becomes "the retry wrapper". A ticket number
   goes away. Write the rewrite out. It is the rewrite, not the original text, that
   becomes a skill candidate.

2. THEN LABEL each candidate, using the rewrite as the evidence:
     UNIVERSAL  the rewrite still states something actionable to someone who has
                never seen this repo.
     LOCAL      the rewrite collapses into a fact about one codebase. File it in
                that repo's CLAUDE.md or notes. Say which repo.
     DISCARD    the rewrite collapses to a tautology, to restated documentation,
                or to nothing.
   Do not label before rewriting. The label is a judgement about the rewrite. An
   automatic classifier for this was built and measured at chance (7/14), so there
   is no shortcut here: notes/research/insight-capture.md section 6.

3. THEN APPLY THE EXISTING THRESHOLD to the UNIVERSAL survivors only. A candidate
   earns a skill only if it is BOTH costly to have gotten right (more than 15
   minutes of trial and error, a non-obvious ordering constraint, or an error a
   fresh session would predictably repeat) AND likely to recur (it has already
   happened twice, or it is a standing part of the workflow). Both, or it gets a
   note instead of a skill.

4. SESSION-AUDIT CANDIDATES ARE DIFFERENT, and step 1 does not apply to them.
   They carry no lesson to extract a kernel from. They carry a list of what one
   session actually edited, written by the hook without asking the session anything,
   because a session asked mid-fix whether its work is recurring reliably answers no.
   For each one, read the file list as a SET and answer the question the session could
   not: were two or more of those edits fixes of the same kind? If yes, name the kind
   -- that, not any single fix, is the candidate, and it goes to step 3. If no, or if
   the record is not worth carrying forward, run
       skillinsight decline <hash> --why "<one line>"
   Declining keeps the record and marks it; only a decline stops it being presented
   again next week.

5. NEVER AUTO-FORGE. Not from this batch, not from any part of it. Present the
   survivors and what you propose to do with each, and stop. Forging happens only
   when a human says so, through the skill-compounder skill and its builder and
   red-team loop. A queue that forges itself produces skills faster than anyone can
   red-team them, which is the failure this whole design exists to avoid.

------------------------------------------------------------------------------
INSTRUCTIONS
    if [ "$dskip" -gt 0 ]; then
      echo "($dskip already declined and not shown; \`skillinsight list\` still shows them)"
    fi
    if [ "$pskip" -gt 0 ]; then
      echo "($pskip already promoted to a note or a reminder and not shown; \`skillinsight list\` still shows them)"
    fi
    if [ "$skipped" -gt 0 ]; then
      echo "------------------------------------------------------------------------------"
    fi
    jq -r --argjson dec "$dec" '
      . as $r
      | select(($dec | index($r.hash)) | not)
      | "\n[" + (.source) + "]  " + (.project) + "  " + (.ts) + "  " + (.hash[0:8]) + "\n" +
      (.text) + "\n" +
      "------------------------------------------------------------------------------"
      ' "$f"
    # A session-audit record snapshots the file list at the moment the threshold was
    # crossed; the session almost always kept editing afterwards. The live list is on
    # disk until the reminder state ages out, so show it when it has grown. Not folded
    # into the record itself: the queue is append-only by design, and a record that
    # rewrote itself would stop being an account of what was true when it was written.
    jq -r --argjson dec "$dec" \
      '. as $r | select(.source == "session-audit") | select(($dec | index($r.hash)) | not)
       | (.hash[0:8]) + "\t" + (.session // "")' "$f" 2>/dev/null \
    | while IFS="$(printf '\t')" read -r rhash rsid; do
        [ -z "$rsid" ] && continue
        # Must sanitise exactly as hooks/compound-improvement.sh does, or this looks
        # for a filename that never existed and silently shows nothing.
        #
        # THE `cut` IS HALF OF "EXACTLY", AND IT WAS MISSING. Every other site in this
        # package spells it `tr -c 'A-Za-z0-9._-' '_' | cut -c1-96`; this one stopped at
        # the `tr` while the comment above it claimed the spellings matched. The two
        # agree for a 36-character UUID and diverge the moment an id is longer than 96:
        # measured on a 130-character id, the writer produces a 96-character name and
        # this reader looked for the 129-character one, found no file, and `continue`d --
        # showing nothing, with no error, which is indistinguishable from a session that
        # touched no files. A comment asserting two things are identical is not a check;
        # tests/test_insights.py now compares the two expressions on an id long enough
        # to tell them apart.
        safe="$(printf '%s' "$rsid" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-96)"
        case "$safe" in ''|.|..) safe=_ ;; esac
        live="$REMINDERS/$safe.paths"
        [ -f "$live" ] || continue
        total="$(sort -u "$live" 2>/dev/null | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
        case "$total" in ''|*[!0-9]*) continue ;; esac
        echo ""
        echo "LIVE FILE LIST for session-audit $rhash ($total distinct files, current):"
        sort -u "$live" 2>/dev/null | grep '[^[:space:]]' | sed 's/^/  /'
        echo "------------------------------------------------------------------------------"
      done
    # The queue has now been read, so record that. Without this, running `review` and
    # deciding that nothing in it is worth a skill leaves the surfacing state untouched
    # and the next session announces the same queue again -- which teaches the reader
    # that reviewing changes nothing, and that is how a reminder gets muted. Declining
    # is still what removes a record; this only stops it being ANNOUNCED again
    # immediately.
    record_nudge
    ;;

  pending)
    wants_help "$@" && { usage; exit 0; }
    fmt="text"; proj=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --format) shift; fmt="${1:-}" ;;
        --format=*) fmt="${1#--format=}" ;;
        --project) shift; proj="${1:-}" ;;
        --project=*) proj="${1#--project=}" ;;
        *) die "unexpected argument '$1'" ;;
      esac
      shift
    done
    case "$fmt" in tsv|text) ;; *) die "--format takes 'tsv' or 'text'" ;; esac
    line="$(pending_tsv "$proj")"
    if [ "$fmt" = "tsv" ]; then
      printf '%s\n' "$line"
      exit 0
    fi
    count="$(printf '%s' "$line" | cut -f1)"
    days="$(printf '%s' "$line" | cut -f2)"
    pweek="$(printf '%s' "$line" | cut -f3)"
    phash="$(printf '%s' "$line" | cut -f4)"
    hline="$(printf '%s' "$line" | cut -f6-)"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
    if [ "$count" -eq 0 ]; then
      echo "skillinsight: nothing pending (declined records are not counted)"
    else
      echo "$count pending candidate(s); the oldest is $days day(s) old."
      echo "top: $hline"
      echo "     [$phash]  in $pweek"
      echo ""
      echo "  skillinsight review --week $pweek"
      echo "  skillinsight decline $phash --why \"<one line>\"   # not this one, ever"
      echo "  skillinsight snooze 14                            # not now"
    fi
    if [ -f "$NUDGE_STAMP" ]; then
      echo "last surfaced: $(cat "$NUDGE_STAMP" 2>/dev/null) (epoch, watermark)"
    else
      echo "last surfaced: never"
    fi
    if [ -f "$SNOOZE" ]; then
      su="$(cat "$SNOOZE" 2>/dev/null || echo 0)"
      case "$su" in ''|*[!0-9]*) su=0 ;; esac
      if [ "$su" -gt "$now" ]; then
        echo "snoozed:       for another $(( (su - now) / 86400 )) day(s)"
      fi
    fi
    ;;

  snooze)
    wants_help "$@" && { usage; exit 0; }
    # "Not now" is a different answer from "not this", and the mechanism has to accept
    # both or it becomes something people mute at the source. `decline` records a
    # judgement about one record and is permanent; this records no judgement at all,
    # expires by itself, and never touches the queue.
    days=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --clear)
          rm -f "$SNOOZE" 2>/dev/null
          echo "skillinsight: snooze cleared"
          exit 0 ;;
        *) [ -n "$days" ] && die "usage: skillinsight snooze [<days>] | --clear"
           days="$1" ;;
      esac
      shift
    done
    [ -z "$days" ] && days=7
    case "$days" in ''|*[!0-9]*) die "snooze takes a whole number of days, or --clear" ;; esac
    [ "$days" -eq 0 ] && die "snooze 0 does nothing; use 'skillinsight snooze --clear'"
    # Bounded, because the arithmetic below is not. `snooze 200000000000000` silently
    # overflowed to a NEGATIVE epoch, printed a cheerful confirmation, and left the
    # reminder firing -- a mute that reports success and does nothing is worse than a
    # refusal. Ten years is longer than any honest "not now".
    [ "${#days}" -gt 6 ] || [ "$days" -gt 3650 ] && \
      die "snooze takes at most 3650 days; use CI_QUEUE_NUDGE=0 to switch it off for good"
    mkdir -p "$DIR" 2>/dev/null || die "cannot write to $DIR"
    printf '%s\n' "$(( now + days * 86400 ))" > "$SNOOZE" || die "cannot write $SNOOZE"
    echo "skillinsight: queue reminders snoozed for $days day(s)"
    echo "               nothing was judged and nothing was removed; the queue is unchanged"
    ;;

  stats)
    [ "$#" -gt 0 ] && { case "$1" in -h|--help) usage; exit 0 ;; *) die "stats takes no arguments" ;; esac; }
    fs="$(all_files)"
    if [ -z "$fs" ]; then
      echo "skillinsight: the queue is empty ($DIR)"
      exit 0
    fi
    total=0; weeks=0; first=""; last=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      c="$(wc -l < "$f" | tr -d ' ')"
      total=$(( total + c ))
      weeks=$(( weeks + 1 ))
      w="$(basename "$f" .jsonl)"
      [ -z "$first" ] && first="$w"
      last="$w"
    done <<STATS_EOF
$fs
STATS_EOF
    dupes=0
    [ -f "$DIR/.dedup-count" ] && dupes="$(cat "$DIR/.dedup-count" 2>/dev/null || echo 0)"
    case "$dupes" in ''|*[!0-9]*) dupes=0 ;; esac
    declined=0
    if [ -f "$DECLINED" ]; then
      declined="$(jq -R -r '(fromjson? // empty) | .hash // empty' "$DECLINED" 2>/dev/null \
        | sort -u | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
    fi
    case "$declined" in ''|*[!0-9]*) declined=0 ;; esac
    promoted=0
    if [ -f "$PROMOTED" ]; then
      promoted="$(jq -R -r '(fromjson? // empty) | .hash // empty' "$PROMOTED" 2>/dev/null \
        | sort -u | grep -c '[^[:space:]]' 2>/dev/null | tr -d ' ')"
    fi
    case "$promoted" in ''|*[!0-9]*) promoted=0 ;; esac
    echo "candidates:      $total"
    echo "weeks covered:   $weeks  ($first .. $last)"
    echo "duplicates skipped: $dupes"
    echo "declined:        $declined"
    echo "promoted:        $promoted"
    echo "by source:"
    while IFS= read -r f; do
      [ -n "$f" ] && jq -r '.source' "$f" 2>/dev/null
    done <<SOURCES_EOF | sort | uniq -c | sed 's/^/  /'
$fs
SOURCES_EOF
    echo "current week:    $(week_of "$now")"
    echo "queue directory: $DIR"
    ;;

  reviews)
    # The read surface for hooks/session-review.sh. That script dispatches a separate,
    # single-purpose session AFTER a session has ended, so whatever it finds lands in a
    # session nobody is in. This is where a person or a later session reads it.
    #
    # It reports the NONE verdicts too, and it says so plainly. "Nothing here clears the
    # bar" is the expected answer, and a listing that showed only the hits would make a
    # trigger that mostly finds nothing look like a trigger that mostly does not run.
    wants_help "$@" && { usage; exit 0; }
    show=""
    all=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --show) shift; show="${1:-}" ;;
        --show=*) show="${1#--show=}" ;;
        --all) all=1 ;;
        *) die "unexpected argument '$1'" ;;
      esac
      shift
    done
    idx="$REVIEWS/index.jsonl"
    if [ ! -f "$idx" ]; then
      echo "skillinsight: no automatic session reviews yet."
      echo "              hooks/session-review.sh writes them when a long session ends;"
      echo "              it is throttled to one dispatch per 21h. Expected: $REVIEWS"
      exit 0
    fi
    # -R with `fromjson?` rather than a stream read: a half-written final line -- the
    # dispatcher appends from another process -- makes plain jq abort and lose every
    # record before it.
    if [ -n "$show" ]; then
      case "$show" in ''|*[!0-9]*) die "--show takes a whole number" ;; esac
      [ "$show" -lt 1 ] && die "--show counts from 1 (1 = newest)"
      # Numbered the same way the listing numbers them, and it has to be the same
      # expression: two orderings means `--show 2` prints something other than the row
      # printed as 2.
      rpt="$(reviews_newest_first "$idx" | jq -r '.report // empty' 2>/dev/null \
             | sed -n "${show}p")"
      [ -z "$rpt" ] && die "no review number $show"
      [ -f "$rpt" ] || die "the report file is gone: $rpt"
      cat "$rpt"
      exit 0
    fi
    lim=20
    [ "$all" -eq 1 ] && lim=100000
    total="$(reviews_newest_first "$idx" | grep -c '[^[:space:]]' | tr -d ' ')"
    case "$total" in ''|*[!0-9]*) total=0 ;; esac
    echo "automatic session reviews: $total"
    echo
    reviews_newest_first "$idx" \
      | jq -r '[(.ts // "?"), (.verdict // "?"), (.name // ""), (.stage // ""),
                (.cost_usd // ""), (.project // "")] | @tsv' 2>/dev/null \
      | head -n "$lim" \
      | awk -F'\t' '{n=NR; printf "  %2d  %s  %-9s %-34s %-8s $%s\n", n, $1, $2, ($3==""?"-":$3), ($4==""?"-":$4), ($5==""?"?":$5); printf "      %s\n", $6}'
    echo
    echo "  skillinsight reviews --show 1    print the newest report in full"
    echo "  reports:                         $REVIEWS"
    echo
    echo "NONE is the expected verdict. A CANDIDATE is a proposal a person still decides on;"
    echo "nothing in here has been forged or installed."
    ;;

  reindex)
    # RECOVERING A REVIEW THAT WAS PAID FOR AND NEVER RECORDED.
    #
    # hooks/session-review.sh writes the model's raw answer to
    # `$REVIEWS/.stage1-<session>.json`, parses it, appends one row to index.jsonl,
    # announces it in `.unread`, and only then removes the temp file. A dispatch that
    # dies between the write and the parse leaves that file holding the whole answer and
    # leaves NOTHING anywhere else: no row, no report, no announcement -- and the
    # cooldown stamp already written, so the next qualifying session is refused too.
    #
    # That is not hypothetical. It is what happened to the first real dispatch this
    # package ever made: 2026-08-25, session f0feae4c, sonnet, 79.8s, $0.2221734,
    # `is_error: false`, a well-formed CANDIDATE returned. The script was rewritten on
    # disk while it was blocked inside that 80-second CLI call, bash -- which reads a
    # script lazily, by byte offset -- resumed in the middle of unrelated text, and the
    # verdict was lost. notes/2026-08-25-first-live-review-verdict.md.
    #
    # So a LEFTOVER .stage1-*.json IS THE SIGNAL. On every path that completes, including
    # every failing one, the dispatcher removes it; one still sitting there is a run that
    # did not reach its own cleanup.
    #
    # IDEMPOTENT BY THE INDEX, NOT BY A STAMP OF ITS OWN. "Has this been recovered?" is
    # answered by reading the file this command appends to, so a second run appends
    # nothing and needs no extra state -- and there is no separate stamp that can get out
    # of step with the index and either re-append a row or hide one forever.
    #
    # AND NOTHING IS DELETED. The stage-1 file stays exactly where it is and the row
    # names it in `source_file`, because it is the evidence FOR the row: it is what a
    # later reader checks the row against, and it is the only copy of what was paid for.
    wants_help "$@" && { usage; exit 0; }
    [ "$#" -gt 0 ] && die "reindex takes no arguments"
    if [ ! -d "$REVIEWS" ]; then
      echo "skillinsight: no reviews directory yet ($REVIEWS); nothing to reindex"
      exit 0
    fi
    idx="$REVIEWS/index.jsonl"
    # Every session that already has a row. `-R` with `fromjson?` for the same reason
    # `reviews` uses it and a stronger one: the dispatcher appends to this file from
    # another process, so its last line can be half-written, and a plain stream read
    # would abort on it and lose every row BEFORE it -- which here does not mean an
    # empty listing, it means re-appending rows that are already there.
    ri_seen=""
    [ -f "$idx" ] && ri_seen="$(jq -R -r '(fromjson? // empty) | select(type=="object")
                                          | .session // empty' "$idx" 2>/dev/null)"
    ri_found=0; ri_added=0; ri_known=0; ri_empty=0
    ri_now_ts="$(date -u -r "$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
                 || date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
    # An explicit leading dot in the pattern matches a dotfile; the `[ -f ]` is what
    # handles the no-match case, where the glob comes back as the literal pattern.
    for sf in "$REVIEWS"/.stage1-*.json; do
      [ -f "$sf" ] || continue
      ri_found=$(( ri_found + 1 ))
      ri_base="$(basename "$sf")"
      # THE SESSION ID COMES FROM THE FILENAME, AND IT HAS TO. The stage-1 JSON carries
      # a `session_id`, and it is the id of the session the MODEL ran in -- a fresh
      # `claude -p` -- not the id of the session under review. Reading it from there
      # would file every recovered verdict under a session nobody has ever seen. What
      # the filename holds is the dispatcher's sanitised id, which for a UUID is the id.
      ri_sid="${ri_base#.stage1-}"; ri_sid="${ri_sid%.json}"
      [ -n "$ri_sid" ] || continue
      if printf '%s\n' "$ri_seen" | grep -Fxq "$ri_sid"; then
        ri_known=$(( ri_known + 1 ))
        continue
      fi
      # The same extraction finalize_stage1 does: `--output-format json` returns either
      # the result object or a stream array containing it, depending on what else is
      # loaded, so accept both rather than guessing which.
      ri_res="$(jq -s -r 'map(if type == "array" then .[] else . end)
                          | map(select(type == "object" and .type == "result"))
                          | (last // {}) | .result // empty' "$sf" 2>/dev/null)"
      if [ -z "$ri_res" ]; then
        # No answer in it means nothing was paid for that can be recovered, so there is
        # nothing to say about it beyond that it is there. NOT indexed as an ERROR row:
        # a permanent row asserting a failure this command cannot actually observe would
        # also be the thing that stops a real recovery later, since the row is the
        # idempotence key.
        ri_empty=$(( ri_empty + 1 ))
        echo "skillinsight: $ri_base holds no model answer; left alone, not indexed"
        continue
      fi
      ri_v=""; ri_n=""
      ri_parsed="$(verdict_of "$ri_res")"
      ri_v="$(printf '%s' "$ri_parsed" | cut -f1)"
      ri_n="$(printf '%s' "$ri_parsed" | cut -f2)"
      # The answer is non-empty by the guard above, so an unmatched verdict is UNPARSED
      # and never ERROR -- the same split hooks/session-review.sh makes, and it matters:
      # reporting a paid-for call whose answer took the wrong shape as a crash sends
      # whoever reads it looking for a bug in the wrong place.
      [ -z "$ri_v" ] && ri_v="UNPARSED"
      ri_cost="$(jq -s -r 'map(if type == "array" then .[] else . end)
                           | map(select(type == "object" and .type == "result"))
                           | (last // {}) | .total_cost_usd // empty' "$sf" 2>/dev/null | head -1)"
      # THE TIMESTAMP IS THE FILE'S, NOT THE CLOCK'S. A verdict recovered a week later is
      # still a verdict from the day it was returned, and filing it under today would put
      # it at the top of `reviews` above reviews that came after it. mtime is what the
      # run left behind; `reindexed_at` below is the only thing that carries today.
      # GNU FORM FIRST, VALIDATE, THEN BSD -- never a plain `A || B` chain. On GNU
      # coreutils `-f` is --file-system, not a format string, so `stat -f %m FILE` there
      # reports on the filesystem, still writes to stdout, and `$( )` captures that. An
      # `||` chain therefore never reaches the GNU form at all: the numeric guard rejects
      # the captured text and every recovered verdict falls back to NOW -- filed under
      # today, above reviews that came after it, which is exactly what the paragraph
      # above says must not happen. BSD stat has no -c, so it fails cleanly and macOS
      # reaches the second form. Same ordering, and the same reason, as the base-cache
      # mtime in statusline/statusline.sh.
      ri_mt="$(stat -c %Y "$sf" 2>/dev/null)"
      case "$ri_mt" in ''|*[!0-9]*) ri_mt="$(stat -f %m "$sf" 2>/dev/null)" ;; esac
      case "$ri_mt" in ''|*[!0-9]*) ri_mt="$now" ;; esac
      ri_ts="$(date -u -r "$ri_mt" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
               || date -u -d "@$ri_mt" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
      ri_wk="$(week_of "$ri_mt")"
      [ -z "$ri_ts" ] && ri_ts="$ri_now_ts"
      [ -z "$ri_wk" ] && ri_wk="$(week_of "$now")"
      # The project, from the reviewed session's own transcript. BOUNDED: the largest
      # transcript measured on this machine was 663 MB and `cwd` is on the first records,
      # so read the head and stop. Absent transcript, absent project -- an empty string,
      # never a guess. The directory name it sits in is the path with the slashes
      # replaced, and turning that back into a path is not reversible.
      ri_proj=""
      for ri_tf in "$TRANSCRIPTS"/*/"$ri_sid".jsonl; do
        [ -f "$ri_tf" ] || continue
        ri_proj="$(head -c 262144 "$ri_tf" 2>/dev/null \
                   | jq -R -r '(fromjson? // empty) | select(type == "object")
                               | .cwd // empty' 2>/dev/null | head -1)"
        [ -n "$ri_proj" ] && break
      done
      # The report. Written only if there is none: a report already on disk is either a
      # real one or a hand-recovery, and either way it is not this command's to overwrite.
      ri_rep="$REVIEWS/$ri_wk/$ri_sid.md"
      if [ ! -f "$ri_rep" ]; then
        mkdir -p "$REVIEWS/$ri_wk" 2>/dev/null
        # `printf -- ` on every line beginning "- ". A FORMAT STRING STARTING WITH "- "
        # IS AN INVALID OPTION TO BASH'S BUILTIN PRINTF and prints nothing, while zsh
        # accepts it, so without the `--` the metadata block silently vanishes under the
        # shell in the shebang and nothing anywhere reports it.
        {
          printf '# Session review (recovered) — %s\n\n' "$ri_ts"
          printf -- '- session: `%s`\n' "$ri_sid"
          printf -- '- project: `%s`\n' "$ri_proj"
          printf -- '- verdict: **%s%s**\n' "$ri_v" "${ri_n:+ $ri_n}"
          printf -- '- cost: $%s\n' "${ri_cost:-unknown}"
          printf -- '- recovered from: `%s`\n' "$ri_base"
          printf -- '- recovered by `skillinsight reindex` at: %s\n\n' "$ri_now_ts"
          printf 'This dispatch ran and was paid for, and its answer was never recorded:\n'
          printf 'the run died between writing the answer out and indexing it. Nothing\n'
          printf 'below has been edited or refined. It is the answer as it was returned.\n\n'
          printf -- '---\n\n'
          printf '%s\n' "$ri_res"
        } > "$ri_rep" 2>/dev/null
      fi
      [ -f "$ri_rep" ] || ri_rep="(the report could not be written to $ri_rep)"
      # `reindexed_at` and `source_file` are the two fields a live row does not have, and
      # they are the whole difference: this row was not written by the dispatch that
      # earned it, and anyone reading it later has to be able to tell, and to go check.
      ri_row="$(jq -c -n --arg ts "$ri_ts" --arg week "$ri_wk" --arg session "$ri_sid" \
        --arg project "$ri_proj" --arg verdict "$ri_v" --arg name "$ri_n" \
        --arg report "$ri_rep" --arg cost "$ri_cost" --arg model "" \
        --arg stage "analysis" --arg rat "$ri_now_ts" --arg src "$ri_base" \
        '{ts:$ts, week:$week, session:$session, project:$project, verdict:$verdict,
          name:$name, report:$report, cost_usd:$cost, model:$model, stage:$stage,
          reindexed_at:$rat, source_file:$src}' 2>/dev/null)"
      # `model` is deliberately empty. The stage-1 file records `modelUsage` keyed by
      # every model the call touched -- on the real lost dispatch that is two, sonnet and
      # a haiku -- and none of them is a record of which model the dispatcher ASKED for.
      # An empty field says "not recorded". A guess would say something false forever.
      if [ -z "$ri_row" ]; then
        echo "skillinsight: could not build an index row for $ri_base; left alone" >&2
        continue
      fi
      printf '%s\n' "$ri_row" >> "$idx" || die "cannot append to $idx"
      # The announcement, for a CANDIDATE. `.unread` is what hooks/compound-improvement.sh
      # surfaces on the first prompt of the next session, and it is the whole reason to
      # recover a verdict rather than just file it: a CANDIDATE nobody is told about is
      # in the same state it was in when it was lost. A recovered NONE is not announced
      # -- "nothing here cleared the bar" is news on the day and noise a fortnight later,
      # and it is in the index either way.
      if [ "$ri_v" = "CANDIDATE" ]; then
        ( printf '%s\t%s\t%s\n' "$ri_ts" "$ri_v${ri_n:+ $ri_n}" "$ri_rep" \
            >> "$REVIEWS/.unread" ) 2>/dev/null
      fi
      ri_added=$(( ri_added + 1 ))
      echo "skillinsight: recovered $ri_sid"
      echo "               $ri_v${ri_n:+ $ri_n}  $ri_ts  \$${ri_cost:-unknown}  from $ri_base"
      echo "               row    -> $idx"
      echo "               report -> $ri_rep"
      [ "$ri_v" = "CANDIDATE" ] && echo "               announced in $REVIEWS/.unread"
    done
    echo "skillinsight: $ri_found stage-1 file(s) examined; $ri_added indexed, $ri_known already indexed, $ri_empty with no answer"
    # Recovering nothing is a success and must exit 0. A bare `[ ... ] && echo` as the
    # last command of a subcommand makes the whole run exit 1 when the test is false,
    # which is how `prune` once reported "archived 0" as a failure.
    if [ "$ri_added" -eq 0 ]; then
      echo "               nothing to recover; the index already accounts for every answer on disk"
    fi
    ;;

  prune)
    weeks=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --older-than) shift; weeks="${1:-}" ;;
        --older-than=*) weeks="${1#--older-than=}" ;;
        -h|--help) usage; exit 0 ;;
        *) die "unexpected argument '$1'" ;;
      esac
      shift
    done
    [ -z "$weeks" ] && die "usage: skillinsight prune --older-than <weeks>"
    case "$weeks" in ''|*[!0-9]*) die "--older-than takes a whole number of weeks" ;; esac
    cutoff="$(week_of "$(( now - weeks * 604800 ))")"
    [ -z "$cutoff" ] && die "could not compute the cutoff week"
    # Week names are %G-W%V and zero padded, so a string comparison is a date
    # comparison, across year boundaries included.
    archive="$DIR/archive"
    moved=0
    fs="$(all_files)"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      w="$(basename "$f" .jsonl)"
      if [ "$w" \< "$cutoff" ]; then
        mkdir -p "$archive" 2>/dev/null || die "cannot create $archive"
        mv "$f" "$archive/" || die "cannot archive $f"
        moved=$(( moved + 1 ))
      fi
    done <<PRUNE_EOF
$fs
PRUNE_EOF
    # Moved, not deleted. Nothing in this project is ever destructively removed;
    # delete the archive by hand once you are sure.
    echo "skillinsight: archived $moved week file(s) older than $cutoff"
    # `[ ... ] && echo` as the last command makes the whole subcommand exit 1 when
    # nothing was archived, which reads as failure. Archiving nothing is a success.
    if [ "$moved" -gt 0 ]; then
      echo "               -> $archive"
    fi
    ;;

  *) usage >&2; die "unknown command '$cmd'" ;;
esac
exit

# Closes the brace group opened just under `set -uo pipefail`. See the note there.
}
