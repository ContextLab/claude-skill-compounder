#!/usr/bin/env bash
# skillreport: did any of this actually pay off?
#
#   skillreport [--help]
#   skillreport skills
#   skillreport applied [--json]
#
# `skillreport skills` is the five-question view: for every skill the ledger knows about,
# what triggered its build, what was built and when, WHETHER IT WAS EVER PUT ON THE
# PROBLEM THAT CAUSED IT, how often it has been used since, and whether anyone judged
# that it worked. It is a SEPARATE view rather than more
# columns on the table below, and deliberately so: the table is forge-centric, one row per
# forge, and its denominator is the number that the reuse headline rests on. The five
# questions are skill-centric -- most skills in the pool were never forged at all, so
# folding them in would silently change what that headline is a fraction of.
#
# THE FIFTH QUESTION IS NOT THE FOURTH ONE AGAIN, and `skillreport applied` is the view
# built for it. A `use` row is ANY invocation, ever, by anyone, for any reason. An `apply`
# row is the ONE that closes the forge loop: a skill here is built AS NEEDED, out of a
# problem that was in front of somebody, so a forge that ends at "installed" has produced
# a tool and left the problem exactly where it was. An `apply` row carries an outcome
# (`used`, `declined` or `failed`) and the verbatim evidence behind it, and only
# `skillforge apply` writes one. A forge that closed `done` and has no `apply` row is the
# visible form of a loop that never closed, and the headline below counts them by name.
#
# APPLY IS SELECTED BY NAME, LIKE EVERY OTHER EVENT THIS FILE READS, and no existing
# count moved to make room for it. The reuse fraction, the forge table, the coverage
# block and the reminder conversion all answer against a ledger holding `apply` rows
# exactly as they answered before those rows existed; tests/test_skillreport_apply.py
# pins that by asserting the same headline against the same ledger with and without them.
#
# Joins the forge ledger written by 'skillforge' against skill invocations recovered
# from Claude Code transcripts, and prints one table plus the number that matters: the
# fraction of forged skills that were invoked at least once AFTER the session that
# forged them. Reuse before or during the forge is not reuse, and an invocation made by
# this package's own probes and tests is not reuse either: those run Claude
# non-interactively, they call these very skills, and they are counted and reported on
# their own line rather than folded into the headline.
#
# PRIVACY. This script reads 7 files, all already on your disk, and writes nothing
# except its own output to the terminal. THAT NUMBER IS NOT MAINTAINED BY HAND ANY MORE.
# It said "three" while the list below held five, because the repeat store and the
# override store were appended to the list and the sentence was left alone -- an
# understated claim about what a privacy-relevant tool opens, printed by `--help` to the
# user directly above the five entries contradicting it. tests/test_skillreport_apply.py
# now DERIVES the count from the list and fails when the two disagree, so the sentence
# cannot go stale again. These are the files:
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/ledger.jsonl
#       one JSON line per forge: skill name, your one-line summary, the originating
#       repository path, epoch timestamps, step counts, outcome and reason.
#   ${SKILL_COMPOUNDER_TRANSCRIPTS:-$HOME/.claude/projects}/*/*.jsonl
#       your Claude Code transcripts. Only six fields are read out of them: the
#       invoked skill name, the record timestamp, the working directory, the session
#       entrypoint (which says whether a person or a script was driving), and the
#       tool-use id and error flag that say whether the invocation ran. Prompts,
#       responses, file contents and tool output are never parsed or printed.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/reminders/*.edits
#       per-session edit counters written by the reminder hook: a unary tally, one 'x'
#       byte per edit, appended with >> so parallel writers cannot lose a count.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/remind/hits.jsonl
#       one row per reminder hooks/remind.sh stated back: which reminder, when, which
#       session, which event, and the lineage id it descends from. No reminder TEXT is
#       read out of it and none is printed; only the ids and the session are counted.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/reminders/nudges.jsonl
#       one row per nudge hooks/compound-improvement.sh delivered: a fixed nudge name or
#       a queue candidate's lineage id, when, and the two session ids. It holds no prompt
#       text, no file path and no command, and nothing in it is printed except the counts.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/repeats/index.jsonl
#       the repeat gate's append-only failure/recovery store. THAT FILE HOLDS THE TEXT OF
#       THE COMMAND THAT FAILED AND THE ERROR IT PRINTED, so it is worth saying what is
#       done with them here: nothing. Only the row type, the failure signature, its
#       session id and the timestamp are read out; the command and the error text are
#       counted and never printed.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/doc-gate/overrides.jsonl
#       one row per time the documentation gate's escape hatch was taken. THAT FILE HOLDS
#       A REASON SOMEBODY TYPED, and this one IS printed: the count and the override kinds
#       are reported, and the most recent reason is quoted back, clipped to 60 characters.
#       An escape nobody counts is indistinguishable from a gate nobody has, which is why
#       the reason is on the report rather than only on disk.
# `skillreport skills` reads the ledger and nothing else. The ledger also holds the
# ledger-v2 rows: `origin` (one per skill, carrying the verbatim text passed to
# `skillforge start --trigger`), `use` (one per invocation: skill name, session id,
# working directory, success flag, and whether a script or a person drove the session)
# `verdict` (a judgement plus the quote behind it) and `apply` (an outcome plus the
# verbatim evidence that the forged skill was put on the problem that caused it).
# There are no network calls anywhere in this script. Nothing leaves the machine.
# Nothing is uploaded, and no summary is sent anywhere.
set -uo pipefail
# ------------------------------------------------------------------------------------
# THE ENTIRE BODY OF THIS SCRIPT IS ONE BRACE GROUP, AND THE `}` AT THE END OF THE FILE
# IS WHAT CLOSES IT. It is not style and it is not decoration.
#
# bash reads a script LAZILY, by byte offset, and resumes at that offset in whatever the
# file holds AT THAT MOMENT. Every file in this package is executed by absolute path out
# of the checkout -- the installer writes those paths into settings.json and symlinks the
# CLIs into ~/bin -- so one `git pull`, `git checkout` or `sed -i` rewrites the bytes of
# a run that is already in flight. Measured on GNU bash 5.3.3(1): prepending forty lines
# to a live 25-line script produced `line 4: non-transferable: command not found` and
# then a second execution of the body; truncating it produced `unexpected EOF` and
# exit 2. It cost a real, paid-for `claude -p` dispatch on 2026-08-25.
#
# A brace group is a single compound command, so bash must find the matching `}` before
# it may run any part of it: the file goes through the parser in ONE pass and nothing
# written to disk afterwards can be executed. A file truncated badly enough to break the
# parse then runs NOTHING, which is also the answer we want here -- half a run is worse
# than no run.
#
# THE `exit` BEFORE THE CLOSING `}` IS LOAD-BEARING TOO. A brace group protects its body
# and nothing past it: measured, a wrapped script that fell off its end had bash resume
# at the offset just past `}`, find prepended text sitting there, and run the whole body
# a SECOND time. So the group is not sufficient on its own. It is a BARE `exit` and not
# `exit 0` because a bare `exit` reuses `$?`, so whatever the last command
# reported is what the caller sees -- exactly as it did before this wrapper existed.
#
# Consequences when editing:
#   - the closing `}` must stay the last line, and `bash -n` is what proves it.
#   - the last statement inside the group must be an `exit`. tests/test_script_wrapping.py
#     checks that across every shipped script and reproduces the hazard against a live
#     process.
#   - `exit` still exits the script, traps are still global, and functions and variables
#     defined inside are still global. Nothing about the semantics changes.
#
# The incident this came out of, and the reproduction, are in docs/DESIGN.md under
# "Never edit a script that may still be running".
# ------------------------------------------------------------------------------------
{


# HOME can be unset (cron, a stripped env, a container). Under `set -u` reading it then
# aborts the script non-zero before it has printed anything.
: "${HOME:=/tmp}"
STATE_ROOT="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}"
LEDGER="$STATE_ROOT/ledger.jsonl"
REMINDERS="$STATE_ROOT/reminders"
# The two gate surfaces. Both are append-only stores written by hooks, and both are read
# here for counts alone -- see the GATES section near the bottom of this file.
# The two delivery logs the FUNNEL joins against. `hits.jsonl` is one row per reminder
# hooks/remind.sh stated back; `nudges.jsonl` is one row per nudge
# hooks/compound-improvement.sh delivered. Both are append-only, both are capped by their
# own writer, and both carry the lineage id that makes the funnel a join.
HITSLOG="$STATE_ROOT/remind/hits.jsonl"
NUDGELOG="$STATE_ROOT/reminders/nudges.jsonl"
REPEATS="$STATE_ROOT/repeats/index.jsonl"
DOC_OVERRIDES="$STATE_ROOT/doc-gate/overrides.jsonl"
TRANSCRIPTS="${SKILL_COMPOUNDER_TRANSCRIPTS:-$HOME/.claude/projects}"
EDIT_EVERY="${CI_EDIT_EVERY:-12}"
# It reaches integer arithmetic twice. Unguarded, `CI_EDIT_EVERY=abc` aborted the whole
# script mid-report under `set -u` ("abc: unbound variable") and `=0` divided by zero;
# either way the reminder section reported the wrong reason or never printed at all.
case "$EDIT_EVERY" in ''|*[!0-9]*|???????*) EDIT_EVERY=12 ;; esac
[ "$EDIT_EVERY" -lt 1 ] && EDIT_EVERY=12
# The repeat gate's own refusal threshold, read here only to say which of the signatures
# it knows about would refuse. Guarded the same way EDIT_EVERY is, and for the same
# reason: it reaches an integer comparison, and a typo'd export must not abort the report.
MIN_SESSIONS="${REPEAT_MIN_SESSIONS:-2}"
case "$MIN_SESSIONS" in ''|*[!0-9]*|???????*) MIN_SESSIONS=2 ;; esac
[ "$MIN_SESSIONS" -lt 1 ] && MIN_SESSIONS=1

VIEW="table"
JSON=0
case "${1:-}" in
  -h|--help|help)
    # Printed by walking the comment block rather than by `sed -n '2,42p'`. The line
    # numbers were a maintenance trap in the most literal way: the block grew by twenty
    # lines when the fifth question landed and the fixed range would have silently
    # truncated the help halfway through a sentence, with nothing failing anywhere.
    # This stops at the first line that is not a comment, which is `set -uo pipefail`.
    awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
    exit 0
    ;;
  skills) VIEW="skills" ;;
  applied)
    VIEW="applied"
    [ $# -gt 0 ] && shift
    case "${1:-}" in
      --json) JSON=1 ;;
      "") : ;;
      *) echo "skillreport: unknown option '$1' for 'applied' (try: skillreport --help)" >&2; exit 2 ;;
    esac
    ;;
  "") : ;;
  *) echo "skillreport: unknown option '$1' (try: skillreport --help)" >&2; exit 2 ;;
esac

command -v jq >/dev/null 2>&1 || { echo "skillreport: jq is required" >&2; exit 1; }

# THE REPEAT GATE'S HEAD EXEMPTIONS ARE ASKED OF THE GATE, NOT REIMPLEMENTED HERE. The
# line below the repeat-gate counts used to say a signature at the session threshold
# "would be refused", from the session count and the self-recovery rule alone. The gate
# also exempts, before it counts anything, a Bash command whose HEAD is on either of its
# two lists, any command reaching for `skillrepeat`, and every non-Bash call. On the live
# store of 2026-09-02 that was the entire difference: this report said ten would be
# refused and the real hook, driven against all ten, denied none (issue #27).
#
# `hooks/repeat-gate.sh --eligible-of` is that script's read-only door for the question,
# the same shape as `--norm-of`. A copy of the two lists kept here would drift from the
# gate's invisibly, and the symptom is the sentence above: a number nobody can act on.
# Resolved from this script's own path with symlinks followed -- both install paths put a
# LINK in the user's bin directory, and `dirname "$0"` on the link names that directory
# rather than the checkout. Reading no file of yours: it is a script this package ships,
# run with a command on stdin, and it opens no store. The five files above stay five.
GATE="${SKILLREPORT_GATE:-}"
if [ -z "$GATE" ]; then
  gate_self="$0"; gate_hops=0
  while [ -L "$gate_self" ] && [ "$gate_hops" -lt 32 ]; do
    gate_link="$(readlink "$gate_self" 2>/dev/null)" || break
    case "$gate_link" in
      /*) gate_self="$gate_link" ;;
      *)  gate_self="$(dirname "$gate_self")/$gate_link" ;;
    esac
    gate_hops=$(( gate_hops + 1 ))
  done
  GATE="$(cd "$(dirname "$gate_self")/.." 2>/dev/null && pwd)/hooks/repeat-gate.sh"
fi
GATE_OK=0
[ -n "$GATE" ] && [ -x "$GATE" ] && GATE_OK=1
# US (0x1f) and not a tab between the fields read below: tab is IFS whitespace, so `read`
# collapses runs of it and one empty field shifts every field after it left by one.
US="$(printf '\037')"

# --------------------------------------------------------- the fifth question: apply
#
# WAS THE NEW SKILL EVER USED ON THE PROBLEM THAT CAUSED IT? One row per `done`, joined
# to the `apply` row that discharged it.
#
# `apply` IS SELECTED BY NAME AND SO IS `done`. Nothing here is classified by exclusion,
# and no selector anywhere in this file was widened to accommodate a new event: the forge
# join still names `start`, `done` and `fail`, and it cannot see an `apply` row at all.
# That is the whole reason `apply` is a new event name rather than a field on `done` --
# a reader written before it existed counts a ledger holding these rows exactly as it did
# before.
#
# THE JOIN MATCHES ON EITHER NAME. `skillforge done` records the FORGE's name; the apply
# marker it writes records the INSTALLED SKILL's name, which is the directory that was
# actually linked and is not always the same string. `skillforge apply` therefore writes
# both -- `name` for the skill and `forge` for the forge -- and a `done` is discharged by
# an apply row that matches either. Matching on `name` alone silently reported every forge
# whose installed directory was named differently from its forge as never applied.
#
# ONE APPLY PER DONE, greedily and in ledger order, for the reason the forge join gives
# one outcome per start: a skill forged twice and applied once must not read as applied
# twice. An apply row that no `done` claims is not discarded -- `skillforge apply --force`
# writes one for a skill this machine never forged, and that is a real record of a real
# act. It is reported separately, under its own heading, and it is not in the denominator.
#
# AN UNNAMED `done` IS NEVER DISCHARGED. Two rows that both lack a name are not thereby
# the same forge, so the sentinels below deliberately never compare equal. The cost is
# reporting such a forge as never applied, which is the honest direction: nothing on disk
# says it was.
apply_join() {          # -> one compact JSON object on stdout; empty output on failure
  [ -s "$LEDGER" ] || return 1
  jq -s -R -c '
    def parse: [ split("\n")[] | select(length > 0) | (fromjson? // empty)
                 | select(type == "object") ];
    parse as $rec
    | [ range(0; ($rec | length)) | select($rec[.].event == "done")  ] as $dones
    | [ range(0; ($rec | length)) | select($rec[.].event == "apply") ] as $applies
    | (reduce $dones[] as $i ({used: [], pairs: []};
         . as $acc
         | ([ $applies[]
              | select(. > $i
                       and ((($rec[.].name  // " no-name")  == ($rec[$i].name // "no-name"))
                            or (($rec[.].forge // " no-forge") == ($rec[$i].name // "no-forge")))) ]
            - $acc.used | .[0]) as $a
         | { used:  (if $a == null then $acc.used else ($acc.used + [$a]) end),
             pairs: ($acc.pairs + [[$i, $a]]) })) as $join
    | ($applies - $join.used) as $loose
    | { forges: [ $join.pairs[]
          | .[0] as $i | .[1] as $ai
          | $rec[$i] as $d
          | (if $ai == null then null else $rec[$ai] end) as $a
          | { name:      ($d.name // "(unnamed)"),
              closed:    ($d.ts // 0),
              applied:   ($a != null),
              outcome:   ($a.outcome // null),
              evidence:  ($a.evidence // null),
              apply_name:($a.name // null),
              apply_ts:  ($a.ts // null),
              marker:    ($a.marker // null),
              elapsed:   (if $a == null then null
                          elif ($a.elapsed // null) != null then $a.elapsed
                          else (($a.ts // 0) - ($d.ts // 0)) end) } ],
        loose: [ $loose[] | $rec[.]
          | { name:     (.name // "(unnamed)"),
              outcome:  (.outcome // null),
              evidence: (.evidence // null),
              forge:    (.forge // null),
              marker:   (.marker // null),
              ts:       (.ts // 0) } ] }
    | . + { closed:   (.forges | length),
            never:    ([ .forges[] | select(.applied | not) ] | length),
            used:     ([ .forges[] | select(.outcome == "used")     ] | length),
            declined: ([ .forges[] | select(.outcome == "declined") ] | length),
            failed:   ([ .forges[] | select(.outcome == "failed")   ] | length) }
  ' "$LEDGER" 2>/dev/null
}
# The row carries its own `elapsed` when a pending-apply marker was there to measure
# against. When that field is absent -- an apply recorded with --force, or a marker that
# had aged out -- the difference between the two timestamps is the same interval,
# computed rather than recorded, so the join derives it instead of printing a hole.

# ------------------------------------------------------------------------ the gates
#
# AN ESCAPE NOBODY COUNTS IS INDISTINGUISHABLE FROM A GATE NOBODY HAS. hooks/doc-gate.sh
# refuses a push whose commits changed code and no documentation, and it ships an escape
# hatch deliberately: a refusal with no way past it is a hook breaking somebody's work
# rather than steering it. But an escape taken in silence leaves the same trace on disk as
# a gate that was never installed -- the push went through, and nothing anywhere says a
# rule was bent. That is why every override writes a row carrying the WRITTEN REASON, and
# why this section exists to count them. The number is not a scold. It is the only thing
# that separates a gate that is working (few overrides, each with a reason someone had to
# type) from one that is being routed around on every push, and without it neither state
# is observable.
#
# NEITHER STORE'S ABSENCE IS A ZERO, and this section never prints one as if it were. A
# missing file means the gate has recorded nothing on this machine, which is a different
# claim from "nothing has been refused" -- the same distinction the ledger horizon makes
# a few hundred lines up.
#
# ROW TYPES ARE SELECTED BY NAME HERE TOO. `fail`, `recover` and `forget` for the repeat
# store; `override` for the doc gate. A row carrying a type neither script knows is
# skipped, not counted as the other thing.
#
# THE REFUSAL COUNT IS THE GATE'S OWN QUERY, NOT A RESTATEMENT OF ITS THRESHOLD. This is a
# report about another component's behaviour, so a sentence here that the component would
# not honour is simply false. Read out of hooks/repeat-gate.sh (arm 3, "THE QUERY") at the
# time this was written, its refusal is
#
#   map(select(.n >= $min and .selfn == 0)) | sort_by(-.n) | (.[0] // empty)
#
# over signatures built with: a `forget` tombstone suppressing only rows stamped BEFORE it;
# `.n` the distinct sessions among the surviving `fail` rows; and `.selfn` the distinct
# sessions among the surviving `recover` rows whose `norm` equals the LAST surviving fail
# row's `norm` -- a SELF-RECOVERY, an earlier session running the identical call and
# getting it to work. The gate treats that as an observation that the call is not broken
# and never refuses the signature at all, however many sessions it failed in. Counting
# `.n >= $min` alone reported those as refusals that would happen; they do not.
#
# ONE CLAUSE OF THAT QUERY CANNOT BE APPLIED HERE, and it is named rather than ignored:
# the gate also drops fail rows from the session it is running in (`.session != $sid`),
# which a report belongs to no session and cannot evaluate. Its only effect is on a
# signature whose sessions include the one asking, so the count below can be one session
# high for a signature that is failing right now, and never wrong about a stale store.
print_gates() {
  echo
  echo "GATES — the repeat gate's store and the documentation gate's escape hatch"
  if [ -s "$REPEATS" ]; then
    # ONE PASS OVER THE STORE, PRODUCING FACTS RATHER THAN PROSE, because the deny count
    # can no longer be computed inside jq: the head exemptions live in the gate and are
    # asked of it below, per candidate. The prose is rendered from the facts afterwards.
    rg="$(jq -s -R -c --argjson min "$MIN_SESSIONS" '
      def parse: [ split("\n")[] | select(length > 0) | (fromjson? // empty)
                   | select(type == "object") ];
      parse as $rows
      | [ $rows[] | select(.t == "forget")  ] as $tomb
      | [ $rows[] | select(.t == "fail")    ] as $f
      | [ $rows[] | select(.t == "recover") ] as $rec
      # A tombstone suppresses rows recorded BEFORE it and only those, exactly as the
      # gate reads them: a signature forgotten and then failing again is live again, so
      # counting every fail row would report signatures the gate itself no longer sees.
      | [ ($f | map(.sig) | unique)[] as $sig
          | (([ $tomb[] | select(.sig == $sig) | (.ts // 0) ] | max) // -1) as $cut
          | [ $f[] | select(.sig == $sig and ((.ts // 0) > $cut)) ] as $live
          | select(($live | length) > 0)
          # The gate compares against the norm the FAIL rows recorded, not the norm of
          # whatever call is being judged, and takes the LAST surviving one. Copied
          # exactly: a paraphrase here is how the two drift.
          | (($live[-1].norm // "")) as $fn
          | [ $rec[] | select(.sig == $sig and ((.ts // 0) > $cut)
                              and ((.norm // "") == $fn)) ] as $self
          | { sig: $sig,
              tool: (($live[-1].tool // "Bash")),
              # The LITERAL command, which is what the gate judges a head on. `norm` is
              # the masked shape and is only the fallback for a row that carries no `cmd`.
              # A newline becomes `;` and not a space: the gate splits a command into
              # segments on `;`, so a space would fuse two commands into one head and
              # this door would disagree with the hook. `bin/skillrepeat` does the same.
              raw:  ((($live[-1].cmd // $live[-1].norm) // "")
                     | gsub("\\n"; ";") | gsub("[\\t\\r]"; " ")),
              n:     ($live | map(.session) | unique | length),
              selfn: ($self | map(.session) | unique | length) } ] as $sigs
      | { known: ($sigs | length), fails: ($f | length), recs: ($rec | length),
          tombs: ($tomb | length),
          transient: ([ $sigs[] | select(.n >= $min and .selfn > 0) ] | length),
          candidates: [ $sigs[] | select(.n >= $min and .selfn == 0)
                        | {sig: .sig, tool: .tool, raw: .raw} ] }
    ' "$REPEATS" 2>/dev/null)"
    if [ -z "$rg" ]; then
      echo "  repeat gate:   the store could not be read ($REPEATS)."
    else
      # ONE `--eligible-of` FORK PER CANDIDATE, and candidates are the signatures that
      # already clear the session rule -- a handful even on a store at the gate's cap,
      # because reaching the threshold takes two distinct sessions of the same failure.
      rg_deny=0
      rg_exempt=0
      rg_cands="$(printf '%s' "$rg" \
        | jq -r '.candidates[] | "\(.sig)\u001f\(.tool)\u001f\(.raw)"' 2>/dev/null)"
      if [ -n "$rg_cands" ]; then
        while IFS="$US" read -r rg_sig rg_tool rg_cmd; do
          [ -z "${rg_sig:-}" ] && continue
          rg_v="eligible"
          # `REPEAT_GATE_DEBUG_DUMP=` blanked for the child: that variable makes the
          # gate APPEND its stdin to a file, and this script promises to write nothing
          # but its own output. A user who exported it for a hook must not find this
          # report appending to it too.
          [ "$GATE_OK" = "1" ] && rg_v="$(printf '%s' "${rg_cmd:-}" \
            | REPEAT_GATE_DEBUG_DUMP="" "$GATE" --eligible-of "${rg_tool:-Bash}" 2>/dev/null)"
          case "$rg_v" in
            eligible) rg_deny=$(( rg_deny + 1 )) ;;
            *)        rg_exempt=$(( rg_exempt + 1 )) ;;
          esac
        done <<EOF
$rg_cands
EOF
      fi
      printf '%s' "$rg" | jq -r --argjson min "$MIN_SESSIONS" \
        --argjson deny "$rg_deny" --argjson exempt "$rg_exempt" \
        --argjson gate_ok "$GATE_OK" '
        "  repeat gate:   \(.known) distinct failure signature(s) known,"
          + " \(.fails) failure row(s), \(.recs) recovery row(s)",
        "                 \($deny) of them at or past the deny threshold"
          + " (>= \($min) distinct sessions) with",
        "                 no self-recovery behind them and a head the gate does not"
          + " exempt, so a new",
        "                 session repeating one would be refused."
          + (if .tombs > 0 then "  \(.tombs) signature(s) forgotten." else "" end),
        (if $exempt == 0 then empty else
          "                 \($exempt) more reached that count with nothing recovering"
          + " them, but the gate",
          "                 exempts the command they run -- its head is on one of the two"
          + " allowlists,",
          "                 or it reaches for skillrepeat, or the tool is not Bash."
         end),
        (if .transient == 0 then empty else
          "                 \(.transient) more reached that count, but an earlier"
          + " session ran the identical",
          "                 call and it worked. The gate reads those as transient and"
          + " never refuses them."
         end),
        (if $gate_ok == 1 then empty else
          "                 The gate script was not found, so the head exemptions could"
          + " not be applied:",
          "                 the count above is an upper bound."
         end)'
    fi
  else
    echo "  repeat gate:   no store yet ($REPEATS)."
    echo "                 Nothing has been recorded on this machine, which is not the"
    echo "                 same claim as nothing having failed twice."
  fi
  if [ -s "$DOC_OVERRIDES" ]; then
    jq -s -R -r '
      def parse: [ split("\n")[] | select(length > 0) | (fromjson? // empty)
                   | select(type == "object") ];
      parse as $rows
      | [ $rows[] | select(.event == "override") ] as $ov
      | "  doc gate:      \($ov | length) override(s) taken"
        + (if ($ov | length) == 0 then "." else
             " (" + ([ $ov | group_by(.kind // "unrecorded")[]
                       | "\(length) \(.[0].kind // "unrecorded")" ] | join(", ")) + ")."
           end),
        (if ($ov | length) == 0 then empty else
          ($ov | sort_by(.ts // 0) | .[-1]
            | "                 most recent reason: \"\((.reason // "") | tostring
                | gsub("[\\n\\t\\r]"; " ") | if length > 60 then .[0:60] + "..." else . end)\"")
         end)
    ' "$DOC_OVERRIDES" 2>/dev/null
  else
    echo "  doc gate:      no overrides recorded ($DOC_OVERRIDES)."
  fi
  echo "  An escape nobody counts is indistinguishable from a gate nobody has, which is"
  echo "  why the overrides are counted here rather than only permitted."
}

# --------------------------------------------------------------- one `dur`, two views
#
# ONE DEFINITION, PREPENDED TO BOTH JQ PROGRAMS. The `applied` view and the `skills` view
# both render the interval between a forge closing and the skill being applied, and each
# used to carry its own copy of this function. They drifted, exactly as two copies do:
# only one copy guarded a NEGATIVE interval, so an apply row stamped BEFORE its `done`
# row -- a stepped clock, a ledger merged from two machines, a hand-edited file -- read
# as "-" in one view and as a fabricated "-200s" in the other, off the same bytes on
# disk. Sharing the text is the only fix that cannot come apart again; both views also
# call `apply_join`, for the same reason.
#
# COARSE ON PURPOSE. The question this column answers is whether applying happened while
# the problem was still in front of somebody or a fortnight later, and a figure to the
# second implies a precision the ledger timestamps do not carry. A null interval and a
# negative one are both "-": not an interval of zero, and not a number invented to fill
# a column. Callers that want prose around the value ask whether it came back "-" rather
# than re-testing the interval themselves, which would put the rule back in two places.
JQ_DUR='
    def dur: if . == null then "-"
             elif . < 0 then "-"
             elif . < 60 then "\(.)s"
             elif . < 3600 then "\((. / 60) | floor)m"
             elif . < 86400 then "\((. / 3600) | floor)h"
             else "\((. / 86400) | floor)d" end;
'

# ------------------------------------------------------- the APPLIED headline
#
# THE HEADLINE THE APPLY ROWS EXIST TO PRODUCE. REUSE answers "was the skill ever invoked
# again"; this answers the narrower and harder question the forge protocol turns on --
# was it ever put on the PROBLEM THAT CAUSED IT. The two are counted from different
# instruments and are never added: reuse counts transcript invocations against a forge
# window, this counts `apply` rows against `done` rows, both selected by name.
#
# IT IS A FUNCTION BECAUSE THE TABLE VIEW HAS THREE EXITS, NOT ONE. It is printed whether
# or not the number is flattering, and it is printed when it is zero of zero, because a
# count that only appears once it looks good is not a measurement -- and that was written
# in this file while both early exits, the empty ledger and the ledger with no `start`
# rows, returned without printing it at all. The second of those is not a corner: a
# ledger holding an `origin` row and a `--force` apply row, which is the whole supported
# shape for a skill forged on another machine, has no `start` row in it, so the one view
# a user runs by default said "no forges recorded yet" and went silent about the apply
# rows sitting in the file. Same argument as `print_gates` directly above, which is
# surfaced on those paths for the same reason.
print_applied_headline() {
  aj_t="$(apply_join)"
  a_closed="$(printf '%s' "${aj_t:-}" | jq -r '.closed // 0' 2>/dev/null)"
  a_never="$(printf '%s' "${aj_t:-}" | jq -r '.never // 0' 2>/dev/null)"
  a_loose="$(printf '%s' "${aj_t:-}" | jq -r '.loose | length' 2>/dev/null)"
  # A missing or unreadable ledger makes every one of those the empty string, and the
  # `case` guards are what keep an empty string out of the integer comparisons below.
  case "${a_closed:-}" in ''|*[!0-9]*) a_closed=0 ;; esac
  case "${a_never:-}" in ''|*[!0-9]*) a_never=0 ;; esac
  case "${a_loose:-}" in ''|*[!0-9]*) a_loose=0 ;; esac
  echo
  echo "APPLIED: $a_closed forges closed, $a_never never applied."
  if [ "$a_never" -gt 0 ]; then
    echo "         A forge with no \`apply\` row produced a tool and left the problem where it"
    echo "         was. Run \`skillreport applied\` for the breakdown and \`skillforge pending\`"
    echo "         for the markers still open."
  elif [ "$a_closed" -eq 0 ]; then
    echo "         No forge in this ledger has closed \`done\`, so there is nothing to apply yet."
  fi
  # Counted here rather than only in `skillreport applied`, because a headline that reads
  # "0 forges closed" over a ledger holding real apply rows understates what is on disk in
  # the one direction this report must never understate.
  if [ "$a_loose" -gt 0 ]; then
    echo "         $a_loose apply row(s) name no forge in this ledger -- recorded with --force, or"
    echo "         for a skill forged on another machine. They are real records and are in"
    echo "         neither half of the count above; \`skillreport applied\` lists them."
  fi
}

# ------------------------------------------------------------------ the applied view
if [ "$VIEW" = "applied" ]; then
  JOINED="$(apply_join)"
  case "${JOINED:-}" in
    '{'*) : ;;
    # An unreadable or absent ledger still has to answer in the shape the caller asked
    # for. `--json` over an empty file is a parse error in the caller's script, and a
    # report that cannot be parsed is worse than one that says zero.
    *) JOINED='{"forges":[],"loose":[],"closed":0,"never":0,"used":0,"declined":0,"failed":0}' ;;
  esac
  if [ "$JSON" -eq 1 ]; then
    printf '%s\n' "$JOINED"
    exit 0
  fi
  printf '%s' "$JOINED" | jq -r "$JQ_DUR"'
    def day: if . == null then "-" else (. | gmtime | strftime("%Y-%m-%d")) end;
    def one: (. // "") | tostring | gsub("[\\n\\t\\r]"; " ");
    def clip($n): one | if (length > $n) then (.[0:$n] + "...") else . end;
    # MARKED, LIKE `clip` DIRECTLY ABOVE. A bare `.[0:$n]` cut a name off at the column
    # width with nothing saying it had been cut, so a truncated name was indistinguishable
    # from one that really ends there and two skills sharing a 28-character prefix rendered
    # as the same label. The marker costs three characters of the name and buys the reader
    # the fact that there is more of it. `length == $n` is its own arm because a jq
    # `" " * 0` yields null rather than the empty string.
    def pad($n): one
                 | if (length > $n) then
                     (if $n > 3 then (.[0:($n - 3)] + "...") else .[0:$n] end)
                   elif (length == $n) then .
                   else . + (" " * ($n - length)) end;
    "APPLIED - was the new skill ever used on the problem that caused it?",
    "A `use` row is any invocation, ever. An apply row is the one that closes the forge",
    "loop: it carries an outcome and the verbatim evidence, and only `skillforge apply`",
    "writes one. Read from the ledger alone; no transcript is consulted here.",
    "",
    ([ ("SKILL" | pad(28)), ("CLOSED" | pad(12)), ("APPLIED" | pad(10)),
       ("AFTER" | pad(7)), "EVIDENCE" ] | join(" ")),
    ([ "----------------------------", "------------", "----------",
       "-------", "--------" ] | join(" ")),
    (if (.forges | length) == 0 then "(no forge has closed `done` in this ledger)" else empty end),
    # LABELLED BY THE INSTALLED SKILL, WHICH IS WHERE `skillreport skills` FILES THE SAME
    # ROW. The join matches an apply row to a `done` by either name, so a forge run as
    # `widget-forge` can be discharged by the skill installed as `widget-skill`; the skills
    # view puts that row in the `widget-skill` block (it is the name `use` rows carry and
    # the name COVERAGE counts) while this column printed `widget-forge`. One row, two
    # views, two labels, and no way for a reader to line them up. The forge name is not
    # dropped -- the footnote under the table names it for every row where they differ.
    (.forges | sort_by(.closed)[]
      | ([ ((if .applied then (.apply_name // .name) else .name end) | pad(28)),
           (.closed | day | pad(12)),
           ((if .applied then .outcome else "NEVER" end) | pad(10)),
           ((if .applied then (.elapsed | dur) else "-" end) | pad(7)),
           (if .applied then (.evidence | clip(60)) else "" end) ] | join(" "))),
    "",
    "\(.closed) forges closed, \(.never) never applied.",
    (if .closed == 0 then empty
     else "  of the \(.closed - .never) applied: \(.used) used, \(.declined) declined, \(.failed) failed." end),
    (if .never > 0 then
       "  A forge with no apply row produced a tool and left the problem where it was.",
       "  `skillforge pending` lists the markers still open; `skillforge apply --name <skill>",
       "  --outcome used --evidence \"<verbatim quote>\"` is what discharges one."
     else empty end),
    (if ([ .forges[] | select(.applied and ((.apply_name // .name) != .name)) ] | length) == 0
     then empty
     else "",
       "  The SKILL column names the INSTALLED skill, which is the block `skillreport skills`",
       "  files the same row under. These rows were forged under another name:",
       (.forges[] | select(.applied and ((.apply_name // .name) != .name))
         | "    \(.apply_name | pad(28)) discharged the forge run as \(.name)")
     end),
    (if (.loose | length) == 0 then empty
     else "",
       "APPLY ROWS WITH NO FORGE IN THIS LEDGER (\(.loose | length))",
       "  Recorded with --force, or for a skill forged on another machine. Real records of",
       "  real acts, so they are shown; they are in neither half of the fraction above.",
       (.loose | sort_by(.ts)[]
         | "    \(.name | pad(28)) \(.ts | day | pad(12)) \(.outcome | pad(10)) \(.evidence | clip(60))")
     end),
    "",
    "A forge with no apply row has not been shown to be useless. It has been shown to be",
    "unapplied, which is a different claim and the one this ledger is careful to make."
  '
  exit 0
fi

# ------------------------------------------------------- the four-question view
#
# WHAT TRIGGERED THE BUILD, WHAT WAS BUILT, USED SINCE, AND DID IT WORK. One block per
# skill, read out of the ledger alone.
#
# THE LEDGER AND THE TRANSCRIPTS ARE NOT ADDED TOGETHER, HERE OR ANYWHERE. They are two
# instruments pointed at the same thing over different intervals: `use` rows begin the
# day the hook was installed, transcripts go back as far as the transcripts do, and a
# window that appears in both would be counted twice by anything that summed them. The
# table view counts transcripts; this view counts rows; each says which.
#
# AN ABSENT RECORD IS NEVER A NEGATIVE RESULT, and the horizon row is what makes that
# statable. A ledger whose first row is Tuesday says nothing whatever about Monday, so
# the header prints where the record begins and says outright that anything earlier is
# unknown rather than none.
#
# HARNESS AND GENUINE STAY VISIBLY SEPARATE. `harness:true` marks an invocation made by
# a session a script started -- this package's own probes and end-to-end tests, which on
# the machine this was written on were 93 of 98 recorded invocations. A row whose
# `harness` field is absent is neither: the entrypoint could not be read when it was
# written, so it is counted and labelled "unclassified" rather than quietly folded into
# the genuine column, which is precisely the move that inflated the headline once already.
if [ "$VIEW" = "skills" ]; then
  if [ ! -s "$LEDGER" ]; then
    echo "no ledger yet ($LEDGER)"
    echo "Nothing to report. The rows this view reads are written by a forge, by the"
    echo "installer, and by the Skill hook on every invocation."
    exit 0
  fi
  # The apply join is computed ONCE, by the same function the `applied` view uses, and
  # handed in here. Writing the join a second time in this filter is how the two views
  # start disagreeing about the same ledger.
  AJ="$(apply_join)"
  case "${AJ:-}" in
    '{'*) : ;;
    *) AJ='{"forges":[],"loose":[],"closed":0,"never":0,"used":0,"declined":0,"failed":0}' ;;
  esac
  jq -s -R -r --argjson aj "$AJ" "$JQ_DUR"'
    # `select(type == "object")` is not decoration. Without it ONE well-formed but
    # non-object line in the ledger -- a bare `[1,2,3]` from a tool that appended to the
    # wrong file -- makes `$rec[.].event` raise "Cannot index array with string", jq exits
    # 5, and the whole view collapses to "no forges recorded yet" with every real row
    # still sitting on disk. Measured against a real mixed ledger while the apply column
    # was being added; hooks/repeat-gate.sh already guards its own store the same way.
    def parse: [ split("\n")[] | select(length > 0) | (fromjson? // empty)
                 | select(type == "object") ];
    def day: if . == null then "-" else (. | gmtime | strftime("%Y-%m-%d")) end;
    def plural($n; $one; $many): if $n == 1 then $one else $many end;
    def one: (. // "") | tostring | gsub("[\\n\\t\\r]"; " ");
    def clip($n): one | if (length > $n) then (.[0:$n] + "...") else . end;
    # WHAT HAPPENED TO THE FORGE OF THIS NAME. `done` and `fail` are the two close
    # events and the NEWEST one is what the name is now, because re-forging after a
    # failed round is this protocol own prescribed workflow and one name legitimately
    # carries a fail and then a done. Both arguments are already-bound variables, so
    # neither is evaluated against whatever input the call happens to sit on.
    def lastclose($cl; $nm): ([ $cl[] | select((.name // "") == $nm) ]
                              | sort_by(.ts // 0) | last);
    def failedforge($cl; $nm): ((lastclose($cl; $nm) | (.event // "")) == "fail");
    parse as $rec
    | [ $rec[] | select(.event == "origin") ]  as $origins
    | [ $rec[] | select(.event == "use") ]     as $uses
    | [ $rec[] | select(.event == "verdict") ] as $verdicts
    | [ $rec[] | select(.event == "horizon") ] as $horizons
    # SELECTED BY NAME, never by negation, like every other reader here. `apply_join`
    # above joins `done` rows only, so a forge that was ABANDONED is invisible to it and
    # a verdict naming that forge used to print exactly like a verdict on a shipped
    # skill. It is not dropped -- the row is on the append-only ledger and stays on the
    # record -- it is annotated with the fail that stands behind it.
    | [ $rec[] | select(.event == "done" or .event == "fail") ] as $closes
    | ( [ $origins[].name ] + [ $uses[].name ] + [ $verdicts[].name ]
        + [ $aj.forges[] | select(.applied) | (.apply_name // .name) ]
        + [ $aj.loose[].name ]
        | map(select(. != null)) | unique ) as $names
    | "SKILLS — what triggered the build, what was built, was it applied, used since, did it work",
      "Read from the ledger alone. The default view counts skill invocations recovered",
      "from transcripts instead; the two are different instruments over different",
      "intervals and are never added together.",
      "",
      (if ($horizons | length) == 0 then
         "No horizon row, so how far back this ledger is complete is unknown."
       else ($horizons | sort_by(.ts) | .[0]) as $h
         | "Ledger horizon: the earliest row is \($h.known_from | day)."
           + (if ($h.complete_from // null) == null
              then " Whether anything happened before that is UNKNOWN, not none: this"
                 + " ledger was already in use when the marker was written."
              else " The ledger has been complete since \($h.complete_from | day)." end)
       end),
      "",
      (if ($names | length) == 0 then "No skills recorded yet." else empty end),
      ( $names[]
        | . as $n
        | ([ $origins[] | select(.name == $n) ] | sort_by(.ts) | .[0]) as $o
        | [ $uses[] | select(.name == $n) ] as $u
        | [ $u[] | select(.harness == true) ] as $harness
        | [ $u[] | select(.harness == false) ] as $genuine
        | [ $u[] | select(.harness == null) ] as $unclassified
        | [ $u[] | select(.ok == false) ] as $failed
        | [ $verdicts[] | select(.name == $n) ] as $v
        | failedforge($closes; $n) as $failed_forge
        | lastclose($closes; $n) as $last_close
        # THE FIFTH QUESTION. Selected by name out of the join above, never by exclusion,
        # and kept separate from `uses` on purpose: a use is any invocation ever, an apply
        # is the one that closed the loop the forge opened.
        #
        # ONE ROW, ONE BLOCK, AND THE NAME CHOSEN IS THE ONE ON THE APPLY ROW -- `.apply_name`,
        # falling back to the name on the forge only when the apply row carries none. The
        # dual-name match this join performs (`apply.name == done.name` OR
        # `apply.forge == done.name`) exists precisely so a skill INSTALLED under one name
        # can discharge a forge run under another, and testing the joined row against both
        # names here printed it under both blocks -- the same apply, the same evidence,
        # twice, in the exact case the dual match was built for. The installed name is the
        # one to keep: it is the name the `use` rows carry (the Skill hook records what was
        # invoked), the name $names is built from a few lines up, and the name COVERAGE
        # counts, so the apply now lands in the block a reader arrives at by looking up the
        # skill they actually call. The block for the forge name is not left lying either:
        # $ap_elsewhere
        # below says where its debt was discharged instead of claiming there was none.
        | ([ $aj.forges[] | select(.applied and ((.apply_name // .name) == $n)) ]
           + [ $aj.loose[] | select(.name == $n) ]
           | sort_by((.apply_ts // .ts // 0))) as $ap
        | [ $aj.forges[] | select(.applied and .name == $n
                                  and ((.apply_name // .name) != $n)) ] as $ap_elsewhere
        | [ $aj.forges[] | select((.applied | not) and .name == $n) ] as $unapplied
        | $n,
          (if $o == null then
             "  origin    NO ORIGIN ROW — this skill has rows here but nothing says where it came from"
           else
             "  origin    \($o.origin)"
             # `has`, not `//`: jq treats false as empty, so `.shipped // null` on a row
             # carrying `shipped:false` yields null and the "lives outside this checkout"
             # half of this line never printed for the skills it exists to describe.
             + (if ($o | has("shipped") | not) then ""
                elif $o.shipped then ", shipped with this package"
                else ", lives outside this checkout" end)
             + (if ($o.backfilled // false) then "  [reconstructed: \($o.source // "source not named")]"
                else "  (recorded \($o.ts | day))" end)
           end),
          (if $o == null then empty
           elif ($o.skill_dir // "") != "" then "  where     \($o.skill_dir)"
           else empty end),
          (if $o == null then empty
           elif ($o.trigger_verbatim // "") != "" then
             "  trigger   [\($o.trigger_kind // "kind not recorded")] \"\($o.trigger_verbatim)\""
           elif ($o.trigger_kind // "") == "unrecorded" then
             "  trigger   NOT RECORDED — the forge ran without --trigger, and the moment has passed"
           else
             "  trigger   not recorded"
           end),
          (if ($u | length) == 0 then "  uses      none recorded" else
          "  uses      \($genuine | length) genuine"
            + (if ($harness | length) > 0 then ", \($harness | length) harness (a script drove the session)" else "" end)
            + (if ($unclassified | length) > 0 then ", \($unclassified | length) unclassified (entrypoint unreadable when recorded)" else "" end)
            + (if ($failed | length) > 0 then ", \($failed | length) failed" else "" end)
            + (if ($genuine | length) > 0
               then ", last genuine use \(($genuine | map(.ts) | max) | day)"
               else "" end)
          end),
          # FOUR INDEPENDENT CONDITIONS, NOT AN `elif` CHAIN, AND THAT IS THE WHOLE POINT.
          # These facts are not alternatives: a name can carry a discharged forge and a
          # standing one at the same time -- the skill was forged twice, the older one was
          # applied and the newer one was not -- and the chain made the NOT APPLIED arm
          # unreachable for any name with a single apply row anywhere behind it. A debt
          # disappeared from the view BECAUSE an earlier debt had been paid, which is the
          # one direction this report must never fail in. Only the closing line is
          # conditional on the other three, because it is the statement that there is
          # nothing to say.
          (if ($ap | length) > 0 then
             ($ap[]
              | "  applied   \(.outcome // "outcome not recorded")"
                # The shared `dur` decides what a null or negative interval renders as;
                # this asks what it returned rather than re-testing the interval, so the
                # rule stays in the one place the two views agree on.
                + ((.elapsed | dur) as $d
                   | if $d == "-" then "" else ", \($d) after the forge closed" end)
                + (if ((.evidence // "") | length) > 0
                   then " — \"\(.evidence | clip(70))\"" else "" end))
           else empty end),
          (if ($unapplied | length) > 0 then
             "  applied   NOT APPLIED — \($unapplied | length) forge(s) closed for this name and nothing says the skill was put on the problem that caused it"
           else empty end),
          (if ($ap_elsewhere | length) > 0 then
             ($ap_elsewhere[]
              | "  applied   \(.outcome // "outcome not recorded"), but recorded under the installed name \"\(.apply_name)\" — the row is in that block, not repeated here")
           else empty end),
          (if ($ap | length) == 0 and ($unapplied | length) == 0
              and ($ap_elsewhere | length) == 0 then
             # `apply_join` pairs `apply` rows against `done` rows, so an abandoned forge
             # never reaches $unapplied and this line used to report it as no forge at
             # all. A forge that failed is not a forge that never happened.
             (if $failed_forge
              then "  applied   NOT APPLICABLE — the forge for this name was abandoned (fail \($last_close.ts | day)), so no skill shipped and there is no debt to discharge"
              else "  applied   no closed forge under this name, so there is nothing to discharge" end)
           else empty end),
          (if ($v | length) == 0 then
             "  verdict   none recorded"
           else
             "  verdict   "
             + ([ $v | group_by(.verdict)[] | "\(length) \(.[0].verdict)" ] | join(", "))
             + "  (model judgements over quoted evidence, not measurements)"
             + (if $failed_forge
                then "\n            (forge failed \($last_close.ts | day); verdict stands on the record only — no skill shipped under this name)"
                else "" end)
           end),
          ""
      ),
      "COVERAGE — how much of the five questions this ledger can actually answer",
      "  skills with an origin row:      \($origins | length)",
      "  of those, trigger recorded:     \([ $origins[] | select((.trigger_verbatim // "") != "") ] | length)",
      "  skills with a recorded use:     \([ $uses[].name ] | unique | length)",
      # A VERDICT ON AN ABANDONED FORGE IS NOT A VERDICT ON A SHIPPED SKILL, and this
      # line is a coverage figure -- how much of the five questions the ledger can answer
      # ABOUT SKILLS THAT EXIST. Counted separately rather than dropped: the row is on
      # the ledger and pretending otherwise is the same silence this block exists to end.
      ( ([ $verdicts[].name ] | unique) as $vnames
        | ([ $vnames[] | select(failedforge($closes; .)) ] | length) as $vfailed
        | "  skills with a verdict:          \(($vnames | length) - $vfailed)"
          + (if $vfailed > 0
             then " (+\($vfailed) whose forge was abandoned; those skills never shipped)"
             else "" end) ),
      "  skills with an apply row:       \((([ $aj.forges[] | select(.applied) | (.apply_name // .name) ] + [ $aj.loose[].name ]) | unique | length))",
      "  forges closed, never applied:   \($aj.never) of \($aj.closed)",
      "  rows that were reconstructed:   \([ $rec[] | select(.backfilled == true) ] | length) of \($rec | length)",
      "",
      "A skill with no rows here has not been shown to be unused. It has been shown to be",
      "unrecorded, which is a different claim and the one this ledger is careful to make."
  ' "$LEDGER"
  exit 0
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/skillreport.XXXXXX")" || { echo "skillreport: cannot create a temp dir" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT INT TERM

# --------------------------------------------------------------------- the ledger

if [ ! -s "$LEDGER" ]; then
  echo "no forges recorded yet ($LEDGER)"
  echo "Nothing to measure. Run a forge with the skill-compounder skill first."
  # Zero of zero, printed. See print_applied_headline: the claim that it appears on every
  # path is only worth making if the paths with nothing to show print it too.
  print_applied_headline
  # The gates are surfaced even with no ledger. They are written by hooks, not by a
  # forge, so a machine that has never forged anything can still have refused a repeat
  # and can still have had its documentation gate overridden -- and those are exactly
  # the numbers a user with no forges is owed a sight of.
  print_gates
  exit 0
fi

# One row per start, joined to the first done/fail for the same name that follows it.
# 'since' is the moment the forge FINISHED. A forge with no done and no fail has no
# finish time, so it gets closed=no and is excluded from the reuse fraction entirely.
# The start timestamp must never stand in for a finish: doing that lets an invocation
# made *during* an unfinished forge be counted as reuse, which turns the one number
# this report exists to produce into a flattering lie.
#
# AN OUTCOME WITH NO START IS ALSO A ROW. Walking start records only meant an outcome
# that nothing joined to was discarded in silence -- and the reason a `done` has no
# `start` is that the process was killed between claiming its slot and appending its
# start row, so silent discarding removed exactly the forges most worth counting. This
# script exists to say whether forged skills get reused; under-reporting the crashed
# ones is the failure mode it can least afford. Such a row is marked, and its forge
# window is reconstructed from the recorded duration, which is real data and not a
# guess: 'since' is still the recorded finish, so nothing during the window counts.
#
# ONE OUTCOME PER START, for the same reason. Matching by name alone let one `done` be
# consumed by two starts of the same name, so an abandoned forge was counted as
# finished and the denominator of the reuse fraction grew by one.
jq -s -R -r '
  def rounds_of(s): ((((s // 2) - 2) / 2) | floor) as $r | (if $r < 0 then 0 else $r end);
  [ split("\n")[] | select(length > 0) | (fromjson? // empty)
    | select(type == "object") ] as $rec
  | [ range(0; ($rec | length)) | select($rec[.].event == "start") ] as $starts
  | [ range(0; ($rec | length))
      | select($rec[.].event == "done" or $rec[.].event == "fail") ] as $ends
  | (reduce $starts[] as $i ({used: [], pairs: []};
       . as $acc
       | ([ $ends[] | select(. > $i and $rec[.].name == $rec[$i].name) ]
          - $acc.used | .[0]) as $e
       | { used:  (if $e == null then $acc.used else ($acc.used + [$e]) end),
           pairs: ($acc.pairs + [[$i, $e]]) })) as $join
  | ($ends - $join.used) as $orphans
  | ( ($join.pairs | map(.[0] as $i | .[1] as $ei | $rec[$i] as $st
        | (if $ei == null then null else $rec[$ei] end) as $en
        | [ $st.name,
            ($st.ts // 0),
            (if $en == null then ($st.ts // 0) else ($en.ts // $st.ts // 0) end),
            (if $en == null then "no outcome" else $en.event end),
            (if $en == null then rounds_of($st.steps)
             else ($en.rounds // rounds_of($st.steps)) end),
            (if $en == null then "no" else "yes" end),
            (if $en == null then "" else ($en.rounds_planned // "" | tostring) end),
            "no",
            # THE NAME THE SKILL WAS INSTALLED UNDER, which is not always the one the
            # forge carried. `done` writes an origin row naming the DIRECTORY it linked
            # and stamps it with the start time of the forge that produced it, in
            # `created_at`; that stamp is the join key. Without this column the reuse
            # count below matches on the forge name alone, so a skill renamed between
            # forging and installing reports 0 uses forever. Measured: forge
            # `dead-guard-check` produced `dead-guard-detection`, and this table printed
            # 0 against 28 recorded invocations.
            (([ $rec[] | select(.event == "origin" and .origin == "forged"
                                and ((.created_at // -1) == ($st.ts // 0)))
                       | .name ] | first) // $st.name) ]))
      + ($orphans | map(. as $j | $rec[$j] as $en
        | [ (if ($en.name // "") == "" then "(unnamed)" else $en.name end),
            (($en.ts // 0) - ($en.duration // 0)),
            ($en.ts // 0),
            $en.event,
            ($en.rounds // 0),
            "yes",
            ($en.rounds_planned // "" | tostring),
            "yes",
            # An orphaned outcome has no start, so there is no stamp to join on and the
            # name on the outcome row is the only name there is.
            ($en.name // "(unnamed)") ])) )
  | sort_by(.[1])
  | .[] | @tsv
' "$LEDGER" > "$TMP/forges.tsv" 2>/dev/null

if [ ! -s "$TMP/forges.tsv" ]; then
  echo "no forges recorded yet ($LEDGER has no 'start' records)"
  # No `start` row does not mean no `apply` row: a skill forged on another machine and
  # recorded here with `skillforge apply --force` lands in exactly this ledger shape.
  print_applied_headline
  print_gates
  exit 0
fi

# ------------------------------------------------- ONE ROW PER SKILL, NOT PER FORGE
#
# A skill forged more than once has one forge row per forge, and every one of those rows
# was credited with the SAME invocations. The join below matches invocations BY NAME, and
# a name cannot say which of its forges it belongs to, so each row counted the lot.
# Measured on the real ledger this package keeps: `ai-tell-audit` had three forge rows
# each reporting the same 4 uses, `finish-task` the same, the harness breakdown printed
# `finish-task 72` three times, and the headline read "7 of 10 finished forges" over 5
# distinct skills. Every one of those figures was a multiple of a real one, and nothing
# on the page said so.
#
# So the unit of the reuse fraction is the SKILL NAME, and the row that stands for a name
# is its LATEST SUCCESSFUL forge. Latest, because `since` is the window every count below
# is measured against and the newest window is the one a reader means by "since it was
# forged".
#
# SUCCESSFUL, and that is not a tidiness preference. The headline says the forge "produced
# a skill that was invoked", and a `fail` produced none. Ranking by recency alone made
# `finish-task` -- forged and shipped 2026-08-27, used once, then re-forged twice into
# failures on 09-01 -- report 0 uses against a window opened by a forge that built nothing,
# and dropped it out of the reused half. The rank is therefore done, then any outcome at
# all, then none: a name with only failures keeps its latest failure and is still counted
# as a finished forge exactly as before, and a name whose only rows are unfinished keeps
# its latest unfinished row, still visible in the table and still excluded from both halves
# of the fraction.
#
# The dropped rows are not lost data: `skillforge ledger` lists every one, and how many
# were folded is reported under the headline. What is dropped is the double counting.
#
# GROUPED BY THE FORGE NAME, which is the name this table prints, so the SKILL column can
# no longer repeat. It is not grouped by the installed name: that would let a rename fold
# two rows the table would then print under one visible name and one hidden one.
#
# Two passes over the same file. The first picks a representative line number per name,
# the second prints the lines it picked, so the ordering by start time survives.
awk -F'\t' '
  NR == FNR {
    rank = ($4 == "done") ? 2 : (($6 == "yes") ? 1 : 0)
    if (!($1 in best) || rank > r[$1] || (rank == r[$1] && $3 + 0 >= t[$1] + 0)) {
      best[$1] = FNR; r[$1] = rank; t[$1] = $3 + 0
    }
    next
  }
  FNR == best[$1]
' "$TMP/forges.tsv" "$TMP/forges.tsv" > "$TMP/skills.tsv" 2>/dev/null

# FAIL OPEN. An awk that produced nothing must not empty the table: a duplicated view is
# wrong by a multiple, an absent one is wrong by everything.
forge_rows="$(wc -l < "$TMP/forges.tsv" 2>/dev/null | tr -cd '0-9')"
skill_rows="$(wc -l < "$TMP/skills.tsv" 2>/dev/null | tr -cd '0-9')"
case "${forge_rows:-}" in ''|*[!0-9]*) forge_rows=0 ;; esac
case "${skill_rows:-}" in ''|*[!0-9]*) skill_rows=0 ;; esac
if [ ! -s "$TMP/skills.tsv" ]; then
  cp "$TMP/forges.tsv" "$TMP/skills.tsv" 2>/dev/null
  skill_rows="$forge_rows"
fi
folded=$(( forge_rows - skill_rows ))
[ "$folded" -lt 0 ] && folded=0

# ---------------------------------------------------------------- the transcripts

# Skill invocations are recorded as assistant tool_use blocks. The grep prefilter is
# the verified recipe from issue #6: transcripts are written as compact JSON, so the
# key order '"name":"Skill","input":{"skill":' is stable. jq then re-checks the shape,
# so a line that matches the substring for some other reason is discarded.
#
# Per-invocation timestamps are real, not inferred: every transcript record carries an
# ISO-8601 '.timestamp'. Fractional seconds are trimmed because jq's fromdateiso8601
# does not accept them. A record whose timestamp cannot be parsed emits -1 and is
# counted separately rather than being folded into either bucket. File mtime is never
# substituted for a record timestamp.
: > "$TMP/inv.tsv"
# The file list is built first rather than iterated inside a pipeline: bash runs every
# stage of a pipeline in a subshell, so a counter incremented in the loop would be lost.
# find rather than a glob, because zsh treats a glob that matches nothing as a fatal
# error and this script has to survive being run under either shell.
find "$TRANSCRIPTS" -maxdepth 2 -type f -name '*.jsonl' 2>/dev/null > "$TMP/files"
found_any=0
[ -s "$TMP/files" ] && found_any=1

# AN ATTEMPT IS NOT A USE (issue #9). Every tool_use has an id, and its result comes
# back in a later user record as a tool_result with the matching .tool_use_id; a failed
# invocation carries "is_error":true there (verified shape: {"type":"tool_result",
# "content":"<tool_use_error>Unknown skill: ...</tool_use_error>","is_error":true,
# "tool_use_id":"toolu_..."}). Counting the tool_use alone counted those failures as
# reuse: one uninstalled skill moved the headline from 80% to 100%. So the failed ids
# are collected first, and the invocation pass below drops any tool_use whose id is in
# the set. A successful result has no is_error key at all, so absence from the set is
# the success condition. The grep prefilter is compact-JSON stable the same way the
# Skill one is, and jq re-checks the shape so a prose line mentioning the substring is
# discarded. Emitted without -r: each id is a quoted JSON string, which is what
# --slurpfile needs, and an empty file slurps to [] rather than an error.
: > "$TMP/errids"
while IFS= read -r f; do
  grep -h '"is_error":true' "$f" 2>/dev/null
done < "$TMP/files" | jq -R '
  (fromjson? // empty) as $rec
  | ($rec.message.content // [])
  | (if type == "array" then .[] else empty end)
  | select((.type? == "tool_result") and (.is_error? == true))
  | (.tool_use_id? // empty) | select(type == "string" and length > 0)
' >> "$TMP/errids" 2>/dev/null

# THIS PACKAGE CALLS ITS OWN SKILLS, AND THAT IS NOT USAGE (self-measurement).
# `scripts/probe_routing_claims.py` spawns one real `claude -p` session per routing
# prompt, and the end-to-end and hot-reload probes do the same. Each of those sessions
# really invokes a real skill and really writes a real transcript, so counted naively
# they are indistinguishable from a person reaching for a skill -- and they dominate.
# Derived on the machine this was written on (reads transcripts only, paste-able):
#
#   find ~/.claude/projects -maxdepth 2 -name '*.jsonl' -exec grep -h '"name":"Skill"' {} + \
#     | jq -r '(fromjson? // empty) as $r | ($r.message.content // [])
#              | (if type=="array" then .[] else empty end)
#              | select(.type? == "tool_use" and .name? == "Skill")
#              | [(.input.skill // "?"), ($r.entrypoint // "?"), ($r.cwd // "?")] | @tsv' \
#     | sort | uniq -c | sort -rn
#
# 98 invocations, over the nine skills this package shipped when that was counted: 93 from probe and test working
# directories, 5 from real project directories. All 93 inflated the headline, which read
# "REUSE: 5 of 5 finished forges (100%)" with per-skill USES of 11/11/11/14/8.
#
# THE RULE IS WHO DROVE THE SESSION, NOT WHERE IT RAN. Claude Code stamps every record
# with `.entrypoint`: "cli" for a person at a terminal, "claude-vscode" for the editor,
# "sdk-cli" for a session started programmatically -- which is what `claude -p` is, and
# which is how every probe and every end-to-end test in this repo spawns Claude. A skill
# invoked inside a session a script started was not chosen by anyone, so it is not reuse.
# On the corpus above the split is exact: all 93 harness invocations carry "sdk-cli" and
# all 5 genuine ones carry "cli". Subagents inherit the entrypoint of the session that
# dispatched them (verified: a sidechain transcript under a `cli` session records
# `"entrypoint":"cli","isSidechain":true`), so delegated work inside a real session still
# counts -- which a rule keyed on `.isSidechain` would have thrown away instead.
#
# A LIST OF TODAY'S TEMP-DIR NAMES WAS THE OBVIOUS FIX AND THE WRONG ONE. `routing-probe-*`,
# `sac-probe`, `sktest-proj` are the names this week's probes happened to use; the next
# probe picks a new one and the headline quietly inflates again -- the same defect, one
# rename later. `.entrypoint` is written by Claude Code itself and survives a rename.
# It also needs no cooperation from the probe: nothing outside this file changes.
#
# WHERE IT RAN IS KEPT AS A LABEL, NEVER AS A FILTER. A system temp root ($TMPDIR, /tmp,
# /var/tmp, /var/folders and their /private twins) is where the harness works, but a real
# user scratching in /tmp is a real user, and erasing them would be the same kind of lie
# pointing the other way. So the temp-root test removes nothing. It only annotates: it
# splits the excluded bucket into runs that happened in a temp directory (what this
# package's probes look like) and runs that happened in a real project (someone's own
# `claude -p` automation, which they are owed a sight of), and it flags counted
# invocations that happened in a temp directory.
#
# Prefixes are matched as whole path segments, not substrings: a project genuinely named
# /Users/me/tmpfoo is not a temp root. Built with jq rather than as a regex so no path
# ever has to be regex-escaped.
TMP_ROOTS="$(jq -n -c --arg t "${TMPDIR:-}" '
  ["/tmp","/private/tmp","/var/tmp","/private/var/tmp","/var/folders","/private/var/folders"]
  + (if ($t | length) > 0 then [($t | sub("/+$"; ""))] else [] end)' 2>/dev/null)"
case "${TMP_ROOTS:-}" in
  '['*) : ;;
  *) TMP_ROOTS='["/tmp","/private/tmp","/var/tmp","/private/var/tmp","/var/folders","/private/var/folders"]' ;;
esac

# A tool_use with NO tool_result anywhere IS counted. The usual reason a result is
# missing is that the session is still live or was cut off mid-turn, not that the
# invocation failed -- a failure writes its error result on the very next record.
# Refusing to count those would under-report exactly the freshest usage. The join is
# by id, and ids are unique tokens, so matching against the pooled set is the same
# join as matching within one file -- a resumed session copies its records verbatim,
# ids included, so the same id can only ever map to the same outcome.
#
# Field 4 is the class ("harness" or "counted") and field 5 is the location ("temp" or
# "proj"). A record with no `.entrypoint` at all -- an older Claude Code wrote it -- is
# classed "counted": absence of the field is a version fact, not a probe signature, and
# the failure that matters here is the one that erases a real use without saying so.
while IFS= read -r f; do
  grep -h '"name":"Skill"' "$f" 2>/dev/null
done < "$TMP/files" | jq -R -r --slurpfile bad "$TMP/errids" --argjson roots "$TMP_ROOTS" '
  (fromjson? // empty) as $rec
  | ($rec.timestamp // "") as $iso
  | (($iso | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601?) // -1) as $ts
  | ($rec.cwd // "unknown") as $cwd
  | ($rec.entrypoint // "") as $ep
  | (if $ep == "sdk-cli" then "harness" else "counted" end) as $class
  # The root is bound to $r first. Written as `startswith(. + "/")` the `.` inside the
  # argument is $cwd, not the root, so every path compared against itself and every
  # invocation classed "proj" -- silently, since "proj" is the safe-looking answer.
  | (if any($roots[]; . as $r | ($cwd == $r) or ($cwd | startswith($r + "/")))
     then "temp" else "proj" end) as $where
  | ($rec.message.content // [])
  | (if type == "array" then .[] else empty end)
  | select((.type? == "tool_use") and (.name? == "Skill"))
  | (.id? // "") as $tid
  | select(($bad | index($tid)) == null)
  | [ (.input.skill // "unknown"), $ts, $cwd, $class, $where ] | @tsv
' >> "$TMP/inv.tsv" 2>/dev/null

# --------------------------------------------------------------------- the table

printf '%-30s %-12s %7s %-12s %12s %9s\n' \
  "SKILL" "FORGED" "ROUNDS" "OUTCOME" "USES SINCE" "PROJECTS"
printf '%-30s %-12s %7s %-12s %12s %9s\n' \
  "------------------------------" "------------" "-------" "------------" "------------" "---------"

total=0
reused=0
unclosed=0
during_total=0
unparsed_total=0
harness_total=0
harness_after_total=0
harness_temp_total=0
harness_proj_total=0
scratch_total=0
orphans=0
overruns=0

# ROUNDS is printed as "completed/planned" when a forge ran past its budget. The budget
# has been in the ledger since the overrun was made representable and nothing printed
# it, so six rounds against a three-round budget read as a plain "6" -- identical to a
# forge that spent exactly what it planned.
# Deliberately does not touch a counter: it is called in a command substitution, which
# is a subshell, so an increment here would be discarded. The caller counts.
rounds_col() { # <completed> <planned>
  case "${2:-}" in ''|*[!0-9]*) printf '%s' "$1"; return ;; esac
  if [ "$1" -gt "$2" ]; then printf '%s/%s' "$1" "$2"
  else printf '%s' "$1"; fi
}
is_over() { # <completed> <planned>
  case "${2:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt "$2" ]
}

while IFS="$(printf '\t')" read -r name start_ts since_ts outcome rounds closed planned orphan installed; do
  [ -n "${name:-}" ] || continue
  is_over "$rounds" "${planned:-}" && overruns=$(( overruns + 1 ))
  rounds="$(rounds_col "$rounds" "${planned:-}")"
  # An outcome with no start is shown from the outcome alone, and says so.
  if [ "${orphan:-no}" = "yes" ]; then
    orphans=$(( orphans + 1 ))
    outcome="$outcome*"
  fi

  # No finish time means no window to measure against. Print the row so the forge is
  # visible, but show a dash rather than a count, and keep it out of both halves of
  # the reuse fraction.
  if [ "${closed:-yes}" != "yes" ]; then
    unclosed=$(( unclosed + 1 ))
    printf '%-30s %-12s %7s %-12s %12s %9s\n' \
      "$(printf '%.30s' "$name")" \
      "$(jq -n -r --argjson t "$start_ts" '$t | gmtime | strftime("%Y-%m-%d")' 2>/dev/null || echo "?")" \
      "$rounds" "$outcome" "-" "-"
    continue
  fi

  total=$(( total + 1 ))
  # The name goes through the environment, not through 'awk -v'. awk processes escape
  # sequences in a -v value, while jq's @tsv writes them: a name holding a real tab
  # arrives here as the two characters \t, -v would turn it back into a tab, and the
  # comparison against the identically-escaped $1 would silently never match. ENVIRON
  # is not unescaped, so both sides stay in the same representation.
  # The harness test comes FIRST, before the timestamp and window tests. A probe
  # invocation is not reuse whenever it happened, and letting one fall through into the
  # `during` bucket would have quietly relabelled it "inside a forge window" -- true, but
  # a different claim than the one the reader needs. Its window is still reported, as
  # harness_after: those are the invocations that were inflating USES SINCE.
  counts="$(SR_NAME="$name" SR_INSTALLED="${installed:-$name}" \
            awk -F'\t' -v since="$since_ts" -v start="$start_ts" '
    BEGIN { n = ENVIRON["SR_NAME"]; m = ENVIRON["SR_INSTALLED"] }
    {
      bare = $1
      sub(/^[^:]*:/, "", bare)          # accept both "name" and "plugin:name"
      # EITHER name. A session invokes a skill by the directory it sits in, so the
      # invocations land under the installed name while the forge row carries the forge
      # name. Matching only the forge name is what hid 28 uses behind a 0.
      if ($1 != n && bare != n && $1 != m && bare != m) next
      if ($4 == "harness") {
        harness++
        if ($5 == "temp") h_temp++; else h_proj++
        if ($2 + 0 >= 0 && $2 + 0 > since + 0) h_after++
        next
      }
      if ($2 + 0 < 0) { unparsed++; next }
      if ($2 + 0 > since + 0) {
        after++
        if ($5 == "temp") scratch++
        if (!seen[$3]++) projects++
      } else if ($2 + 0 >= start + 0) {
        during++
      }
    }
    END { printf "%d %d %d %d %d %d %d %d %d", after + 0, projects + 0, during + 0, \
                 unparsed + 0, harness + 0, h_after + 0, h_temp + 0, h_proj + 0, scratch + 0 }
  ' "$TMP/inv.tsv")"
  # Read the four numbers back with a heredoc rather than 'set -- $counts': zsh does
  # not word-split an unquoted expansion, so the positional-parameter trick silently
  # yields one field there and four under bash.
  after=0; projects=0; during=0; unparsed=0
  harness=0; h_after=0; h_temp=0; h_proj=0; scratch=0
  IFS=' ' read -r after projects during unparsed harness h_after h_temp h_proj scratch <<COUNTS
$counts
COUNTS
  during_total=$(( during_total + during ))
  unparsed_total=$(( unparsed_total + unparsed ))
  harness_total=$(( harness_total + harness ))
  harness_after_total=$(( harness_after_total + h_after ))
  harness_temp_total=$(( harness_temp_total + h_temp ))
  harness_proj_total=$(( harness_proj_total + h_proj ))
  scratch_total=$(( scratch_total + scratch ))
  # Written to a file rather than accumulated into a string: the per-skill breakdown is
  # printed after the loop, and the loop body is not a subshell only because forges.tsv
  # arrives by redirect. A file keeps that true no matter how the loop is later fed.
  [ "$harness" -gt 0 ] && printf '%s\t%s\n' "$name" "$harness" >> "$TMP/harness.tsv"
  [ "$after" -gt 0 ] && reused=$(( reused + 1 ))
  printf '%-30s %-12s %7s %-12s %12s %9s\n' \
    "$(printf '%.30s' "$name")" \
    "$(jq -n -r --argjson t "$since_ts" '$t | gmtime | strftime("%Y-%m-%d")' 2>/dev/null || echo "?")" \
    "$rounds" "$outcome" "$after" "$projects"
done < "$TMP/skills.tsv"

# --------------------------------------------------------------- the headline

echo
if [ "$orphans" -gt 0 ]; then
  echo "* $orphans outcome record(s) have no matching start record. Only the outcome"
  echo "  survives, so the FORGED date is reconstructed from the recorded duration. A"
  echo "  start row is missing when \`start\` was killed between claiming its slot and"
  echo "  appending its row, or when the ledger was truncated after a forge had begun."
fi
if [ "$overruns" -gt 0 ]; then
  echo "ROUNDS reads completed/planned for the $overruns forge(s) that ran past their budget."
fi
if [ "$orphans" -gt 0 ] || [ "$overruns" -gt 0 ]; then echo; fi
if [ "$total" -eq 0 ]; then
  echo "REUSE: not measurable. No forge in the ledger has a recorded finish, so there is"
  echo "       no window to count invocations against."
else
  pct=$(( reused * 100 / total ))
  echo "REUSE: $reused of $total finished forges ($pct%) produced a skill that was invoked"
  echo "       at least once after the forge that created it finished."
fi
if [ "$unclosed" -gt 0 ]; then
  echo "       $unclosed forge(s) never closed out and are excluded from both halves of that"
  echo "       fraction. They have no finish time, so nothing can be counted as after it."
fi
if [ "$folded" -gt 0 ]; then
  echo "       Counted once per SKILL, not once per forge row. $folded of the $forge_rows forge"
  echo "       row(s) in the ledger share a name with a row above and are folded into it, so"
  echo "       one skill's invocations are not credited to each of its forges in turn."
  echo "       \`skillforge ledger\` lists every forge row."
fi

# The same headline the two early exits above print, from the same function, so the three
# paths cannot say different things about one ledger. See print_applied_headline.
print_applied_headline

echo
echo "$during_total invocation(s) fell inside a forge window and were not counted as reuse."
if [ "$unparsed_total" -gt 0 ]; then
  echo "$unparsed_total invocation(s) had no parseable timestamp and were not counted at all."
fi

# The excluded bucket is printed unconditionally once it is non-empty, and it names both
# its size and how much of the headline it would have been. A number that is only ever
# subtracted in silence is how the inflation got in; this line is what stops it coming
# back unnoticed.
if [ "$harness_total" -gt 0 ]; then
  echo
  echo "EXCLUDED AS PROBE/TEST HARNESS"
  echo "  $harness_total invocation(s) of these skills came from non-interactive sessions"
  echo "  (transcript entrypoint \"sdk-cli\": \`claude -p\` and the SDK), so a script chose the"
  echo "  skill, not a person. This package's own routing probes and end-to-end tests run"
  echo "  exactly that way against these very skills."
  echo "  $harness_after_total of them landed after the forge that created the skill and"
  echo "  would otherwise have been counted as reuse in the table above."
  echo "  Where they ran: $harness_temp_total in a system temp directory, $harness_proj_total in a project directory."
  if [ "$harness_proj_total" -gt 0 ]; then
    echo "  A non-interactive run in a project directory may be your own automation rather"
    echo "  than this package's harness. It is excluded and shown here, never dropped."
  fi
  if [ -s "$TMP/harness.tsv" ]; then
    echo "  By skill:"
    sort -t"$(printf '\t')" -k2 -nr "$TMP/harness.tsv" 2>/dev/null \
      | awk -F'\t' '{ printf "    %-30s %s\n", substr($1, 1, 30), $2 }'
  fi
fi
if [ "$scratch_total" -gt 0 ]; then
  echo
  echo "$scratch_total counted invocation(s) ran in a system temp directory from an interactive"
  echo "session. Working in /tmp is not a probe, so they are in the headline; the location is"
  echo "flagged here and nowhere subtracted."
fi
if [ "$found_any" -eq 0 ]; then
  echo "WARNING: no transcripts found under $TRANSCRIPTS, so every count above is zero"
  echo "         for want of data, not for want of reuse."
fi

# ------------------------------------------------------------------ the funnel
#
# ONE ID, FOLLOWED ACROSS SIX STORES. Until this block existed nothing in this package
# could say which delivery produced which outcome: every figure spanning two artifact
# kinds was reconstructed by counting one store and dividing (issue #37). A count cannot
# answer that question at any precision, so the chain is joined instead.
#
# THE ID IS DERIVED, NEVER MINTED HERE. hooks/insight-capture.sh and hooks/precompact.sh
# both write a queue record under the same content digest; `skillinsight promote` stamps
# `c<first 8 of that digest>` onto the note and its reminder; hooks/remind.sh copies it
# onto every delivery; `skillforge start --from` carries it onto the start row, and the
# origin, apply and verdict rows read it back off that. So a lineage is one string and
# every store holds the same one.
#
# EVERY SELECTOR IS BY EVENT NAME. `.claude/CLAUDE.md`: "Add an event type freely; never
# widen a selector to a negation." The unattributed count below is the one place a
# negation would have been natural -- "anything not carrying an id" -- and it is still
# written as an explicit list of the five event names it covers, so a new event type is
# invisible to it until someone adds it here on purpose.
#
# WHAT "ACTED ON" MEANS, AND WHAT IT DOES NOT. EVERY note/start/use/apply/verdict row is
# attributed to AT MOST ONE lineage, by the first of four tests that holds: its own
# `from`, its own `candidate`, a `note` row whose own id IS a delivered lineage, or the
# lineage that was delivered FIRST to the session the row was written in. ACTED ON counts
# the note/start/use/apply rows so attributed; OUTCOME counts the verdict rows; a row that
# passes none of the four is UNATTRIBUTED. Those three are a partition of the ledger, and
# the block prints the arithmetic (`CHECK:`) rather than asserting it in prose.
#
# IT WAS NOT A PARTITION, TWICE OVER, AND BOTH HALVES WERE VISIBLE ON THE LIVE STORE.
# A row whose `from` named a lineage that appeared in no delivery log was excluded from
# UNATTRIBUTED for carrying an id and excluded from the table because the table listed
# only lineages a delivery log knew, so it was counted NOWHERE. And a row was counted for
# EVERY lineage delivered to its session, so ACTED ON summed to 104 against 69 DELIVERED
# and no reader could say what the column totalled. The first is fixed by listing every
# lineage any store names, with DELIVERED 0 where nothing delivered it; the second by
# attributing each row once.
#
# THE SESSION CLAUSE IS THE WEAK ONE, and it is why this block reports the two delivery
# logs' session ids rather than assuming them: a session that was reminded and then forged
# is evidence of a sequence, not of a cause. It is not called a cause anywhere in the
# output. Its tie-break is stated rather than hidden -- a session that received two
# lineages gives its rows to whichever was delivered there first, ties by id -- so that
# half of ACTED ON is a FLOOR for the other lineage, which the output says.
#
# ONE JQ PASS, AND EVERY LOOKUP IS AN OBJECT KEY. This was `$G[] as $g | [ $ROWS[] | ... ]`
# with `index` over arrays inside it, which is O(lineages x rows): at the writers own caps
# (2000 nudge rows, 5000 ledger rows) the whole report took 47.9 s on this machine, all of
# it here. It is now three `reduce`s into objects and one `group_by`, and the same case
# runs in a couple of seconds. tests/test_skillreport_harness.py::FunnelCostTest drives
# exactly those caps under a bound the old shape could not meet.
#
# TWO SESSION ID NAMESPACES, AND BOTH ARE JOINED. The hook payload's `.session_id` is
# what hooks/remind.sh and hooks/skill-use.sh stamp; $CLAUDE_CODE_SESSION_ID is what
# `skillnote`, `skillforge start` and `skillforge apply` record, and it is a DIFFERENT id
# (bin/skillforge's header measures this). hooks/compound-improvement.sh records both on
# every delivery, so a row keyed on either can be joined; a delivery that carries only one
# of them simply matches fewer rows, and nothing is matched to the wrong session.
: > "$TMP/f-hits" 2>/dev/null || true
: > "$TMP/f-nudges" 2>/dev/null || true
[ -f "$HITSLOG" ]  && cat "$HITSLOG"  > "$TMP/f-hits"   2>/dev/null
[ -f "$NUDGELOG" ] && cat "$NUDGELOG" > "$TMP/f-nudges" 2>/dev/null
: > "$TMP/f-ledger" 2>/dev/null || true
[ -f "$LEDGER" ] && cat "$LEDGER" > "$TMP/f-ledger" 2>/dev/null

# --rawfile, never --arg. A ledger or a delivery log can grow past MAX_ARG_STRLEN, which
# Linux caps at a hard 131072 bytes per argv element regardless of ARG_MAX, and the
# failure is the whole block emitting nothing (docs/DESIGN.md; hooks/apply-gate.sh shipped
# exactly that). A file path is bounded; the file behind it is not.
#
# Output is TSV, one line per lineage plus one `!` line carrying the unattributed count
# and the totals, so bash formats and jq only counts.
#
# THE SHAPE IS THREE `reduce`s AND ONE `group_by`, AND THAT IS A PERFORMANCE CONTRACT.
# Nothing below may index a growing ARRAY: `index` is a linear scan, and one of those
# inside a per-lineage loop is what made this 47.9 s at the writers own caps. Every lookup
# is an object key, which jq resolves in constant time.
jq -n -r --rawfile hits "$TMP/f-hits" --rawfile nudges "$TMP/f-nudges" \
        --rawfile ledger "$TMP/f-ledger" '
  def rows($s): $s | split("\n")[] | select(length > 0)
                   | (fromjson? // empty) | select(type == "object");
  def str($f): (($f // "") | tostring);
  # A `ts` a foreign writer left as a string, or absent, must not make `sort_by` compare
  # a string against a number and reorder the whole delivery list around it.
  def num($f): (($f // 0) | if type == "number" then . else 0 end);
  # EVERY FIELD IS READ OFF A BOUND ROW, NEVER OFF `.`. A jq function argument is
  # evaluated against the input of the function it was passed to, so `index(str(.session))`
  # reads `.session` from the ARRAY being indexed and raises "cannot index array with
  # string" -- behind a 2>/dev/null, that is a funnel that silently reports nothing at all.
  # bin/skillinsight carries a comment about the identical trap in `pending_tsv`; this is
  # the second time it has bitten in this package. Bind the row, then read from the binding.
  ( [ rows($hits) | . as $r
      | { id: (if (str($r.candidate) | length) > 0
               then str($r.candidate) else str($r.id) end),
          ts: num($r.ts),
          s: [ str($r.session) ] } ]
    + [ rows($nudges) | . as $r
      | { id: str($r.id), ts: num($r.ts),
          s: [ str($r.session), str($r.cc_session) ] } ]
    | map(select((.id | length) > 0))
    | map(.s |= (map(select(length > 0)) | unique)) ) as $D
  # HOW MANY DELIVERIES EACH LINEAGE GOT. Also the set of lineages a delivery log knows,
  # which is what the note-id clause below tests against.
  | ( reduce ($D[] | .id) as $i ({}; .[$i] = ((.[$i] // 0) + 1)) ) as $DELIV
  # SESSION -> THE LINEAGE DELIVERED THERE FIRST. Sorted by [ts, id] and taken first-wins,
  # so a session that received two lineages resolves to ONE of them deterministically and
  # a row cannot be counted twice. The tie-break is by id and is printed in the block.
  | ( [ $D[] | . as $d | $d.s[] | {s: ., id: $d.id, ts: $d.ts} ]
      | sort_by([.ts, .id])
      | reduce .[] as $x ({}; if has($x.s) then . else .[$x.s] = $x.id end) ) as $SESS
  # EVERY SELECTOR IS BY EVENT NAME, here and nowhere else in this block.
  | [ rows($ledger)
      | select(.event == "note" or .event == "start" or .event == "use"
               or .event == "apply" or .event == "verdict") ] as $ROWS
  # ONE LINEAGE PER ROW, OR NONE. The four clauses in order; `lin == ""` is unattributed.
  | [ $ROWS[] | . as $r
      | { ev: str($r.event),
          lin: ( if (str($r.from) | length) > 0 then str($r.from)
                 elif (str($r.candidate) | length) > 0 then str($r.candidate)
                 elif (str($r.event) == "note")
                      and ($DELIV[str($r.id)] != null) then str($r.id)
                 else ($SESS[str($r.session)] // "") end ) } ] as $A
  | ( [ $A[] | select(.lin == "") ] | length ) as $un
  | ( [ $A[] | select(.lin != "") ]
      | group_by(.lin)
      | map({ id: .[0].lin,
              acted: ([ .[] | select(.ev != "verdict") ] | length),
              out:   ([ .[] | select(.ev == "verdict") ] | length) })
      | reduce .[] as $g ({}; .[$g.id] = $g) ) as $ACT
  # THE TABLE IS THE UNION, which is the whole of the first repair: a lineage named only
  # by a ledger row is listed with DELIVERED 0 rather than counted nowhere.
  | ( ( ($DELIV | keys_unsorted) + ($ACT | keys_unsorted) ) | unique ) as $ALLIDS
  | ( [ $ALLIDS[] | . as $i
        | { id: $i, n: ($DELIV[$i] // 0),
            acted: (($ACT[$i] | .acted) // 0), out: (($ACT[$i] | .out) // 0) } ]
      | sort_by([ -.n, -(.acted + .out), .id ]) ) as $T
  | ( [ $T[] | .acted + .out ] | add // 0 ) as $intable
  | ( [ $T[] | [ .id, (.n|tostring), (.acted|tostring), (.out|tostring) ] | @tsv ]
      + [ (["!", ($un|tostring), ($ROWS|length|tostring), ($D|length|tostring),
            ($DELIV|length|tostring), ($intable|tostring), ($T|length|tostring)]
           | @tsv) ] )[]
' > "$TMP/funnel" 2>/dev/null || : > "$TMP/funnel"

f_un=0; f_all=0; f_deliv=0; f_lineages=0; f_intable=0; f_rows=0
while IFS="$(printf '\t')" read -r c1 c2 c3 c4 c5 c6 c7; do
  [ "$c1" = "!" ] || continue
  f_un="$c2"; f_all="$c3"; f_deliv="$c4"; f_lineages="$c5"; f_intable="$c6"; f_rows="$c7"
done < "$TMP/funnel"
for v in f_un f_all f_deliv f_lineages f_intable f_rows; do
  eval "n=\$$v"
  case "${n:-}" in ''|*[!0-9]*) eval "$v=0" ;; esac
done

# HOW MANY LINEAGES GET A LINE OF THEIR OWN. A store at the writers caps can name
# thousands, and a report nobody reads to the end reports nothing. The rest are FOLDED,
# never dropped: the remainder line carries their three counts, so `CHECK` below still
# covers every row in the ledger.
FUNNEL_SHOW=25

echo
echo "FUNNEL (counted joins on the lineage id — no estimate anywhere in this block)"
if [ "$f_deliv" -eq 0 ] && [ "$f_rows" -eq 0 ]; then
  echo "  no deliveries logged yet, in either $HITSLOG"
  echo "  or $NUDGELOG, and no ledger row names a lineage, so"
  echo "  there is nothing to join."
  echo "  That is an absence of data, not an absence of compounding."
elif [ "$f_deliv" -eq 0 ]; then
  echo "  no deliveries logged yet, in either $HITSLOG"
  echo "  or $NUDGELOG. The $f_rows lineage(s) below are the ones"
  echo "  ledger rows name, and every one of them is DELIVERED 0."
  echo "  That is an absence of data, not an absence of compounding."
else
  echo "  $f_deliv logged delivery(ies) across $f_lineages delivered lineage(s);"
  echo "  $f_rows lineage(s) below, delivered or named by a ledger row."
fi
if [ "$f_rows" -gt 0 ]; then
  printf '  %-18s %9s %9s %9s\n' "LINEAGE" "DELIVERED" "ACTED ON" "OUTCOME"
  f_shown=0; f_hidden=0; h_d=0; h_a=0; h_o=0
  while IFS="$(printf '\t')" read -r c1 c2 c3 c4 c5 c6 c7; do
    [ -n "${c1:-}" ] || continue
    [ "$c1" = "!" ] && continue
    if [ "$f_shown" -lt "$FUNNEL_SHOW" ]; then
      printf '  %-18s %9s %9s %9s\n' "$c1" "$c2" "$c3" "$c4"
      f_shown=$(( f_shown + 1 ))
    else
      f_hidden=$(( f_hidden + 1 ))
      h_d=$(( h_d + c2 )); h_a=$(( h_a + c3 )); h_o=$(( h_o + c4 ))
    fi
  done < "$TMP/funnel"
  if [ "$f_hidden" -gt 0 ]; then
    printf '  %-18s %9s %9s %9s\n' "(+$f_hidden more)" "$h_d" "$h_a" "$h_o"
    echo "  The last line folds every lineage past the first $FUNNEL_SHOW, counts included, so"
    echo "  nothing below is computed over a subset."
  fi
  echo "  DELIVERED counts rows in the two delivery logs. ACTED ON and OUTCOME PARTITION the"
  echo "  ledger: every note/start/use/apply/verdict row is attributed to AT MOST ONE lineage,"
  echo "  by the first of these that holds — its own \`from\`, its own \`candidate\`, a note row"
  echo "  whose own id is a delivered lineage, or the lineage delivered FIRST to the session it"
  echo "  was written in (ties by id). ACTED ON counts the note/start/use/apply rows so"
  echo "  attributed; OUTCOME counts the verdict rows. A row attributed by its session alone is"
  echo "  a sequence and never a cause, and a session that received two lineages gives its rows"
  echo "  to one of them, so that half of ACTED ON is a floor rather than a total."
fi
f_sum=$(( f_intable + f_un ))
if [ "$f_sum" -eq "$f_all" ]; then
  echo "  CHECK: $f_intable row(s) in the table + $f_un unattributed = $f_all note/start/use/apply/verdict row(s)."
else
  echo "  CHECK FAILED: $f_intable in the table + $f_un unattributed = $f_sum, but the ledger"
  echo "  holds $f_all note/start/use/apply/verdict row(s). That is a defect in this block,"
  echo "  not in the ledger: some row was counted twice or not at all."
fi
echo "  UNATTRIBUTED: $f_un ledger row(s) carry no lineage id and sit in no session that"
echo "  received a delivery, out of $f_all note/start/use/apply/verdict row(s) in all."
echo "  They are reported here and nowhere dropped, guessed at, or folded into a rate —"
echo "  the same way a forge with no --trigger is recorded as trigger_kind:\"unrecorded\"."

# ---------------------------------------------- reminder-to-forge conversion
#
# COUNTED, NOT RECONSTRUCTED. This block divided each session's `.edits` tally by
# CI_EDIT_EVERY, guessed how many checkpoints that session must have hit, compared the
# guess to the all-time count of `start` rows, and printed a paragraph explaining that the
# numerator and the denominator covered different windows. The hook logs every delivery
# now (`<state>/reminders/nudges.jsonl`), so the numerator and the denominator are rows.
#
# THE JOIN IS ON THE SESSION AND THE ORDER. A nudge delivered in session S counts toward
# the conversion when a `start` row exists in S at or after that delivery's timestamp. A
# forge that started BEFORE the nudge is not a conversion of it, and the ordering is what
# keeps this from becoming the same all-time-over-a-window comparison in new words.
# `start` rows are matched on BOTH session id namespaces, for the reason the funnel above
# gives.
#
# THE EDIT COUNTERS ARE STILL REPORTED, BELOW THE LINE, AND ARE NOT FOLDED IN. They are
# the deliveries made before the log existed. A checkpoint they imply is a checkpoint
# nothing can join to anything, which is exactly what the estimate was; stating them as
# unjoinable is the honest form of the number the old block printed as a rate.
#
# THE COUNTER IS A UNARY TALLY, NOT A DECIMAL NUMBER. `hooks/compound-improvement.sh`
# appends ONE BYTE per counted edit (`printf 'x' >> "$STATE_DIR/$sid.edits"`), so the
# count is the FILE SIZE. It writes that way on purpose: an O_APPEND write of one byte
# is atomic, and the read-modify-write it replaced lost events under the double hook
# delivery and the parallel-agent bursts this package runs in -- measured there at 12 of
# 60. The reader here required digits, which is a shape the hook has never written, so
# EVERY counter on every real disk was skipped and this block printed "not computable"
# for its whole life while the state directory was full of counters. The two sides are
# one format with two halves; change neither alone.
#
# `wc -c` prints a leading-space-padded count on BSD, and reading that as a number has
# already zeroed one cap in this package, so the digits are extracted rather than
# trusted. A file holding any byte other than the tally byte was not written by the
# hook: it is skipped, which is also what keeps the "not computable" branch reachable.
checkpoints=0
sessions=0
if [ -d "$REMINDERS" ]; then
  find "$REMINDERS" -maxdepth 1 -type f -name '*.edits' 2>/dev/null > "$TMP/counters"
  while IFS= read -r c; do
    [ -f "$c" ] || continue
    [ -z "$(tr -d 'x' < "$c" 2>/dev/null)" ] || continue
    n="$(tr -cd 'x' < "$c" 2>/dev/null | wc -c | tr -cd '0-9')"
    case "${n:-}" in ''|*[!0-9]*) continue ;; esac
    [ "$n" -gt 0 ] || continue
    sessions=$(( sessions + 1 ))
    checkpoints=$(( checkpoints + n / EDIT_EVERY ))
  done < "$TMP/counters"
fi
# COUNTED BY SELECTOR, because every other reader in this file is -- not because the
# substring it replaced was observed failing. A reviewer flagged the old line,
# `grep -c '"event":"start"' "$LEDGER"`, as newly unsafe now that `apply` rows carry
# free-text `evidence`: a session quoting a ledger line into its own evidence would be
# counted as a forge that never happened. THAT DOES NOT REPRODUCE, and the reason is worth
# keeping so nobody re-reports it. A string value is JSON-encoded, so an evidence quote
# containing `"event":"start"` is written to disk as `\"event\":\"start\"` -- the byte
# after `event` is a backslash, not a quote, and the grep pattern cannot match. Measured on
# a ledger holding exactly that evidence, plus a malformed line and a foreign array: both
# the old grep and the selector below answered 2.
#
# The change stands anyway, for the reason .claude/CLAUDE.md gives: "every reader selects
# its events BY NAME". A rule with one exception in it is a rule nobody can apply. The
# selector is also immune to a hand-edited or foreign line that is not JSON-encoded at all,
# which the grep is not.
#
# `-R -n` with `inputs` reads the file a RAW LINE AT A TIME, and `fromjson? // empty` drops
# a line that does not parse. `jq -s` would have been shorter and is wrong here: it aborts
# on the first malformed line and takes the whole count with it, and this ledger is
# append-only, hand-editable, and deliberately exercised with malformed and foreign lines.
# jq returns a bare integer, so nothing here parses `wc -l` output -- which on BSD is padded
# with a leading space and has already zeroed one cap in this package.
starts="$(jq -R -n '[inputs | fromjson? // empty
                    | select(type == "object" and .event == "start")] | length' \
            < "$LEDGER" 2>/dev/null || echo 0)"
case "${starts:-}" in ''|*[!0-9]*) starts=0 ;; esac

# nudged sessions, and how many of them went on to start a forge.
conv="$(jq -n -r --rawfile nudges "$TMP/f-nudges" --rawfile ledger "$TMP/f-ledger" '
  def rows($s): $s | split("\n")[] | select(length > 0)
                   | (fromjson? // empty) | select(type == "object");
  def str($f): (($f // "") | tostring);
  # ONE DELIVERY IS ONE SESSION, recorded under two names. Keyed on the payload session id
  # -- the one hooks/skill-use.sh and hooks/remind.sh also stamp -- and falling back to
  # $CLAUDE_CODE_SESSION_ID only where the payload carried none, so a row carrying both
  # cannot inflate the denominator to two.
  [ rows($nudges) | . as $r
    | { key: (if (str($r.session) | length) > 0 then str($r.session)
              else str($r.cc_session) end),
        ids: ([ str($r.session), str($r.cc_session) ] | map(select(length > 0))),
        ts: (($r.ts // 0) | if type == "number" then . else 0 end) }
    | select((.key | length) > 0) ] as $N
  | [ rows($ledger) | . as $r | select($r.event == "start")
      | { s: str($r.session),
          ts: (($r.ts // 0) | if type == "number" then . else 0 end) }
      | select((.s | length) > 0) ] as $S
  | ($N | group_by(.key)
        | map({ ids: (map(.ids) | add | unique), first: (map(.ts) | min) })) as $SESS
  | ( [ $SESS[] | . as $g
        | select( [ $S[] | . as $st
                    | select(($g.ids | index($st.s)) != null)
                    | select($st.ts >= $g.first) ] | length > 0 ) ] | length ) as $CONV
  | [ ($N | length), ($SESS | length), $CONV ] | @tsv
' 2>/dev/null)"
n_deliv=0; n_sess=0; n_conv=0
if [ -n "${conv:-}" ]; then
  n_deliv="$(printf '%s' "$conv" | cut -f1)"
  n_sess="$(printf '%s' "$conv" | cut -f2)"
  n_conv="$(printf '%s' "$conv" | cut -f3)"
fi
for v in n_deliv n_sess n_conv; do
  eval "n=\$$v"
  case "${n:-}" in ''|*[!0-9]*) eval "$v=0" ;; esac
done

echo
echo "REMINDER CONVERSION (counted rows: logged deliveries joined to later forges)"
echo "  nudge deliveries logged:    $n_deliv in $n_sess session(s)"
echo "  of those sessions, forged:  $n_conv"
if [ "$n_sess" -gt 0 ]; then
  echo "  conversion:                 $(( n_conv * 100 / n_sess ))% of nudged sessions started a forge afterwards"
else
  echo "  conversion:                 not computable, no nudge delivery has been logged yet"
fi
echo "  forges started, all time:   $starts"
echo "  Counted, not estimated: the first three lines are rows in $NUDGELOG"
echo "  joined to start rows in the same session at or after the delivery. A start that"
echo "  came first is not a conversion of a nudge that came second, and is not counted."
echo "  UNLOGGED, from before the hook wrote a delivery down:"
echo "  edit counters on disk:      $sessions session(s)"
if [ "$checkpoints" -gt 0 ]; then
  echo "  checkpoints they imply:     $checkpoints (assuming CI_EDIT_EVERY=$EDIT_EVERY)"
else
  echo "  checkpoints they imply:     0 (assuming CI_EDIT_EVERY=$EDIT_EVERY) — no checkpoints implied yet"
fi
echo "  A checkpoint those counters imply is one nothing can be joined to: the counter"
echo "  records that a nudge fired, never which session acted on it. They are reported"
echo "  here and are not folded into the conversion above."

print_gates
exit

# Closes the brace group opened just under `set -uo pipefail`. See the note there.
}
