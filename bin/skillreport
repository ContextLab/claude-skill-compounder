#!/usr/bin/env bash
# skillreport: did any of this actually pay off?
#
#   skillreport [--help]
#
# Joins the forge ledger written by 'skillforge' against skill invocations recovered
# from Claude Code transcripts, and prints one table plus the number that matters: the
# fraction of forged skills that were invoked at least once AFTER the session that
# forged them. Reuse before or during the forge is not reuse.
#
# PRIVACY. This script reads three files, all already on your disk, and writes nothing
# except its own output to the terminal:
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/ledger.jsonl
#       one JSON line per forge: skill name, your one-line summary, the originating
#       repository path, epoch timestamps, step counts, outcome and reason.
#   ${SKILL_COMPOUNDER_TRANSCRIPTS:-$HOME/.claude/projects}/*/*.jsonl
#       your Claude Code transcripts. Only five fields are read out of them: the
#       invoked skill name, the record timestamp, the working directory, and the
#       tool-use id and error flag that say whether the invocation ran. Prompts,
#       responses, file contents and tool output are never parsed or printed.
#   ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}/reminders/*.edits
#       per-session edit counters written by the reminder hook (an integer each).
# There are no network calls anywhere in this script. Nothing leaves the machine.
# Nothing is uploaded, and no summary is sent anywhere.
set -uo pipefail

STATE_ROOT="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}"
LEDGER="$STATE_ROOT/ledger.jsonl"
REMINDERS="$STATE_ROOT/reminders"
TRANSCRIPTS="${SKILL_COMPOUNDER_TRANSCRIPTS:-$HOME/.claude/projects}"
EDIT_EVERY="${CI_EDIT_EVERY:-12}"
# It reaches integer arithmetic twice. Unguarded, `CI_EDIT_EVERY=abc` aborted the whole
# script mid-report under `set -u` ("abc: unbound variable") and `=0` divided by zero;
# either way the reminder section reported the wrong reason or never printed at all.
case "$EDIT_EVERY" in ''|*[!0-9]*|???????*) EDIT_EVERY=12 ;; esac
[ "$EDIT_EVERY" -lt 1 ] && EDIT_EVERY=12

case "${1:-}" in
  -h|--help|help)
    sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "") : ;;
  *) echo "skillreport: unknown option '$1' (try: skillreport --help)" >&2; exit 2 ;;
esac

command -v jq >/dev/null 2>&1 || { echo "skillreport: jq is required" >&2; exit 1; }

TMP="$(mktemp -d "${TMPDIR:-/tmp}/skillreport.XXXXXX")" || { echo "skillreport: cannot create a temp dir" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT INT TERM

# --------------------------------------------------------------------- the ledger

if [ ! -s "$LEDGER" ]; then
  echo "no forges recorded yet ($LEDGER)"
  echo "Nothing to measure. Run a forge with the skill-compounder skill first."
  exit 0
fi

# One row per start, joined to the first done/fail for the same name that follows it.
# 'since' is the moment the forge FINISHED. A forge with no done and no fail has no
# finish time, so it gets closed=no and is excluded from the reuse fraction entirely.
# The start timestamp must never stand in for a finish: doing that lets an invocation
# made *during* an unfinished forge be counted as reuse, which turns the one number
# this report exists to produce into a flattering lie.
#
# AN OUTCOME WITH NO START IS ALSO A ROW. Walking start records only meant an outcome
# that nothing joined to was discarded in silence -- and the reason a `done` has no
# `start` is that the process was killed between claiming its slot and appending its
# start row, so silent discarding removed exactly the forges most worth counting. This
# script exists to say whether forged skills get reused; under-reporting the crashed
# ones is the failure mode it can least afford. Such a row is marked, and its forge
# window is reconstructed from the recorded duration, which is real data and not a
# guess: 'since' is still the recorded finish, so nothing during the window counts.
#
# ONE OUTCOME PER START, for the same reason. Matching by name alone let one `done` be
# consumed by two starts of the same name, so an abandoned forge was counted as
# finished and the denominator of the reuse fraction grew by one.
jq -s -R -r '
  def rounds_of(s): ((((s // 2) - 2) / 2) | floor) as $r | (if $r < 0 then 0 else $r end);
  [ split("\n")[] | select(length > 0) | (fromjson? // empty) ] as $rec
  | [ range(0; ($rec | length)) | select($rec[.].event == "start") ] as $starts
  | [ range(0; ($rec | length))
      | select($rec[.].event == "done" or $rec[.].event == "fail") ] as $ends
  | (reduce $starts[] as $i ({used: [], pairs: []};
       . as $acc
       | ([ $ends[] | select(. > $i and $rec[.].name == $rec[$i].name) ]
          - $acc.used | .[0]) as $e
       | { used:  (if $e == null then $acc.used else ($acc.used + [$e]) end),
           pairs: ($acc.pairs + [[$i, $e]]) })) as $join
  | ($ends - $join.used) as $orphans
  | ( ($join.pairs | map(.[0] as $i | .[1] as $ei | $rec[$i] as $st
        | (if $ei == null then null else $rec[$ei] end) as $en
        | [ $st.name,
            ($st.ts // 0),
            (if $en == null then ($st.ts // 0) else ($en.ts // $st.ts // 0) end),
            (if $en == null then "no outcome" else $en.event end),
            (if $en == null then rounds_of($st.steps)
             else ($en.rounds // rounds_of($st.steps)) end),
            (if $en == null then "no" else "yes" end),
            (if $en == null then "" else ($en.rounds_planned // "" | tostring) end),
            "no" ]))
      + ($orphans | map(. as $j | $rec[$j] as $en
        | [ (if ($en.name // "") == "" then "(unnamed)" else $en.name end),
            (($en.ts // 0) - ($en.duration // 0)),
            ($en.ts // 0),
            $en.event,
            ($en.rounds // 0),
            "yes",
            ($en.rounds_planned // "" | tostring),
            "yes" ])) )
  | sort_by(.[1])
  | .[] | @tsv
' "$LEDGER" > "$TMP/forges.tsv" 2>/dev/null

if [ ! -s "$TMP/forges.tsv" ]; then
  echo "no forges recorded yet ($LEDGER has no 'start' records)"
  exit 0
fi

# ---------------------------------------------------------------- the transcripts

# Skill invocations are recorded as assistant tool_use blocks. The grep prefilter is
# the verified recipe from issue #6: transcripts are written as compact JSON, so the
# key order '"name":"Skill","input":{"skill":' is stable. jq then re-checks the shape,
# so a line that matches the substring for some other reason is discarded.
#
# Per-invocation timestamps are real, not inferred: every transcript record carries an
# ISO-8601 '.timestamp'. Fractional seconds are trimmed because jq's fromdateiso8601
# does not accept them. A record whose timestamp cannot be parsed emits -1 and is
# counted separately rather than being folded into either bucket. File mtime is never
# substituted for a record timestamp.
: > "$TMP/inv.tsv"
# The file list is built first rather than iterated inside a pipeline: bash runs every
# stage of a pipeline in a subshell, so a counter incremented in the loop would be lost.
# find rather than a glob, because zsh treats a glob that matches nothing as a fatal
# error and this script has to survive being run under either shell.
find "$TRANSCRIPTS" -maxdepth 2 -type f -name '*.jsonl' 2>/dev/null > "$TMP/files"
found_any=0
[ -s "$TMP/files" ] && found_any=1

# AN ATTEMPT IS NOT A USE (issue #9). Every tool_use has an id, and its result comes
# back in a later user record as a tool_result with the matching .tool_use_id; a failed
# invocation carries "is_error":true there (verified shape: {"type":"tool_result",
# "content":"<tool_use_error>Unknown skill: ...</tool_use_error>","is_error":true,
# "tool_use_id":"toolu_..."}). Counting the tool_use alone counted those failures as
# reuse: one uninstalled skill moved the headline from 80% to 100%. So the failed ids
# are collected first, and the invocation pass below drops any tool_use whose id is in
# the set. A successful result has no is_error key at all, so absence from the set is
# the success condition. The grep prefilter is compact-JSON stable the same way the
# Skill one is, and jq re-checks the shape so a prose line mentioning the substring is
# discarded. Emitted without -r: each id is a quoted JSON string, which is what
# --slurpfile needs, and an empty file slurps to [] rather than an error.
: > "$TMP/errids"
while IFS= read -r f; do
  grep -h '"is_error":true' "$f" 2>/dev/null
done < "$TMP/files" | jq -R '
  (fromjson? // empty) as $rec
  | ($rec.message.content // [])
  | (if type == "array" then .[] else empty end)
  | select((.type? == "tool_result") and (.is_error? == true))
  | (.tool_use_id? // empty) | select(type == "string" and length > 0)
' >> "$TMP/errids" 2>/dev/null

# A tool_use with NO tool_result anywhere IS counted. The usual reason a result is
# missing is that the session is still live or was cut off mid-turn, not that the
# invocation failed -- a failure writes its error result on the very next record.
# Refusing to count those would under-report exactly the freshest usage. The join is
# by id, and ids are unique tokens, so matching against the pooled set is the same
# join as matching within one file -- a resumed session copies its records verbatim,
# ids included, so the same id can only ever map to the same outcome.
while IFS= read -r f; do
  grep -h '"name":"Skill"' "$f" 2>/dev/null
done < "$TMP/files" | jq -R -r --slurpfile bad "$TMP/errids" '
  (fromjson? // empty) as $rec
  | ($rec.timestamp // "") as $iso
  | (($iso | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601?) // -1) as $ts
  | ($rec.cwd // "unknown") as $cwd
  | ($rec.message.content // [])
  | (if type == "array" then .[] else empty end)
  | select((.type? == "tool_use") and (.name? == "Skill"))
  | (.id? // "") as $tid
  | select(($bad | index($tid)) == null)
  | [ (.input.skill // "unknown"), $ts, $cwd ] | @tsv
' >> "$TMP/inv.tsv" 2>/dev/null

# --------------------------------------------------------------------- the table

printf '%-30s %-12s %7s %-12s %12s %9s\n' \
  "SKILL" "FORGED" "ROUNDS" "OUTCOME" "USES SINCE" "PROJECTS"
printf '%-30s %-12s %7s %-12s %12s %9s\n' \
  "------------------------------" "------------" "-------" "------------" "------------" "---------"

total=0
reused=0
unclosed=0
during_total=0
unparsed_total=0
orphans=0
overruns=0

# ROUNDS is printed as "completed/planned" when a forge ran past its budget. The budget
# has been in the ledger since the overrun was made representable and nothing printed
# it, so six rounds against a three-round budget read as a plain "6" -- identical to a
# forge that spent exactly what it planned.
# Deliberately does not touch a counter: it is called in a command substitution, which
# is a subshell, so an increment here would be discarded. The caller counts.
rounds_col() { # <completed> <planned>
  case "${2:-}" in ''|*[!0-9]*) printf '%s' "$1"; return ;; esac
  if [ "$1" -gt "$2" ]; then printf '%s/%s' "$1" "$2"
  else printf '%s' "$1"; fi
}
is_over() { # <completed> <planned>
  case "${2:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt "$2" ]
}

while IFS="$(printf '\t')" read -r name start_ts since_ts outcome rounds closed planned orphan; do
  [ -n "${name:-}" ] || continue
  is_over "$rounds" "${planned:-}" && overruns=$(( overruns + 1 ))
  rounds="$(rounds_col "$rounds" "${planned:-}")"
  # An outcome with no start is shown from the outcome alone, and says so.
  if [ "${orphan:-no}" = "yes" ]; then
    orphans=$(( orphans + 1 ))
    outcome="$outcome*"
  fi

  # No finish time means no window to measure against. Print the row so the forge is
  # visible, but show a dash rather than a count, and keep it out of both halves of
  # the reuse fraction.
  if [ "${closed:-yes}" != "yes" ]; then
    unclosed=$(( unclosed + 1 ))
    printf '%-30s %-12s %7s %-12s %12s %9s\n' \
      "$(printf '%.30s' "$name")" \
      "$(jq -n -r --argjson t "$start_ts" '$t | gmtime | strftime("%Y-%m-%d")' 2>/dev/null || echo "?")" \
      "$rounds" "$outcome" "-" "-"
    continue
  fi

  total=$(( total + 1 ))
  # The name goes through the environment, not through 'awk -v'. awk processes escape
  # sequences in a -v value, while jq's @tsv writes them: a name holding a real tab
  # arrives here as the two characters \t, -v would turn it back into a tab, and the
  # comparison against the identically-escaped $1 would silently never match. ENVIRON
  # is not unescaped, so both sides stay in the same representation.
  counts="$(SR_NAME="$name" awk -F'\t' -v since="$since_ts" -v start="$start_ts" '
    BEGIN { n = ENVIRON["SR_NAME"] }
    {
      bare = $1
      sub(/^[^:]*:/, "", bare)          # accept both "name" and "plugin:name"
      if ($1 != n && bare != n) next
      if ($2 + 0 < 0) { unparsed++; next }
      if ($2 + 0 > since + 0) {
        after++
        if (!seen[$3]++) projects++
      } else if ($2 + 0 >= start + 0) {
        during++
      }
    }
    END { printf "%d %d %d %d", after + 0, projects + 0, during + 0, unparsed + 0 }
  ' "$TMP/inv.tsv")"
  # Read the four numbers back with a heredoc rather than 'set -- $counts': zsh does
  # not word-split an unquoted expansion, so the positional-parameter trick silently
  # yields one field there and four under bash.
  after=0; projects=0; during=0; unparsed=0
  IFS=' ' read -r after projects during unparsed <<COUNTS
$counts
COUNTS
  during_total=$(( during_total + during ))
  unparsed_total=$(( unparsed_total + unparsed ))
  [ "$after" -gt 0 ] && reused=$(( reused + 1 ))
  printf '%-30s %-12s %7s %-12s %12s %9s\n' \
    "$(printf '%.30s' "$name")" \
    "$(jq -n -r --argjson t "$since_ts" '$t | gmtime | strftime("%Y-%m-%d")' 2>/dev/null || echo "?")" \
    "$rounds" "$outcome" "$after" "$projects"
done < "$TMP/forges.tsv"

# --------------------------------------------------------------- the headline

echo
if [ "$orphans" -gt 0 ]; then
  echo "* $orphans outcome record(s) have no matching start record. Only the outcome"
  echo "  survives, so the FORGED date is reconstructed from the recorded duration. A"
  echo "  start row is missing when \`start\` was killed between claiming its slot and"
  echo "  appending its row, or when the ledger was truncated after a forge had begun."
fi
if [ "$overruns" -gt 0 ]; then
  echo "ROUNDS reads completed/planned for the $overruns forge(s) that ran past their budget."
fi
if [ "$orphans" -gt 0 ] || [ "$overruns" -gt 0 ]; then echo; fi
if [ "$total" -eq 0 ]; then
  echo "REUSE: not measurable. No forge in the ledger has a recorded finish, so there is"
  echo "       no window to count invocations against."
else
  pct=$(( reused * 100 / total ))
  echo "REUSE: $reused of $total finished forges ($pct%) produced a skill that was invoked"
  echo "       at least once after the forge that created it finished."
fi
if [ "$unclosed" -gt 0 ]; then
  echo "       $unclosed forge(s) never closed out and are excluded from both halves of that"
  echo "       fraction. They have no finish time, so nothing can be counted as after it."
fi

echo
echo "$during_total invocation(s) fell inside a forge window and were not counted as reuse."
if [ "$unparsed_total" -gt 0 ]; then
  echo "$unparsed_total invocation(s) had no parseable timestamp and were not counted at all."
fi
if [ "$found_any" -eq 0 ]; then
  echo "WARNING: no transcripts found under $TRANSCRIPTS, so every count above is zero"
  echo "         for want of data, not for want of reuse."
fi

# ---------------------------------------------- reminder-to-forge conversion

# The reminder hook does not log when it fires, only the running edit count per
# session. Checkpoints are therefore reconstructed: a session with N edits must have
# hit floor(N / CI_EDIT_EVERY) checkpoints. This is an estimate, and it is a loose one:
# the hook prunes counters older than 7 days, so the denominator is a rolling window
# while the ledger numerator is the whole history.
checkpoints=0
sessions=0
if [ -d "$REMINDERS" ]; then
  find "$REMINDERS" -maxdepth 1 -type f -name '*.edits' 2>/dev/null > "$TMP/counters"
  while IFS= read -r c; do
    [ -f "$c" ] || continue
    n="$(cat "$c" 2>/dev/null)"
    case "${n:-}" in ''|*[!0-9]*) continue ;; esac
    sessions=$(( sessions + 1 ))
    checkpoints=$(( checkpoints + n / EDIT_EVERY ))
  done < "$TMP/counters"
fi
starts="$(grep -c '"event":"start"' "$LEDGER" 2>/dev/null || echo 0)"
case "${starts:-}" in ''|*[!0-9]*) starts=0 ;; esac

echo
echo "REMINDER CONVERSION (estimate, see the comment in this script)"
echo "  edit counters on disk:      $sessions session(s)"
echo "  checkpoints they imply:     $checkpoints (assuming CI_EDIT_EVERY=$EDIT_EVERY)"
echo "  forges started, all time:   $starts"
if [ "$checkpoints" -gt 0 ]; then
  echo "  rough conversion:           $(( starts * 100 / checkpoints ))%"
else
  echo "  rough conversion:           not computable, no checkpoints implied yet"
fi
echo "  The numerator covers all time and the denominator only the last 7 days, so read"
echo "  the conversion as a loose upper bound rather than a rate."
