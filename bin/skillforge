#!/usr/bin/env bash
# skillforge — drives the live terminal animation shown while a skill is being forged.
#
# The session calls this at each transition of the builder/red-team loop; the status
# line renders the animation from the state it writes (see statusline/).
#
#   skillforge start <name> <total-steps> <one-line summary...> [--skill-dir <dir>]
#                    --trigger "<verbatim text that set this off>"
#                    --trigger-kind <user-prompt|hook-checkpoint|review-dispatch|agent-decision>
#   skillforge step  [--name <forge>] <step-number> <what is happening now...>
#   skillforge round --name <forge> --blocking <k> --total <m>
#                    [--subsystems "<what the blocking findings named>"]
#                    [--shapes "<the finding shapes>"]
#   skillforge escalate --name <forge> --converging | --narrowed "<what was cut>"
#   skillforge done  [--name <forge>] [--skill-dir <dir>] [message...]
#   skillforge fail  [--name <forge>] <reason...>
#   skillforge reap  [--name <forge>]
#   skillforge clear [--name <forge> | --all]
#   skillforge show  [--name <forge> | --all] [--full]
#   skillforge list
#   skillforge ledger [--json] [--full]
#   skillforge install <name> [--skill-dir <dir>]
#   skillforge origin  --name <skill> --origin <forged|workflow|seeded|adopted|unknown>
#                      [--skill-dir <dir>] [--trigger <text> --trigger-kind <kind>]
#   skillforge use     --name <skill> [--ok|--failed] [--session <id>] [--cwd <dir>]
#                      [--entrypoint <cli|sdk-cli|...>] [--harness|--genuine]
#                      [--tool-use-id <id>] [--recorded live|derived]
#   skillforge verdict --name <skill> --verdict <WORKED|NO-OP|MISFIRED|UNKNOWN>
#                      --evidence "<verbatim quote>" [--use-ts <epoch>]
#                      [--use-session <id>] [--judged-by <who>]
#   skillforge apply   --name <skill> --outcome <used|declined|failed>
#                      --evidence "<verbatim quote>" [--forge <forge>] [--session <id>]
#                      [--force]
#   skillforge pending [--json] [--full]
#   skillforge backfill <file.jsonl | ->
#   skillforge horizon
#   skillforge doctor
#
# THE LEDGER ANSWERS FIVE QUESTIONS: what triggered the build, what was built, WHETHER
# THE SKILL WAS THEN PUT ON THE PROBLEM THAT CAUSED IT, when it has been used since, and
# whether it worked. `--trigger` is the first of those and it is the one nothing else can
# recover later, so `start` warns loudly without it and records `trigger_kind:"unrecorded"`
# rather than leaving a silent gap. Set SKILLFORGE_REQUIRE_TRIGGER=1 to make a missing
# trigger a refusal instead.
#
# THE THIRD QUESTION IS THE ONE THIS FILE ANSWERED LAST, AND IT IS THE ONE THE WHOLE
# PROTOCOL IS FOR. Skills here are built AS NEEDED, out of a problem that was in front of
# somebody; a forge that ends at "installed" has produced a tool and left the problem
# where it was. `done` therefore writes a PENDING-APPLY MARKER -- one small JSON file per
# closed forge, under apply-pending/ -- and `apply` is what discharges it, with the
# verbatim evidence that the skill was actually put on that problem. A marker nobody
# discharges is the visible form of a loop that never closed: `skillforge pending` lists
# them oldest first, and the status line shows them.
#
# WHY `done` COULD NOT SIMPLY BE RENAMED, OR MADE TO MEAN "APPLIED". `done` closes the
# FORGE. Applying happens afterwards, in a different command, usually minutes later and
# sometimes in a different session -- and it can come back `declined` (the skill was read
# and judged not to fit) or `failed` (it fired and did not help), both of which are true
# outcomes of a forge that closed perfectly well. Folding the two together would also move
# the ledger join: `start` is matched to the first `done` or `fail` that follows it, and
# every reader of this file selects those events BY NAME. `apply` is a NEW event name, so
# the join cannot see it and no existing count changes -- the rule stated under "ledger v2
# rows" below, applied to itself.
#
# `origin`, `use` and `verdict` rows are written by `done`, by the installer, by
# hooks/skill-use.sh and by whatever judges a session; `backfill` is the only door
# reconstructed history comes through, and everything it writes is permanently marked
# `backfilled:true` with a `source`. Every reader here selects events by name, so a
# ledger holding these rows is counted by an older reader exactly as it was before.
#
# `done` INSTALLS the skill the forge produced, so that closing the loop is what makes
# the skill usable. See "installing what was forged" below for how the skill is found
# and what happens when the name is taken.
#
# SEVERAL FORGES CAN RUN AT ONCE. Each one gets its own file under forge/, named after
# the forge, so `start` never destroys another forge's record. Which forge a command
# acts on is resolved in this order:
#
#   1. --name <forge> (or -n), or the $SKILLFORGE_NAME environment variable.
#   2. The single live forge, when exactly one is active. This is the common case and
#      needs no argument at all.
#   3. Otherwise the command REFUSES and lists the live names. It does not guess: a
#      guess means `done` closing the wrong record and the status line naming the wrong
#      job, which is the whole reason forges are tracked separately.
#
# THE HELD-OUT FIELDS. `show` and `ledger` leave out `root`, `trigger`, `project` and
# `trigger_verbatim` (and the table's project column) and say so. Those four are the forging
# protocol's held-out test data, and the orchestrator subagent that drives this CLI must
# not hold them; the record on disk keeps every one of them. `--full` prints them.
#
# A FORGE THAT NOTHING CLOSES HOLDS ITS NAME FOREVER. `start` refuses a name whose forge
# is live, which is right, and nothing ever expires `active`, which is not: on 2026-08-28 a
# forge killed with its session -- a laptop closing its lid is enough -- sat
# `status:"active"` for three and a half days and wedged the one name anybody wanted to
# re-forge. So there is a TTL, SKILLFORGE_ACTIVE_TTL, six hours by default, measured
# against IDLE time and not elapsed time. The distinction is the whole safety of it: the
# median real forge here runs 3.3 hours and the longest healthy one ran 6.5, so a six-hour
# ELAPSED cap would reap a forge that was still working, while a six-hour gap BETWEEN STEPS
# is longer than any healthy forge has ever lived. Past it, `skillforge doctor` says WARN,
# `skillforge reap` appends a `fail` row reading "reaped: exceeded SKILLFORGE_ACTIVE_TTL"
# and the name is free, and `start` on that name reaps it itself and says so on stderr
# instead of refusing. Nothing is edited and nothing is deleted: the ledger stays
# append-only, and a reaped forge is a forge with the outcome row it was missing.
#
# THE ROUND CAP IS ENFORCED ON `round`, AND DELIBERATELY NOT ON `step`. A budget is a
# plan and the step reached is an OBSERVATION, so `step` records an overrun rather than
# refusing it -- three tests in tests/test_skillforge.py pin exactly that -- and nothing
# there could refuse a round anyway, because a step number is whatever the caller types.
# `round` is different: it owns the per-forge round record, <state>/rounds/<forge>.tsv,
# one line per red-team round in the format the forging protocol has always written by
# hand, so it knows how many rounds are really on the record and how many the budget
# planned (`rounds_planned`, (steps - 2) / 2).
#
#   skillforge round     appends one line and exits 0 while budgeted rounds remain. A
#                        round PAST the budget exits 3 and writes NO row, naming the two
#                        most recent blocking counts -- "not converging" is a claim about
#                        a trajectory, and a refusal that hides the trajectory is one
#                        nobody can check -- and the two ways past it.
#   skillforge escalate  is the only way past it, and there are exactly two arguments it
#                        accepts. `--converging` is granted only when the last two
#                        recorded rounds show a STRICTLY FALLING blocking count.
#                        `--narrowed "<what was cut>"` is granted ONCE per forge, because
#                        a narrowed skill is a new skill for review purposes and owes one
#                        cold round. Either grant raises the forge's `steps` by exactly
#                        2 -- one round -- so the status line, `show` and the ledger's
#                        `rounds_planned` all see the raised budget, and appends an
#                        `escalate` row carrying the round counts and which claim bought
#                        it. TWO GRANTS PER FORGE IS THE CEILING: a third is refused
#                        whichever kind it is.
#
# WHY THAT IS A REAL CAP AND NOT A SPEED BUMP. `--converging` requires a strictly
# decreasing sequence of non-negative integers, which terminates on its own; and the
# two-grant ceiling bounds a forge at four rounds regardless of what the counts do.
#
# EXIT CODES. 0 success. 1 an environment that cannot be worked in (no jq, a state
# directory that cannot be created) or a `doctor` FAIL. 2 bad argv, or a refusal the
# caller can fix by typing something else. 3 the round cap, from `round` alone. 4 an
# escalation refused, from `escalate` alone. 3 and 4 are separate on purpose: a caller
# that hit the cap has two documented moves left, and a caller whose escalation was
# refused has already spent one of them.
#
# `skillforge horizon` writes the ledger's horizon row if the file does not already carry
# one, and does nothing else. It exists so another CLI in this package can make sure the
# record says where it begins before appending a row of its own, rather than duplicating
# `ledger_ensure_horizon` and having two spellings of "where does this record start".
#
# `skillforge doctor` is the health surface for everything else. Every hook in this package
# opens with `command -v jq || exit 0` and `mkdir -p "$STATE_DIR" || exit 0`, so a missing
# jq, a state directory gone read-only, a SKILL_COMPOUNDER_STATE pointing somewhere that no
# longer exists, or a settings.json that stopped parsing silences all of it with nothing on
# any surface -- indistinguishable, from the outside, from a package that had nothing to
# say. `doctor` prints one line per check, PASS, WARN or FAIL, and exits 1 on any FAIL.
#
# THE TWO KNOBS THOSE ADD. Both are read in exactly one place and both default to the
# behaviour described above, so neither has to be set for anything here to work:
#   SKILLFORGE_ACTIVE_TTL         Seconds of IDLE time after which an `active` forge is
#                                 presumed dead. 21600, six hours. A value that is not
#                                 digits falls back to it rather than erroring, because
#                                 `[ x -ge y ]` on a non-number prints "integer expected"
#                                 and takes the meaning of every reap decision with it.
#   SKILLFORGE_DOCTOR_JQ_VERSION  Pins the version string `doctor` reads instead of asking
#                                 `jq --version`, exactly as SKILLFORGE_NOW pins the clock
#                                 and for the same reason: the too-old branch is otherwise
#                                 reachable only by installing a jq from 2015, and a guard
#                                 nobody has watched fire is a guard nobody has watched at
#                                 all. For tests; nothing else should set it.
#   SKILL_COMPOUNDER_REVIEW       Read by `doctor` only to REPORT whether the paid session
#                                 review has been opted into (hooks/session-review.sh owns
#                                 the switch and its default, which is 0). The check is
#                                 informational and never fails; doctor is where a user
#                                 learns it, and where they are told how to turn it on.
#   SKILLFORGE_SURFER_BIN         The `surfer` executable `doctor` probes, instead of
#                                 asking PATH for it. claude-history-surfer is a real
#                                 dependency of hooks/mission.sh, so the PASS branch can
#                                 only be reached on a machine that has it; this points
#                                 the check at a real checkout's bin/surfer rather than
#                                 standing a fake one up, which would test nothing. For
#                                 tests; nothing else should set it.
#
# State is NOT keyed on a session id. The id in $CLAUDE_CODE_SESSION_ID and the
# .session_id delivered to hooks and the status line are different values for the same
# session, so a session-keyed file written here would never be found by the renderer.
# A forge name is visible to both sides, which is why it is the key.
#
# PRIVACY. Four kinds of file are written, all under
# ${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}, all local, all plain text:
#   forge/<name>.forge.json  one in-progress forge (name, summary, step, phase, times).
#   forge/.outcome.<id>.claim  a copy of the record that closed one forge, left behind so
#                       that a second 'done' cannot append a second outcome row for it.
#                       Same contents as the forge file. Reaped an hour later.
#   apply-pending/<name>.json  one per closed forge, holding the name, the forge, the
#                       skill directory, the summary, the verbatim trigger, the epoch the
#                       forge closed, the session id if the environment carried one, and
#                       whether the skill was installed. Deleted by `skillforge apply`.
#                       It is the only file here that holds the trigger text outside the
#                       forge record itself, which is why `pending` redacts it by default.
#   ledger.jsonl        one JSON line per start/done/fail, appended forever. Each line
#                       holds the skill name, the one-line summary you passed to
#                       'start', the originating repository path, epoch timestamps,
#                       step counts, outcome and reason. No file contents, no
#                       transcripts, no credentials.
#                       It also holds the ledger-v2 rows: `origin` (one per skill: how it
#                       entered the pool, where its directory is, and the verbatim text
#                       you passed to --trigger), `use` (one per skill invocation: the
#                       skill name, your session id, the working directory, whether it
#                       succeeded, and whether a script or a person drove the session),
#                       `verdict` (a judgement plus the quote behind it), `apply` (the
#                       skill was put on the problem that caused it, or was not, plus the
#                       quote behind that), and one
#                       `horizon` row saying where the record begins. The trigger text,
#                       a verdict's evidence and an apply's evidence are the only free
#                       text stored, and all of it is text you passed in yourself.
# Any other *.json left in forge/ by an older version is read as a forge too, so an
# upgrade neither loses it nor deletes it behind your back.
# Nothing is transmitted. This script makes no network calls. Delete ledger.jsonl at
# any time; skillforge recreates it on the next forge.
set -uo pipefail
# ------------------------------------------------------------------------------------
# THE ENTIRE BODY OF THIS SCRIPT IS ONE BRACE GROUP, AND THE `}` AT THE END OF THE FILE
# IS WHAT CLOSES IT. It is not style and it is not decoration.
#
# bash reads a script LAZILY, by byte offset, and resumes at that offset in whatever the
# file holds AT THAT MOMENT. Every file in this package is executed by absolute path out
# of the checkout -- the installer writes those paths into settings.json and symlinks the
# CLIs into ~/bin -- so one `git pull`, `git checkout` or `sed -i` rewrites the bytes of
# a run that is already in flight. Measured on GNU bash 5.3.3(1): prepending forty lines
# to a live 25-line script produced `line 4: non-transferable: command not found` and
# then a second execution of the body; truncating it produced `unexpected EOF` and
# exit 2. It cost a real, paid-for `claude -p` dispatch on 2026-08-25.
#
# A brace group is a single compound command, so bash must find the matching `}` before
# it may run any part of it: the file goes through the parser in ONE pass and nothing
# written to disk afterwards can be executed. A file truncated badly enough to break the
# parse then runs NOTHING, which is also the answer we want here -- half a run is worse
# than no run.
#
# THE `exit` BEFORE THE CLOSING `}` IS LOAD-BEARING TOO. A brace group protects its body
# and nothing past it: measured, a wrapped script that fell off its end had bash resume
# at the offset just past `}`, find prepended text sitting there, and run the whole body
# a SECOND time. So the group is not sufficient on its own. It is a BARE `exit` and not
# `exit 0` because the `case` this ends in has arms that exit non-zero on purpose
# (an unknown subcommand is exit 2, and see the exit-code table above); a bare `exit`
# reuses `$?` and preserves every one of them, while `exit 0` would silently erase them.
#
# Consequences when editing:
#   - the closing `}` must stay the last line, and `bash -n` is what proves it.
#   - the last statement inside the group must be an `exit`. tests/test_script_wrapping.py
#     checks that across every shipped script and reproduces the hazard against a live
#     process.
#   - `exit` still exits the script, traps are still global, and functions and variables
#     defined inside are still global. Nothing about the semantics changes.
#
# The incident this came out of, and the reproduction, are in docs/DESIGN.md under
# "Never edit a script that may still be running".
# ------------------------------------------------------------------------------------
{


# HOME can be unset (cron, a stripped env, a container). Under `set -u` reading it then
# aborts the script non-zero before it has printed anything.
: "${HOME:=/tmp}"
STATE_ROOT="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}"
DIR="$STATE_ROOT/forge"
mkdir -p "$DIR" 2>/dev/null || { echo "skillforge: cannot create $DIR" >&2; exit 1; }
LEDGER="$STATE_ROOT/ledger.jsonl"
# One file per closed forge whose skill has not yet been put on the problem that caused
# it. NOT created here: `done` makes it when it has something to put in it, and every
# reader treats "the directory does not exist" and "the directory is empty" as the same
# answer -- nothing pending. Creating it eagerly would have `pending` report an empty
# queue on a machine that has never forged anything, which is true but says more than we
# know; more practically, the status line and hooks/apply-gate.sh both stat this path and
# neither should be made to care which of the two it found.
APPLY_DIR="$STATE_ROOT/apply-pending"
# Fields in the slot index below are separated by US (0x1f), not by a tab. Two reasons,
# and both are load-bearing: a skill name is allowed to contain a tab (skillreport has a
# regression test for exactly that), and tab is IFS whitespace, so `read` would collapse
# a run of them and shift every later field by one.
SEP="$(printf '\037')"

command -v jq >/dev/null 2>&1 || { echo "skillforge: jq is required" >&2; exit 1; }

# SKILLFORGE_IDLE_SECS (2700) is the age past which `list` marks an active forge
# stale. It is the RENDERER's knob, read here deliberately rather than duplicated:
# two thresholds would let the status line call a forge idle while `list` calls it
# healthy.
# SKILLFORGE_NOW pins the clock so tests can assert on durations and dates.
now() { if [ -n "${SKILLFORGE_NOW:-}" ]; then printf '%s' "$SKILLFORGE_NOW"; else date +%s; fi; }
die() { echo "skillforge: $*" >&2; exit 2; }

# `die` is exit 2: bad argv, or a refusal the caller can fix by typing something else.
# The round cap and a refused escalation are neither -- the caller typed the right thing
# and the answer is no, for a reason it can act on -- so they carry their own codes, and
# a script driving this CLI can tell the three apart without parsing prose.
refuse() { # <exit code> <message...>
  rf_code="$1"; shift
  echo "skillforge: $*" >&2
  exit "$rf_code"
}

# The renderer guards this knob and the CLI did not, so `SKILLFORGE_NOW=abc` reached
# `--argjson now abc`, jq failed, and the one thing `start` could report was its own
# fallback message -- "could not write to .../forge (is it writable?)" against a
# perfectly writable directory. Checked once, here, where the message can name the
# actual cause. Ten digits is every epoch second until the year 2286.
case "${SKILLFORGE_NOW:-}" in
  '') : ;;
  *[!0-9]*|???????????*)
    die "SKILLFORGE_NOW must be epoch seconds (digits only, at most 10); got '$SKILLFORGE_NOW'" ;;
esac

# HOW LONG AN `active` FORGE IS BELIEVED. Six hours, of IDLE -- time since the last
# `skillforge step` -- and not of elapsed time. See the header: 6.5 hours is the longest
# healthy forge on record and 3.3 the median, so a cap on ELAPSED time at this magnitude
# would close a forge that was still working, and one on IDLE time at this magnitude cannot:
# a live forge steps, and a gap this long is longer than any healthy forge has existed.
#
# IT IS DELIBERATELY NOT SKILLFORGE_IDLE_SECS, which is 45 minutes and means something
# else. That one marks a row in `list` -- "this has stopped moving, look at it" -- and a
# person looks. This one is the threshold past which a forge is presumed DEAD and a `fail`
# row is written for it without anybody being asked, which is a far stronger claim and
# needs a far longer wait. One knob for both would make the reaper as eager as the marker.
# A junk value falls back rather than erroring: `[ x -ge y ]` prints "integer expected" and
# takes the meaning of every reap decision with it.
ACTIVE_TTL="${SKILLFORGE_ACTIVE_TTL:-21600}"
case "$ACTIVE_TTL" in ''|*[!0-9]*|???????????*) ACTIVE_TTL=21600 ;; esac
# The reason string is written into a ledger row that outlives every session, so it names
# the knob that produced it. A row reading "abandoned" says a person judged it; this one
# says a clock did, and which clock, so the judgement can be checked later against the TTL
# that was in force.
REAP_REASON="reaped: exceeded SKILLFORGE_ACTIVE_TTL"

# How long since a stamp, in the coarsest unit that stays honest. This exists because
# staleness was COMPUTED and then thrown away: the status line has rendered `idle 3d13h`
# since it was written, and no other surface ever consumed that signal. A forge whose
# orchestrator died sat `active` for three and a half days, wedging its own name, with
# nothing in the CLI willing to say so.
fmt_age() { # <seconds>
  a="${1:-}"
  case "$a" in ''|*[!0-9]*) printf 'unknown'; return 0 ;; esac
  if   [ "$a" -lt 60 ]   ; then printf '%ds' "$a"
  elif [ "$a" -lt 3600 ] ; then printf '%dm' "$(( a / 60 ))"
  elif [ "$a" -lt 86400 ]; then printf '%dh%02dm' "$(( a / 3600 ))" "$(( (a % 3600) / 60 ))"
  else                          printf '%dd%02dh' "$(( a / 86400 ))" "$(( (a % 86400) / 3600 ))"
  fi
}

# Seconds since a record was last stepped, or "" when the stamp is unusable. Never
# guess: a record with no readable `updated` is reported as unknown, not as fresh.
slot_idle() { # <file> -> seconds | ""
  si_u="$(sfield "$1" updated)"
  case "$si_u" in ''|*[!0-9]*) printf '' ;; *) printf '%s' "$(( $(now) - si_u ))" ;; esac
}

# `.[$k] // empty` WAS WRONG ABOUT EXACTLY ONE VALUE, `false`. jq's `//` is the
# alternative operator, not a null coalesce: it takes the right-hand side whenever the
# left is `null` OR `false`. Measured, today, against a file holding
# `{"installed":false,"name":"w"}`:
#
#   jq -r --arg k installed '.[$k] // empty'                          -> (nothing)
#   jq -r --arg k installed '.[$k] | if . == null then empty else . end' -> false
#
# So `if . == null then empty else . end` keeps the two answers that were always right --
# absent and JSON null both read as "" -- and stops folding `false` in with them. THAT IS
# ALL IT DOES, AND IT IS NOT WHAT MAKES `apply` RECORD `installed:false` TODAY. `apply`
# does not read the marker through this accessor: five separate reads could straddle the
# marker's deletion by a racing applier, so it takes ONE jq snapshot of the file (search
# for `a_snap`) and spells the same rule inline there, as
# `(.installed | if . == null then "" else tostring end)`. Two spellings of one rule, in
# two places, and the caller that carries the field is the second one -- fixing the
# accessor alone would have left the row exactly as broken as it was.
#
# WHICH OTHER CALLERS THIS MOVES: none, today, and the audit is mechanical rather than a
# judgement. Every other `field` call site reads `id`, `started`, `trigger`,
# `trigger_kind`, `name`, `steps`, `summary`, `step`, `finished`, `phase`, `status`,
# `skill_dir` or `root` off a forge record, or `session` off a pending-apply marker. No
# boolean is written into a forge record at all (`start` and `close_forge` write strings
# and numbers only), and the marker carries exactly one, `installed`, which is the field
# above. Booleans do exist in this file -- `shipped`, `marker`, `backfilled` -- and all of
# them are written into LEDGER ROWS, which no reader here reads back through `field`.
#
# The hazard therefore returns the moment a boolean is added to a record and read back,
# and there is a third spelling waiting for it: `sfield` still reads `(.[$k] // "")`,
# which prints nothing for `false` (measured, same file, same key). It is display-only
# today -- `name`, `step`, `steps`, `phase` -- so it is left as it is rather than changed
# blind, but a boolean read through it would vanish the same way this one did.
field() { # <file> <key>
  jq -r --arg k "$2" '.[$k] | if . == null then empty else . end' "$1" 2>/dev/null
}

# ONE LINE, ALWAYS, WHATEVER IS IN THE FILE. `field` with -r pretty-prints a container,
# so a foreign record holding `"step": {"a":1}` put raw newlines through `list`'s
# fixed-width printf and split one forge across three rows. `tojson` is compact by
# construction and the gsub catches the rest.
sfield() { # <file> <key>
  jq -r --arg k "$2" '(.[$k] // "") | (if type == "string" then . else tojson end)
                      | gsub("[[:cntrl:]]"; " ")' "$1" 2>/dev/null
}

# A blank or all-whitespace name cannot be typed after --name and cannot be told apart
# from its neighbours on screen, so wherever a name is DISPLAYED it is replaced by the
# one handle that does identify it: its file. Counting such a record while refusing to
# name it made `step` say "b, c, d are all live" with four records blocking it.
#
# `LC_ALL=C` on the `tr`, and it is not cosmetic. BSD `tr` ABORTS with "Illegal byte
# sequence" on a byte that is not valid in the ambient locale, and the failed substitution
# then yields the empty string -- which is exactly the answer this `case` reads as "the
# name is blank". A name that is merely not UTF-8 would be relabelled "(unnamed: ...)".
# The class being matched is ASCII whitespace, so byte semantics are what was wanted here
# anyway; see the same fix on `apply --evidence`.
label_of() { # <name> <path>
  case "$(printf '%s' "${1:-}" | LC_ALL=C tr -d '[:space:]')" in
    '') printf '(unnamed: %s)' "$(basename "$2")" ;;
    *)  printf '%s' "$1" ;;
  esac
}

# Truncate and pad to a number of TERMINAL COLUMNS. `printf '%.28s'` and `%-28s` are
# BYTE-based: a CJK forge name was cut mid-character, so a stray \347 reached the
# terminal, and it was padded to 28 bytes rather than 28 columns, so every later column
# of the table shifted. This is the same problem the renderer solves in fit(), at table
# scale, with the wide/fullwidth blocks that a skill name can plausibly contain.
cell() { # <string> <columns>
  jq -rn --arg s "$1" --argjson w "$2" '
    def cw: if (. >= 4352   and . <= 4447)   or (. >= 8986   and . <= 8987)
              or (. >= 9193   and . <= 9196)   or (. >= 11904  and . <= 42191)
              or (. >= 44032  and . <= 55203)  or (. >= 63744  and . <= 64255)
              or (. >= 65040  and . <= 65049)  or (. >= 65072  and . <= 65135)
              or (. >= 65280  and . <= 65376)  or (. >= 65504  and . <= 65510)
              or (. >= 127744 and . <= 130041) or (. >= 131072 and . <= 262141)
            then 2
            elif (. >= 768   and . <= 879)   or (. >= 8203  and . <= 8207)
              or (. >= 8288  and . <= 8303)  or (. >= 65024 and . <= 65039)
            then 0 else 1 end;
    ($s | gsub("[[:cntrl:]]"; " ")) as $t
    | ($t | explode) as $c
    | ([foreach $c[] as $x (0; . + ($x | cw))]) as $cum
    | ($cum | last // 0) as $tot
    | if $tot <= $w then $t + ((" " * ($w - $tot)) // "")
      else ([ range(0; ($c | length)) | select($cum[.] <= ($w - 1)) ] | length) as $k
        | (($c[0:$k] | implode) + "…")
          + ((" " * ($w - 1 - (if $k == 0 then 0 else $cum[$k - 1] end))) // "")
      end' 2>/dev/null || printf '%s' "$1"
}

update() { # <file> <jq args...>
  u_file="$1"; shift
  u_tmp="$u_file.tmp.$$"
  # The whole group is wrapped, not just jq. A redirect that cannot open its target is
  # reported by the SHELL, not by jq, so the unwrapped form printed bash's own
  # "Permission denied" above the tidy message below it. `start` already does this.
  if ! { { jq "$@" "$u_file" > "$u_tmp"; } 2>/dev/null && mv "$u_tmp" "$u_file"; }; then
    rm -f "$u_tmp" 2>/dev/null; die "could not update $u_file"
  fi
}

# Orphan temp files. `start` writes its record to ".start.<pid>.<ts>.tmp" before it
# claims a slot and `update` writes "<slot>.tmp.<pid>"; a process killed between the
# write and the rename leaves one behind, and nothing reaped them -- 29 survived 60
# SIGKILLs during `start`, and the directory grows without bound. Neither name ends in
# .json, so they are invisible to slots() and to the renderer, and reaping them must
# not change that.
#
# AGE, NOT EXISTENCE, IS THE TEST. A temp file younger than an hour may belong to a
# writer that is still running, and deleting it would corrupt a concurrent start. No
# write survives sixty minutes.
# `! -name '*.json'` is not belt and braces, it is the whole safety of this function. A
# forge may legitimately be NAMED `build.tmp`, whose slot file is `build.tmp.forge.json`,
# and that matches `*.tmp.*`: an hour into a long forge the next `start` deleted the live
# slot, the animation stopped, and `done --name build.tmp` answered "no forge named
# build.tmp". Every temp this script writes ends in `.tmp` or `.tmp.<pid>` and a slot
# always ends in `.json`, so the two sets are separable -- but only if the separation is
# stated.
reap_temps() {
  # `.apply.*` covers everything `apply` leaves in here: its staged row, and the three
  # claims -- forge instance, act, session -- that stop a second delivery of one intent
  # from appending a second row. A claim is a TEMP FILE and not a permanent record -- the
  # marker deletion is what makes an apply durable -- so it ages out on the same hour as
  # everything else, for the same reason: no write survives sixty minutes. None of these
  # names ends in `.json`, so the guard above still separates them from every slot.
  find "$DIR" -maxdepth 1 -type f ! -name '*.json' \
       \( -name '.start.*.tmp' -o -name '*.tmp.*' -o -name '.apply.*' \) \
       -mmin +60 -exec rm -f {} + 2>/dev/null || true
}

# Spent outcome claims. One is left behind by every forge that is closed out (see
# close_forge), so the directory would otherwise grow by one small file per forge forever.
#
# A CLAIM WHOSE FORGE IS STILL ACTIVE IS NOT SPENT, whatever its age. That combination is
# the fingerprint of a closer killed between winning the claim and publishing the closed
# record, and the claim is then the only thing standing between that forge and a second
# outcome row. Reaping it by age alone would hand the duplicate back after an hour. Ages
# out on the same hour as every other temp file, and for the same reason: no write
# survives sixty minutes.
reap_claims() {
  rc_old="$(find "$DIR" -maxdepth 1 -type f -name '.outcome.*.claim' -mmin +60 2>/dev/null)"
  [ -n "$rc_old" ] || return 0
  rc_live=" "
  while IFS="$SEP" read -r rc_st rc_nm rc_stt rc_pth; do
    [ -n "${rc_pth:-}" ] || continue
    [ "$rc_stt" = "active" ] || continue
    rc_live="$rc_live$(forge_id "$rc_pth") "
  done <<SLOTS
$(slots)
SLOTS
  printf '%s\n' "$rc_old" | while IFS= read -r rc_f; do
    [ -n "$rc_f" ] || continue
    rc_id="${rc_f##*/}"; rc_id="${rc_id#.outcome.}"; rc_id="${rc_id%.claim}"
    # A forge id is filename-safe, so it holds no space and this match cannot straddle
    # two ids.
    case "$rc_live" in *" $rc_id "*) continue ;; esac
    rm -f "$rc_f" 2>/dev/null || true
  done
}

# The originating repository, best effort. Outside a checkout (or with no git at all)
# the working directory is the honest answer.
# Cached, and `start` warms it BEFORE it claims a slot. The value cannot change inside
# one invocation, and the `git rev-parse` behind it is the slowest thing in
# `ledger_append` -- which is what runs immediately after the slot claim. A process
# killed in that window leaves a live forge with no `start` row (4 of 60 SIGKILL
# trials). Warming the cache first takes the fork-and-exec out of the window entirely.
# It does not close the window; `ledger` and `skillreport` now SHOW an outcome that has
# no start rather than dropping it, which is the half that matters.
PROJECT_ROOT_CACHE=""
project_root() {
  [ -n "$PROJECT_ROOT_CACHE" ] || \
    PROJECT_ROOT_CACHE="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
  printf '%s' "$PROJECT_ROOT_CACHE"
}

int_or_zero() { case "${1:-}" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$1" ;; esac; }

# ------------------------------------------------------------ the held-out fields
#
# THE FORGING PROTOCOL'S ISOLATION IS SUPPOSED TO BE STRUCTURAL, AND FOR ONE STAGE IT
# WAS NOT. `skills/skill-compounder/SKILL.md` holds the original project out as test
# data: the builder C and the red-teamer D are denied it by CONSTRUCTION -- a scratch
# working directory, no path into the project, no CLI -- while the orchestrator B was
# denied it only by a sentence in its brief. B is handed this script and told to call
# `step`, and `skillforge show` answered with `root` (the repository path) and
# `trigger` (the verbatim user utterance), while `ledger --json` answered with
# `project` and `trigger_verbatim` for every forge on the machine. The two things B
# must never hold were one command away, in a tool B was told to run.
#
# So the read commands hold them back by default and say that they did. Not deleted:
# the RECORD keeps every field, `skillreport` reads the ledger file directly, and
# stage E still receives the verbatim trigger from A by hand -- which is its existing
# path and the only one that ever mattered. What changes is what the CLI VOLUNTEERS.
#
# `--full` lifts it, for A, who is the party the test set belongs to. A flag is not a
# wall and is not meant to be one: nothing can stop an agent that reads the state
# directory itself. What it stops is the accident -- B running the command it was told
# to run and having the answer put in front of it -- which is what actually happened.
#
# The removal is REPORTED IN THE OUTPUT, never silent, and lists exactly the fields
# that were present: a reader must be able to tell "this forge recorded no trigger"
# from "this view is not showing you the trigger". Those are opposite facts and they
# used to look identical.
HELD_OUT_FIELDS='["root","trigger","project","trigger_verbatim"]'

redact_prog() {
  if [ "$FULL_OPT" -eq 1 ]; then printf '%s' '.'; return 0; fi
  printf '%s' '. as $r
    | ('"$HELD_OUT_FIELDS"' | map(. as $k | select($r | has($k)))) as $gone
    | delpaths([$gone[] | [.]])
    | (if ($gone | length) > 0
       then . + {held_out: $gone,
                 held_out_note: "the forging protocol holds these back; skillforge --full shows them"}
       else . end)'
}

# ------------------------------------------------------------------- forge identity
#
# One id per forge, written into the record by `start` before the slot is published, and
# never reused. It is what an outcome claim is named after (see close_forge), and the
# claim scheme rests entirely on this never coming round again: a claim path that could
# be reused would refuse to close the SECOND forge that landed on it, forever.
#
# The clock here is the real one, deliberately, and not now(): SKILLFORGE_NOW is pinned
# to a constant by every test in this repo, and an id that collapses to pid alone under a
# pin is one bad PATH away from colliding in exactly the situation the tests exist to
# exercise. Seconds, pid and two draws of $RANDOM.
new_forge_id() {
  printf '%s.%s.%s%s' "$(date +%s 2>/dev/null || printf '0')" "$$" \
                      "${RANDOM:-0}" "${RANDOM:-0}"
}

# `stat -f` selects a format on BSD and reports on the FILESYSTEM on GNU coreutils
# (docs/DESIGN.md), so it is unusable here. `ls -i` prints the inode number first on both.
inode_of() { # <file>
  # shellcheck disable=SC2012 # find has no portable inode format; only field 1 of one named file is read
  i_n="$(ls -di "$1" 2>/dev/null | awk 'NR == 1 { print $1 }')"
  case "${i_n:-}" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$i_n" ;; esac
}

# The id of an EXISTING record, as a bounded, filename-safe string.
#
# THIS FUNCTION MUST BE INJECTIVE. Two live forges that answer to one id share one claim,
# so the second cannot be closed at all and the first one's corpse is published over it.
# Sanitizing an arbitrary field is therefore exactly the wrong move: `tr` is many-to-one,
# and two foreign records in `alpha!.json` and `alpha@.json` mapped to one claim -- the
# second forge was destroyed, was unclosable, and left no ledger row. An id that is not
# ALREADY a safe, bounded filename is not repaired, it is not used. Bounded as well as
# safe: a claim path longer than NAME_MAX makes `ln` fail with no claim to show for it,
# both closers take the fall-through below, and the duplicate row is back (reproduced
# with a 230-character foreign slot filename in the fallback, 2 rows and 0 claims).
#
# The fallback identifies a record that carries no id of its own -- one written by an
# older version of this script, or by hand -- by its slot's INODE and start time. An
# inode is unique among the files that exist right now, and `start` and `update` both
# publish by renaming a fresh file into place, so a second forge in the same slot gets a
# different one. Neither half is enough alone: inode numbers are recycled once a file is
# deleted, and `started` repeats under a pinned clock -- two successive id-less forges of
# one name at a pinned clock shared an id and the second was unclosable. The slot
# filename is deliberately NOT part of it: it is unbounded and not filename-safe, which
# is what broke both ways above.
forge_id() { # <record file>
  f_id="$(field "$1" id)"
  case "$f_id" in *[!A-Za-z0-9._-]*) f_id="" ;; esac
  [ "${#f_id}" -le 64 ] || f_id=""
  [ -n "$f_id" ] || f_id="legacy.$(int_or_zero "$(field "$1" started)").$(inode_of "$1")"
  printf '%s' "$f_id"
}

# ------------------------------------------------------------------ slot discovery

# Every *.json directly under forge/ that parses and carries a name and a status is a
# forge slot. `find` rather than a glob: zsh makes an unmatched glob a fatal error, and
# this file has to keep working if it is ever sourced or run under something other than
# bash. A file that does not parse is SKIPPED, never deleted -- a half-written temp file
# from a concurrent writer must not take a forge down with it, and neither must a state
# file from a future version this build does not understand.
#
# The temp files written by update()/start are named "<file>.tmp.<pid>", which does not
# end in .json, so a render can never catch one mid-write.
# A record whose name holds a newline, a carriage return or a US cannot be represented
# in a one-line index, so it is SKIPPED -- never deleted, and never allowed to produce a
# phantom half-row that a later --name lookup could match. `start` refuses those three
# characters, so only a hand-written or foreign state file can be in that shape.
slot_meta() { # <file> -> "started<US>name<US>status" or nothing
  jq -r 'select((has("name")) and (has("status")) and ((.name|type) == "string")
                and (((.name | contains("\n")) or (.name | contains("\r"))
                      or (.name | contains("\u001f"))) | not))
         | "\(.started // 0)\u001f\(.name)\u001f\(.status)"' "$1" 2>/dev/null
}

slots() { # -> "started<US>name<US>status<US>path" per slot, oldest start first
  find "$DIR" -maxdepth 1 -type f -name '*.json' 2>/dev/null | while IFS= read -r s_f; do
    s_meta="$(slot_meta "$s_f")"
    [ -n "$s_meta" ] || continue
    printf '%s%s%s\n' "$s_meta" "$SEP" "$s_f"
  done | sort -t"$SEP" -k1,1n -k4,4
}

# Resolve which slot a command acts on. Sets RESOLVED (a path) or AMBIG (a name list).
# Returns 0 resolved, 1 nothing to act on, 3 ambiguous.
#
# Ambiguity is measured over ACTIVE forges only. A finished forge lingers on disk for
# its status-line clear-out window, and letting that corpse make every no-argument
# command ambiguous for the next 30 seconds would be a worse bug than the one this
# replaces.
resolve_slot() { # <wanted name, or empty>
  RESOLVED=""; AMBIG=""; RESOLVED_STATE=""; RESOLVED_NAME=""
  r_want="$1"; r_all=0; r_act=0; r_allp=""; r_actp=""; r_alln=""; r_actn=""
  r_alls=""; r_allnm=""; r_actnm=""
  while IFS="$SEP" read -r r_st r_nm r_stt r_pth; do
    [ -n "${r_pth:-}" ] || continue
    [ -n "$r_want" ] && [ "$r_nm" != "$r_want" ] && continue
    r_lbl="$(label_of "$r_nm" "$r_pth")"
    r_all=$(( r_all + 1 )); r_allp="$r_pth"; r_alls="$r_stt"; r_allnm="$r_nm"
    # `${r_alln:+, }` is what dropped a blank name silently: appending "" leaves the
    # accumulator empty, so the NEXT name became the first one and the count and the
    # list disagreed. label_of makes every entry non-empty, so it cannot recur.
    r_alln="$r_alln${r_alln:+, }$r_lbl"
    if [ "$r_stt" = "active" ]; then
      r_act=$(( r_act + 1 )); r_actp="$r_pth"; r_actnm="$r_nm"
      r_actn="$r_actn${r_actn:+, }$r_lbl"
    fi
  done <<SLOTS
$(slots)
SLOTS
  if [ "$r_act" -eq 1 ]; then
    RESOLVED="$r_actp"; RESOLVED_STATE="active"; RESOLVED_NAME="$r_actnm"; return 0
  fi
  if [ "$r_act" -gt 1 ]; then AMBIG="$r_actn"; return 3; fi
  if [ "$r_all" -eq 1 ]; then
    RESOLVED="$r_allp"; RESOLVED_STATE="$r_alls"; RESOLVED_NAME="$r_allnm"; return 0
  fi
  if [ "$r_all" -gt 1 ]; then AMBIG="$r_alln"; return 3; fi
  return 1
}

# `step`, `done` and `fail` must act on a LIVE forge and nothing else. Falling back to
# the one remaining record when none is active let a bare `step` rewind the bar under a
# green ✓, and let a second `done` append a second outcome record for one start -- the
# ledger then counts a forge twice and its own start-to-outcome join hides it.
# Returns 0 with RESOLVED set, or exits.  <command> <no-active-is-fatal?>
require_active() { # <command> <fatal|quiet>
  resolve_slot "$NAME_OPT"; rq=$?
  [ "$rq" -eq 3 ] && ambiguous "$1"
  if [ "$rq" -eq 1 ]; then
    # Named a forge that does not exist at all: always an error, even for the commands
    # whose empty case is a silent no-op. A typo in --name would otherwise close
    # nothing, say nothing, and exit 0.
    [ -n "$NAME_OPT" ] && die "no forge named '$NAME_OPT' (try: skillforge list)"
    [ "$2" = "fatal" ] && die "no active forge; run 'skillforge start' first"
    exit 0
  fi
  if [ "$RESOLVED_STATE" != "active" ]; then
    [ "$2" = "fatal" ] && die "forge '$RESOLVED_NAME' is not running (status: $RESOLVED_STATE); it has already been closed out"
    echo "skillforge: '$RESOLVED_NAME' was already closed out (status: $RESOLVED_STATE); nothing to do"
    exit 0
  fi
  return 0
}

ambiguous() { # <command> -- never guesses; says exactly what to type instead
  die "$AMBIG are all live. Say which one: skillforge $1 --name <forge> ... ('skillforge list' shows them; a forge whose session died is cleared with 'skillforge clear --name <forge>')"
}

# forge/<slug>.forge.json. The slug is only a filename; the name inside the file is
# what every lookup uses, so a mangled or truncated slug can never mislabel a forge.
slug_of() {
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-' | cut -c1-60)"
  s="$(printf '%s' "$s" | sed 's/^-*//; s/-*$//')"
  [ -n "$s" ] && printf '%s' "$s" || printf 'forge'
}

# ------------------------------------------------------------------------- ledger

# One JSON object, one line. jq builds the whole line before any redirect runs, so a
# single short write reaches the file and concurrent forges cannot interleave half a
# record. Building is separated from appending because an OUTCOME line is built before
# its claim is taken and appended after (see close_forge): everything expensive -- five
# forks of jq, a `git rev-parse` -- happens on the near side of the claim, and all that
# is left on the far side is one builtin append.
ledger_line() { # <event> <name> <steps> <summary> [step] [phase] [duration] [rounds]
  # `rounds` on a start record is the plan; on a done or fail record it is the count
  # actually completed, and `rounds_planned` records what was budgeted alongside it.
  #
  # The trigger arrives through two globals rather than as arguments 10 and 11. Only
  # `start` sets them, and only `start` can: every other command runs in its own process,
  # where they are empty. Adding two positional parameters instead would have put them
  # behind seven optional ones at every call site, which is how a caller ends up passing a
  # duration into `rounds`.
  jq -n -c \
    --arg event "$1" --arg name "$2" --arg summary "${4:-}" \
    --arg project "$(project_root)" \
    --argjson ts "$(now)" --argjson steps "$(int_or_zero "${3:-0}")" \
    --arg step "${5:-}" --arg phase "${6:-}" --arg duration "${7:-}" --arg rounds "${8:-}" \
    --arg planned "${9:-}" \
    --arg trigger "${TRIGGER_TEXT:-}" --arg tkind "${TRIGGER_KIND:-}" \
    --arg skill "${SKILL_PRESENT:-}" \
    '{event:$event, name:$name, ts:$ts, steps:$steps, summary:$summary, project:$project}
     + (if $step     == "" then {} else {step:     ($step|tonumber)}     end)
     + (if $phase    == "" then {} else {phase:     $phase}              end)
     + (if $duration == "" then {} else {duration: ($duration|tonumber)} end)
     + (if $rounds   == "" then {} else {rounds:   ($rounds|tonumber)}   end)
     + (if $planned  == "" then {} else {rounds_planned: ($planned|tonumber)} end)
     + (if $trigger  == "" then {} else {trigger_verbatim: $trigger}     end)
     + (if $tkind    == "" then {} else {trigger_kind: $tkind}           end)
     + (if $skill    == "" then {} else {skill:        $skill}           end)' 2>/dev/null
}

# A ledger failure must never break a forge, hence the bare returns.
ledger_append() { # <same arguments as ledger_line>
  la_line="$(ledger_line "$@")"
  [ -n "$la_line" ] || return 0
  ledger_ensure_horizon
  # `2>/dev/null` BEFORE the `>>`, AND THE ORDER IS THE WHOLE POINT. Redirections are
  # applied left to right, so written the other way round `>>` is opened first and a
  # failure to open it is reported by the SHELL to a stderr that is still the terminal --
  # the suppression that looks like it is there does nothing. Measured: `printf x >> ro
  # 2>/dev/null` prints "Permission denied", `printf x 2>/dev/null >> ro` is silent. Every
  # append in this file is written this way; see the one in `apply`, where the same
  # ordering printed bash's own error above skillforge's success message.
  printf '%s\n' "$la_line" 2>/dev/null >> "$LEDGER" || return 0
  return 0
}

# ------------------------------------------------------------------ ledger v2 rows
#
# THE FOUR QUESTIONS. A ledger of start/step/done/fail answers "a forge happened" and
# nothing else. What the record has to answer is: what triggered the build, what was
# built, when it has been used since, and whether it worked. Three event types carry
# those, alongside every existing one:
#
#   origin   one row per skill: how it entered the pool, where it lives, and the
#            verbatim thing that set the forge off.
#   use      one row per invocation, written live by hooks/skill-use.sh.
#   verdict  one judgement about one use, with the quote it rests on.
#
# EVERY READER SELECTS THE EVENTS IT UNDERSTANDS BY NAME, so a file holding these rows
# is counted by an older `skillforge ledger` or `skillreport` exactly as it was before.
# That is not a hope, it is the reason `ledger` and `skillreport` filter on
# `.event == "start"` rather than on "not an outcome": a reader that classified by
# exclusion would have folded every `use` row into the forge count the day this landed.
#
# PROVENANCE IS PART OF THE ROW, NOT OF THE FILE. A row written as the thing happened
# carries `confidence:"measured"` and `backfilled:false`. A row reconstructed afterwards
# carries `backfilled:true`, `confidence:"reconstructed"`, a `source` naming the evidence
# it was read from, and `reconstructed_at`. The two kinds live in one file forever and no
# reader may present the second as the first. `backfilled` is written EXPLICITLY on live
# rows rather than left absent: "the key is missing" and "this row is live" are the same
# bytes only until somebody hand-edits the file, and the whole point of the distinction is
# that it survives.
#
# A FIELD THE DATA DOES NOT ESTABLISH IS OMITTED. Never guessed, never defaulted to
# something plausible. `trigger_kind:"unrecorded"` is the one exception and it is not a
# guess: it is the positive statement that a forge ran without recording why, which is a
# fact about the forge worth counting.
TRIGGER_KINDS="user-prompt hook-checkpoint review-dispatch agent-decision"
VERDICT_VALUES="WORKED NO-OP MISFIRED UNKNOWN"
# `apply` answers what happened when the forged skill was put on the problem it was forged
# for. THREE OUTCOMES, NOT ONE, and the two that are not `used` are the reason this is an
# outcome rather than a flag: `declined` (it was read and judged not to fit) and `failed`
# (it fired and did not help) are true results of a forge that closed perfectly well, and
# a queue that only accepted `used` would be discharged by lying or not at all.
APPLY_OUTCOMES="used declined failed"

# A CLOSE THAT PRODUCED NO SKILL IS A FACT ABOUT THE FORGE, AND IT USED TO BE SAID ONCE
# AND THEN LOST. `done` prints "no SKILL.md was found ... nothing was installed" to a
# terminal that scrolls, and wrote a `done` row byte-for-byte identical to one from a
# forge that shipped something: the ledger, which is the only durable evidence this
# protocol produces about itself, could not tell the two apart afterwards.
#
# WHY IT IS RECORDED RATHER THAN REFUSED. Not every forge writes a skill -- a fix, a
# retirement and a red-team round all close legitimately with nothing to install -- so a
# refusal would break the documented cases. Nor may `done` exit non-zero: a caller reads
# that as a close that failed and retries, and the close DID happen. The rule this repo
# actually holds is that a gap must be countable rather than silent, so the row carries
# `skill: "present"` or `skill: "missing"` and `skillforge ledger --json --full` counts them.
# Set only by `done`, because only `done` claims to have finished something; absent
# everywhere else, which is the file's rule for a field the data does not establish.
SKILL_PRESENT=""

# The commit the forge was standing on, best effort. Omitted rather than faked.
commit_here() {
  git -C "$PWD" rev-parse --short HEAD 2>/dev/null || printf ''
}

# Does the ledger already hold an origin row for this skill?
# The name goes in through --arg and never through the program text: a skill name is
# user-supplied, and a name holding a quote or a backslash spliced into a jq program is
# both a syntax error and, less kindly, a way to make the check answer whatever the name
# says. A ledger that cannot be read answers "no": a duplicate row is recoverable and a
# row never written is not.
ledger_has_origin() { # <name>
  [ -s "$LEDGER" ] || return 1
  jq -e -s -R --arg n "$1" '
    [ split("\n")[] | select(length > 0) | (fromjson? // empty) ]
    | map(select(.event == "origin" and .name == $n)) | length > 0' "$LEDGER" >/dev/null 2>&1
}

# Same question for one recorded invocation, keyed on the tool_use id Claude Code gives
# it. The hook that writes these already claims each event once, but the two guards catch
# different failures: the claim marker is per session and ages out after an hour, while
# this one is the ledger's own memory and never does.
ledger_has_use_id() { # <tool_use_id>
  [ -n "${1:-}" ] || return 1
  [ -s "$LEDGER" ] || return 1
  jq -e -s -R --arg id "$1" '
    [ split("\n")[] | select(length > 0) | (fromjson? // empty) ]
    | map(select(.event == "use" and .tool_use_id == $id)) | length > 0' "$LEDGER" >/dev/null 2>&1
}

# THE HORIZON. An empty stretch of ledger means one of two completely different things:
# nothing happened, or nothing was being recorded yet. The live ledger on the machine
# this was written on has a 7.4-hour pre-history in which a real forge ran and produced a
# real skill, and no row of it exists. Read without a horizon, that reads as a negative
# result -- which is the exact failure this whole exercise is about.
#
# So one row states where the record begins:
#   known_from     the earliest ts in the file at the moment the marker was written, or
#                  now, if the file was empty.
#   complete_from  written ONLY when the ledger was empty, because only then is "complete
#                  from here" a thing we know. Otherwise the field is absent, and its
#                  absence says the completeness of what came before is unestablished.
# Written at most once, by whichever ledger write comes first.
ledger_ensure_horizon() {
  grep -q '"event":"horizon"' "$LEDGER" 2>/dev/null && return 0
  lh_now="$(now)"
  lh_first="$(jq -s -R 'def n: [ split("\n")[] | select(length > 0) | (fromjson? // empty)
                                 | (.ts // empty) | numbers ];
                        (n | min) // null' "$LEDGER" 2>/dev/null)"
  case "${lh_first:-null}" in
    null|'') lh_first="$lh_now"; lh_complete="$lh_now" ;;
    *)       lh_complete="" ;;
  esac
  lh_line="$(jq -n -c --argjson ts "$lh_now" --argjson known "$lh_first" \
    --arg complete "$lh_complete" \
    '{event:"horizon", ts:$ts, known_from:$known,
      note:"This ledger holds no row before known_from. Whether anything happened before it is UNKNOWN, not none.",
      confidence:"measured", backfilled:false}
     + (if $complete == "" then {} else {complete_from:($complete|tonumber)} end)' 2>/dev/null)"
  [ -n "$lh_line" ] || return 0
  printf '%s\n' "$lh_line" 2>/dev/null >> "$LEDGER" || return 0
  return 0
}

# Append one already-built row. Like ledger_append, a failure here never breaks a caller.
ledger_raw_append() { # <compact json line>
  [ -n "${1:-}" ] || return 0
  ledger_ensure_horizon
  printf '%s\n' "$1" 2>/dev/null >> "$LEDGER" || return 0
  return 0
}

# ONE ORIGIN ROW PER SKILL, EVER. Install runs on every upgrade and `done` runs on every
# forge, so an origin row that appended unconditionally would grow by one per install and
# turn "how did this skill get here" into a pile of contradictory answers. The first
# answer is kept; a later caller that knows better says so with its own event rather than
# by writing a second origin.
#
# `shipped` says whether the skill lives inside this checkout's skills/ or somewhere else
# entirely. A skill forged into a user's personal directory is the normal case in the
# field, not an edge case, and a model that could only describe repo-shipped skills would
# be blind to most of what this package actually builds.
origin_append() { # <name> <origin> <skill_dir> <trigger> <trigger_kind> <created_at>
  oa_name="${1:-}"; [ -n "$oa_name" ] || return 0
  ledger_has_origin "$oa_name" && return 0
  oa_dir="${3:-}"
  oa_shipped="false"
  oa_home="$(app_home)"
  if [ -n "$oa_home" ]; then
    case "$oa_dir" in "$oa_home/skills/"*) oa_shipped="true" ;; esac
  fi
  oa_line="$(jq -n -c --arg name "$oa_name" --arg origin "${2:-unknown}" \
    --arg dir "$oa_dir" --argjson shipped "$oa_shipped" \
    --arg tv "${4:-}" --arg tk "${5:-}" --arg created "${6:-}" \
    --arg commit "$(commit_here)" --arg project "$(project_root)" \
    --argjson ts "$(now)" \
    '{event:"origin", ts:$ts, name:$name, origin:$origin, project:$project,
      confidence:"measured", backfilled:false}
     + (if $dir     == "" then {} else {skill_dir:$dir, shipped:$shipped} end)
     + (if $tv      == "" then {} else {trigger_verbatim:$tv}   end)
     + (if $tk      == "" then {} else {trigger_kind:$tk}       end)
     + (if $commit  == "" then {} else {created_commit:$commit} end)
     + (if $created == "" then {} else {created_at:($created|tonumber)} end)' 2>/dev/null)"
  ledger_raw_append "$oa_line"
}

# The origin row a finished forge implies, written from the forge record itself so that
# the trigger recorded at `start` is what lands in it.
#
# THE NAME IS THE DIRECTORY'S, NOT THE FORGE'S -- the same rule install_forged_skill
# follows, and for the same reason: a session resolves a skill by the directory it sits
# in, so an origin row under the forge's name would describe a skill nothing can invoke.
# A forge that produced no SKILL.md at all (a fix, a retirement, a red-team round) gets no
# origin row: there is no skill to have an origin.
origin_for_forge() { # <forge name> <record file>
  of_name="${1:-}"; of_rec="${2:-}"
  find_skill_dir "$of_name" "$of_rec" || return 0
  origin_append "$(basename "$FOUND")" forged "$FOUND" \
    "$(field "$of_rec" trigger)" "$(field "$of_rec" trigger_kind)" \
    "$(int_or_zero "$(field "$of_rec" started)")"
}

# Red-team rounds are not stored during a forge, only the step budget and the step
# reached. SKILL.md budgets steps as 2 + 2*rounds: one step to dispatch the builder, one
# for its draft, then a review step and a revision step per round.
#
# So the budget implies the PLANNED rounds, and the step reached implies the COMPLETED
# ones. Reporting the planned count on an outcome record is a lie the ledger tells about
# itself: a forge abandoned at step 3 of 8 recorded three rounds when it had finished
# none. A start record carries the plan; a done or fail record carries what happened.
rounds_planned() {
  r=$(( ( $(int_or_zero "${1:-0}") - 2 ) / 2 ))
  [ "$r" -lt 0 ] && r=0
  printf '%s' "$r"
}

rounds_completed() { # <step reached>
  r=$(( ( $(int_or_zero "${1:-0}") - 2 ) / 2 ))
  [ "$r" -lt 0 ] && r=0
  printf '%s' "$r"
}

# --------------------------------------------------------------- the round record
#
# One file per forge, <state>/rounds/<forge>.tsv, one line per red-team round, in the
# format the forging protocol has been writing by hand since the first forge:
#
#   <n><TAB>blocking=<k><TAB>total=<m><TAB>subsystems=<...><TAB>shapes=<...>
#
# THE READERS TAKE COLUMNS BY NUMBER AND LEAVE THE REST ALONE, because the two real round
# files on the machine this was written on carry a sixth, free-text column on some rows
# (a `DECISION=...` note a session added by hand). A reader that required five columns
# would refuse the record the protocol actually produced.
ROUNDS_DIR="$STATE_ROOT/rounds"

# Named with the SAME expression every other per-name file in this package uses
# (apply_marker_path, the hook claim directories): one spelling, or one forge grows two
# round files under two spellings and the cap counts half its own rounds.
rounds_file() { # <forge name> -> path
  printf '%s/%s.tsv' "$ROUNDS_DIR" "$(safe_name "$1")"
}

# One value, flattened to one line and one column. A tab inside a value adds a column and
# a newline adds a row, and either makes the file say something nobody wrote. `LC_ALL=C`
# is not cosmetic: BSD `tr` ABORTS with "Illegal byte sequence" on a byte that is not
# valid in the ambient locale, and the failed substitution then yields the empty string,
# so a subsystem list that is merely not UTF-8 would be silently recorded as blank. Same
# fix as label_of and as `apply --evidence`.
tsv_field() { # <value>
  printf '%s' "${1:-}" | LC_ALL=C tr '\t\n\r' '   ' | LC_ALL=C tr -d '[:cntrl:]'
}

# How many rounds are really on the record. `grep -c ''` and NOT `wc -l`, for two
# separate reasons that both bite here: BSD `wc` prints a leading-space-padded count,
# which a numeric `case` guard reads as non-numeric and zeroes -- the defect that made
# CLAIM_GATE_MAX_BYTES dead code on BSD -- and `wc -l` counts newlines, so it misses a
# last line without one, which is exactly the shape a hand-edited round file has.
rounds_count() { # <rounds file> -> a count, 0 when the file is not there
  [ -f "$1" ] || { printf '0'; return 0; }
  int_or_zero "$(grep -c '' "$1" 2>/dev/null | tr -cd '0-9')"
}

# The `blocking=` column of one recorded round, counted back from the most recent.
# Prints NOTHING and returns 1 when that round is not there or does not carry a readable
# count, so no caller can mistake a missing row for a blocking count of zero -- which is
# the one value that would make every trajectory look like it was falling.
rounds_blocking() { # <rounds file> <how far back: 1 = most recent>
  rb_back="$(int_or_zero "${2:-1}")"
  [ "$rb_back" -ge 1 ] || return 1
  [ "$(rounds_count "$1")" -ge "$rb_back" ] || return 1
  rb_v="$(tail -n "$rb_back" "$1" 2>/dev/null | head -n 1 | cut -f2)"
  case "$rb_v" in blocking=*) rb_v="${rb_v#blocking=}" ;; *) return 1 ;; esac
  case "$rb_v" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$rb_v"
}

# The outcome line a CLOSED record implies. Duration is read out of the record's own
# `finished` rather than taken from a second clock read, so the same record always yields
# the same line no matter who builds it or when -- which is what lets the line be built
# before the claim below and still describe the forge exactly.
ledger_close_line() { # <closed record file> <event>
  l_f="$1"
  l_name="$(field "$l_f" name)"; l_steps="$(int_or_zero "$(field "$l_f" steps)")"
  l_summary="$(field "$l_f" summary)"; l_step="$(int_or_zero "$(field "$l_f" step)")"
  l_started="$(int_or_zero "$(field "$l_f" started)")"
  l_dur=$(( $(int_or_zero "$(field "$l_f" finished)") - l_started ))
  [ "$l_dur" -lt 0 ] && l_dur=0
  ledger_close_line_out="$(ledger_line "$2" "$l_name" "$l_steps" "$l_summary" \
    "$l_step" "$(field "$l_f" phase)" "$l_dur" \
    "$(rounds_completed "$l_step")" "$(rounds_planned "$l_steps")")"
  printf '%s' "$ledger_close_line_out"
}

# ------------------------------------------------------------ the pending-apply marker
#
# A FORGE THAT ENDS AT "INSTALLED" HAS BUILT A TOOL AND LEFT THE PROBLEM WHERE IT WAS.
# The skill was forged because something was in front of somebody; the loop closes when
# that something is dealt with USING the skill, and until this existed nothing in the
# package could tell the two apart. The ledger showed a `done` row and a skill directory,
# and both are true of a forge whose output nobody ever opened.
#
# So `done` leaves a marker behind: one small JSON file naming the skill, the forge, where
# the skill landed, what set the forge off, when it closed and whether it installed. It is
# a DEBT, and `apply` is the only thing that pays it. Three consumers read it -- the status
# line segment, hooks/apply-gate.sh on Stop, and `skillforge pending` -- and the on-disk
# shape is the contract between them, so it is written here and nowhere else.
#
# `fail` WRITES NO MARKER: an abandoned forge produced nothing to apply, and a debt nobody
# can discharge is a permanent false alarm that teaches every reader to ignore the queue.
# A `done` THAT INSTALLED NOTHING STILL WRITES ONE, with installed:false. That is exactly
# the case that must not be forgotten quietly -- a forge that ran its rounds and produced
# a skill nobody could invoke is the loudest thing this package can find, and the old
# behaviour was to print one line to a terminal that scrolls.

# The filename component for a name. The SAME expression every script in this package
# uses for the same job (hooks/compound-improvement.sh claim_once, insight-capture.sh):
# one spelling, or one skill becomes two entries under two spellings and the debt is paid
# against the wrong file.
#
# `tr -c` is MANY-TO-ONE, and unlike forge_id -- which refuses an unsafe id rather than
# repairing it, because two live forges sharing one claim cannot both be closed -- a
# collision here is tolerable and deliberate: `a/b` and `a:b` share a marker, so the
# second `done` overwrites the first marker rather than adding one. The cost is a lost
# reminder for a name shape no skill directory can have (a skill name IS a directory
# name), against a filename that is guaranteed openable on every filesystem. `printf '%s'`
# and not `echo`: a name of `-n` or `-e` is otherwise eaten by the builtin.
safe_name() { # <name>
  sn="$(printf '%s' "${1:-}" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-96)"
  [ -n "$sn" ] || sn="_"
  printf '%s' "$sn"
}

apply_marker_path() { # <skill name>
  printf '%s/%s.json' "$APPLY_DIR" "$(safe_name "$1")"
}

# Written by `done`, atomically, through a temp file and a rename -- the status line reads
# this directory once a second and hooks/apply-gate.sh reads it at the end of every turn,
# so a plain redirect would put a half-written file in front of both. Same reasoning as
# the forge slot itself; see `start`.
#
# A failure here NEVER breaks `done`. The forge closed, the ledger row is already on disk,
# and a marker that could not be written is a missing reminder, not a missing record.
#
# `forge_id` IS WHAT MAKES ONE DEBT DISTINGUISHABLE FROM THE NEXT. The name is not enough
# and neither is name+session: re-forging a skill after a red-team fix is this protocol's
# own prescribed workflow, so one session routinely closes two forges of one name and owes
# two separate debts. `apply` keys its idempotence claim on this value, so without it the
# second debt was swallowed by the first apply's claim -- the row was never written and the
# marker was deleted anyway, taking the evidence with it. It is the id `close_forge` used
# for its own outcome claim, so the two agree by construction and it is unique per forge.
apply_marker_write() { # <skill name> <forge name> <skill dir> <trigger> <trigger kind>
                       # <summary> <closed epoch> <installed true|false> [forge id]
  am_name="${1:-}"; [ -n "$am_name" ] || return 0
  mkdir -p "$APPLY_DIR" 2>/dev/null || return 0
  am_path="$(apply_marker_path "$am_name")"
  am_tmp="$am_path.tmp.$$"
  { jq -n -c --arg name "$am_name" --arg forge "${2:-}" --arg dir "${3:-}" \
      --arg trigger "${4:-}" --arg tkind "${5:-}" --arg summary "${6:-}" \
      --argjson closed "$(int_or_zero "${7:-0}")" \
      --arg session "${CLAUDE_CODE_SESSION_ID:-}" \
      --argjson installed "${8:-false}" --arg fid "${9:-}" \
      '{name:$name, forge:$forge, skill_dir:$dir, trigger:$trigger,
        trigger_kind:$tkind, summary:$summary, closed:$closed,
        session:$session, installed:$installed}
       + (if $fid == "" then {} else {forge_id:$fid} end)' > "$am_tmp"; } 2>/dev/null \
    || { rm -f "$am_tmp" 2>/dev/null; return 0; }
  mv "$am_tmp" "$am_path" 2>/dev/null || rm -f "$am_tmp" 2>/dev/null
  return 0
}

# Every marker on disk, oldest CLOSE first, one compact JSON object per line with an `age`
# added. `find` and not a glob, for the reason slots() gives: an unmatched glob is fatal
# under zsh. A file that does not parse is skipped and never deleted -- the same rule the
# forge slots follow, and for the same reason: a half-written file from a concurrent
# writer, or a marker from a future version, must not take the queue down.
apply_markers() { # -> compact JSON per line
  [ -d "$APPLY_DIR" ] || return 0
  find "$APPLY_DIR" -maxdepth 1 -type f -name '*.json' 2>/dev/null | while IFS= read -r m_f; do
    jq -c --argjson now "$(now)" --arg path "$m_f" \
      'select((has("name")) and ((.name|type) == "string") and (.name | length > 0))
       | . + {age: ($now - (.closed // $now)), path: $path}' "$m_f" 2>/dev/null
  done | jq -s -c 'sort_by(.closed // 0, .name)[]' 2>/dev/null
}

# The names that are pending, as one comma-separated line, for the message `apply` prints
# when it is asked to discharge a debt that does not exist. Saying only "nothing is
# pending for X" leaves a caller who typo-ed the name with no way to see the right one.
apply_pending_names() {
  apply_markers | jq -r '.name' 2>/dev/null \
    | while IFS= read -r p_n; do printf '%s, ' "$p_n"; done | sed 's/, $//'
}

# Seconds as something a person reads at a glance. Deliberately coarse: the queue is
# answering "has this been sitting here", not "how long exactly", and a bare second count
# for a two-day-old marker is a number the reader has to do arithmetic on.
ago() { # <seconds>
  a_s="$(int_or_zero "${1:-0}")"
  if   [ "$a_s" -lt 60 ];    then printf '%ss' "$a_s"
  elif [ "$a_s" -lt 3600 ];  then printf '%sm' "$(( a_s / 60 ))"
  elif [ "$a_s" -lt 86400 ]; then printf '%sh' "$(( a_s / 3600 ))"
  else                            printf '%sd' "$(( a_s / 86400 ))"
  fi
}

# ------------------------------------------------------------------- outcome claim
#
# EXACTLY ONE OUTCOME ROW PER FORGE, WITH NO LOCK ANYWHERE. Two concurrent `done`s both
# passed require_active -- both read `status: active`, because neither had written yet --
# and both appended, so the ledger counted one forge twice: 40 of 40 trials. A `fail`
# racing a `done` and a `clear` racing a `done` did the same, 40 of 40 each. The ledger is
# the only evidence this protocol produces about itself, so a duplicate row is not a
# cosmetic defect.
#
# The outcome is claimed the way a SLOT is claimed, by `ln` of a fully-written file onto a
# path that has never been used before: a hard link either appears atomically or fails
# because the name is taken. Exactly one process links it, the losers exit, and NOTHING IS
# HELD -- a killed process leaves no lock behind because there was none, which is why this
# is not a portable-lock scheme wearing a different hat. The claim path is named after the
# forge's id, which `start` writes into the record before publishing the slot and which is
# never reused, so a claim can only ever refer to the one forge that created it.
#
# The order is: build the closed record, build the ledger line, claim, append, publish.
# Everything that forks a process happens BEFORE the claim -- the same reasoning that
# warms project_root() ahead of the slot claim in `start` -- so the interval between
# winning the claim and having the row on disk is one `printf` builtin.
#
# WHAT A KILL AT EACH STEP LEAVES BEHIND:
#   before the claim      nothing; the forge is untouched and still active. Retry closes it.
#   after ln, before the  no row, no claim beyond the file itself, slot still active. The
#   append                next `done` finds the claim taken, heals the slot from the
#                         claim's own copy of the record, and reports it already closed.
#                         One outcome is missing from the ledger and the ledger says so:
#                         that start reads "never closed out". The window is one builtin.
#   after the append,     the row is on disk and the slot is still active. Same heal: the
#   before the publish    next `done`, `fail` or `clear` republishes the winner's record
#                         and appends nothing. No second row, and the forge closes.
#   after the publish     the forge is closed, the row is written; there is nothing left
#                         to do and nothing left to go wrong.
# No path leaves a forge that cannot be closed, because no path leaves anything a later
# invocation has to wait for.
#
# WHICH OF A RACING done AND fail WINS: whichever links the claim first. There is no
# priority between them, and there deliberately is none -- both are outcomes, both are
# true reports of what their caller believed, and picking one by kind would mean the
# ledger recorded the outcome that arrived second. The loser exits 0 saying the forge was
# already closed out, which is what the caller of a second close is told today.

# Publish a closed record onto a slot -- but only while that slot is still the forge the
# record belongs to.
#
# THE WINNER NEEDS THIS GUARD EXACTLY AS MUCH AS THE HEALER DOES. Left unguarded it was
# not a theoretical window but an unbounded one: SIGSTOP a closer between the claim and
# the publish, let another process heal the forge, `start` the same name again, then
# SIGCONT -- and the 6-step forge that was live was replaced by the 4-step corpse. That
# second forge then had no outcome row and could never be closed, because its own claim
# had never been taken. `done` answered "already closed out" forever. A stopped process
# is the extreme case; a loaded machine is the ordinary one.
#
# The check does not make the publish atomic -- a `start` landing between the test and the
# `mv` still loses -- but it bounds the exposure to two adjacent statements instead of to
# however long a process can be suspended.
publish_close() { # <staged record> <slot file> <the id it was staged for>
  if [ "$(field "$2" status)" = "active" ] && [ "$(forge_id "$2")" = "$3" ]; then
    mv "$1" "$2" 2>/dev/null || rm -f "$1" 2>/dev/null
  else
    rm -f "$1" 2>/dev/null
  fi
}

# Returns 0 if this process owns the outcome, 1 if another process does. Sets CLOSED_NAME.
close_forge() { # <slot file> <status to write> <event> <phase> [keep|drop]
  cf_f="$1"; cf_status="$2"; cf_event="$3"; cf_phase="$4"; cf_mode="${5:-keep}"
  # Set BEFORE the early return: a `clear` that removed the slot between require_active
  # and here sends the caller straight to closed_out, which reads this, and under `set -u`
  # an unset variable is not a missing word in a sentence, it is `CLOSED_NAME: unbound
  # variable` on stderr and a non-zero exit from a `done` that did nothing wrong.
  CLOSED_NAME="${RESOLVED_NAME:-}"
  # Same reasoning, same place: an id is INTERNAL STATE, and a variable this file reads
  # with a `:-` default but never assigns on some path is a variable the ambient
  # environment can supply. The early return below is that path.
  CLOSED_ID=""
  [ -f "$cf_f" ] || return 1
  cf_id="$(forge_id "$cf_f")"
  # Published for the caller, because `done` needs the id of the forge IT closed and
  # cannot re-derive it from the slot afterwards: publish_close may legitimately decline
  # to publish (a `start` raced it), leaving a DIFFERENT forge in that file. Reading the
  # slot again there would stamp the pending-apply marker with the new forge's identity.
  CLOSED_ID="$cf_id"
  cf_claim="$DIR/.outcome.$cf_id.claim"
  cf_tmp="$cf_f.tmp.$$"
  # The closed record is written COMPLETE, to a temp file, before anything is claimed --
  # the same ordering `start` uses, and for the same reason: what appears at a claimed
  # path is never a placeholder, so the loser below can publish it unread. The whole group
  # is wrapped because a redirect that cannot open its target is reported by the SHELL.
  { jq --arg p "$cf_phase" --arg s "$cf_status" --argjson now "$(now)" \
       '.status = $s | .phase = $p | .updated = $now | .finished = $now
        | (if $s == "done"
           then .step = (if .step > .steps then .step else .steps end) else . end)' \
       "$cf_f" > "$cf_tmp"; } 2>/dev/null \
    || { rm -f "$cf_tmp" 2>/dev/null; die "could not update $cf_f"; }
  CLOSED_NAME="$(sfield "$cf_tmp" name)"
  cf_line="$(ledger_close_line "$cf_tmp" "$cf_event")"

  if ln "$cf_tmp" "$cf_claim" 2>/dev/null; then
    :
  elif [ -e "$cf_claim" ]; then
    # Lost. Someone else's outcome is the one the ledger will carry.
    rm -f "$cf_tmp" 2>/dev/null
    # If the winner has not published yet -- or was killed before it could -- finish its
    # work rather than leaving a forge that shows as running forever. The record comes
    # from the CLAIM, never from this process, so whichever of the two writes it last
    # writes the same bytes.
    cf_heal="$cf_f.tmp.$$.heal"
    if ln "$cf_claim" "$cf_heal" 2>/dev/null; then
      publish_close "$cf_heal" "$cf_f" "$cf_id"
    fi
    return 1
  fi
  # `ln` failed and no claim is there to explain it: the directory has gone read-only, or
  # the filesystem refused the link. Proceed. The claim exists to stop a duplicate row,
  # and a claim that cannot be created must never become a reason a forge cannot be
  # closed -- that is the failure mode a lock would have had.
  if [ -n "$cf_line" ]; then printf '%s\n' "$cf_line" 2>/dev/null >> "$LEDGER" || true; fi
  if [ "$cf_mode" = "keep" ]; then
    publish_close "$cf_tmp" "$cf_f" "$cf_id"
  else
    rm -f "$cf_tmp" 2>/dev/null
  fi
  return 0
}

# What a closer prints when another process owned the outcome. Deliberately the same
# sentence require_active prints for a `done` typed after the forge was closed: to the
# caller the two are the same situation -- the forge is closed, and this call is not what
# closed it.
closed_out() { # <slot file>
  co_st="$(field "$1" status)"
  [ -n "$co_st" ] || co_st="cleared"
  echo "skillforge: '$CLOSED_NAME' was already closed out (status: $co_st); nothing to do"
  exit 0
}

# ------------------------------------------------------ installing what was forged
#
# A FORGE THAT ENDS WITH AN UNUSABLE SKILL HAS NOT FINISHED. `skills/<name>/SKILL.md`
# written during a session is invisible to that session until something links it into
# the directory Claude Code reads, and only the installer ever made those links -- so a
# skill forged and red-teamed through ten rounds answered `Unknown skill` for the rest
# of the day, and the usage report showed it with 0 uses. That reads as "nobody
# bothered", when the truth was that nobody could.
#
# THE OWNERSHIP JUDGEMENT IS NOT REIMPLEMENTED HERE. `skill_compounder/installer.py`
# decides by four independent proofs of authorship whether a link at a destination is
# one this package made (`_link_is_ours`). A second, shell-flavoured version of that
# test would be the weaker one, and this package has twice destroyed a user's own
# skills by being permissive about what counts as ours. `done` shells out to the one
# implementation. python3 missing is reported, loudly, as a failure to install -- never
# as a silent skip, because a silent skip leaves the user believing it worked.

# The checkout this script belongs to, following however many symlinks lie between the
# name that was typed and bin/skillforge. `readlink -f` is GNU-only and `realpath` is
# not on every macOS, so the loop is hand-rolled.
APP_HOME_CACHE=""
app_home() {
  if [ -z "$APP_HOME_CACHE" ]; then
    ah_p="$0"; ah_n=0
    while [ -L "$ah_p" ] && [ "$ah_n" -lt 32 ]; do
      ah_t="$(readlink "$ah_p")"
      case "$ah_t" in /*) ah_p="$ah_t" ;; *) ah_p="$(dirname "$ah_p")/$ah_t" ;; esac
      ah_n=$(( ah_n + 1 ))
    done
    APP_HOME_CACHE="$(cd "$(dirname "$ah_p")/.." 2>/dev/null && pwd)"
  fi
  printf '%s' "$APP_HOME_CACHE"
}

abspath() { # <path> -> absolute, with trailing slashes stripped so basename is right
  ap_p="$1"
  case "$ap_p" in /*) : ;; *) ap_p="$PWD/$ap_p" ;; esac
  while :; do case "$ap_p" in ?*/) ap_p="${ap_p%/}" ;; *) break ;; esac; done
  printf '%s' "$ap_p"
}

# Where a skill has to land to be visible. In order: an explicit override (tests, and
# anyone whose layout is unusual), the claude_dir this package was actually installed
# into, and only then the default location.
# WHERE CLAUDE CODE'S OWN CONFIG LIVES, resolved once and in one place. `doctor` reads
# settings.json out of here and `skills_dest` hangs skills/ off it, and the two must agree:
# a doctor that checks the wiring in one directory while `done` installs into another
# reports a healthy install of something nobody is running.
claude_dir() {
  cd_c="$(jq -r '.claude_dir // empty' "$STATE_ROOT/install-manifest.json" 2>/dev/null)"
  [ -n "${cd_c:-}" ] || cd_c="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  printf '%s' "$cd_c"
}

skills_dest() {
  if [ -n "${SKILLFORGE_SKILLS_DIR:-}" ]; then printf '%s' "$SKILLFORGE_SKILLS_DIR"; return 0; fi
  printf '%s/skills' "$(claude_dir)"
}

# WHERE THE SKILL IS. Answered in this order:
#   1. --skill-dir on this command.
#   2. --skill-dir recorded by `start`, which is the only way a skill written somewhere
#      unconventional is findable at all. A record written before this field existed
#      simply does not have it, and falls through to the search below -- which is why
#      the search is not conditional on the record.
#   3. The two conventional layouts, under the repository `start` recorded first, then
#      under the repository (or plain directory) we are standing in now.
# Sets FOUND and FOUND_SCOPE: explicit, personal (a repo's skills/), project (a repo's
# .claude/skills/, which Claude Code already loads for that repo and nowhere else).
find_skill_dir() { # <name> <record file, or empty>
  FOUND=""; FOUND_SCOPE=""
  fs_n="$1"; fs_rec="${2:-}"; fs_root=""
  if [ -n "$SKILLDIR_OPT" ]; then FOUND="$SKILLDIR_OPT"; FOUND_SCOPE="explicit"; return 0; fi
  # A name that is not one path component cannot be a directory name under skills/.
  case "$fs_n" in ''|*/*|.|..) return 1 ;; esac
  if [ -n "$fs_rec" ] && [ -f "$fs_rec" ]; then
    fs_d="$(field "$fs_rec" skill_dir)"
    if [ -n "$fs_d" ]; then FOUND="$fs_d"; FOUND_SCOPE="explicit"; return 0; fi
    fs_root="$(field "$fs_rec" root)"
  fi
  for fs_b in "$fs_root" "$(project_root)" "$PWD"; do
    [ -n "$fs_b" ] || continue
    if [ -f "$fs_b/skills/$fs_n/SKILL.md" ]; then
      FOUND="$fs_b/skills/$fs_n"; FOUND_SCOPE="personal"; return 0
    fi
    if [ -f "$fs_b/.claude/skills/$fs_n/SKILL.md" ]; then
      FOUND="$fs_b/.claude/skills/$fs_n"; FOUND_SCOPE="project"; return 0
    fi
  done
  return 1
}

# Always prints exactly one line saying what happened, whatever happened. Sets
# INSTALL_STATUS and returns the installer's exit status, which `install` reports and
# `done` does not: the forge closed either way, and a `done` that exits non-zero would
# be read as a close that failed.
install_forged_skill() { # <name> <record file, or empty>
  INSTALL_STATUS=""
  ins_n="$1"; ins_rec="${2:-}"
  if [ "${SKILLFORGE_NO_INSTALL:-0}" = "1" ]; then INSTALL_STATUS="disabled"; return 0; fi
  ins_dest="$(skills_dest)"
  if ! find_skill_dir "$ins_n" "$ins_rec"; then
    # Not every forge writes a skill: a fix, a retirement or a red-team round does not.
    # A skill ALREADY sitting at that name in the destination is NOT evidence that this
    # forge produced one -- it is far more likely to be the user's own, and reporting it
    # as "already installed" told someone their forge had landed when nothing had.
    INSTALL_STATUS="not-found"
    ins_note=""
    [ -f "$ins_dest/$ins_n/SKILL.md" ] && ins_note=" (something else called '$ins_n' is already at $ins_dest/$ins_n; this forge did not put it there)"
    echo "skillforge: no SKILL.md was found for '$ins_n', so nothing was installed (looked under skills/ and .claude/skills/ in $(project_root))$ins_note. If the skill is somewhere else: skillforge install '$ins_n' --skill-dir <dir>"
    return 0
  fi
  # A skill under <repo>/.claude/skills/ is ALREADY loaded, for that repository. Linking
  # it into the personal directory would widen a scope its author chose, in every other
  # project, without being asked. Say where it is instead. An explicit --skill-dir IS
  # the author asking, so that path installs.
  if [ "$FOUND_SCOPE" = "project" ]; then
    INSTALL_STATUS="project"
    echo "skillforge: '$(basename "$FOUND")' is a project skill at $FOUND — already live for this project, and not linked into $ins_dest, which would have widened a scope its author chose. To make it available everywhere: skillforge install '$(basename "$FOUND")' --skill-dir '$FOUND'"
    return 0
  fi
  # THE NAME THAT GOES LIVE IS THE DIRECTORY'S, NOT THE FORGE'S. Claude Code resolves a
  # skill by the directory it sits in, so `--skill-dir .../real-name` under a forge called
  # `typo-name` installs `real-name` -- and a message that said "installed 'typo-name'"
  # promised a skill that would answer `Unknown skill` forever. Report what is true, and
  # say so when the two differ rather than picking one and hoping.
  ins_base="$(basename "$FOUND")"
  ins_py="$(app_home)/skill_compounder/installer.py"
  if ! command -v python3 >/dev/null 2>&1 || [ ! -f "$ins_py" ]; then
    INSTALL_STATUS="failed"
    echo "skillforge: NOT INSTALLED — '$ins_base' is written at $FOUND but could not be linked into $ins_dest: this needs python3 and $ins_py. Until then the skill does not exist as far as any session is concerned. Link it by hand with: ln -s '$FOUND' '$ins_dest/$ins_base'" >&2
    return 4
  fi
  ins_out="$(python3 "$ins_py" link-skill --skill-dir "$FOUND" --skills-dir "$ins_dest" \
             --app-home "$(app_home)" --state-dir "$STATE_ROOT" 2>/dev/null)"
  ins_rc=$?
  INSTALL_STATUS="$(printf '%s' "$ins_out" | jq -r '.status // empty' 2>/dev/null)"
  ins_msg="$(printf '%s' "$ins_out" | jq -r '.message // empty' 2>/dev/null)"
  ins_warn="$(printf '%s' "$ins_out" | jq -r '.warning // empty' 2>/dev/null)"
  ins_old="$(printf '%s' "$ins_out" | jq -r '.displaced // empty' 2>/dev/null)"
  ins_decl="$(printf '%s' "$ins_out" | jq -r '.declared_name // empty' 2>/dev/null)"
  ins_alias=""
  [ "$ins_base" = "$ins_n" ] || ins_alias=" — NOTE: the forge is called '$ins_n' but the skill directory is '$ins_base', so '$ins_base' is the name that answers"
  case "${INSTALL_STATUS:-}" in
    linked)
      echo "skillforge: installed '$ins_base' → $ins_dest/$ins_base — no restart; if Skill still says \"Unknown skill\", make one more tool call and retry$ins_alias"
      if [ -n "${ins_old:-}" ]; then
        echo "skillforge: that replaced an earlier link of ours, which pointed at $ins_old"
      fi ;;
    already-linked|already-there)
      echo "skillforge: '$ins_base' was already installed at $ins_dest/$ins_base$ins_alias" ;;
    refused)
      echo "skillforge: NOT INSTALLED — $ins_msg" >&2
      echo "skillforge: '$ins_base' is still only at $FOUND, so nothing can invoke it yet. Free that name — move or rename what holds it — then: skillforge install '$ins_base' --skill-dir '$FOUND'" >&2 ;;
    failed|error)
      # The name is not the problem here: the directory is read-only, or what was pointed
      # at is not a skill. Telling the user to free a name they already own sends them to
      # do something that changes nothing and fails again.
      echo "skillforge: NOT INSTALLED — $ins_msg" >&2
      echo "skillforge: '$ins_base' is still only at $FOUND, so nothing can invoke it yet. Fix what that says, then: skillforge install '$ins_base' --skill-dir '$FOUND'" >&2 ;;
    *)
      INSTALL_STATUS="failed"
      echo "skillforge: NOT INSTALLED — could not link '$ins_base' from $FOUND into $ins_dest${ins_out:+ ($ins_out)}" >&2 ;;
  esac
  # Reported for every outcome, including the ones that installed cleanly: a directory
  # and a frontmatter `name:` that disagree is an authoring mistake, and install time is
  # the last moment anyone looks.
  if [ -n "${ins_decl:-}" ]; then
    echo "skillforge: WARNING — $FOUND/SKILL.md declares 'name: $ins_decl' but the directory is '$ins_base'. Make the two agree (see the skill-authoring skill); until then it is not certain which name a session will resolve." >&2
  fi
  if [ -n "${ins_warn:-}" ]; then echo "skillforge: $ins_warn" >&2; fi
  return "$ins_rc"
}


# --------------------------------------------------------------------------- doctor
#
# WHY THIS IS A SURFACE AND NOT A LOG. Every hook in this package opens with
# `command -v jq >/dev/null 2>&1 || exit 0` and `mkdir -p "$STATE_DIR" 2>/dev/null || exit 0`,
# and both of those are RIGHT: a hook that fails a turn is worse than a hook that does
# nothing. The price is that a missing jq, a state directory that has gone read-only, a
# SKILL_COMPOUNDER_STATE pointing somewhere that no longer exists, a settings.json that
# stopped parsing, or a skills symlink left dangling by a moved checkout silences the whole
# package -- no error, no status-line segment, no ledger row, nothing anywhere saying so.
# Every one of those is quiet in EXACTLY the same way a package with nothing to say is
# quiet, which is why none of them has ever been noticed from the inside.
#
# THE VERDICT IS THE FIRST WORD, so the output greps, and there are three of them:
#   FAIL  this package is not doing something it says it does.
#   WARN  look at it; it may be a deliberate choice. The plugin wiring cannot carry a
#         statusLine, a fresh install has no ledger, an idle forge may still be live work.
#   PASS  the check ran and found nothing.
# ONLY FAIL SETS THE EXIT STATUS. A WARN that failed the command would be switched off
# inside a week, and every FAIL would go with it.
#
# NOTHING HERE CHANGES STATE except one probe file, written and immediately removed to
# answer the one question `[ -w ]` cannot (below). `doctor` never reaps, never installs and
# never repairs: a health surface that edits what it is measuring cannot be run twice.
DOCTOR_FAILED=0
DOCTOR_PASS=0
DOCTOR_WARN=0
DOCTOR_FAIL_N=0
# `--json` mode: DOCTOR_JSON=1 switches `dr` from printing a text line to appending a
# compact JSON object to DOCTOR_JSON_CHECKS instead. Counts and the exit status are
# computed the SAME WAY in both modes -- only how a check is reported changes -- so
# `--json` and the text form can never disagree about how many passed.
DOCTOR_JSON=0
DOCTOR_JSON_CHECKS=()
dr() { # <PASS|WARN|FAIL> <label> <detail...>
  dr_v="$1"; dr_l="$2"; shift 2
  case "$dr_v" in
    FAIL) DOCTOR_FAILED=1; DOCTOR_FAIL_N=$(( DOCTOR_FAIL_N + 1 )) ;;
    WARN) DOCTOR_WARN=$(( DOCTOR_WARN + 1 )) ;;
    *)    DOCTOR_PASS=$(( DOCTOR_PASS + 1 )) ;;
  esac
  if [ "$DOCTOR_JSON" -eq 1 ]; then
    DOCTOR_JSON_CHECKS[${#DOCTOR_JSON_CHECKS[@]}]="$(jq -n -c --arg n "$dr_l" --arg s "$dr_v" --arg d "$*" \
      '{name:$n,status:$s,detail:$d}')"
    return 0
  fi
  # The detail is an ARGUMENT to %s and never part of the format, so a `%` inside it --
  # a path, a jq program, a settings.json command line -- is printed and not interpreted.
  printf '%-4s  %-10s  %s\n' "$dr_v" "$dr_l" "$*"
}
# A continuation line, indented past the verdict column so it cannot be mistaken for one.
# `--json`'s contract is "nothing else on stdout" besides the one object, so in that mode
# this is silent; the check it would have annotated still carries its own verdict and
# detail, which is what the JSON counts are built from.
dr_note() { [ "$DOCTOR_JSON" -eq 1 ] && return 0; printf '            %s\n' "$*"; }

# THE MARKERS ARE READ FROM skill_compounder/installer.py, NEVER COPIED. They are the
# installer's own definition of which settings.json entries are ours, and a copy that
# drifted would have `doctor` report a wiring nobody has -- passing against markers the
# installer stopped writing, or failing against ones it started writing. `sed`, not
# `python3`: python3 is the installer's dependency, not this script's, and a doctor that
# needs an interpreter the machine may not have is one more thing to be silently absent.
APP_ROOT=""
app_root() {
  [ -n "$APP_ROOT" ] || APP_ROOT="$(app_home)"
  printf '%s' "$APP_ROOT"
}
installer_py() { printf '%s/skill_compounder/installer.py' "$(app_root)"; }
installer_const() { # <CONSTANT NAME> -> its string value, or nothing
  ic_f="$(installer_py)"
  [ -f "$ic_f" ] || return 1
  sed -n "s/^$1 = \"\\(.*\\)\"[[:space:]]*\$/\\1/p" "$ic_f" | head -n 1
}
# Every marker naming a hook SCRIPT, whatever it is called and however many there are.
# Listing the seven of them by name here would be an eighth place to update on the day an
# eighth hook lands, and the one that got missed would look exactly like a hook the user
# had removed. STATUSLINE_MARKER falls out on the `.sh`: it is a shell comment, not a file.
installer_hook_markers() {
  ih_f="$(installer_py)"
  [ -f "$ih_f" ] || return 1
  sed -n 's/^[A-Z_]*MARKER = "\(.*\)"[[:space:]]*$/\1/p' "$ih_f" | grep '\.sh$' | sort -u
}

doctor_jq() {
  dj_p="$(command -v jq 2>/dev/null || true)"
  if [ -z "$dj_p" ]; then
    # UNREACHABLE FROM HERE TODAY, and kept anyway: this script refuses at its own
    # `command -v jq` guard a hundred lines above, so a jq-less machine gets that message
    # rather than this one. The line stays because the CHECK is about the package and not
    # about this CLI -- every hook exits 0 without jq and says nothing at all -- and
    # because a `doctor` whose jq row simply vanished would read as a doctor with fewer
    # checks rather than a machine with no jq.
    dr FAIL jq "jq is not on PATH. Every hook in this package exits 0 without it, silently, and that is the whole failure."
    return 0
  fi
  # SKILLFORGE_DOCTOR_JQ_VERSION pins the version string, exactly as SKILLFORGE_NOW pins
  # the clock and for the same reason: the too-old branch below is otherwise reachable
  # only by installing a jq from 2015, and a guard nobody has watched fire is a guard
  # nobody has watched at all. It pins the STRING, not the answer -- the comparison under
  # test is the real one.
  dj_v="${SKILLFORGE_DOCTOR_JQ_VERSION:-}"
  [ -n "$dj_v" ] || dj_v="$(jq --version 2>/dev/null || true)"
  dj_n="${dj_v#jq-}"
  dj_maj="${dj_n%%.*}"
  dj_rest="${dj_n#*.}"; dj_min="${dj_rest%%.*}"
  case "$dj_maj" in ''|*[!0-9]*) dj_maj="" ;; esac
  case "$dj_min" in ''|*[!0-9]*) dj_min="" ;; esac
  if [ -z "$dj_maj" ] || [ -z "$dj_min" ]; then
    dr WARN jq "$dj_p answers '$dj_v', which is not a version this can compare. 1.6 or newer is what the package is written against."
    return 0
  fi
  # 1.6 AND THE EVIDENCE FOR IT: `skillforge backfill` runs jq with --rawfile, which jq
  # gained in 1.6, and hooks/doc-gate.sh records the same floor from the other side. Not a
  # guess at what "modern jq" means -- one measured feature, in this file, at this version.
  if [ "$dj_maj" -lt 1 ] || { [ "$dj_maj" -eq 1 ] && [ "$dj_min" -lt 6 ]; }; then
    dr FAIL jq "$dj_v at $dj_p is older than 1.6, which is the floor: 'skillforge backfill' passes --rawfile, and jq did not have it before 1.6."
    return 0
  fi
  dr PASS jq "$dj_v at $dj_p"
}

doctor_state() {
  ds_src="the default"
  [ -n "${SKILL_COMPOUNDER_STATE:-}" ] && ds_src="SKILL_COMPOUNDER_STATE"
  if [ ! -d "$STATE_ROOT" ]; then
    dr FAIL state "$STATE_ROOT does not exist and could not be created (from $ds_src)."
    return 0
  fi
  # A REAL WRITE, NOT `[ -w ]`. access(2) answers out of the permission bits, and is wrong
  # about a read-only mount, an ACL that denies what the bits allow, and a full filesystem
  # -- three of the ways this directory actually stops accepting writes. The probe is
  # removed immediately; it is the only thing `doctor` writes anywhere.
  ds_probe="$STATE_ROOT/.doctor-probe.$$"
  if ( : > "$ds_probe" ) 2>/dev/null; then
    rm -f "$ds_probe" 2>/dev/null
    dr PASS state "$STATE_ROOT is writable (from $ds_src)"
  else
    dr FAIL state "$STATE_ROOT (from $ds_src) will not accept a write. Every hook here does 'mkdir -p ... || exit 0' and then goes quiet, so nothing else will ever tell you."
  fi
}

doctor_settings() {
  dx_f="$(claude_dir)/settings.json"
  if [ ! -f "$dx_f" ]; then
    dr WARN settings "no $dx_f, so nothing here is wired through the installer path"
    return 0
  fi
  if ! jq -e . "$dx_f" >/dev/null 2>&1; then
    dr FAIL settings "$dx_f does not parse as JSON. Claude Code disables EVERY setting in a malformed file, not only ours."
    return 0
  fi
  dx_markers="$(installer_hook_markers)"
  if [ -z "$dx_markers" ]; then
    dr WARN settings "$dx_f parses, but the hook markers cannot be read from $(installer_py), so the wiring cannot be checked against anything but a duplicate of that list."
    return 0
  fi
  dx_cmds="$(jq -r '[(.hooks // {}) | to_entries[] | .value[]? | (.hooks // [])[]? | (.command // "")] | .[]' "$dx_f" 2>/dev/null)"
  dx_have=0; dx_missing=""
  while IFS= read -r dx_m; do
    [ -n "$dx_m" ] || continue
    # `tr -cd '0-9'` on the count: BSD `grep -c` and `wc` pad with a leading space, and a
    # numeric guard that reads that space as non-numeric has already zeroed one cap here.
    dx_c="$(int_or_zero "$(printf '%s\n' "$dx_cmds" | grep -c -F -- "$dx_m" 2>/dev/null | tr -cd '0-9')")"
    [ "$dx_c" -eq 0 ] && dx_missing="$dx_missing${dx_missing:+, }$dx_m"
    dx_have=$(( dx_have + dx_c ))
  done <<MARKERS
$dx_markers
MARKERS
  # The expected count comes from hooks/hooks.json, which is the plugin wiring of the same
  # scripts to the same events. tests/test_plugin.py already pins the two against each
  # other, so counting against it here cannot drift from what install.sh writes.
  dx_want="$(int_or_zero "$(jq '[(.hooks // {}) | to_entries[] | .value[]? | (.hooks // [])[]?] | length' "$(app_root)/hooks/hooks.json" 2>/dev/null)")"
  if [ "$dx_want" -eq 0 ]; then
    dr WARN settings "$dx_have entry/entries of ours in $dx_f, but $(app_root)/hooks/hooks.json could not be read for the expected count"
  elif [ "$dx_have" -eq "$dx_want" ]; then
    dr PASS settings "$dx_have/$dx_want hook entries wired in $dx_f"
  elif [ "$dx_have" -eq 0 ]; then
    dr WARN settings "none of our $dx_want hook entries are in $dx_f. Expected if this repo is loaded as a PLUGIN, which carries hooks/hooks.json instead; a fault if install.sh was ever run."
  elif [ "$dx_have" -lt "$dx_want" ]; then
    dr FAIL settings "$dx_have of $dx_want hook entries wired; not wired to anything: $dx_missing. A PARTIAL wiring is the shape that silences one event and leaves the rest working, so nothing downstream will report it."
  else
    dr WARN settings "$dx_have hook entries against the $dx_want in hooks/hooks.json: duplicates. Everything a hook counts, stamps or does once has to survive the same event twice."
  fi
}

doctor_statusline() {
  dl_f="$(claude_dir)/settings.json"
  if [ ! -f "$dl_f" ]; then
    dr WARN statusline "no $dl_f, so the forge animation has nothing to render into"
    return 0
  fi
  dl_m="$(installer_const STATUSLINE_MARKER)"
  if [ -z "$dl_m" ]; then
    dr WARN statusline "cannot read STATUSLINE_MARKER from $(installer_py)"
    return 0
  fi
  dl_c="$(jq -r '.statusLine.command // ""' "$dl_f" 2>/dev/null)"
  case "$dl_c" in
    *"$dl_m"*) dr PASS statusline "installed, carrying the marker '$dl_m'" ;;
    '')  dr WARN statusline "no statusLine in $dl_f. The forge animation renders from there and nowhere else; a plugin install cannot carry one, so this is expected on that path." ;;
    *)   dr WARN statusline "a statusLine is set but carries no '$dl_m' marker, so the forge animation is not being rendered: $dl_c" ;;
  esac
}

doctor_skills() {
  dk_dir="$(skills_dest)"
  if [ ! -d "$dk_dir" ]; then
    dr WARN skills "no skills directory at $dk_dir, so nothing forged here can be invoked"
    return 0
  fi
  dk_here=0; dk_broken=""; dk_foreign=""
  dk_app="$(app_root)"
  while IFS= read -r dk_l; do
    [ -n "$dk_l" ] || continue
    dk_t="$(readlink "$dk_l" 2>/dev/null)"
    [ -n "$dk_t" ] || continue
    case "$dk_t" in /*) : ;; *) dk_t="$(dirname "$dk_l")/$dk_t" ;; esac
    case "$dk_t" in
      "$dk_app"/*)
        dk_here=$(( dk_here + 1 ))
        [ -e "$dk_t" ] || dk_broken="$dk_broken${dk_broken:+, }$(basename "$dk_l")" ;;
      *)
        [ -e "$dk_t" ] || dk_foreign="$dk_foreign${dk_foreign:+, }$(basename "$dk_l")" ;;
    esac
  done <<LINKS
$(find "$dk_dir" -maxdepth 1 -type l 2>/dev/null)
LINKS
  if [ -n "$dk_broken" ]; then
    dr FAIL skills "$dk_here link(s) in $dk_dir point into $dk_app and these do not resolve: $dk_broken. A dangling link is an 'Unknown skill' at the moment it is invoked, and only then."
  else
    dr PASS skills "$dk_here link(s) into this checkout, all resolve ($dk_dir)"
  fi
  # Reported, never removed, and never counted as ours. A dangling link pointing somewhere
  # else may be the user's own, or another tool's, and this package has twice destroyed a
  # user's skills by being generous about what counts as its own.
  if [ -n "$dk_foreign" ]; then
    dr_note "also dangling, pointing outside this checkout and so not ours to judge: $dk_foreign"
  fi
}

doctor_ledger() {
  if [ ! -s "$LEDGER" ]; then
    dr PASS ledger "no ledger yet at $LEDGER; nothing has been forged, which is not a fault"
    return 0
  fi
  # Counted with jq rather than with `wc`, and blank lines excluded, because the question
  # is how many ROWS there are. `-R -n` with `inputs` reads a raw line at a time and
  # `fromjson?` drops what does not parse, which is the same reader every other consumer
  # of this file uses; `jq -s` would abort on the first bad line and take the count with it.
  dg_pair="$(jq -r -R -n '[inputs | select(test("^[[:space:]]*$") | not)] as $l
                       | "\([$l[] | select((fromjson? | type) == "object")] | length) \($l | length)"' \
             < "$LEDGER" 2>/dev/null)"
  dg_ok="$(int_or_zero "$(printf '%s' "$dg_pair" | cut -d" " -f1)")"
  dg_all="$(int_or_zero "$(printf '%s' "$dg_pair" | cut -d" " -f2)")"
  if printf '%s' "$(tail -n 1 "$LEDGER" 2>/dev/null)" | jq -e 'type == "object"' >/dev/null 2>&1; then
    if [ "$dg_ok" -lt "$dg_all" ]; then
      dr WARN ledger "the last line parses, but $(( dg_all - dg_ok )) of $dg_all row(s) in $LEDGER do not. Every reader here drops those silently, so whatever they recorded is already gone from every count."
    else
      dr PASS ledger "$dg_all row(s), all parse, last one included ($LEDGER)"
    fi
  else
    dr FAIL ledger "the LAST line of $LEDGER does not parse as JSON. That is the shape a killed append leaves, and every reader here drops it silently, so the forge it was about is simply missing from the record."
  fi
}

doctor_counters() {
  dc_dir="$STATE_ROOT/reminders"
  if [ ! -d "$dc_dir" ]; then
    dr PASS counters "no $dc_dir yet; the reminder hook has not run against this state"
    return 0
  fi
  # THE FORM IS REPORTED, NOT JUDGED. The hook appends one byte per edit -- an `x` -- so
  # the count is the file SIZE, which is what makes it safe under the 4-way parallelism
  # edits actually arrive at; a read-modify-write lost 48 of 60 when it was measured. A
  # reader that expects a decimal number sees `xxxx`, and a reader that expects a tally
  # sees `4`, and each drops what it does not recognise WITHOUT SAYING SO. So this counts
  # both forms and prints which is on disk, and leaves which one is correct to whoever
  # owns the reader -- the two only have to agree, and nothing else here can see whether
  # they do.
  dc_n=0; dc_unary=0; dc_digits=0; dc_empty=0; dc_junk=""; dc_mixed=""
  while IFS= read -r dc_f; do
    [ -n "$dc_f" ] || continue
    dc_n=$(( dc_n + 1 ))
    # LC_ALL=C: BSD `tr` ABORTS on a byte that is not valid in the ambient locale, and the
    # empty string it then yields is exactly the answer this `case` reads as "empty file".
    dc_v="$(LC_ALL=C tr -d '\n\r' < "$dc_f" 2>/dev/null)"
    case "$dc_v" in
      '') dc_empty=$(( dc_empty + 1 )) ;;
      *[!0-9]*)
        case "$dc_v" in
          *[!x]*)
            # DIGITS FOLLOWED BY A TALLY IS ITS OWN THING, and it is on this machine: one
            # file here holds `36` and then 900 `x` bytes. That is a single session that
            # was counted as a decimal number, then appended to as a tally when the hook
            # changed form under it. Neither reader can add the two halves up -- one sees
            # a non-number, the other counts 902 bytes for 936 edits -- so it is called
            # out separately from a file that is simply corrupt.
            dc_head="$(printf '%s' "$dc_v" | LC_ALL=C sed 's/^[0-9]*//')"
            case "$dc_head" in
              *[!x]*) dc_junk="$dc_junk${dc_junk:+, }$(basename "$dc_f")" ;;
              *)      dc_mixed="$dc_mixed${dc_mixed:+, }$(basename "$dc_f")" ;;
            esac ;;
          *) dc_unary=$(( dc_unary + 1 )) ;;
        esac ;;
      *) dc_digits=$(( dc_digits + 1 )) ;;
    esac
  done <<COUNTERS
$(find "$dc_dir" -maxdepth 1 -type f -name '*.edits' 2>/dev/null)
COUNTERS
  dc_sum="$dc_n counter file(s): $dc_unary unary 'x' tally/tallies, $dc_digits digit string(s), $dc_empty empty"
  if [ -n "$dc_junk" ]; then
    dr FAIL counters "$dc_sum, and these are neither a tally nor a number: $dc_junk"
    [ -n "$dc_mixed" ] && dr_note "and these hold a number with a tally appended to it: $dc_mixed"
  elif [ -n "$dc_mixed" ]; then
    dr FAIL counters "$dc_sum, and these hold a decimal count with a tally appended after it: $dc_mixed. One session written under both forms; no reader can add the halves up, so those edits are lost to every count that uses them."
  elif [ "$dc_unary" -gt 0 ] && [ "$dc_digits" -gt 0 ]; then
    dr WARN counters "$dc_sum. BOTH forms are present, so a reader that takes one is dropping the other and is not saying so."
  elif [ "$dc_n" -eq 0 ]; then
    dr PASS counters "no *.edits counters in $dc_dir yet"
  else
    dr PASS counters "$dc_sum"
  fi
}

doctor_forges() {
  df_act=0; df_stale=""; df_unknown=""
  while IFS="$SEP" read -r df_st df_nm df_stt df_pth; do
    [ -n "${df_pth:-}" ] || continue
    [ "$df_stt" = "active" ] || continue
    df_act=$(( df_act + 1 ))
    df_idle="$(slot_idle "$df_pth")"
    if [ -z "$df_idle" ]; then
      df_unknown="$df_unknown${df_unknown:+, }$(label_of "$df_nm" "$df_pth")"
    elif [ "$df_idle" -ge "$ACTIVE_TTL" ]; then
      df_stale="$df_stale${df_stale:+, }$(label_of "$df_nm" "$df_pth") (idle $(fmt_age "$df_idle"))"
    fi
  done <<SLOTS
$(slots)
SLOTS
  if [ -n "$df_stale" ]; then
    dr WARN forges "$df_act active, and these have not stepped in over $(fmt_age "$ACTIVE_TTL"): $df_stale"
    dr_note "Each one holds its name against a new forge. 'skillforge reap' writes each a 'fail' row and frees the name; it never touches a forge inside the TTL."
  elif [ -n "$df_unknown" ]; then
    dr WARN forges "$df_act active, and the age of these cannot be read: $df_unknown"
  else
    dr PASS forges "$df_act active forge(s), none idle over $(fmt_age "$ACTIVE_TTL")"
  fi
  if [ -n "$df_stale" ] && [ -n "$df_unknown" ]; then
    dr_note "age unreadable, so never guessed at and never reaped: $df_unknown"
  fi
  # THE LEDGER'S OWN OPEN STARTS, which are a different set. A `start` row whose forge FILE
  # is gone -- cleared, or lost with the directory -- can never be reaped, because reap
  # closes a record and there is no record left; it stays "never closed out" in the ledger
  # forever. Counted by NAME, per the rule this file states for itself, and reported only
  # when it exceeds what is on disk, so a healthy machine says nothing.
  if [ -s "$LEDGER" ]; then
    df_open="$(int_or_zero "$(jq -R -n '
        [inputs | fromjson? // empty | select(type == "object")] as $r
        | (reduce ($r[] | select(.event == "start") | (.name // "")) as $n ({}; .[$n] = ((.[$n] // 0) + 1))) as $s
        | (reduce ($r[] | select(.event == "done" or .event == "fail") | (.name // "")) as $n ({}; .[$n] = ((.[$n] // 0) + 1))) as $e
        | [ $s | to_entries[] | (.value - ($e[.key] // 0)) | select(. > 0) ] | add // 0' \
        < "$LEDGER" 2>/dev/null)")"
    if [ "$df_open" -gt "$df_act" ]; then
      dr_note "$df_open start row(s) in the ledger have no done/fail row and $df_act still have a forge file, so $(( df_open - df_act )) cannot be reaped at all: nothing is left to close. 'skillforge ledger' lists them as never closed out."
    fi
  fi
}

# INFORMATIONAL, NOT A HEALTH CHECK: this is never anything but PASS, because whether the
# paid session review is on or off is a choice, not a fault -- doctor has no basis for
# preferring either. It exists only because nothing else surfaces the answer: the switch
# is read by hooks/session-review.sh alone, at its first gate, and that script is
# detached (started by hooks/insight-capture.sh, in neither settings.json nor
# hooks/hooks.json), so a user who wants to know whether it is live has nowhere else to
# look. The env var name and its default ("0", meaning nothing runs until the user asks
# for it) are read here exactly as hooks/session-review.sh reads them --
# REVIEW_ON="${SKILL_COMPOUNDER_REVIEW:-0}", and only the literal string "1" turns it on
# -- so this can never report a wiring that script does not itself have. The disabled
# branch carries the way to switch it on, because the user reading that line is the one
# who wants to know; the enabled branch carries the price, for the same reason.
doctor_review() {
  dv_on="${SKILL_COMPOUNDER_REVIEW:-0}"
  if [ "$dv_on" = "1" ]; then
    dr PASS review "review: enabled (SKILL_COMPOUNDER_REVIEW=1); one paid claude -p per session review, median \$0.17, and the default cooldown caps it at 8 a week (see README)"
  else
    dr PASS review "review: disabled (opt in with SKILL_COMPOUNDER_REVIEW=1 in the top-level env block of settings.json, which is where all three readers see it; see README)"
  fi
}

# `surfer` IS A DEPENDENCY, NOT A FEATURE OF THIS PACKAGE, and that is why it gets a row.
# hooks/mission.sh states the user's own requests back verbatim, and the only place those
# exist as data is claude-history-surfer's per-project JSONL -- this package deliberately
# keeps no second copy of them. So without `surfer` the mission hook still runs, still
# exits 0, and delivers nothing at any of its five moments: quiet in exactly the way a
# session with nothing to restate is quiet, which is the shape of failure `doctor` exists
# for. FAIL rather than WARN, because five wirings are pointing at it.
#
# `surfer stats` and not `surfer --version`: the question is not whether the CLI runs but
# whether it can READ ITS STORE, and a store that has moved, gone unreadable, or was never
# scaffolded answers the second question and not the first.
#
# THE VERDICT FOR A MISSING SURFER IS NOT FIXED, and the reason is doctor's own definition
# of FAIL: "this package is not doing something it says it does". A machine that wires the
# mission hook and has no surfer has five entries pointing at a hook that can never speak,
# which is exactly that. A machine that wires nothing -- a fresh checkout, a state
# directory being driven by a test, a config this doctor is only reading -- is not silently
# broken, it is simply not installed, and calling that a FAIL would put a non-fault on the
# exit status of every run. WARN there, and say what would make it a fault.
#
# THE INSTALL LINE NAMES A REPOSITORY AND NOT A PIPE-TO-SHELL ONE-LINER, deliberately:
# this file and bin/skillreport are both held to containing no network call at all
# (tests/test_ledger.py, which greps for the fetch commands by name), and such a line
# sitting in a reporting CLI is the shape that guard exists to keep out -- quoted inside a
# message or not, since a grep cannot tell those apart and should not have to.
mission_wired() {   # 0 when settings.json wires hooks/mission.sh, 1 when it does not
  mw_f="$(claude_dir)/settings.json"
  [ -f "$mw_f" ] || return 1
  mw_m="$(installer_const MISSION_MARKER)"
  [ -n "$mw_m" ] || return 1
  jq -r '[(.hooks // {}) | to_entries[] | .value[]? | (.hooks // [])[]? | (.command // "")] | .[]' \
     "$mw_f" 2>/dev/null | grep -q -F -- "$mw_m"
}
SURFER_INSTALL_HINT="Install claude-history-surfer (github.com/ContextLab/claude-history-surfer); this package's own install.sh does it for you."
doctor_surfer() {
  du_bin="${SKILLFORGE_SURFER_BIN:-}"
  if [ -n "$du_bin" ]; then
    if [ ! -x "$du_bin" ]; then
      dr FAIL surfer "SKILLFORGE_SURFER_BIN=$du_bin is not an executable file, so nothing was probed."
      return 0
    fi
  else
    du_bin="$(command -v surfer 2>/dev/null || true)"
  fi
  du_verdict=WARN
  du_because=" Nothing wires hooks/mission.sh in $(claude_dir)/settings.json, so nothing is silent yet; this becomes a fault the moment install.sh wires it, and cannot be seen from here at all if this repo is loaded as a plugin."
  if mission_wired; then
    du_verdict=FAIL
    du_because=" hooks/mission.sh is wired in $(claude_dir)/settings.json and reads its prompt store and nothing else, so all five of those wirings deliver nothing, silently."
  fi
  if [ -z "$du_bin" ]; then
    dr "$du_verdict" surfer "surfer is not on PATH.$du_because $SURFER_INSTALL_HINT"
    return 0
  fi
  # PYTHONDONTWRITEBYTECODE, because `doctor` promises it changes nothing but its own
  # probe file, and this is the one line here that runs SOMEBODY ELSE'S program. surfer is
  # stdlib python, and a framework python whose source directory is not writable caches
  # its bytecode under $HOME/Library/Caches instead -- so probing it wrote a tree into the
  # user's home on every run, which is exactly the promise being broken and was invisible
  # until a test compared the directory before and after.
  du_out="$(PYTHONDONTWRITEBYTECODE=1 "$du_bin" stats 2>&1)"; du_rc=$?
  if [ "$du_rc" -ne 0 ]; then
    du_tail="$(printf '%s\n' "$du_out" | tail -n 1)"
    dr "$du_verdict" surfer "$du_bin is there but 'surfer stats' exited $du_rc: ${du_tail:-no output at all}. The mission hook reads that same store, so it has nothing to state either.$du_because"
    return 0
  fi
  # The total is on STDERR ("N prompt(s) across current project."), which is why the call
  # above folds stderr in. `tr -cd` on the capture for the reason the settings check gives:
  # BSD tools pad a count with a leading space and a numeric guard reads that as junk.
  du_n="$(int_or_zero "$(printf '%s\n' "$du_out" | sed -n 's/^\([0-9][0-9]*\) prompt(s).*/\1/p' | tail -n 1 | tr -cd '0-9')")"
  if [ "$du_n" -eq 0 ]; then
    dr PASS surfer "$du_bin reads its store; 0 prompt(s) recorded for this project yet, so the mission has nothing to state here until you type something"
  else
    dr PASS surfer "$du_bin: $du_n prompt(s) recorded for this project"
  fi
}

# THE MISSION STORE IS WHERE DELIVERY BECOMES COUNTABLE. hooks/mission.sh claims each
# event under <state>/mission/<session>/ so that the two wirings' duplicate delivery is a
# no-op, and appends one row per delivery to <state>/mission/hits.jsonl. An unwritable
# directory therefore does not stop the mission -- it stops the CLAIM, so every moment is
# stated twice and nothing is recorded, which is the one failure here that looks like
# working harder. An absent directory is not a fault: it is what a machine that has not
# started a session since installing looks like, so it is a WARN that says which.
doctor_mission() {
  dm_dir="$STATE_ROOT/mission"
  if [ ! -d "$dm_dir" ]; then
    dr WARN mission "no $dm_dir, so the mission has never been delivered against this state. Expected before the first session after installing; a fault if sessions have run since."
    return 0
  fi
  # A REAL WRITE, for the reason doctor_state gives: access(2) reads permission bits and
  # is wrong about a read-only mount, an ACL, and a full disk alike.
  dm_probe="$dm_dir/.doctor-probe.$$"
  if ( : > "$dm_probe" ) 2>/dev/null; then
    rm -f "$dm_probe" 2>/dev/null
  else
    dr FAIL mission "$dm_dir will not accept a write. The per-event claim lives there, so with both wirings active every moment is delivered twice and no delivery is recorded."
    return 0
  fi
  dm_hits="$dm_dir/hits.jsonl"
  if [ ! -s "$dm_hits" ]; then
    dr PASS mission "$dm_dir is writable; 0 deliveries recorded"
    return 0
  fi
  # Same reader every consumer of a JSONL file here uses: a raw line at a time with
  # `fromjson?`, never `jq -s`, which aborts on the first bad line and takes the count of
  # the good ones with it.
  dm_pair="$(jq -r -R -n '[inputs | select(test("^[[:space:]]*$") | not)] as $l
                       | [$l[] | fromjson? | select(type == "object")] as $o
                       | "\($o | length) \($l | length) \([$o[] | .moment // empty | if . == "subagent" then "dispatch" else . end] | unique | length)"' \
             < "$dm_hits" 2>/dev/null)"
  dm_ok="$(int_or_zero "$(printf '%s' "$dm_pair" | cut -d" " -f1)")"
  dm_all="$(int_or_zero "$(printf '%s' "$dm_pair" | cut -d" " -f2)")"
  dm_moments="$(int_or_zero "$(printf '%s' "$dm_pair" | cut -d" " -f3)")"
  # Six labels, five moments: `dispatch` (PreToolUse on Agent, to the parent) and
  # `subagent` (SubagentStart, to the child) are the one moment "before an expensive task"
  # reached from two events, so the jq above folds them before counting.
  if [ "$dm_all" -eq 0 ]; then
    dr PASS mission "$dm_dir is writable; 0 deliveries recorded"
  elif [ "$dm_ok" -lt "$dm_all" ]; then
    dr FAIL mission "$(( dm_all - dm_ok )) of $dm_all line(s) in $dm_hits do not parse as JSON. Every reader drops those without saying so, so the deliveries they recorded are already missing from every count of whether any of this lands."
  else
    dr PASS mission "$dm_all delivery/deliveries recorded in $dm_hits, across $dm_moments of the five moments"
  fi
}

# --------------------------------------------------------------------- option parse

cmd="${1:-}"; shift 2>/dev/null || true

# --name is accepted anywhere in the argument list; --all only where it means something,
# so that a `fail` reason or a `step` phase containing the word is left alone.
NAME_OPT="${SKILLFORGE_NAME:-}"
ALL_OPT=0
case "$cmd" in clear|show|list) ALLOW_ALL=1 ;; *) ALLOW_ALL=0 ;; esac
# --full lifts the HELD-OUT REDACTION on the read commands. See redact_prog().
# `pending` is one of them: a pending-apply marker carries the verbatim trigger, so
# `pending --json` is a third door onto the forging protocol's held-out test data, and it
# would be open to exactly the orchestrator subagent that is handed this CLI and told to
# drive it. Held back by default, and the omission is named, like the other two.
FULL_OPT=0
case "$cmd" in show|ledger|pending) ALLOW_FULL=1 ;; *) ALLOW_FULL=0 ;; esac
# --skill-dir is only an option where it means something, for the same reason --all is:
# a `fail` reason or a `step` phase that happens to contain the word is left alone.
SKILLDIR_OPT="${SKILLFORGE_SKILL_DIR:-}"
[ -n "$SKILLDIR_OPT" ] && SKILLDIR_OPT="$(abspath "$SKILLDIR_OPT")"
case "$cmd" in start|done|install) ALLOW_SKILLDIR=1 ;; *) ALLOW_SKILLDIR=0 ;; esac
# --trigger / --trigger-kind, on `start` only, for the same reason: a `fail` reason or a
# `step` phase that happens to contain the word is left alone. Empty means "not recorded",
# and ledger_line writes nothing for an empty one rather than an empty string.
TRIGGER_TEXT=""; TRIGGER_KIND=""
case "$cmd" in start) ALLOW_TRIGGER=1 ;; *) ALLOW_TRIGGER=0 ;; esac
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --name|-n) [ $# -ge 2 ] || die "--name requires a forge name"
               NAME_OPT="$2"; shift 2 ;;
    --name=*)  NAME_OPT="${1#--name=}"; shift ;;
    --skill-dir)   if [ "$ALLOW_SKILLDIR" -eq 1 ]; then
                     [ $# -ge 2 ] || die "--skill-dir requires a directory"
                     SKILLDIR_OPT="$(abspath "$2")"; shift 2
                   else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --skill-dir=*) if [ "$ALLOW_SKILLDIR" -eq 1 ]; then
                     SKILLDIR_OPT="$(abspath "${1#--skill-dir=}")"; shift
                   else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --trigger)      if [ "$ALLOW_TRIGGER" -eq 1 ]; then
                      [ $# -ge 2 ] || die "--trigger requires the verbatim text that set this forge off"
                      TRIGGER_TEXT="$2"; shift 2
                    else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --trigger=*)    if [ "$ALLOW_TRIGGER" -eq 1 ]; then
                      TRIGGER_TEXT="${1#--trigger=}"; shift
                    else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --trigger-kind) if [ "$ALLOW_TRIGGER" -eq 1 ]; then
                      [ $# -ge 2 ] || die "--trigger-kind requires one of: $TRIGGER_KINDS"
                      TRIGGER_KIND="$2"; shift 2
                    else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --trigger-kind=*) if [ "$ALLOW_TRIGGER" -eq 1 ]; then
                      TRIGGER_KIND="${1#--trigger-kind=}"; shift
                    else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --all)     if [ "$ALLOW_ALL" -eq 1 ]; then ALL_OPT=1; shift
               else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --full)    if [ "$ALLOW_FULL" -eq 1 ]; then FULL_OPT=1; shift
               else ARGS[${#ARGS[@]}]="$1"; shift; fi ;;
    --)        shift; while [ $# -gt 0 ]; do ARGS[${#ARGS[@]}]="$1"; shift; done ;;
    *)         ARGS[${#ARGS[@]}]="$1"; shift ;;
  esac
done
# bash 3.2 under `set -u` treats an empty array expansion as unbound, so every use of
# ARGS has to carry the +alternate guard.
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$cmd" in
  start)
    name="${1:-}"; steps="${2:-}"; shift 2 2>/dev/null || true
    summary="$*"
    [ -n "$NAME_OPT" ] && [ -z "$name" ] && { name="$NAME_OPT"; }
    [ -z "$name" ] && die "usage: skillforge start <name> <total-steps> <summary...>"
    # The name is the key for every lookup and it is written into a one-line index, so
    # a newline inside it would split one forge into two phantom rows and make every
    # later --name miss. A tab is fine: the index is US-separated precisely so that a
    # skill name holding one still round-trips.
    case "$name" in
      *'
'*|*"$(printf '\r')"*|*"$SEP"*)
        die "a forge name cannot contain a newline, a carriage return or a US (0x1f)" ;;
    esac
    # Digits only AND a bounded magnitude. `--argjson t 99999999999999999999` is
    # accepted by jq as the FLOAT 1e+20, which then fails every later integer test:
    # bash prints "[: integer expected" on stderr, the renderer's numeric guard folds
    # 1e+20 back to 1, and a forge at step 5 renders as a full bar at 100%.
    case "$steps" in ''|*[!0-9]*) die "total-steps must be a positive integer" ;; esac
    case "$steps" in ?????*) die "total-steps must be between 1 and 9999" ;; esac
    [ "$steps" -lt 1 ] && die "total-steps must be >= 1"
    [ -z "$summary" ] && die "a one-line summary is required — it is what the user sees"

    # WHAT TRIGGERED THIS FORGE IS THE MEASUREMENT THE PROJECT EXISTS TO MAKE: did a human
    # ask, or did the machinery notice? A forge that does not record it produces a row
    # that cannot answer the first of the four questions, ever, because the moment passes.
    #
    # AND YET A MISSING TRIGGER IS A WARNING, NOT A REFUSAL. Refusing does not produce a
    # trigger, it produces no forge record at all: every caller written before this flag
    # existed -- the README's own example, the demo script, the line `setup.py` prints on
    # a fresh install, and any half-written procedure in a doc -- would exit 2, and the
    # cheapest way past a CLI that refuses is to stop calling it. That trades a row with
    # one missing field for no row, no animation and no outcome, which is strictly worse
    # for all four questions. So the gap is recorded AS a gap: `trigger_kind:"unrecorded"`
    # is a positive statement that a forge ran without recording why, and it is countable.
    # SKILLFORGE_REQUIRE_TRIGGER=1 turns it into a refusal for anyone whose callers are
    # all updated and who wants the rule enforced.
    if [ -n "$TRIGGER_KIND" ]; then
      case " $TRIGGER_KINDS " in
        *" $TRIGGER_KIND "*) : ;;
        *) die "--trigger-kind must be one of: $TRIGGER_KINDS (got '$TRIGGER_KIND')" ;;
      esac
    fi
    if [ -n "$TRIGGER_TEXT" ] && [ -z "$TRIGGER_KIND" ]; then
      # The quote alone does not answer the question. "Fix the flaky test" reads the same
      # whether a person typed it or a checkpoint hook produced it, and which of those it
      # was is the entire point of recording it.
      die "--trigger needs --trigger-kind <$(printf '%s' "$TRIGGER_KINDS" | tr ' ' '|')>: the quote says what was asked, the kind says who asked"
    fi
    if [ -z "$TRIGGER_TEXT" ]; then
      if [ "${SKILLFORGE_REQUIRE_TRIGGER:-0}" = "1" ]; then
        die "SKILLFORGE_REQUIRE_TRIGGER=1 and no --trigger was given. Add: --trigger \"<verbatim text that set this off>\" --trigger-kind <$(printf '%s' "$TRIGGER_KINDS" | tr ' ' '|')>"
      fi
      TRIGGER_KIND="unrecorded"
      echo "skillforge: WARNING — no --trigger given, so this forge will record nothing about why it started, and the ledger will read 'trigger not recorded' for it forever." >&2
      echo "skillforge:   Add: --trigger \"<verbatim text that set this off>\" --trigger-kind <$(printf '%s' "$TRIGGER_KINDS" | tr ' ' '|')>" >&2
    fi

    # Does a forge by this name already exist? An ACTIVE one is refused: overwriting it
    # is exactly the defect this multi-slot scheme exists to remove, and silently
    # forging two things under one name would make both the animation and the ledger
    # join meaningless. A FINISHED one is reused in place -- it has already been closed
    # out to the ledger and the status line was about to reap it anyway.
    existing=""; existing_state=""
    while IFS="$SEP" read -r e_st e_nm e_stt e_pth; do
      [ -n "${e_pth:-}" ] || continue
      [ "$e_nm" = "$name" ] || continue
      existing="$e_pth"; existing_state="$e_stt"
      [ "$e_stt" = "active" ] && break
    done <<SLOTS
$(slots)
SLOTS
    if [ -n "$existing" ] && [ "$existing_state" = "active" ]; then
      # This refusal is where a wedged name is actually met, so it is where the
      # staleness has to be named. Nothing expires `active`, so a forge whose
      # orchestrator died holds its name forever behind a message that otherwise reads
      # like ordinary contention. NOT `done`: that records a forge which never finished
      # as COMPLETED and installs it. The honest closes are `fail` and `clear`.
      e_idle="$(slot_idle "$existing")"
      if [ -n "$e_idle" ]; then e_age="last stepped $(fmt_age "$e_idle") ago"
      else e_age="last step time unknown"; fi
      # PAST THE TTL, REFUSING IS THE WRONG ANSWER. A forge that has not stepped in longer
      # than any healthy forge has ever lived is not contention with a colleague, it is a
      # corpse holding the one name the caller wants -- and the caller is usually a subagent,
      # which reads "already live" as "somebody else is on it" and stops. So it is reaped
      # here, with the same `fail` row `skillforge reap` writes, and the start goes through.
      # Told on stderr, not stdout: stdout is the line the caller may be parsing, and a
      # reap is something that happened TO the caller rather than an answer to what it asked.
      #
      # REAPING NEEDS A READABLE AGE. A record whose `updated` cannot be parsed is refused
      # exactly as before, because the alternative is guessing that an unreadable stamp
      # means old, and closing somebody's live forge on that guess.
      if [ -n "$e_idle" ] && [ "$e_idle" -ge "$ACTIVE_TTL" ]; then
        if close_forge "$existing" failed fail "$REAP_REASON"; then
          echo "skillforge: reaped the forge named '$name' — it had not stepped in $(fmt_age "$e_idle"), past SKILLFORGE_ACTIVE_TTL ($(fmt_age "$ACTIVE_TTL")). A 'fail' row is in the ledger; this start is taking the name." >&2
        else
          echo "skillforge: '$name' was closed out by another process as it was being reaped; this start is taking the name." >&2
        fi
        existing_state="failed"
      else
      die "a forge named '$name' is already live (step $(sfield "$existing" step)/$(sfield "$existing" steps), $e_age). If it died, close it with 'skillforge fail --name $name <reason>'; to discard it, 'skillforge clear --name $name'. Do not use 'done' -- that records it as completed. Or forge under a different name."
      fi
    fi

    # The record is written COMPLETE, to a temp file, before any slot is claimed.
    # That ordering is the whole trick below: the file that appears at a slot path is
    # never a placeholder, so a concurrent starter can always tell an occupied slot
    # from a free one. A plain redirect onto the slot would truncate it first, and the
    # status line renders once a second: a render landing inside that window reads a
    # partial file, its jq fails, and the whole forge segment vanishes for a frame.
    # That is the progress bar "blinking".
    #
    # The temp name does not end in .json, so it is invisible to slots() and to the
    # renderer while it is being written.
    # Warmed here, outside the slot-claim window below: see project_root().
    project_root >/dev/null 2>&1
    tmp="$DIR/.start.$$.$(now).tmp"
    # The whole group is wrapped, not just jq: a redirect that cannot open its target
    # is reported by the SHELL, so `jq ... > "$tmp" 2>/dev/null` still prints bash's own
    # "Permission denied" above the tidy message below it.
    # `id` is written HERE, before the slot is claimed, so that every record this script
    # publishes carries one from the instant it becomes visible. It is what names this
    # forge's outcome claim; see close_forge.
    # THE FIRST OBJECT IS FROZEN, AND NEW FIELDS ARE MERGED ONTO IT RATHER THAN ADDED
    # INSIDE IT. tests/test_forge_close_race.py reconstructs a pre-claim version of this
    # script by deleting the literal `, id:$id}` that ends that object; a field written
    # between `updated:$now` and the brace makes its anchor miss, and the whole race
    # suite quietly becomes a copy of the unmodified script instead of failing.
    # `root` and `skill_dir` are written HERE because `done` may run from a different
    # directory, and because a skill written outside the two conventional layouts is
    # not findable at close time by any other means. A record from an older version has
    # neither field; find_skill_dir falls back to searching for exactly that reason.
    # `trigger` and `trigger_kind` are carried on the RECORD as well as on the start row,
    # because the origin row is written at `done` -- possibly hours later, in another
    # directory -- and the record is the only thing that still remembers what was said.
    { jq -n --arg n "$name" --arg s "$summary" --argjson t "$steps" --argjson now "$(now)" \
      --arg id "$(new_forge_id)" --arg root "$(project_root)" --arg sd "$SKILLDIR_OPT" \
      --arg tg "$TRIGGER_TEXT" --arg tk "$TRIGGER_KIND" \
      '{name:$n, summary:$s, phase:"initializing", step:0, steps:$t,
        status:"active", started:$now, updated:$now, id:$id}
       + {root:$root}
       + (if $sd == "" then {} else {skill_dir:$sd} end)
       + (if $tg == "" then {} else {trigger:$tg} end)
       + (if $tk == "" then {} else {trigger_kind:$tk} end)' > "$tmp"; } 2>/dev/null \
      || { rm -f "$tmp" 2>/dev/null; die "could not write to $DIR (is it writable?)"; }

    if [ -n "$existing" ]; then
      # A finished record for the same name, replaced in place: one slot per name, so
      # the ledger's start-to-outcome join stays unambiguous.
      FILE="$existing"
      mv "$tmp" "$FILE" || { rm -f "$tmp"; die "could not write $FILE"; }
    else
      FILE="$DIR/$(slug_of "$name").forge.json"
      # Claiming a slot is `ln`, not a redirect: a hard link either appears atomically
      # or fails because the name is taken, and it publishes the finished record in the
      # same instant. `set -o noclobber; : > "$FILE"` was tried first and is WRONG here
      # -- it claims with a 0-byte file, so a racing starter looking at that slot sees
      # an empty file, reads it as an abandoned claim, and takes the slot too. Three
      # simultaneous starts with names that share a slug then collapsed into one, and
      # two of them were lost with no error and exit status 0.
      n=1
      while :; do
        if ln "$tmp" "$FILE" 2>/dev/null; then rm -f "$tmp"; break; fi
        if [ ! -e "$FILE" ]; then
          rm -f "$tmp"; die "could not create $FILE (is $DIR writable?)"
        fi
        if [ "$(field "$FILE" name)" = "$name" ]; then
          # Lost a same-name race, or a finished record appeared since the scan above.
          if [ "$(field "$FILE" status)" = "active" ]; then
            rm -f "$tmp"
            die "a forge named '$name' is already live. If it died, close it with 'skillforge fail --name $name <reason>'; to discard it, 'skillforge clear --name $name'. Do not use 'done' -- that records it as completed. Or forge under a different name."
          fi
          mv "$tmp" "$FILE"; break
        fi
        # Zero bytes is not a slot: slots() skips it, so it cannot be a live forge, and
        # taking it back stops one failed write from poisoning that slug forever.
        if [ ! -s "$FILE" ]; then mv "$tmp" "$FILE"; break; fi
        n=$(( n + 1 ))
        [ "$n" -gt 64 ] && { rm -f "$tmp"; die "cannot find a free slot file in $DIR"; }
        FILE="$DIR/$(slug_of "$name")-$n.forge.json"
      done
    fi
    ledger_append start "$name" "$steps" "$summary"
    reap_temps; reap_claims
    echo "skillforge: forging '$name' ($steps steps) — animation live in the status line"
    # Count the OTHER live forges and say so. A session that starts a second forge
    # without noticing is the situation where a bare `skillforge step` stops being
    # unambiguous, so it has to be told at the moment it becomes true.
    others="$(slots | awk -F"$SEP" -v me="$name" '$3 == "active" && $2 != me { printf "%s%s", (n++ ? ", " : ""), $2 }')"
    # `if`, not `&&`: a trailing `&&` whose test is false makes the whole script exit
    # non-zero, and a caller that checks the exit status of `start` would read a forge
    # that started perfectly well as a failure.
    if [ -n "$others" ]; then
      echo "skillforge: also live: $others — target this one with 'skillforge step --name $name ...'"
    fi
    ;;

  step)
    require_active step fatal
    FILE="$RESOLVED"
    n="${1:-}"; shift 2>/dev/null || true
    phase="$*"
    case "$n" in ''|*[!0-9]*) die "usage: skillforge step [--name <forge>] <step-number> <phase...>" ;; esac
    # Bounded for the same reason `start` bounds the budget: `--argjson n 1e20` is a
    # float that fails every later integer test, and an unbounded step is now WRITTEN
    # rather than clamped, so it also sets the width of a status-line field.
    case "$n" in ?????*) die "step-number must be between 0 and 9999" ;; esac
    [ -z "$phase" ] && die "a phase description is required"
    # THE STEP IS RECORDED AS GIVEN, NOT CLAMPED TO THE BUDGET. Clamping made an
    # overrun unrepresentable: 14 of 12 was stored as 12, so the status line could not
    # show it, `rounds_completed` under-counted it, and `skillreport` -- which reads
    # nothing but the ledger -- could never report that a forge went long. A budget is
    # a plan; the step reached is an observation, and the observation is what is kept.
    update "$FILE" --argjson n "$n" --arg p "$phase" --argjson now "$(now)" \
      '.step = $n | .phase = $p | .updated = $now'
    s_total="$(sfield "$FILE" steps)"
    s_over=""
    [ "$n" -gt "$(int_or_zero "$s_total")" ] && s_over=" (past the $s_total-step budget)"
    echo "skillforge: [$n/$s_total] $(sfield "$FILE" name): $phase$s_over"
    ;;

  done)
    require_active 'done' quiet
    FILE="$RESOLVED"
    msg="${*:-clean red-team pass}"
    # Asked BEFORE the close, because close_forge builds the ledger row and the row is
    # where the answer has to land. It is two `test -f` calls against a cached
    # project_root, so it costs nothing on the near side of the outcome claim -- which
    # is where everything expensive belongs anyway (see close_forge).
    if find_skill_dir "$(field "$FILE" name)" "$FILE"; then
      SKILL_PRESENT="present"
    else
      SKILL_PRESENT="missing"
    fi
    # `done` fills the bar, but it must not REWIND a forge that ran past its budget:
    # the ledger's rounds-completed count is derived from the step reached. close_forge
    # carries that rule, and decides which of several racing closers writes the row.
    if close_forge "$FILE" 'done' 'done' "$msg"; then
      echo "skillforge: '$CLOSED_NAME' complete — $msg"
      # BEFORE the install, not after: the origin row describes what this forge produced
      # and why, and it is true whether or not the link into the skills directory
      # succeeds. Written first also means link_skill finds an origin already there and
      # does not add an "adopted" one over the top of "forged".
      origin_for_forge "$(field "$FILE" name)" "$FILE"
      # Closing the loop is what makes the skill usable. Its status is deliberately not
      # this command's: the forge did close, and a non-zero `done` would be read as a
      # close that failed and retried. What went wrong is said out loud instead.
      # The RAW name, not CLOSED_NAME: sfield folds control characters to spaces so a
      # name is safe to print, and a forge name is allowed to contain a tab (the index is
      # US-separated for exactly that reason). Installing off the printable form looked
      # for a directory nobody had written.
      install_forged_skill "$(field "$FILE" name)" "$FILE" || true
      # THE DEBT. Written LAST, because `installed` is not knowable until the install has
      # been attempted, and inside the `close_forge` winner branch, because a marker is a
      # reminder to do something once -- a losing second `done` exits through closed_out
      # above and must not re-create a debt the winner may already have discharged.
      #
      # THE NAME ON THE MARKER IS THE DIRECTORY'S, NOT THE FORGE'S, the same rule
      # install_forged_skill and origin_for_forge follow and for the same reason: a
      # session invokes a skill by the directory it sits in, so a marker under the forge
      # name would tell somebody to apply a skill that answers `Unknown skill`. FOUND is
      # whatever find_skill_dir last resolved -- set by the SKILL_PRESENT check above even
      # when SKILLFORGE_NO_INSTALL kept install_forged_skill from looking again.
      apply_name="$(field "$FILE" name)"
      [ -n "${FOUND:-}" ] && apply_name="$(basename "$FOUND")"
      # `installed` answers ONE question: can a session invoke this now. `project` counts,
      # because a skill under a repo's .claude/skills/ is already live for that repo --
      # that is precisely why install_forged_skill declines to widen it. Everything else,
      # including SKILLFORGE_NO_INSTALL being set, is false: nothing was linked, and
      # saying otherwise is the "it worked" this package exists to stop producing.
      apply_installed=false
      case "${INSTALL_STATUS:-}" in
        linked|already-linked|already-there|project) apply_installed=true ;;
      esac
      # now(), not the record's `finished`: publish_close may legitimately decline to
      # publish the closed record (a `start` that raced it), leaving the slot without a
      # `finished` field at all, and a debt dated 1970 sorts to the head of the queue
      # forever. Both are the same clock, so under a pinned SKILLFORGE_NOW they agree.
      # CLOSED_ID and not `forge_id "$FILE"`: it is the id of the forge THIS close_forge
      # won, captured before publish_close could decline to publish over a slot a racing
      # `start` had already taken.
      apply_marker_write "$apply_name" "$(field "$FILE" name)" "${FOUND:-}" \
        "$(field "$FILE" trigger)" "$(field "$FILE" trigger_kind)" \
        "$(field "$FILE" summary)" "$(now)" "$apply_installed" "${CLOSED_ID:-}"
      echo "skillforge: '$apply_name' is forged but NOT YET APPLIED. Use it on the problem that caused it, then record what happened: skillforge apply --name '$apply_name' --outcome used --evidence \"<verbatim quote>\""
    else
      closed_out "$FILE"
    fi
    ;;

  fail)
    require_active fail quiet
    FILE="$RESOLVED"
    reason="${*:-abandoned}"
    if close_forge "$FILE" failed fail "$reason"; then
      echo "skillforge: '$CLOSED_NAME' abandoned — $reason"
    else
      closed_out "$FILE"
    fi
    ;;

  round)
    # THE CAP LIVES HERE AND NOT ON `step`; the header says why at length.
    require_active round fatal
    FILE="$RESOLVED"
    # Flags are normalised to --key=value first, the use/verdict/origin arm's pattern and
    # for its reason: writing the two-form parse out per flag is where a `[ $# -ge 2 ]`
    # guard gets forgotten, and a missing value then silently becomes the NEXT flag's
    # name -- recorded, on the round record, as if it were a subsystem.
    RARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --*=*) RARGS[${#RARGS[@]}]="$1"; shift ;;
        --*)   [ $# -ge 2 ] || die "$1 requires a value"
               RARGS[${#RARGS[@]}]="$1=$2"; shift 2 ;;
        *)     die "skillforge round takes flags only; got '$1'" ;;
      esac
    done
    set -- ${RARGS[@]+"${RARGS[@]}"}
    r_blocking=""; r_total=""; r_subsystems=""; r_shapes=""
    for a in "$@"; do
      k="${a%%=*}"; v="${a#*=}"
      case "$k" in
        --blocking)   r_blocking="$v" ;;
        --total)      r_total="$v" ;;
        --subsystems) r_subsystems="$v" ;;
        --shapes)     r_shapes="$v" ;;
        *)            die "unknown option '$k' for skillforge round" ;;
      esac
    done
    r_usage="usage: skillforge round --name <forge> --blocking <k> --total <m> [--subsystems \"...\"] [--shapes \"...\"]"
    case "$r_blocking" in ''|*[!0-9]*) die "--blocking must be a count of findings (digits). $r_usage" ;; esac
    case "$r_total"    in ''|*[!0-9]*) die "--total must be a count of findings (digits). $r_usage" ;; esac
    case "$r_blocking" in ?????*) die "--blocking must be between 0 and 9999" ;; esac
    case "$r_total"    in ?????*) die "--total must be between 0 and 9999" ;; esac
    # The blocking findings are a SUBSET of the findings, so a row claiming otherwise is
    # a typo, and a typo here is what the whole convergence rule is then read off.
    [ "$r_blocking" -le "$r_total" ] || die "--blocking ($r_blocking) cannot exceed --total ($r_total): blocking findings are a subset of the round's findings"

    r_name="$(field "$FILE" name)"
    r_planned="$(rounds_planned "$(int_or_zero "$(field "$FILE" steps)")")"
    r_file="$(rounds_file "$r_name")"
    r_have="$(rounds_count "$r_file")"
    r_n=$(( r_have + 1 ))
    # Both counts are read BEFORE the cap decision, so the refusal can show the
    # trajectory it is refusing on.
    r_b1="$(rounds_blocking "$r_file" 1 || true)"
    r_b2="$(rounds_blocking "$r_file" 2 || true)"
    if [ "$r_n" -gt "$r_planned" ]; then
      r_trend="only $r_have round(s) are on the record, so there is no fall to point at yet"
      if [ -n "$r_b1" ] && [ -n "$r_b2" ]; then
        if   [ "$r_b1" -lt "$r_b2" ]; then r_dir="it fell"
        elif [ "$r_b1" -gt "$r_b2" ]; then r_dir="it rose"
        else                               r_dir="it held"
        fi
        r_trend="round $r_have = $r_b1, round $(( r_have - 1 )) = $r_b2: $r_dir"
      fi
      # NOTHING IS WRITTEN ON THIS PATH. The append is below the refusal, not above it:
      # a cap that records the round it just refused has not refused anything.
      refuse 3 "round cap reached ($r_have of $r_planned planned). Round $r_n is earned, not taken: 'skillforge escalate --name $r_name --converging' needs blocking to have fallen ($r_trend), 'skillforge escalate --name $r_name --narrowed \"<what you cut>\"' buys the cold round a narrowed skill owes. Otherwise close it: skillforge fail --name $r_name \"not converging: <what kept coming back>\"."
    fi

    mkdir -p "$ROUNDS_DIR" 2>/dev/null || die "could not create $ROUNDS_DIR"
    # One `printf` builds and appends the whole row, so a concurrent writer cannot
    # interleave half a line -- the same reason ledger_line builds its JSON before any
    # redirect runs. `2>/dev/null` BEFORE the `>>` and the order is the whole point:
    # written the other way round, a failure to open the file is reported by the SHELL
    # to a stderr that is still the terminal.
    printf '%s\tblocking=%s\ttotal=%s\tsubsystems=%s\tshapes=%s\n' \
      "$r_n" "$r_blocking" "$r_total" \
      "$(tsv_field "$r_subsystems")" "$(tsv_field "$r_shapes")" \
      2>/dev/null >> "$r_file" || die "could not append to $r_file"
    r_left=$(( r_planned - r_n ))
    if [ "$r_left" -gt 0 ]; then
      echo "skillforge: round $r_n/$r_planned recorded for '$r_name' — $r_blocking blocking of $r_total finding(s); $r_left round(s) left in the budget"
    else
      echo "skillforge: round $r_n/$r_planned recorded for '$r_name' — $r_blocking blocking of $r_total finding(s); that was the last budgeted round. Another one is earned, not taken: 'skillforge escalate --name $r_name --converging' if blocking fell, or '--narrowed \"<what you cut>\"'."
    fi
    exit 0
    ;;

  escalate)
    require_active escalate fatal
    FILE="$RESOLVED"
    EARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --converging) EARGS[${#EARGS[@]}]="$1"; shift ;;
        --*=*)        EARGS[${#EARGS[@]}]="$1"; shift ;;
        --*)          [ $# -ge 2 ] || die "$1 requires a value"
                      EARGS[${#EARGS[@]}]="$1=$2"; shift 2 ;;
        *)            die "skillforge escalate takes flags only; got '$1'" ;;
      esac
    done
    set -- ${EARGS[@]+"${EARGS[@]}"}
    e_conv=0; e_cut=""; e_narrow_given=0; e_kind=""
    for a in "$@"; do
      k="${a%%=*}"; v="${a#*=}"
      case "$k" in
        --converging) e_conv=1 ;;
        --narrowed)   e_cut="$v"; e_narrow_given=1 ;;
        *)            die "unknown option '$k' for skillforge escalate" ;;
      esac
    done
    e_usage="usage: skillforge escalate --name <forge> --converging | --narrowed \"<what was cut>\""
    if [ "$e_conv" -eq 1 ] && [ "$e_narrow_given" -eq 1 ]; then
      die "give one of --converging or --narrowed, never both: they are different claims about why the round is owed, and the ledger row records which one bought it"
    fi
    # Same LC_ALL=C emptiness test `apply --evidence` uses: a value of spaces is not a
    # value, and a narrowing nobody wrote down is not reviewable by the cold round it
    # is buying.
    if [ "$e_narrow_given" -eq 1 ]; then
      case "$(printf '%s' "$e_cut" | LC_ALL=C tr -d '[:space:]')" in
        '') die "--narrowed needs the subsystem that was cut, in your own words: a narrowing nobody wrote down is not reviewable" ;;
      esac
      e_kind="narrowed"
    fi
    [ "$e_conv" -eq 1 ] && e_kind="converging"
    [ -n "$e_kind" ] || die "$e_usage"

    e_name="$(field "$FILE" name)"
    e_file="$(rounds_file "$e_name")"
    e_have="$(rounds_count "$e_file")"
    e_steps="$(int_or_zero "$(field "$FILE" steps)")"
    e_grants="$(int_or_zero "$(field "$FILE" escalations)")"
    e_narrowings="$(int_or_zero "$(field "$FILE" escalations_narrowed)")"
    e_b1="$(rounds_blocking "$e_file" 1 || true)"
    e_b2="$(rounds_blocking "$e_file" 2 || true)"

    # TWO GRANTS PER FORGE, WHATEVER KIND THEY WERE. This is what bounds the loop no
    # matter what the counts do: two budgeted rounds plus two granted is four, and there
    # is no third grant to ask for.
    if [ "$e_grants" -ge 2 ]; then
      refuse 4 "'$e_name' has already been escalated twice — $e_steps steps, $(rounds_planned "$e_steps") rounds planned — and two grants is the ceiling. There is no third. Close it: skillforge fail --name $e_name \"not converging: <what kept coming back>\"."
    fi

    if [ "$e_kind" = "converging" ]; then
      # THE ASSESSMENT BINDS FROM ROUND 2, where the first comparison exists. One data
      # point cannot match the converging definition, so a forge with fewer than two
      # recorded rounds is refused here rather than granted on a comparison nobody made.
      if [ -z "$e_b1" ] || [ -z "$e_b2" ]; then
        refuse 4 "--converging is a claim about a trajectory and '$e_name' has $e_have round(s) with a readable blocking count, so there is no comparison to make. Record the rounds with 'skillforge round --name $e_name --blocking <k> --total <m>' first."
      fi
      if [ "$e_b1" -ge "$e_b2" ]; then
        refuse 4 "--converging refused for '$e_name': blocking went round $(( e_have - 1 )) = $e_b2 → round $e_have = $e_b1, which is not a fall. A further round is earned by a strictly falling blocking count. Narrow instead — 'skillforge escalate --name $e_name --narrowed \"<what you cut>\"' — or close it: skillforge fail --name $e_name \"not converging: <what kept coming back>\"."
      fi
    else
      if [ "$e_narrowings" -ge 1 ]; then
        refuse 4 "--narrowed is granted once per forge and '$e_name' has already spent it. A second narrowing is a different skill again, not a longer review of this one. Either --converging, which needs blocking to have fallen, or close it: skillforge fail --name $e_name \"not converging: <what kept coming back>\"."
      fi
    fi

    # EXACTLY 2, WHICH IS ONE ROUND. SKILL.md budgets steps as 2 + 2 x rounds -- a review
    # step and a revision step per round -- so any other number would grant a fraction of
    # a round and leave `rounds_planned` disagreeing with the budget it was derived from.
    e_after=$(( e_steps + 2 ))
    [ "$e_after" -le 9999 ] || die "'$e_name' is budgeted $e_steps steps and raising it would pass the 9999-step bound 'start' enforces"
    e_grant=$(( e_grants + 1 ))
    e_narrow_after="$e_narrowings"
    [ "$e_kind" = "narrowed" ] && e_narrow_after=$(( e_narrowings + 1 ))
    # THE RAISED BUDGET GOES ON THE RECORD, which is what the status line renders, what
    # `show` prints and what `rounds_planned` is read off at close. A second store for
    # the grant would be a second answer to "how many rounds does this forge have", and
    # the two would disagree the first time one of them was not written.
    update "$FILE" --argjson s "$e_after" --argjson g "$e_grant" \
      --argjson nn "$e_narrow_after" --arg k "$e_kind" --argjson now "$(now)" \
      '.steps = $s | .escalations = $g | .escalations_narrowed = $nn
       | .escalated = $k | .updated = $now'

    # A NEW EVENT NAME, so every existing selector is blind to it: `ledger` and
    # `skillreport` join `start` to `done`/`fail` BY NAME, and the rule this file states
    # for itself is that an event type may be added freely and a selector never widened
    # to a negation.
    es_line="$(jq -n -c --arg name "$e_name" --arg reason "$e_kind" \
      --arg cut "$e_cut" --arg project "$(project_root)" \
      --argjson ts "$(now)" --argjson grant "$e_grant" \
      --argjson recorded "$e_have" \
      --argjson before "$(rounds_planned "$e_steps")" \
      --argjson after "$(rounds_planned "$e_after")" \
      --argjson sb "$e_steps" --argjson sa "$e_after" \
      --arg b1 "$e_b1" --arg b2 "$e_b2" \
      '{event:"escalate", ts:$ts, name:$name, reason:$reason, grant:$grant,
        rounds_recorded:$recorded, rounds_planned_before:$before,
        rounds_planned_after:$after, steps_before:$sb, steps_after:$sa,
        project:$project, confidence:"measured", backfilled:false}
       + (if $cut == "" then {} else {narrowed:$cut}                 end)
       + (if $b1  == "" then {} else {blocking_last:($b1|tonumber)}  end)
       + (if $b2  == "" then {} else {blocking_prev:($b2|tonumber)}  end)' 2>/dev/null)"
    [ -n "$es_line" ] || die "could not build an escalate row for '$e_name'"
    ledger_raw_append "$es_line"
    echo "skillforge: escalation granted for '$e_name' ($e_kind) — budget raised to $e_after steps, $(rounds_planned "$e_after") rounds; grant $e_grant of 2. Record the round it buys with 'skillforge round --name $e_name --blocking <k> --total <m>'."
    exit 0
    ;;

  horizon)
    ledger_ensure_horizon
    exit 0
    ;;

  reap)
    # THE `fail` ROW IS THE POINT OF THIS, not the freed name. An `active` forge with no
    # outcome is invisible to the ledger's start-to-outcome join -- it counts as "never
    # closed out" for as long as the ledger exists -- and it holds its name against every
    # new forge. One appended row does both jobs at once: the join closes and the name is
    # free. Nothing is edited and nothing is deleted, so the ledger stays append-only,
    # which is the property every reader of it depends on.
    #
    # ONLY FORGES PAST THE TTL, EVER. `--name` narrows the set; it does not lower the bar.
    # A reap that could be talked into closing a forge that stepped a minute ago writes a
    # `fail` row over live work, and the forge has no way to tell anyone it was working.
    rp_n=0; rp_unknown=""
    while IFS="$SEP" read -r rp_st rp_nm rp_stt rp_pth; do
      [ -n "${rp_pth:-}" ] || continue
      [ "$rp_stt" = "active" ] || continue
      if [ -n "$NAME_OPT" ] && [ "$rp_nm" != "$NAME_OPT" ]; then continue; fi
      rp_idle="$(slot_idle "$rp_pth")"
      if [ -z "$rp_idle" ]; then
        rp_unknown="$rp_unknown${rp_unknown:+, }$(label_of "$rp_nm" "$rp_pth")"
        continue
      fi
      [ "$rp_idle" -ge "$ACTIVE_TTL" ] || continue
      if close_forge "$rp_pth" failed fail "$REAP_REASON"; then
        rp_n=$(( rp_n + 1 ))
        echo "skillforge: reaped '$CLOSED_NAME' — idle $(fmt_age "$rp_idle"), past SKILLFORGE_ACTIVE_TTL ($(fmt_age "$ACTIVE_TTL")). A 'fail' row is in the ledger and the name is free again."
      fi
    done <<SLOTS
$(slots)
SLOTS
    if [ "$rp_n" -eq 0 ]; then
      if [ -n "$NAME_OPT" ]; then
        echo "skillforge: nothing reaped — no forge named '$NAME_OPT' has been idle longer than $(fmt_age "$ACTIVE_TTL")."
      else
        echo "skillforge: nothing reaped — no active forge has been idle longer than $(fmt_age "$ACTIVE_TTL")."
      fi
    fi
    # Never guessed at, and never silently skipped either: a record nobody can date is
    # exactly the one that would otherwise hold its name forever with no surface saying why.
    if [ -n "$rp_unknown" ]; then
      echo "skillforge: not reaped, age unknown: $rp_unknown. A record with no readable 'updated' is never guessed at; close it by hand with 'skillforge fail --name <forge> <reason>'." >&2
    fi
    exit 0
    ;;

  doctor)
    if [ "${1:-}" = "--json" ]; then
      DOCTOR_JSON=1
      doctor_jq
      doctor_state
      doctor_settings
      doctor_statusline
      doctor_skills
      doctor_surfer
      doctor_ledger
      doctor_counters
      doctor_forges
      doctor_mission
      doctor_review
      # Same aggregation every text run uses -- DOCTOR_PASS/WARN/FAIL_N/FAILED are built
      # by `dr` identically in both modes -- so `--json`'s counts and exit status cannot
      # drift from the text form's. `jq -s` over the accumulated per-check objects, one
      # per array element already, never per line: the `+alternate` guard is `set -uo
      # pipefail`'s own requirement for an array that is never actually empty here (eleven
      # checks always run), kept anyway because doctor's own house rule is never to guess.
      dj_exit=0; [ "$DOCTOR_FAILED" -eq 1 ] && dj_exit=1
      printf '%s\n' ${DOCTOR_JSON_CHECKS[@]+"${DOCTOR_JSON_CHECKS[@]}"} | jq -s \
        --argjson pass "$DOCTOR_PASS" --argjson warn "$DOCTOR_WARN" --argjson fail "$DOCTOR_FAIL_N" \
        --argjson exit "$dj_exit" --argjson now "$(now)" --arg state "$STATE_ROOT" \
        '{checks: ., pass:$pass, warn:$warn, fail:$fail, exit:$exit, now:$now, state:$state}'
      exit "$dj_exit"
    fi
    echo "skillforge doctor"
    echo ""
    doctor_jq
    doctor_state
    doctor_settings
    doctor_statusline
    doctor_skills
    doctor_surfer
    doctor_ledger
    doctor_counters
    doctor_forges
    doctor_mission
    doctor_review
    echo ""
    echo "$DOCTOR_PASS pass, $DOCTOR_WARN warn, $DOCTOR_FAIL_N fail"
    # `if`, not a trailing `&&`: a false `&&` as the last command makes the script exit
    # non-zero, which is precisely the answer this line exists to reserve for a real FAIL.
    if [ "$DOCTOR_FAILED" -eq 1 ]; then exit 1; fi
    exit 0
    ;;

  install)
    # The retry path after a refusal, and the repair path for a forge closed before any
    # of this existed. Unlike `done`, an install that did not happen exits non-zero:
    # here the install IS the request.
    ins_name="${1:-}"
    [ -z "$ins_name" ] && ins_name="$NAME_OPT"
    [ -z "$ins_name" ] && [ -n "$SKILLDIR_OPT" ] && ins_name="$(basename "$SKILLDIR_OPT")"
    [ -z "$ins_name" ] && die "usage: skillforge install <name> [--skill-dir <dir>]"
    install_forged_skill "$ins_name" ""; ins_rc=$?
    case "${INSTALL_STATUS:-}" in
      linked|already-linked|already-there|project|disabled) exit 0 ;;
      not-found) exit 3 ;;
      # Whatever the installer said: a refusal (3) and a failure (4) are different
      # problems and a caller that branches on the code should be able to tell them apart.
      *) [ "$ins_rc" -gt 0 ] && exit "$ins_rc"; exit 4 ;;
    esac
    ;;

  use|verdict|origin)
    # The three ledger-v2 writers. They touch no forge slot and no animation: they only
    # append one row, so they share nothing with the commands above except the ledger.
    #
    # Flags are normalised to --key=value first. Writing the two-form parse out per flag
    # is where a `[ $# -ge 2 ]` guard gets forgotten, and a missing value then silently
    # becomes the NEXT flag's name -- recorded, in the ledger, as if it were evidence.
    NARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --ok|--failed|--harness|--genuine) NARGS[${#NARGS[@]}]="$1"; shift ;;
        --*=*) NARGS[${#NARGS[@]}]="$1"; shift ;;
        --*) [ $# -ge 2 ] || die "$1 requires a value"
             NARGS[${#NARGS[@]}]="$1=$2"; shift 2 ;;
        *)   die "skillforge $cmd takes flags only; got '$1'" ;;
      esac
    done
    set -- ${NARGS[@]+"${NARGS[@]}"}

    v_name="$NAME_OPT"; v_ok="true"; v_session=""; v_cwd=""; v_ep=""; v_harness=""
    v_id=""; v_recorded="live"; v_verdict=""; v_evidence=""; v_usets=""; v_usesession=""
    v_by=""; v_origin=""; v_dir=""; v_created=""; v_trigger=""; v_tkind=""
    for a in "$@"; do
      k="${a%%=*}"; v="${a#*=}"
      case "$k" in
        --ok)          v_ok="true" ;;
        --failed)      v_ok="false" ;;
        --harness)     v_harness="true" ;;
        --genuine)     v_harness="false" ;;
        --name|--skill) v_name="$v" ;;
        --session)     v_session="$v" ;;
        --cwd)         v_cwd="$v" ;;
        --entrypoint)  v_ep="$v" ;;
        --tool-use-id) v_id="$v" ;;
        --recorded)    v_recorded="$v" ;;
        --verdict)     v_verdict="$v" ;;
        --evidence)    v_evidence="$v" ;;
        --use-ts)      v_usets="$v" ;;
        --use-session) v_usesession="$v" ;;
        --judged-by)   v_by="$v" ;;
        --origin)      v_origin="$v" ;;
        --skill-dir)   v_dir="$(abspath "$v")" ;;
        --created-at)  v_created="$v" ;;
        --trigger)     v_trigger="$v" ;;
        --trigger-kind) v_tkind="$v" ;;
        *)             die "unknown option '$k' for skillforge $cmd" ;;
      esac
    done
    [ -n "$v_name" ] || die "usage: skillforge $cmd --name <skill> ..."

    case "$cmd" in
      origin)
        case "${v_origin:-}" in
          forged|workflow|seeded|adopted|unknown) : ;;
          *) die "--origin must be one of: forged workflow seeded adopted unknown" ;;
        esac
        if [ -n "$v_tkind" ]; then
          case " $TRIGGER_KINDS unrecorded " in
            *" $v_tkind "*) : ;;
            *) die "--trigger-kind must be one of: $TRIGGER_KINDS" ;;
          esac
        fi
        if ledger_has_origin "$v_name"; then
          echo "skillforge: '$v_name' already has an origin row; nothing was written"
          exit 0
        fi
        origin_append "$v_name" "$v_origin" "$v_dir" "$v_trigger" "$v_tkind" "$v_created"
        echo "skillforge: recorded origin '$v_origin' for '$v_name'"
        ;;

      use)
        # Called by hooks/skill-use.sh on every Skill invocation, and by the backfill
        # importer for reconstructed ones. It must be cheap and it must never be the
        # reason a turn fails, so every refusal below is about a row that would be WRONG,
        # never about one that is merely incomplete.
        case "$v_recorded" in
          live|derived) : ;;
          *) die "--recorded must be live or derived" ;;
        esac
        if [ -n "$v_id" ] && ledger_has_use_id "$v_id"; then
          echo "skillforge: use $v_id is already in the ledger; nothing was written"
          exit 0
        fi
        # WHO DROVE THE SESSION is the genuine/harness question, and the answer is the
        # transcript's `.entrypoint` ("sdk-cli" means a script did). An explicit
        # --harness/--genuine wins; otherwise it is derived from the entrypoint; and if
        # neither is known the field is OMITTED rather than guessed, because "counted"
        # is the answer that inflates the headline and a silent default is how it got
        # inflated the first time.
        if [ -z "$v_harness" ] && [ -n "$v_ep" ]; then
          if [ "$v_ep" = "sdk-cli" ]; then v_harness="true"; else v_harness="false"; fi
        fi
        v_proj=""
        if [ -n "$v_cwd" ]; then
          v_proj="$(git -C "$v_cwd" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$v_cwd")"
        fi
        u_line="$(jq -n -c --arg name "$v_name" --argjson ok "$v_ok" \
          --arg session "$v_session" --arg cwd "$v_cwd" --arg project "$v_proj" \
          --arg ep "$v_ep" --arg harness "$v_harness" --arg id "$v_id" \
          --arg recorded "$v_recorded" --argjson ts "$(now)" \
          '{event:"use", ts:$ts, name:$name, ok:$ok, recorded:$recorded,
            confidence:"measured", backfilled:false}
           + (if $session == "" then {} else {session:$session} end)
           + (if $cwd     == "" then {} else {cwd:$cwd}         end)
           + (if $project == "" then {} else {project:$project} end)
           + (if $ep      == "" then {} else {entrypoint:$ep}   end)
           + (if $harness == "" then {} else {harness:($harness|test("true"))} end)
           + (if $id      == "" then {} else {tool_use_id:$id}  end)' 2>/dev/null)"
        [ -n "$u_line" ] || die "could not build a use row for '$v_name'"
        ledger_raw_append "$u_line"
        ;;

      verdict)
        case " $VERDICT_VALUES " in
          *" ${v_verdict:-} "*) : ;;
          *) die "--verdict must be one of: $VERDICT_VALUES" ;;
        esac
        # A VERDICT WITH NO QUOTE IS NOT WRITTEN. WORKED, NO-OP and MISFIRED are claims
        # about what a skill did, and a claim with no evidence behind it is exactly the
        # kind of confident-sounding number this ledger exists to stop producing.
        # UNKNOWN is the honest outcome when there is nothing to quote, so it alone may
        # be written bare -- that is what makes it first-class rather than a failure.
        if [ "$v_verdict" != "UNKNOWN" ] && [ -z "$v_evidence" ]; then
          die "--evidence is required for $v_verdict: a verdict with no verbatim quote behind it is not written (UNKNOWN may be written bare)"
        fi
        case "${v_usets:-0}" in ''|*[!0-9]*) v_usets="" ;; esac
        vd_line="$(jq -n -c --arg name "$v_name" --arg verdict "$v_verdict" \
          --arg evidence "$v_evidence" --arg by "$v_by" --arg usesession "$v_usesession" \
          --arg usets "$v_usets" --argjson ts "$(now)" \
          '{event:"verdict", ts:$ts, name:$name, verdict:$verdict,
            judged_at:$ts, confidence:"measured", backfilled:false,
            judgement:"model judgement over recorded evidence, not a measurement"}
           + (if $evidence   == "" then {} else {evidence:$evidence}       end)
           + (if $by         == "" then {} else {judged_by:$by}            end)
           + (if $usesession == "" then {} else {use_session:$usesession}  end)
           + (if $usets      == "" then {} else {use_ts:($usets|tonumber)} end)' 2>/dev/null)"
        [ -n "$vd_line" ] || die "could not build a verdict row for '$v_name'"
        ledger_raw_append "$vd_line"
        ;;
    esac
    exit 0
    ;;

  apply)
    # THE FIFTH QUESTION, ANSWERED. `done` left a debt; this is the only thing that pays
    # it. It appends one `apply` row and deletes the marker, and it touches no forge slot:
    # the forge closed long ago, possibly in another session.
    #
    # Flags are normalised to --key=value first, for the reason the use/verdict/origin arm
    # gives: writing the two-form parse out per flag is where a `[ $# -ge 2 ]` guard gets
    # forgotten, and a missing value then silently becomes the NEXT flag's name --
    # recorded, in the ledger, as if it were evidence. Which is the exact defect this
    # command exists to make impossible.
    AARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) AARGS[${#AARGS[@]}]="$1"; shift ;;
        --*=*)   AARGS[${#AARGS[@]}]="$1"; shift ;;
        --*)     [ $# -ge 2 ] || die "$1 requires a value"
                 AARGS[${#AARGS[@]}]="$1=$2"; shift 2 ;;
        *)       die "skillforge apply takes flags only; got '$1'" ;;
      esac
    done
    set -- ${AARGS[@]+"${AARGS[@]}"}

    # INITIALISED, ALL OF THEM, INCLUDING THE FLAGS THIS ARM SETS ON ONE BRANCH ONLY.
    # `A_NO_MARKER` was assigned on a single `elif` and read as `${A_NO_MARKER:-0}`, which
    # made it the one value in this arm that could arrive from the ambient environment: an
    # exported `A_NO_MARKER=1` sent a delivery WITH a pending marker down the no-marker
    # path and had it refused. Nothing here is a knob, so nothing here is read from
    # outside; the knobs this file does take are named in the header.
    a_name="$NAME_OPT"; a_outcome=""; a_evidence=""; a_forge=""; a_session=""; a_force=0
    A_NO_MARKER=0
    for a in "$@"; do
      k="${a%%=*}"; v="${a#*=}"
      case "$k" in
        --name|--skill) a_name="$v" ;;
        --outcome)      a_outcome="$v" ;;
        --evidence)     a_evidence="$v" ;;
        --forge)        a_forge="$v" ;;
        --session)      a_session="$v" ;;
        --force)        a_force=1 ;;
        *)              die "unknown option '$k' for skillforge apply" ;;
      esac
    done
    [ -n "$a_name" ] || die "usage: skillforge apply --name <skill> --outcome <used|declined|failed> --evidence \"<verbatim>\""
    case " $APPLY_OUTCOMES " in
      *" ${a_outcome:-} "*) : ;;
      *) die "--outcome must be one of: $APPLY_OUTCOMES (got '${a_outcome:-}')" ;;
    esac
    # --EVIDENCE IS REQUIRED, AND THE ARGUMENT FOR IT IS NOT THE ONE `--trigger` GETS.
    # `start` only WARNS without a trigger because refusing there produces no forge record
    # at all, and a row with one missing field beats no row. Here the row IS the claim:
    # "the skill was used" with nothing to quote is not an incomplete measurement, it is
    # the unsupported completion claim this whole package was built to stop -- the same
    # thing hooks/claim-gate.sh refuses on a Stop, arriving through a CLI instead. There
    # is nothing to preserve by accepting it, because what would be preserved is the
    # assertion without the evidence. `declined` and `failed` are held to it too: those
    # are also claims about what happened when somebody put the skill in front of the
    # problem, and "it did not fit" needs a quote exactly as much as "it worked" does.
    #
    # `LC_ALL=C` ON THE `tr`, AND IT IS THE DIFFERENCE BETWEEN THIS GUARD WORKING AND IT
    # REFUSING REAL EVIDENCE. BSD `tr` aborts with "Illegal byte sequence" the moment it
    # meets a byte that is not valid in the ambient locale; the command substitution then
    # yields the empty string and this `case` concludes that no evidence was given.
    # Measured under LANG=en_US.UTF-8 with a quote beginning \377: "tr: Illegal byte
    # sequence" on stderr, then "--evidence is required", exit 2, for 40 characters of
    # perfectly good evidence. A verbatim quote is pasted terminal output -- latin-1, a
    # truncated multibyte character, a stray control byte are all ordinary in it, and the
    # one input this flag exists to carry is the one it refused. The class being tested is
    # ASCII whitespace, so byte semantics are also simply the right semantics here.
    case "$(printf '%s' "$a_evidence" | LC_ALL=C tr -d '[:space:]')" in
      '') die "--evidence is required: record the verbatim quote showing what happened when '$a_name' was put on the problem that caused it. \"used it\" with nothing to quote is the claim this package exists to refuse." ;;
    esac
    # A BOUND, BECAUSE THE ROW IS APPENDED VERBATIM AND FOREVER. Every reader of this file
    # slurps the whole ledger through `jq -s`, so one pasted megabyte is carried by every
    # `skillforge ledger`, `pending` and `skillreport` run from then on. The bound below is
    # far past any quote a human pastes and far short of a transcript dump; the figure is
    # here and nowhere else -- tests/test_forge_apply.py reads it out of this line rather
    # than restating it. What is being refused is
    # a mistake -- a file redirected into the flag -- not a use case. Refused rather than
    # truncated: a truncated quote is still presented as verbatim, and this flag's entire
    # value is that it is. `${#...}` counts characters under a multibyte locale and bytes
    # under bash 3.2, and either bounds the row; the test pins it in the C locale, where
    # the two agree.
    APPLY_EVIDENCE_MAX=65536
    if [ "${#a_evidence}" -gt "$APPLY_EVIDENCE_MAX" ]; then
      die "--evidence is ${#a_evidence} long; the limit is $APPLY_EVIDENCE_MAX. Quote the part that shows what happened, not the whole transcript -- every reader of this ledger carries the row forever."
    fi

    a_marker="$(apply_marker_path "$a_name")"
    a_have=0; a_closed=""; a_installed=""; a_instance=""
    # ONE READ, NOT FIVE, AND THE RACE IS WHY. The marker is deleted by whichever apply
    # discharges it, so five separate `field` calls against the path can straddle that
    # deletion: the first returns a value and the rest return nothing. Reproduced with six
    # concurrent appliers -- a late racer read `forge_id` as empty, fell back to a
    # different claim key, won it, and appended a SECOND row for one act. A single jq takes
    # one snapshot; every field below comes out of it, so they are consistent or all
    # absent. US-separated for the reason slots() gives: a forge name may contain a tab.
    a_snap="$(jq -r '[(.closed // 0), (.installed | if . == null then "" else tostring end),
                      (.forge // ""), (.session // ""), (.forge_id // "")]
                     | join("\u001f")' "$a_marker" 2>/dev/null)"
    if [ -n "$a_snap" ]; then
      a_have=1
      IFS="$SEP" read -r a_closed a_installed a_m_forge a_m_session a_instance <<SNAP
$a_snap
SNAP
      a_closed="$(int_or_zero "$a_closed")"
      [ -n "$a_forge" ] || a_forge="$a_m_forge"
      # WHICH FORGE THIS DEBT BELONGS TO. See the claim below for why name+session was not
      # enough. A marker written by an older version carries no `forge_id`; the close epoch
      # stands in, because `done` rewrites the marker every time it closes a forge and the
      # two closes a caller could confuse are seconds to hours apart.
      [ -n "$a_instance" ] || a_instance="legacy.$a_closed"
    elif [ -f "$a_marker" ]; then
      # The file is there but says nothing this build understands -- half-written by a
      # concurrent `done`, or from a future version. The debt is real, so it is still
      # discharged; with no instance to name, the claim falls back to the session, which
      # is where the winner's tombstone is. Never deleted for being unparseable: that is
      # the rule every reader of this directory follows.
      a_have=1
    elif [ "$a_force" -eq 0 ]; then
      # NOTHING TO DISCHARGE. Whether that is an error is decided a few lines down, once
      # the session key is known -- NOT here, and the difference is a whole delivery. The
      # second delivery of one act arrives after the winner has removed the marker and
      # carries no `--force`, because it is the SAME COMMAND; refused here it exited 2
      # saying "no forge is waiting to be applied" about an act that is on the ledger, and
      # a hook wired through both install paths took that on every event. Two of ten
      # concurrent racers hit it, in two runs out of eight.
      A_NO_MARKER=1
    fi
    # WHOSE SESSION IS THIS. The applier's, not the forger's: the row answers "who put it
    # on the problem". An explicit --session wins, then the environment; the marker's own
    # session is the last resort, because in the ordinary case the two are the same
    # session and an id is better than a hole. It is also half the idempotence key below,
    # so it has to be stable across two deliveries of one intent -- which every one of
    # those three is.
    [ -n "$a_session" ] || a_session="${CLAUDE_CODE_SESSION_ID:-}"
    [ -n "$a_session" ] || { [ "$a_have" -eq 1 ] && a_session="$(field "$a_marker" session)"; }

    # THE THREE CLAIM PATHS, BUILT ONCE AND IN ONE PLACE. The refusal below consults two
    # of them and the claim further down takes them, and while the refusal spelled its own
    # path inline the two spellings were one edit away from disagreeing -- the same hazard
    # the session-id sanitising note in .claude/CLAUDE.md describes, in one file.
    #
    # THE ACT ID IS WHAT MAKES A SECOND ACT VISIBLE. name+outcome+evidence, in this
    # session: it is the identity of what somebody did, and it is the only thing on disk
    # that can tell a genuinely SECOND act on one skill from the SAME act delivered twice.
    # The row itself cannot -- a first delivery carries marker:true, elapsed and installed
    # and its re-delivery carries none of them, so two records of one act do not match
    # byte for byte. `cksum` because it is POSIX and already on the minimal PATH these
    # scripts run under; both of its fields are kept, so a collision needs the same CRC
    # AND the same length. Two acts that really do share a name, an outcome and a verbatim
    # quote are one act as far as this ledger can tell, and are folded on purpose.
    a_act_id="$(printf '%s\037%s\037%s\037%s' "$a_name" "$a_session" "$a_outcome" \
      "$a_evidence" | cksum 2>/dev/null | tr -cd '0-9 ' | tr ' ' '.')"
    a_base="$DIR/.apply.$(safe_name "$a_name")"
    a_claim_session="$a_base.s.$(safe_name "$a_session").claim"
    # No `cksum` on PATH leaves no act id, and the fallback is the behaviour that shipped
    # before it: the session tombstone answers for the whole session. It absorbs a
    # re-delivery, which is the case that must not regress, and it cannot see a second
    # act, which is the case that then gets refused rather than dropped.
    a_claim_row=""
    [ -n "$a_act_id" ] && a_claim_row="$a_base.r.$(safe_name "$a_act_id").claim"
    # WHICH KEY THIS DELIVERY IS HELD TO, and the middle branch is the whole of `--force`.
    #
    # With a marker, the forge instance: one debt, one claim.
    #
    # WITHOUT a marker and WITHOUT `--force`, the SESSION -- and it must stay the session,
    # because that is what makes a racer safe. A delivery that finds no marker at all is
    # usually not a second act; it is a racer that read the directory a few milliseconds
    # after the winner discharged the debt, and it carries its own wording of the evidence
    # because two agents describing one act do not type the same sentence. Keyed on the
    # act it would find its key FREE and append a second row for one act, which is the
    # duplicate this whole scheme exists to prevent. The concurrent case, and the count of
    # duplicate rows it produced before the tombstone, are in
    # tests/test_forge_apply.py DebtsAreDistinguishedByForgeInstance; the figure lives
    # there and is not repeated here.
    # So it loses the session key, exits 0, and what it is TOLD depends on the act claim --
    # see the loser branch, which is where a second act is named and pointed at --force.
    #
    # WITH `--force`, the act: the flag is a deliberate statement that this is a real act
    # with no marker to discharge, so it must be able to get past a session key some
    # earlier apply is holding -- otherwise the advice the loser branch gives is advice
    # that does not work. Two identical forced deliveries still collide on the act.
    if [ -n "$a_instance" ]; then
      a_claim="$a_base.f.$(safe_name "$a_instance").claim"
    elif [ "$a_force" -eq 1 ] && [ -n "$a_claim_row" ]; then
      a_claim="$a_claim_row"
    else
      a_claim="$a_claim_session"
    fi

    # THE REFUSAL, DECIDED HERE, WHERE THE TOMBSTONE CAN BE SEEN. A winner claims the
    # session key as well as its forge instance for exactly this case: a later delivery
    # with no marker to key on lands on a path that is already taken and loses quietly.
    # That protection was unreachable while the refusal above ran first -- the delivery it
    # was built for never got as far as the claim. So a session that already holds a
    # tombstone for this skill falls THROUGH, loses the claim below, and is told there
    # what happened; everything else is refused exactly as before.
    #
    # NOTHING IS REFUSED HERE FOR BEING A SECOND ACT, and that is deliberate. This branch
    # cannot tell a second act from a racer -- both arrive with no marker and evidence of
    # their own -- and a racer that exits non-zero is a hook failing on every event. The
    # distinction is drawn where it is cheap and safe: past the claim, where nothing can
    # be appended by either of them, the loser branch reads the act claim and says which
    # of the two this was.
    #
    # NAME WHAT IS PENDING. A refusal that says only "nothing is pending for 'wdiget'"
    # leaves a caller who mistyped the name with no way to see the right one, and the
    # cheapest way past a CLI that refuses without helping is to stop calling it.
    if [ "$A_NO_MARKER" -eq 1 ]; then
      if [ -z "$a_session" ] || [ ! -e "$a_claim_session" ]; then
        a_names="$(apply_pending_names)"
        [ -n "$a_names" ] || a_names="(nothing)"
        die "no forge is waiting to be applied for '$a_name'. Pending: $a_names. If '$a_name' really was applied and its marker is gone (or it was never forged here), record it anyway with --force and the row will say so (marker:false)."
      fi
    fi

    a_ts="$(now)"
    a_elapsed=""
    if [ "$a_have" -eq 1 ] && [ -n "$a_closed" ] && [ "$a_closed" -gt 0 ]; then
      a_elapsed=$(( a_ts - a_closed ))
      # Clamped for the same reason ledger_close_line clamps a duration: a state directory
      # copied between machines, or a clock stepped backwards, must not put a negative
      # number in the record and make every later reader special-case it.
      [ "$a_elapsed" -lt 0 ] && a_elapsed=0
    fi
    a_marker_flag=false
    [ "$a_have" -eq 1 ] && a_marker_flag=true
    a_line="$(jq -n -c --arg name "$a_name" --arg outcome "$a_outcome" \
      --arg evidence "$a_evidence" --arg forge "$a_forge" --arg session "$a_session" \
      --arg elapsed "$a_elapsed" --arg installed "$a_installed" \
      --argjson marker "$a_marker_flag" --argjson ts "$a_ts" \
      '{event:"apply", ts:$ts, name:$name, outcome:$outcome, evidence:$evidence,
        marker:$marker, confidence:"measured", backfilled:false}
       + (if $forge     == "" then {} else {forge:$forge}                 end)
       + (if $session   == "" then {} else {session:$session}             end)
       + (if $elapsed   == "" then {} else {elapsed:($elapsed|tonumber)}  end)
       + (if $installed == "" then {} else {installed:($installed|test("true"))} end)' 2>/dev/null)"
    [ -n "$a_line" ] || die "could not build an apply row for '$a_name'"

    # THE SAME CLAIM SCHEME `done` USES. `ln` of a fully-written file onto a path that has
    # never been used is atomic: exactly one process links it, nothing is HELD, and a
    # killed process leaves no lock because there was none. What it stops is two deliveries
    # of ONE act -- a retried command, a hook wired through both install paths, two agents
    # told the same thing -- both finding the marker, both appending, and the ledger saying
    # a skill was applied twice on the strength of one act.
    #
    # THE KEY IS THE FORGE INSTANCE, NOT name+session, AND name+session WAS A BUG. Forging
    # a skill again after a red-team fix is this protocol's own prescribed workflow, so one
    # session closes two forges of one name and owes two separate debts. Keyed on
    # name+session the first apply's claim was still on disk (reaped only at -mmin +60)
    # when the second arrived: the second took the LOSER branch, deleted the new marker,
    # printed "already been recorded", and exited 0 -- one apply row on disk, the second
    # forge's evidence gone for good. Reproduced, one session id throughout.
    #
    # A `--force` REPORT HAS NO FORGE INSTANCE TO NAME, so it falls back to the session:
    # nothing on disk ties it to a forge, and within one session a second unattached report
    # of the same skill is a re-delivery rather than a second act. The two kinds of key
    # share one namespace, hence the `f.`/`s.` prefixes -- a forge id and a session id are
    # both opaque strings and neither may be mistaken for the other. The name and one key
    # are all that is in the path: three `safe_name` components would exceed NAME_MAX on
    # a long skill name, and `ln` failing for want of a shorter filename hands back the
    # duplicate row the claim exists to prevent (measured at 230 characters, in forge_id).
    #
    # THE TWO RECEIPTS. Whatever it keyed on, the winner ALSO claims the other two: the
    # SESSION key, so a later delivery with no marker to key on lands on a taken path and
    # loses quietly, and the ACT key -- this name, this outcome, this evidence, in this
    # session -- which is what the loser branch reads to tell a re-delivery of the
    # recorded act from a genuinely different one. Both are best effort and neither is
    # fatal: they prevent a duplicate and they explain one, they are not what makes the
    # apply durable. Both are also why every winner takes all three even when it needed
    # only one: a receipt nobody left is a question nobody can answer later.
    #
    # Everything that forks is on the near side of the claim -- the row is already built,
    # and ledger_ensure_horizon runs here rather than inside the append below -- so the
    # interval between winning the claim and having the row on disk is one printf builtin.
    ledger_ensure_horizon
    a_tmp="$DIR/.apply.$$.$a_ts.tmp"
    { printf '%s\n' "$a_line" > "$a_tmp"; } 2>/dev/null || a_tmp=""
    a_won=1
    # WHAT THIS INVOCATION CREATED, AND NOTHING ELSE. The release below is keyed on these
    # two flags rather than on the paths, because the tombstone path may already be held
    # by an EARLIER apply of this skill in this session -- the one whose row is on the
    # ledger. `ln` failing on it is the normal case, not an error, and a release that
    # deleted it anyway handed the session key back: the next report with no marker to key
    # on (a `--force` re-delivery of that first act) then won it and wrote its row a
    # second time. Reproduced, one session, two forges, one failed append.
    a_made_claim=0
    a_made_session=0
    a_made_row=0
    if [ -n "$a_tmp" ]; then
      if ln "$a_tmp" "$a_claim" 2>/dev/null; then
        a_made_claim=1
        if [ "$a_claim" = "$a_claim_session" ]; then
          a_made_session=1
        elif ln "$a_tmp" "$a_claim_session" 2>/dev/null; then
          a_made_session=1
        fi
        if [ -z "$a_claim_row" ]; then
          :
        elif [ "$a_claim" = "$a_claim_row" ]; then
          a_made_row=1
        elif ln "$a_tmp" "$a_claim_row" 2>/dev/null; then
          a_made_row=1
        fi
      elif [ -e "$a_claim" ]; then
        a_won=0
      fi
      # `ln` failed with no claim to explain it -- a read-only state directory, or a
      # filesystem that refuses links. Proceed: the claim exists to stop a duplicate row,
      # and a claim that cannot be created must never become the reason an apply cannot be
      # recorded at all. Exactly the fall-through close_forge takes, for the same reason.
      rm -f "$a_tmp" 2>/dev/null
    fi
    if [ "$a_won" -eq 0 ]; then
      # LOST, AND THE HEAL BELOW MAY NOT BE TAKEN ON FAITH. Deleting the marker finishes
      # work the winner may not have reached -- but only if the winner GOT there. A winner
      # killed between the claim and the append, or one whose append failed, writes no row
      # and keeps its marker on purpose; the heal then deleted the debt anyway, said the
      # act "has already been recorded", and exited 0. No row, no debt, `pending` reporting
      # nothing waiting: the same false completion claim a failed append used to produce,
      # arriving by the other door. Every hook event is delivered twice, so this branch is
      # the ordinary path and not an edge.
      #
      # THE CLAIM FILE IS THE WINNER'S ROW, byte for byte -- it is a hard link to the file
      # the winner built the row in -- so whether that row reached the ledger is a question
      # about this file's own contents and needs nothing from the winner. The match is on
      # a WHOLE LINE, exactly: the row is one line of JSON, and a substring match would say
      # yes to a longer row that merely contains this one.
      #
      # NOT `grep -F -x`, AND THE REASON IS A HARD CEILING. BSD grep 2.6.0-FreeBSD -- the
      # `grep` in /usr/bin, which is what these scripts get under a minimal PATH -- aborts
      # with `grep: out of memory` and exit 2 once a fixed pattern passes a ceiling, and
      # the longest row APPLY_EVIDENCE_MAX allows is past it. No figure is quoted here on
      # purpose: `python3 tests/test_forge_apply.py TheLandedCheckHasNoPatternLengthLimit`
      # bisects that ceiling on the machine it runs on and prints it, with the length of
      # the row each of its three cases builds, on every run. Exit 2 reads here as "no
      # match", and the loser then concludes the winner recorded nothing: it keeps a debt
      # that HAS been discharged and tells the caller its act was never written. Wrong in
      # the direction that loses a paid debt.
      #
      # `awk` has no pattern-length limit -- it is comparing two strings, not compiling a
      # matcher -- and the row is handed to it as a FILE rather than through the
      # environment or argv, both of which are bounded by ARG_MAX. `NR == FNR` selects the
      # claim file's one line, which is why the emptiness guard below is load-bearing: on
      # an empty claim file that test would fall on the ledger's first line and take IT as
      # the pattern. Both sides are concatenated with "" so a row that happened to look
      # numeric is still compared as text.
      a_wrow="$(cat "$a_claim" 2>/dev/null)"
      a_landed=0
      if [ -n "$a_wrow" ] && awk '
        NR == FNR { aw_row = $0 ""; next }
        ($0 "") == aw_row { aw_hit = 1; exit }
        END { exit (aw_hit ? 0 : 1) }
      ' "$a_claim" "$LEDGER" 2>/dev/null; then
        a_landed=1
      fi
      if [ "$a_landed" -eq 1 ]; then
        # The row is on disk. What is said about it depends on WHICH claim was lost, and
        # ONE RUN MUST NOT PRINT TWO INCOMPATIBLE STATEMENTS: the stderr line here used to
        # say the recorded row does not discharge that forge while the stdout line on the
        # same run said it had been recorded "for this forge". A caller reading either
        # alone was misled by the other, so each branch carries its own stdout line and
        # none of them borrows another's.
        if [ -n "$a_instance" ]; then
          # Lost on this forge's own instance claim: the recorded row IS this debt, so the
          # marker is healed -- the winner may have been killed before it could.
          [ "$a_have" -eq 1 ] && rm -f "$a_marker" 2>/dev/null
          echo "skillforge: '$a_name' has already been recorded as applied for this forge; nothing was written"
          exit 0
        fi
        # No instance: the claim we lost names an act or a session, and neither says the
        # forge behind any pending marker was applied. A marker written by a LATER `done`,
        # or one this build could not parse, therefore STAYS.
        if [ "$a_have" -eq 1 ]; then
          echo "skillforge: the pending marker for '$a_name' is LEFT WHERE IT IS: this delivery lost on a claim that names an act rather than a forge, so it does not say the pending forge was applied. Check it with 'skillforge pending'." >&2
        fi
        # THE SECOND ACT, NAMED RATHER THAN SWALLOWED. The act claim is this name, this
        # outcome, this evidence, in this session: a winner takes it alongside whatever it
        # keyed on, so its presence answers the one question the session key cannot. Taken
        # means this very act is the one on the ledger -- a re-delivery, or a racer typing
        # the same quote -- and there is nothing to record. FREE means the recorded row is
        # a DIFFERENT act, and this one has not been written anywhere: saying "already
        # been recorded" about it is the false completion claim this package exists to
        # refuse, and saying nothing at all is worse. It cannot be appended here (the
        # session key is held, and letting it through would give every concurrent racer a
        # row of its own), so
        # the caller is told exactly that, and told the flag that does record it.
        #
        # EXIT 0 EITHER WAY, and the racer is why: a delivery with no marker is far more
        # often a lost race than a second act, and a hook wired through both install paths
        # would take a non-zero exit on every event. Nothing is claimed to have been
        # recorded, so nothing is claimed falsely.
        if [ -n "$a_claim_row" ] && [ ! -e "$a_claim_row" ]; then
          echo "skillforge: NOTHING WAS RECORDED for this act on '$a_name'. An apply row for '$a_name' from this session is already on $LEDGER, but it is a DIFFERENT act -- the outcome or the evidence differs -- and this one has not been written anywhere. If it really is a second, distinct act, record it with: skillforge apply --name '$a_name' --outcome $a_outcome --force --evidence \"<the quote>\"" >&2
          echo "skillforge: nothing was written for '$a_name'; see the note above about recording it with --force"
          exit 0
        fi
        echo "skillforge: that act on '$a_name' -- same outcome, same evidence -- has already been recorded in this session; nothing was written"
        exit 0
      fi
      if [ -e "$a_claim" ]; then
        # The claim is still held and no row carrying it is on the ledger. Either the
        # winner is between its `ln` and its `printf` right now -- microseconds, and it
        # will delete the marker itself -- or it died in that window and never will. The
        # two are indistinguishable from here and the same answer is right for both: touch
        # NOTHING, say what is true, and leave the debt for `pending` to keep showing.
        # Exit 0, because a second delivery of one act is not a failure of this caller's;
        # the delivery that owns the row is the one that reports on it.
        echo "skillforge: another delivery of '$a_name' holds the claim and NO row for it has reached $LEDGER, so nothing was written here and the pending marker is left where it is -- the debt is still owed. If that delivery died before it could append, the claim is reaped after an hour and the same command will then record it." >&2
        exit 0
      fi
      # The claim is gone: the winner released it, which it does on exactly one path --
      # its append failed and it exited non-zero saying so. Nothing was recorded by
      # either of us and the key is free again, so the retry is a plain re-run.
      echo "skillforge: the delivery of '$a_name' that held the claim recorded NOTHING and released it, so nothing was written and the debt is still owed. Fix the ledger (is $LEDGER writable?) and run the same command again." >&2
      exit 1
    fi
    # THE MARKER IS DISCHARGED ONLY IF THE ROW REALLY LANDED, and until this was written it
    # was discharged either way. The append was `printf ... >> "$LEDGER" 2>/dev/null ||
    # true` with an unconditional `rm -f "$a_marker"` under it: with the ledger chmod 444,
    # `apply` printed bash's own "Permission denied", then "recorded — 'ro' was USED ... The
    # loop is closed.", exited 0, wrote no row, deleted the debt, and `pending` reported
    # nothing waiting. That is precisely the unsupported completion claim hooks/claim-gate.sh
    # exists to refuse, arriving through this package's own CLI -- and the evidence quote,
    # which nothing else holds, was gone with it.
    #
    # `2>/dev/null` AFTER THE `>>` DID NOT EVEN SUPPRESS THAT MESSAGE, which is why the
    # reproduction shows bash's own "Permission denied" ABOVE skillforge's own line.
    # Redirections are applied left to right: written that way round `>>` is opened first
    # and its failure is reported by the SHELL, to a stderr that is still the terminal.
    # Putting `2>/dev/null` FIRST is the fix -- measured, `printf x 2>/dev/null >> ro` is
    # silent where `printf x >> ro 2>/dev/null` is not -- and unlike a brace group it
    # leaves the line shape the reconstructions in tests/test_forge_close_race.py anchor
    # on. Every other append in this file now reads the same way.
    #
    # THE CLAIM IS RELEASED ON FAILURE, AND ONLY THE PART OF IT THIS INVOCATION CREATED.
    # It was taken for an act that did not happen, and leaving it would make the retry --
    # the whole point of exiting non-zero -- lose, which now leaves the debt but still
    # records nothing until the claim is reaped. What must NOT be released is a tombstone
    # this invocation found already taken: that one is an earlier apply's receipt, its row
    # is on the ledger, and deleting it reopens the session key for a duplicate.
    if printf '%s\n' "$a_line" 2>/dev/null >> "$LEDGER"; then
      rm -f "$a_marker" 2>/dev/null
    else
      [ "$a_made_claim" -eq 1 ] && rm -f "$a_claim" 2>/dev/null
      [ "$a_made_session" -eq 1 ] && rm -f "$a_claim_session" 2>/dev/null
      [ "$a_made_row" -eq 1 ] && rm -f "$a_claim_row" 2>/dev/null
      echo "skillforge: could not append the apply row to $LEDGER, so NOTHING was recorded for '$a_name'. The pending marker is left where it is -- the debt is still owed. Fix the ledger (is it writable?) and run the same command again." >&2
      exit 1
    fi
    reap_temps
    a_when=""
    [ -n "$a_elapsed" ] && a_when=" $(ago "$a_elapsed") after it was forged"
    case "$a_outcome" in
      used) echo "skillforge: recorded — '$a_name' was USED on the problem that caused it$a_when. The loop is closed." ;;
      *)    echo "skillforge: recorded — '$a_name' was $a_outcome on the problem that caused it$a_when." ;;
    esac
    [ "$a_have" -eq 0 ] && echo "skillforge: no pending marker existed for '$a_name', so the row records marker:false — it is a report, not something this ledger watched happen." >&2
    a_left="$(apply_markers | jq -s 'length' 2>/dev/null)"
    case "$(int_or_zero "${a_left:-0}")" in
      0) : ;;
      *) echo "skillforge: $a_left forge(s) still waiting to be applied (skillforge pending)" ;;
    esac
    exit 0
    ;;

  pending)
    # THE QUEUE OF UNPAID DEBTS, oldest first, which is the order they should be worked
    # off in: the longest-standing one is the forge most likely to have been forgotten.
    # `--json` is what the status line and hooks/apply-gate.sh would read if they went
    # through the CLI; both read the directory directly, and this is the human door.
    p_rows="$(apply_markers)"
    if [ "${1:-}" = "--json" ]; then
      # One compact object per line, redacted like `show` and `ledger --json`: a marker
      # carries the verbatim trigger. `--full` lifts it for the party the held-out set
      # belongs to.
      [ -n "$p_rows" ] && printf '%s\n' "$p_rows" | jq -c "$(redact_prog)" 2>/dev/null
      exit 0
    fi
    if [ -z "$p_rows" ]; then
      echo "nothing is waiting to be applied ($APPLY_DIR)"
      exit 0
    fi
    p_n=0
    printf '%-28s %-6s %-9s %-20s %s\n' "SKILL" "AGE" "INSTALLED" "FORGE" "SUMMARY"
    while IFS= read -r p_line; do
      [ -n "$p_line" ] || continue
      p_n=$(( p_n + 1 ))
      # Through jq, one field per read, for the reason sfield exists: a summary holding a
      # control character would otherwise split one marker across three rows of the table.
      p_name="$(printf '%s' "$p_line" | jq -r '(.name // "") | gsub("[[:cntrl:]]"; " ")' 2>/dev/null)"
      p_age="$(printf '%s' "$p_line" | jq -r '.age // 0' 2>/dev/null)"
      p_forge="$(printf '%s' "$p_line" | jq -r '(.forge // "") | gsub("[[:cntrl:]]"; " ")' 2>/dev/null)"
      p_sum="$(printf '%s' "$p_line" | jq -r '(.summary // "") | gsub("[[:cntrl:]]"; " ")' 2>/dev/null)"
      p_ins="$(printf '%s' "$p_line" | jq -r 'if .installed then "yes" else "NO" end' 2>/dev/null)"
      printf '%s %-6s %-9s %s %s\n' \
        "$(cell "$p_name" 28)" "$(ago "$p_age")" "$p_ins" "$(cell "$p_forge" 20)" "$p_sum"
    done <<PENDING
$p_rows
PENDING
    echo ""
    echo "$p_n forge(s) closed and not yet applied. A skill is built AS NEEDED, so the loop is not closed until it has been put on the problem that caused it: skillforge apply --name <skill> --outcome used --evidence \"<verbatim quote>\""
    echo "(the verbatim trigger each one recorded is held out of this view; skillforge pending --json --full shows it)"
    exit 0
    ;;

  backfill)
    # THE ONLY DOOR RECONSTRUCTED HISTORY COMES THROUGH. Rows arrive as JSON lines and
    # are appended only after EVERY line has been checked, so a file with one bad row
    # leaves the ledger untouched instead of half-imported -- there is no undo for an
    # append, and a partial import cannot be told apart from a complete one afterwards.
    #
    # Three rules, none of them negotiable:
    #   1. Every row carries `backfilled:true`, `confidence:"reconstructed"`, a `source`
    #      naming the evidence it was read from, and `reconstructed_at`. A row without a
    #      source is refused: the whole file is refused with it.
    #   2. No live row is ever rewritten, moved or removed. This only ever appends.
    #   3. A row that duplicates something already in the ledger is skipped, so the
    #      import is re-runnable.
    bf_in="${1:-}"
    [ -n "$bf_in" ] || die "usage: skillforge backfill <file.jsonl | -> "
    bf_tmp="$DIR/.backfill.$$.tmp"
    if [ "$bf_in" = "-" ]; then cat > "$bf_tmp"; else
      [ -f "$bf_in" ] || die "no such file: $bf_in"
      cat "$bf_in" > "$bf_tmp" 2>/dev/null || die "could not read $bf_in"
    fi
    [ -f "$LEDGER" ] || : > "$LEDGER" 2>/dev/null || true
    bf_out="$(jq -R -s --rawfile existing "$LEDGER" --argjson now "$(now)" '
      def parse: [ split("\n")[] | select(length > 0) | (fromjson? // empty) ];
      ($existing | parse) as $old
      | [ split("\n")[] | select((. | gsub("[[:space:]]"; "")) != "") ] as $lines
      | [ range(0; ($lines | length))
          | { n: (. + 1), raw: $lines[.], obj: ($lines[.] | fromjson? // null) } ] as $rows
      | [ $rows[]
          | . as $r
          | (if   ($r.obj | type) != "object" then "line \($r.n): not a JSON object"
             elif (["origin","use","verdict"] | index($r.obj.event) | not)
                  then "line \($r.n): event must be origin, use or verdict (got \($r.obj.event | tojson))"
             elif (($r.obj.name // "") | length) == 0
                  then "line \($r.n): no name"
             elif (($r.obj.source // "") | length) == 0
                  then "line \($r.n): no source. A reconstructed row must name the transcript, note or file it was read from."
             elif ($r.obj.backfilled == false)
                  then "line \($r.n): backfilled:false. This entry point only accepts reconstructed rows."
             else empty end) ] as $errors
      | if ($errors | length) > 0 then {errors: $errors, append: [], skipped: 0}
        else
          (reduce $rows[] as $r ({append: [], skipped: 0, seen: $old};
             ($r.obj) as $o
             | (.seen | any(
                  ($o.event == "origin" and .event == "origin" and .name == $o.name)
                  or ($o.event == "use" and .event == "use"
                      and ((($o.tool_use_id // "") != "" and .tool_use_id == $o.tool_use_id)
                           or (($o.tool_use_id // "") == ""
                               and .name == $o.name and .ts == $o.ts
                               and (.session // "") == ($o.session // ""))))
                  or ($o.event == "verdict" and .event == "verdict"
                      and .name == $o.name and (.use_ts // null) == ($o.use_ts // null)
                      and (.use_session // "") == ($o.use_session // ""))
                )) as $dup
             | if $dup then .skipped += 1
               else ($o + {backfilled: true, confidence: "reconstructed"}
                     + (if ($o.reconstructed_at // null) == null
                        then {reconstructed_at: $now} else {} end)) as $row
                    | .append += [$row] | .seen += [$row]
               end))
          | {errors: [], append: .append, skipped: .skipped}
        end' "$bf_tmp" 2>&1)"
    rm -f "$bf_tmp" 2>/dev/null
    case "$bf_out" in
      '{'*) : ;;
      *) die "could not read $bf_in as JSON lines: $bf_out" ;;
    esac
    bf_err="$(printf '%s' "$bf_out" | jq -r '.errors[]?' 2>/dev/null)"
    if [ -n "$bf_err" ]; then
      echo "skillforge: nothing was imported. $bf_in has rows this cannot accept:" >&2
      printf '%s\n' "$bf_err" | sed 's/^/  /' >&2
      exit 2
    fi
    ledger_ensure_horizon
    bf_n=0
    while IFS= read -r bf_line; do
      [ -n "$bf_line" ] || continue
      printf '%s\n' "$bf_line" >> "$LEDGER" || die "could not append to $LEDGER"
      bf_n=$(( bf_n + 1 ))
    done <<BACKFILL
$(printf '%s' "$bf_out" | jq -c '.append[]?' 2>/dev/null)
BACKFILL
    bf_skip="$(printf '%s' "$bf_out" | jq -r '.skipped // 0' 2>/dev/null)"
    echo "skillforge: backfilled $bf_n row(s) into $LEDGER, skipped $bf_skip already present. Every imported row is marked backfilled:true and confidence:\"reconstructed\"."
    exit 0
    ;;

  clear)
    # An active forge thrown away is still a forge that happened. Record it, so the
    # ledger cannot quietly overstate the completion rate.
    if [ "$ALL_OPT" -eq 1 ]; then
      cleared=0
      while IFS="$SEP" read -r c_st c_nm c_stt c_pth; do
        [ -n "${c_pth:-}" ] || continue
        # `drop`: the slot is about to be deleted, so there is nothing to publish. The
        # claim still decides the row, so a clear racing a done writes one row, not two.
        if [ "$c_stt" = "active" ]; then
          close_forge "$c_pth" failed fail "cleared before completing" drop || :
        fi
        rm -f "$c_pth"; cleared=$(( cleared + 1 ))
      done <<SLOTS
$(slots)
SLOTS
      reap_temps; reap_claims
      echo "skillforge: cleared $cleared forge(s)"
      exit 0
    fi
    resolve_slot "$NAME_OPT"; rc=$?
    [ "$rc" -eq 3 ] && die "$AMBIG are all live. Say which one: skillforge clear --name <forge>, or clear every one with skillforge clear --all"
    [ "$rc" -eq 1 ] && [ -n "$NAME_OPT" ] && die "no forge named '$NAME_OPT' (try: skillforge list)"
    if [ "$rc" -eq 0 ]; then
      if [ "$(field "$RESOLVED" status)" = "active" ]; then
        close_forge "$RESOLVED" failed fail "cleared before completing" drop || :
      fi
      rm -f "$RESOLVED"
      echo "skillforge: cleared"
      exit 0
    fi
    echo "skillforge: nothing to clear"
    ;;

  show)
    if [ "$ALL_OPT" -eq 1 ]; then
      shown=0
      while IFS="$SEP" read -r s_st s_nm s_stt s_pth; do
        [ -n "${s_pth:-}" ] || continue
        jq -c "$(redact_prog)" "$s_pth" 2>/dev/null && shown=$(( shown + 1 ))
      done <<SLOTS
$(slots)
SLOTS
      [ "$shown" -eq 0 ] && echo "no active forge"
      exit 0
    fi
    resolve_slot "$NAME_OPT"; rc=$?
    # A --name that matches nothing is a typo, and answering it with the same
    # "no active forge" a quiet system prints -- at exit 0 -- tells the caller their
    # forge finished when in fact it was never found. `step` and `clear` both die here.
    [ "$rc" -eq 1 ] && [ -n "$NAME_OPT" ] && die "no forge named '$NAME_OPT' (try: skillforge list)"
    if [ "$rc" -eq 0 ]; then
      jq "$(redact_prog)" "$RESOLVED" 2>/dev/null || cat "$RESOLVED"
    elif [ "$rc" -eq 3 ]; then
      # Several are live and no name was given. Print them ALL rather than picking one:
      # `show` is what a caller uses to ask "what is going on", and answering with one
      # of several is the misreport this whole scheme exists to stop. One compact object
      # per line, so a downstream `jq -re '.status'` still reads every one of them.
      while IFS="$SEP" read -r s_st s_nm s_stt s_pth; do
        [ -n "${s_pth:-}" ] || continue
        jq -c "$(redact_prog)" "$s_pth" 2>/dev/null
      done <<SLOTS
$(slots)
SLOTS
    else
      echo "no active forge"
    fi
    ;;

  list)
    # IDLE IS A COLUMN, NOT A DERIVATION THE READER HAS TO DO. The status line has
    # computed this since it was written and nothing else consumed it, so the one
    # place a person asks "what is running?" could not distinguish a forge that
    # stepped a minute ago from one whose orchestrator died three days back. The
    # threshold is the renderer's own, so the two surfaces cannot drift apart.
    #
    # Nothing is closed or deleted here, deliberately. An idle forge may still be
    # live work, and the decision to end one belongs to a person; this only makes
    # the decision possible by putting the age where it is read.
    listed=0
    stale=0
    l_thresh="${SKILLFORGE_IDLE_SECS:-2700}"
    case "$l_thresh" in ''|*[!0-9]*) l_thresh=2700 ;; esac
    while IFS="$SEP" read -r l_st l_nm l_stt l_pth; do
      [ -n "${l_pth:-}" ] || continue
      [ "$listed" -eq 0 ] && printf '%-28s %-8s %8s  %-9s %s\n' "FORGE" "STATE" "STEP" "IDLE" "PHASE"
      listed=$(( listed + 1 ))
      l_idle="$(slot_idle "$l_pth")"
      if [ -n "$l_idle" ]; then l_age="$(fmt_age "$l_idle")"; else l_age="?"; fi
      # Only an ACTIVE forge can be stale. A `done` or `failed` record is old on
      # purpose and is reaped on its own TTL; flagging it would train the reader to
      # ignore the mark.
      if [ "$l_stt" = "active" ] && [ -n "$l_idle" ] && [ "$l_idle" -ge "$l_thresh" ]; then
        l_age="${l_age}!"; stale=$(( stale + 1 ))
      fi
      printf '%s %-8s %8s  %-9s %s\n' \
        "$(cell "$(label_of "$l_nm" "$l_pth")" 28)" "$l_stt" \
        "$(sfield "$l_pth" step)/$(sfield "$l_pth" steps)" "$l_age" "$(sfield "$l_pth" phase)"
    done <<SLOTS
$(slots)
SLOTS
    [ "$listed" -eq 0 ] && echo "no active forge"
    # ON STDERR, DELIBERATELY. The `!` in the IDLE column is data and belongs in the
    # table; this paragraph is advice for a person. Printed to stdout it added five lines
    # to a surface that is parsed as a table, and three tests that read `list` that way
    # broke -- correctly. A human sees both streams; a parser sees only the table.
    if [ "$stale" -gt 0 ]; then
      {
        echo ""
        echo "! $stale forge(s) have not stepped in over $(fmt_age "$l_thresh"). Nothing expires an"
        echo "  active forge, and it holds its name against a new one, so a forge whose session"
        echo "  died stays here until someone says so. If it died: skillforge fail --name <forge>"
        echo "  <reason>. To discard it: skillforge clear --name <forge>. Both write a ledger row;"
        echo "  'done' would record it as completed and install it."
      } >&2
    fi
    exit 0
    ;;

  ledger)
    if [ "${1:-}" = "--json" ]; then
      # Line by line through the same filter, and `-c`, because the contract of
      # `--json` is one row per line and a reader downstream splits on newlines.
      # `--full` prints the file exactly as it is on disk.
      [ -s "$LEDGER" ] && jq -c "$(redact_prog)" "$LEDGER" 2>/dev/null
      exit 0
    fi
    if [ ! -s "$LEDGER" ]; then
      echo "no forges recorded yet ($LEDGER)"
      exit 0
    fi
    # Each start is joined to the first done/fail for the same name that follows it.
    # A start with nothing after it is an abandoned forge: the session ended, crashed,
    # or moved on without closing out. It is reported, not dropped.
    #
    # AND SO IS THE MIRROR IMAGE. An outcome that no start joins to used to be dropped
    # in silence, because the join walked start records only: a planted `done` for
    # `ghost-one` produced output that read "6 forge(s)" and never mentioned it. That is
    # not a hypothetical shape. `start` claims its slot with `ln` and appends its ledger
    # row immediately afterwards; a process killed between the two leaves a live forge
    # with no start row (4 of 60 SIGKILL trials), and its eventual `done` is then an
    # orphan. Those are precisely the forges worth seeing -- the ones that crashed -- so
    # an unmatched outcome is now a row, marked, rather than a silence.
    # The `where` column is the project directory's own name, which is project content
    # under the same rule as `root`: an orchestrator subagent running `skillforge ledger`
    # would be reading the held-out set out of a status table. Held back with the rest,
    # and marked, rather than left as the one uncovered corner of the same surface.
    jq -s -R -r --argjson full "$FULL_OPT" '
      def rounds_of(s): ((((s // 2) - 2) / 2) | floor) as $r | (if $r < 0 then 0 else $r end);
      # jq 1.6 returns [] for ("" | split("/")), so .[-1] on an absent or empty
      # project yields null, which then interpolates as the literal string "null".
      def wherefrom: if $full == 0 then "(held out)"
                     else ([ ((. // "") | split("/"))[] | select(length > 0) ] | last // "-")
                     end;
      # `rounds_planned` has been in the JSONL since the overrun was made representable
      # and nothing ever printed it, so a forge that ran six rounds against a three-round
      # budget read as a plain "6 round(s)" -- indistinguishable from one that spent
      # exactly its budget. The budget is only worth showing when it was not met.
      def roundtxt($r; $p):
        if $p == null or $p == $r then "\($r) round(s)"
        elif $r > $p             then "\($r) of \($p) round(s) (over)"
        else                          "\($r) of \($p) round(s)" end;
      [ split("\n")[] | select(length > 0) | (fromjson? // empty) ] as $rec
      | [ range(0; ($rec | length)) | select($rec[.].event == "start") ] as $starts
      | [ range(0; ($rec | length))
          | select($rec[.].event == "done" or $rec[.].event == "fail") ] as $ends
      # ONE OUTCOME PER START. Matching by name alone let a single `done` be consumed by
      # two starts of the same name -- a forge that was abandoned when its slot file
      # went missing was then reported as finished, wearing the date, duration and
      # phase belonging to the OTHER one, and the finished count came out one too
      # high. NOTE: no apostrophes in here. This whole program sits inside a
      # single-quoted shell string, so one closes it and the file stops parsing. Each
      # is claimed by the earliest start that can take it and by nothing else, so an
      # unclaimed start reads "no outcome" and an unclaimed outcome becomes an orphan
      # row below. Array subtraction keeps the order of the left operand.
      | (reduce $starts[] as $i ({used: [], pairs: []};
           . as $acc
           | ([ $ends[] | select(. > $i and $rec[.].name == $rec[$i].name) ]
              - $acc.used | .[0]) as $e
           | { used:  (if $e == null then $acc.used else ($acc.used + [$e]) end),
               pairs: ($acc.pairs + [[$i, $e]]) })) as $join
      | ($ends - $join.used) as $orphans
      | ( ($join.pairs | map(.[0] as $i | .[1] as $ei | $rec[$i] as $st
            | (if $ei == null then null else $rec[$ei] end) as $en
            | { name:     $st.name,
                ts:       ($st.ts // 0),
                where:    (($st.project // "") | wherefrom),
                outcome:  (if $en == null then "no outcome" else $en.event end),
                rounds:   (if $en == null then rounds_of($st.steps)
                           else ($en.rounds // rounds_of($st.steps)) end),
                planned:  (if $en == null then null else ($en.rounds_planned // null) end),
                duration: (if $en == null then null else ($en.duration // null) end),
                phase:    (if $en == null then "never closed out" else ($en.phase // "") end),
                orphan:   false }))
          # An orphan is dated by when the forge STARTED, reconstructed from the
          # recorded duration, so it sorts into the table where its start would have
          # been rather than at its finish.
          + ($orphans | map(. as $j | $rec[$j] as $en
            | { name:     ($en.name // ""),
                ts:       (($en.ts // 0) - ($en.duration // 0)),
                where:    (($en.project // "") | wherefrom),
                outcome:  $en.event,
                rounds:   ($en.rounds // 0),
                planned:  ($en.rounds_planned // null),
                duration: ($en.duration // null),
                phase:    ($en.phase // ""),
                orphan:   true })) )
      | sort_by(.ts)
      | (.[] | "\(.ts | gmtime | strftime("%Y-%m-%d"))  \(.name)  [\(.outcome)]\(if .orphan then "*" else "" end)  \(roundtxt(.rounds; .planned))  \(if .duration == null then "-" else "\(.duration)s" end)  \(.where)  \(.phase)"),
        "",
        "\(length) forge(s): \(map(select(.outcome == "done")) | length) done, \(map(select(.outcome == "fail")) | length) abandoned, \(map(select(.outcome == "no outcome")) | length) never closed out",
        (([ .[] | select(.orphan) ] | length) as $o
         | if $o == 0 then empty
           else "* \($o) outcome record(s) have no matching start record, so only the outcome survives and its date is reconstructed from the recorded duration. A start row is missing when `start` was killed between claiming its slot and appending its row, or when the ledger was truncated after a forge had begun."
           end),
        # THE FIFTH QUESTION, SELECTED BY NAME AND BY NOTHING ELSE. `apply` rows are
        # picked out of $rec directly; they never touch $starts, $ends or the join, so
        # every count above reads exactly as it did before this event type existed --
        # which is the rule this file states for itself and then has to keep.
        (([ $rec[] | select(.event == "apply") ]) as $ap
         | if ($ap | length) == 0 then empty
           else "\($ap | length) apply row(s): \($ap | map(select(.outcome == "used")) | length) used, \($ap | map(select(.outcome == "declined")) | length) declined, \($ap | map(select(.outcome == "failed")) | length) failed. An apply row says a forged skill was put on the problem that caused it; skillforge pending lists the forges still waiting."
           end)
    ' "$LEDGER"
    ;;
  ""|-h|--help|help)
    # The header block is the help text, and it ends one line above `set -uo pipefail`.
    # THAT LINE NUMBER WAS A LITERAL AND IT WAS WRONG THE FIRST TIME THE HEADER GREW: it
    # said 120, the header reached 143, and twenty-three lines of help -- including two
    # whole subcommands -- were silently cut off. Nothing failed and nothing said so, which
    # is what a hard-coded offset into a file that people edit always does eventually. So
    # it is DERIVED, from the one line that is guaranteed to be the first statement, and
    # the literal survives only as the fallback for a `$0` that cannot be read.
    help_end="$(grep -n '^set -uo pipefail$' "$0" 2>/dev/null | head -n 1 | cut -d: -f1)"
    case "$help_end" in
      ''|*[!0-9]*) help_end=120 ;;
      *) help_end=$(( help_end - 1 )) ;;
    esac
    sed -n "2,${help_end}p" "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command '$cmd' (try: skillforge help)" ;;
esac
exit

# Closes the brace group opened just under `set -uo pipefail`. See the note there.
}
