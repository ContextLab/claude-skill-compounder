#!/usr/bin/env bash
# skillcontrib: read-only reconnaissance for proposing a skill to an upstream repo.
#
#   skillcontrib dedup <skill-name> [--description <text>] [--repo <r>] [--override-rejected]
#   skillcontrib whoami [--repo <r>]
#   skillcontrib preflight <skill-dir>
#   skillcontrib --help
#
# This script performs NO network writes. It only reads: no forking, no branch
# creation, no uploading of commits, no opening of pull requests. Those steps belong
# to the contribute-skill skill, behind its consent gates, where a human sees each
# one before it happens.
#
# Exit codes
#   0   clean / success
#   2   usage error
#   3   dedup: fuzzy matches present. The caller MUST ask the user.
#   4   dedup: exact match on an OPEN or MERGED pull request.
#   5   dedup: match on a CLOSED-unmerged pull request. Blocks resubmission unless
#       --override-rejected is passed. A declined proposal is a signal, not noise.
#   6   gh is not installed
#   7   gh is not authenticated
#   8   a read-only lookup failed (network, rate limit, unknown repo)
#   10  preflight: skill directory not found
#   11  preflight: SKILL.md not found
#   12  preflight: frontmatter missing or unterminated
#   13  preflight: non-portable frontmatter key
#   14  preflight: description longer than 500 characters
#   15  preflight: frontmatter longer than 1024 characters
#   16  preflight: body longer than 500 lines
#   17  preflight: required frontmatter field missing
set -uo pipefail

DEFAULT_REPO="ContextLab/claude-skill-compounder"
PORTABLE_KEYS="name description license compatibility metadata allowed-tools"
MAX_DESCRIPTION=500
MAX_FRONTMATTER=1024
MAX_BODY_LINES=500
FUZZY_THRESHOLD=25   # percent token overlap at or above which a hit is "above threshold"
STOPWORDS='["when","this","that","with","from","into","your","must","should","would",
            "user","users","skill","skills","claude","code","uses","using","used",
            "want","wants","need","needs","only","also","have","been","them","then",
            "than","they","what","which","does","doing","make","makes","made","about",
            "will","just","like","some","such","each","more","most","other","after",
            "before","because","between","never","always","every","there","here"]'

fail() { code="$1"; shift; echo "skillcontrib: $*" >&2; exit "$code"; }

usage() {
  cat <<'USAGE'
skillcontrib: read-only reconnaissance before proposing a skill upstream.

  skillcontrib dedup <skill-name> [--description <text>] [--repo OWNER/REPO]
                                  [--override-rejected]
        Two-layer duplicate check against every pull request in any state.
        Layer 1 (exact): skill directory name and `name:` frontmatter.
        Layer 2 (fuzzy): `description:` tokens against pull request titles.
        Prints every match, including sub-threshold fuzzy ones. It never decides
        for you: exit 3 means "ask the user", exit 4 and 5 mean "stop".

  skillcontrib whoami [--repo OWNER/REPO]
        Print the acting identity and whether it has push access to the repo.
        `maintainer` means branch directly on upstream. `contributor` means the
        fork path. Also reports whether the upstream repo is archived.

  skillcontrib preflight <skill-dir>
        Validate a skill before proposing it: SKILL.md present, frontmatter parses,
        only the six portable frontmatter keys, description <= 500 characters,
        frontmatter <= 1024 characters, body <= 500 lines.

Repo defaults to ContextLab/claude-skill-compounder.
Exit codes are documented at the top of this script.
USAGE
}

require_gh() {
  command -v gh >/dev/null 2>&1 || fail 6 "gh is not installed. Install it from https://cli.github.com and retry."
  gh auth status >/dev/null 2>&1 || fail 7 "gh is not authenticated. Run 'gh auth login' yourself, then retry."
  command -v jq >/dev/null 2>&1 || fail 6 "jq is required."
}

# ------------------------------------------------------------------ whoami

cmd_whoami() {
  repo="$DEFAULT_REPO"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo) shift; repo="${1:-}"; [ -n "$repo" ] || fail 2 "--repo needs a value" ;;
      -h|--help) usage; exit 0 ;;
      *) fail 2 "unexpected argument to whoami: $1" ;;
    esac
    shift
  done
  require_gh

  user=$(gh api user --jq .login 2>/dev/null)
  [ -n "$user" ] || fail 8 "could not read the authenticated identity from gh api user."

  archived=$(gh repo view "$repo" --json isArchived --jq .isArchived 2>/dev/null)
  [ -n "$archived" ] || fail 8 "could not read $repo. Check the name and your network."

  # A collaborator check answers 204 No Content for someone with push access and 404
  # for everyone else, so success or failure of the call IS the answer.
  if gh api "repos/$repo/collaborators/$user" --silent >/dev/null 2>&1; then
    role="maintainer"; path="branch directly on upstream; do not fork"
  else
    role="contributor"; path="fork the repo, branch on the fork"
  fi

  echo "acting as: $user"
  echo "repo:      $repo"
  echo "role:      $role"
  echo "path:      $path"
  echo "archived:  $archived"
  [ "$archived" = "true" ] && echo "WARNING:   upstream is archived and rejects writes."
  return 0
}

# ------------------------------------------------------------------ dedup

# The authoritative duplicate lookup. Three details are load-bearing:
#   1. --limit 100. The default page size is 30, so a sweep without it silently
#      misses older pull requests and concludes "no duplicate".
#   2. --state all really does return OPEN, CLOSED, and MERGED together. GitHub
#      models a merged pull request as a closed one, and the JSON `state` field is
#      what distinguishes MERGED from CLOSED-unmerged.
#   3. Never reach for `gh api search/issues -f q=...`. Passing -f flips gh to POST,
#      and POST /search/issues does not exist, so it answers 404. If the search API
#      is needed for a qualifier gh pr list does not expose, it must be -X GET.
# One more caveat the caller has to live with: this is the search index, and the
# index lags pull request creation by seconds to minutes. A duplicate opened moments
# ago can be invisible here. Absence of evidence is not evidence of absence.
# gh's stderr is deliberately not swallowed here. A failed lookup must be visible and
# must not be mistaken for a clean result; callers check the exit status.
pr_search() {
  gh pr list --repo "$repo" --state all --search "$1" \
     --json number,title,state,url,headRefName --limit 100
}

cmd_dedup() {
  name=""; desc=""; repo="$DEFAULT_REPO"; override=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --description) shift; desc="${1:-}" ;;
      --repo) shift; repo="${1:-}"; [ -n "$repo" ] || fail 2 "--repo needs a value" ;;
      --override-rejected) override=1 ;;
      -h|--help) usage; exit 0 ;;
      -*) fail 2 "unknown flag: $1" ;;
      *) [ -z "$name" ] || fail 2 "dedup takes one skill name"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || fail 2 "usage: skillcontrib dedup <skill-name> [--description <text>]"
  require_gh

  # Resolve the repo first. A search against a repo that does not exist answers an empty
  # list with a zero exit status, which is indistinguishable from "no duplicate found".
  # This call 404s properly, so a typo in the repo name cannot read as a clean result.
  archived=$(gh repo view "$repo" --json isArchived --jq .isArchived 2>/dev/null)
  [ -n "$archived" ] || fail 8 "could not resolve $repo. Check the name, your network, and 'gh api rate_limit'."
  [ "$archived" = "true" ] && echo "WARNING: $repo is archived and rejects writes." >&2

  results=$(pr_search "$name") || fail 8 "pull request lookup failed for $repo. A failed lookup is not a clean one."
  [ -n "$results" ] || fail 8 "empty response from the pull request lookup for $repo."

  # Fuzzy terms: the longest few description tokens, searched one at a time. GitHub
  # ANDs the terms in a single query, which would be far too narrow, and the search
  # index allows only 30 requests per minute, so three extra queries is the budget.
  dtoks="[]"
  if [ -n "$desc" ]; then
    dtoks=$(printf '%s' "$desc" | jq -R -s --argjson stop "$STOPWORDS" '
      ascii_downcase | [splits("[^a-z0-9]+")]
      | map(select(length >= 4)) | map(select(. as $t | $stop | index($t) | not)) | unique')
    for term in $(printf '%s' "$dtoks" | jq -r 'sort_by(-length, .)[:3][]'); do
      more=$(pr_search "$term") || fail 8 "fuzzy lookup failed for term '$term'. A failed lookup is not a clean one."
      [ -n "$more" ] && results=$(printf '%s\n%s' "$results" "$more" | jq -s 'add')
    done
  fi

  rows=$(printf '%s' "$results" | jq -r --arg name "$name" --argjson dtoks "$dtoks" \
    --argjson stop "$STOPWORDS" --argjson thr "$FUZZY_THRESHOLD" '
    def toks: ascii_downcase | [splits("[^a-z0-9]+")]
      | map(select(length >= 4)) | map(select(. as $t | $stop | index($t) | not)) | unique;
    def overlap($t): if ($dtoks | length) == 0 then 0
      else (([$dtoks[] | select(. as $x | $t | index($x))] | length) * 100 / ($dtoks | length) | floor) end;
    unique_by(.number) | sort_by(-.number)
    | map(. + {exact: ((.title | ascii_downcase | contains($name | ascii_downcase))
                       or (.headRefName | ascii_downcase | contains($name | ascii_downcase)))})
    | map(. + {score: overlap(.title | toks)})
    | map(select(.exact or .score > 0))
    | .[] | [ (if .exact then "exact" else "fuzzy" end), .state, (.score | tostring),
              (if .score >= $thr then "above" else "below" end),
              (.number | tostring), .url, .title ] | join("\t")')

  exact_live=0; rejected=0; fuzzy=0
  echo "repo:        $repo"
  echo "skill name:  $name"
  if [ -n "$desc" ]; then echo "description: $desc"; else echo "description: (none given; the fuzzy layer did not run)"; fi
  echo
  if [ -z "$rows" ]; then
    echo "No matching pull request in any state."
  else
    printf '%-6s %-7s %-6s %-6s %-7s %s\n' KIND STATE SCORE BAND NUMBER TITLE
    printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r kind state score band number url title; do
      printf '%-6s %-7s %-6s %-6s %-7s %s\n' "$kind" "$state" "$score%" "$band" "#$number" "$title"
      printf '       %s\n' "$url"
    done
  fi

  # Tally in this shell. A `while read` in a pipeline runs in a subshell under bash,
  # so the counters above would be lost; the loop below reads from a here-string.
  while IFS="$(printf '\t')" read -r kind state score band number url title; do
    [ -n "${kind:-}" ] || continue
    if [ "$kind" = "exact" ] && [ "$state" = "CLOSED" ]; then
      rejected=$((rejected + 1))
    elif [ "$kind" = "exact" ]; then
      exact_live=$((exact_live + 1))
    else
      fuzzy=$((fuzzy + 1))
    fi
  done <<EOF
$rows
EOF

  echo
  echo "exact on OPEN or MERGED: $exact_live"
  echo "exact on CLOSED and unmerged: $rejected"
  echo "fuzzy candidates: $fuzzy"
  echo "note: the search index lags pull request creation, so a duplicate opened in the last few minutes may not appear above."

  if [ "$rejected" -gt 0 ] && [ "$override" -eq 0 ]; then
    echo
    echo "BLOCKED: a maintainer already declined this contribution. Read that pull request."
    echo "Pass --override-rejected only after the user has read it and said to proceed anyway."
    exit 5
  fi
  if [ "$rejected" -gt 0 ]; then
    echo
    echo "OVERRIDE: a declined pull request was found and overridden by explicit request."
  fi
  if [ "$exact_live" -gt 0 ]; then
    echo
    echo "STOP: an equivalent contribution is already open or already merged."
    exit 4
  fi
  if [ "$fuzzy" -gt 0 ] || [ "$rejected" -gt 0 ]; then
    echo
    echo "ASK THE USER: possible duplicates above, including sub-threshold ones. Decide together."
    exit 3
  fi
  echo
  echo "CLEAN: no duplicate found."
  return 0
}

# ---------------------------------------------------------------- preflight

cmd_preflight() {
  dir=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      -*) fail 2 "unknown flag: $1" ;;
      *) [ -z "$dir" ] || fail 2 "preflight takes one directory"; dir="$1" ;;
    esac
    shift
  done
  [ -n "$dir" ] || fail 2 "usage: skillcontrib preflight <skill-dir>"
  [ -d "$dir" ] || fail 10 "skill directory not found: $dir"
  md="$dir/SKILL.md"
  [ -f "$md" ] || fail 11 "SKILL.md not found in $dir"

  head -n 1 "$md" | grep -q '^---[[:space:]]*$' || fail 12 "frontmatter missing: $md must start with a --- line"
  close=$(awk 'NR>1 && /^---[[:space:]]*$/ {print NR; exit}' "$md")
  [ -n "$close" ] || fail 12 "frontmatter unterminated: no closing --- line in $md"

  fm=$(sed -n "2,$((close - 1))p" "$md")
  fm_chars=$(printf '%s\n' "$fm" | wc -c | tr -d ' ')
  keys=$(printf '%s\n' "$fm" | awk -F: '/^[A-Za-z][A-Za-z0-9_-]*:/ {print $1}')

  for k in $keys; do
    case " $PORTABLE_KEYS " in
      *" $k "*) ;;
      *) fail 13 "non-portable frontmatter key '$k'. Only these survive outside Claude Code: $PORTABLE_KEYS" ;;
    esac
  done

  case "$keys" in *name*) ;; *) fail 17 "required frontmatter field missing: name" ;; esac
  case "$keys" in *description*) ;; *) fail 17 "required frontmatter field missing: description" ;; esac

  # A description can be folded across indented continuation lines, so gather them.
  desc=$(printf '%s\n' "$fm" | awk '
    /^description:/ {grab = 1; sub(/^description:[[:space:]]*/, ""); printf "%s", $0; next}
    grab && /^[A-Za-z][A-Za-z0-9_-]*:/ {grab = 0}
    grab {sub(/^[[:space:]]+/, " "); printf "%s", $0}
    END {print ""}')
  desc_chars=$(printf '%s' "$desc" | wc -c | tr -d ' ')

  body_lines=$(sed -n "$((close + 1)),\$p" "$md" | wc -l | tr -d ' ')

  [ "$desc_chars" -le "$MAX_DESCRIPTION" ] || fail 14 "description is $desc_chars characters; the limit is $MAX_DESCRIPTION"
  [ "$fm_chars" -le "$MAX_FRONTMATTER" ] || fail 15 "frontmatter is $fm_chars characters; the limit is $MAX_FRONTMATTER"
  [ "$body_lines" -le "$MAX_BODY_LINES" ] || fail 16 "body is $body_lines lines; the limit is $MAX_BODY_LINES"

  echo "OK: $md"
  echo "  frontmatter keys: $(printf '%s' "$keys" | tr '\n' ' ')"
  echo "  description: $desc_chars chars (limit $MAX_DESCRIPTION)"
  echo "  frontmatter: $fm_chars chars (limit $MAX_FRONTMATTER)"
  echo "  body: $body_lines lines (limit $MAX_BODY_LINES)"
  return 0
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  dedup) cmd_dedup "$@" ;;
  whoami) cmd_whoami "$@" ;;
  preflight) cmd_preflight "$@" ;;
  -h|--help|help|"") usage; [ -n "$cmd" ] && exit 0; exit 2 ;;
  *) echo "skillcontrib: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
