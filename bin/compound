SCRIPT_DIRS = ("scripts", "bin", "tools")
SCRIPT_CAP = 200
WEEK = 7 * 86400
CHECK_BUDGET_MS = 500
CHECK_TEXT_CAP = 20000
# A match that hits every one of these would refuse nearly every tool call.
MATCH_PROBES = ("a", "ls", "git status")
# The package's own procedures: listed, never offered by `find` as reusable work.
OWN_SKILLS = ("learn", "reuse")
# What COMPOUND_HOME holds when it is ours; `uninstall --purge` removes nothing else.
HOME_NAMES = ("lessons", "events.jsonl", "install.json", "app", "history-surfer", "claims")
MAX_EPOCH = 253402300799  # 9999-12-31T23:59:59Z
# Prompt-log rows that begin like this were not typed by the user.
NOT_TYPED = ("<agent-message", "<task-notification", "<system-reminder",
             "This session is being continued from a previous conversation")
STOPWORDS = frozenset(
    "a an and are as at be by for from in is it of on or that the this to with".split()
)


class Fail(Exception):
    """An error with the exit status it should end the process on."""

    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code
        self.message = message


def usage(message):
    return Fail(2, message)


def failure(message):
    return Fail(1, message)


# ----------------------------------------------------------------------------- clock


def parse_ts(value):
    """Epoch seconds for an epoch number or an ISO 8601 string, else None."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        try:
            return _finite(float(value))
        except OverflowError:
            return None
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    if re.match(r"^\d+(\.\d+)?$", text):
        return _finite(float(text))
    import datetime

    iso = text
    if iso.endswith("Z") or iso.endswith("z"):
        iso = iso[:-1] + "+00:00"
    iso = re.sub(r"(\.\d{6})\d+", r"\1", iso)
    try:
        dt = datetime.datetime.fromisoformat(iso)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return _finite(dt.timestamp())
    except (ValueError, OverflowError):
        return None


def _finite(number):
    """`number`, or None for NaN and the infinities."""
    if number != number or number in (float("inf"), float("-inf")):
        return None
    return number


def now():
    pinned = os.environ.get("COMPOUND_NOW")
    if pinned:
        value = parse_ts(pinned)
        if value is None:
            raise usage("COMPOUND_NOW is neither epoch seconds nor an ISO 8601 time: %r" % pinned[:80])
        if not 0 <= value <= MAX_EPOCH:
            raise usage("COMPOUND_NOW is outside the years 1970 to 9999: %r" % pinned[:80])
        return value
    return time.time()


def iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def local_date(epoch):
    return time.strftime("%Y-%m-%d", time.localtime(epoch))


def age_text(seconds):
    seconds = int(seconds)
    if seconds < 0:
        return "in the future"
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")


def date_text(stamp, clock):
    """The local day of `stamp`: "3 Oct", with the year when it is not `clock`'s. "?" for
    a time no calendar holds."""
    try:
        then, today = time.localtime(stamp), time.localtime(clock)
    except (ValueError, OverflowError, OSError):
        return "?"
    text = "%d %s" % (then.tm_mday, MONTHS[then.tm_mon - 1])
    return text if then.tm_year == today.tm_year else "%s %d" % (text, then.tm_year)


def when_text(stamp, clock):
    """How long ago `stamp` was, for a person: 5s, 2m, 3h, then "yesterday" for the
    calendar day before, then the date. `--json` output carries the stamp itself."""
    if stamp is None or not 0 <= stamp <= MAX_EPOCH:
        return "?"
    seconds = int(clock - stamp)
    if 0 <= seconds < 86400:
        return age_text(seconds)
    if seconds >= 0:
        import datetime

        try:
            then, today = time.localtime(stamp), time.localtime(clock)
            days = (datetime.date(today.tm_year, today.tm_mon, today.tm_mday)
                    - datetime.date(then.tm_year, then.tm_mon, then.tm_mday)).days
        except (ValueError, OverflowError, OSError):
            return "?"
        if days == 1:
            return "yesterday"
    return date_text(stamp, clock)


# What a person is shown for each event type. The type names are the log's and the ones
# `events --type` takes; these are the words of the reports, the band and the pane.
EVENT_WORDS = {
    "reuse": "reused", "guard": "guarded", "recall": "recalled", "capture": "owed", "remind": "reminded",
    "refuse": "refused", "learn": "recorded", "skip": "declined", "nudge": "asked", "promote": "moved",
    "candidate": "candidate", "skill": "skill", "rm": "removed", "judge": "judged", "error": "error",
}

BOLD, DIM, RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN = "1", "2", "31", "32", "33", "34", "35", "36"
EVENT_COLOURS = {
    "reuse": CYAN, "guard": RED, "recall": MAGENTA, "capture": YELLOW, "remind": YELLOW, "refuse": YELLOW,
    "learn": GREEN, "skip": DIM, "nudge": BLUE, "promote": BLUE, "candidate": DIM, "skill": BLUE, "rm": DIM,
    "judge": DIM,
    "error": RED,
}
STATUS_COLOURS = {"PASS": GREEN, "WARN": YELLOW, "FAIL": RED}


def colours_on():
    """Colour only for a person at a terminal: stdout is one, NO_COLOR is unset or empty
    and TERM is not "dumb". Never in `--json`, which does not call `paint`."""
    try:
        return bool(sys.stdout.isatty()) and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"
    except (AttributeError, ValueError):
        return False


def paint(text, *codes):
    codes = [code for code in codes if code]
    if not codes or not text or not colours_on():
        return text
    return "\x1b[%sm%s\x1b[0m" % (";".join(codes), text)


def term_width():
    """The columns a line may take: COLUMNS when it is a number, else the terminal's when
    stdout is one, else None (piped: nobody said how wide)."""
    value = os.environ.get("COLUMNS", "")
    if value.isdigit() and int(value) > 0:
        return max(40, int(value))
    try:
        if sys.stdout.isatty():
            import shutil

            return max(40, shutil.get_terminal_size().columns)
    except (AttributeError, ValueError, OSError):
        pass
    return None


def clip(text, room):
    """`text` in at most `room` characters, a cut ending in an ellipsis."""
    if len(text) <= room:
        return text
    return text[:max(0, room - 1)] + "\u2026" if room > 1 else text[:max(0, room)]


def plural(count, one, many=None):
    return "%d %s" % (count, one if count == 1 else (many or one + "s"))


# ----------------------------------------------------------------------------- paths


def pkg_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _expand(path):
    return os.path.abspath(os.path.expanduser(path))


def claude_dir():
    return _expand(os.environ.get("COMPOUND_CLAUDE_DIR") or "~/.claude")


def home_dir():
    value = os.environ.get("COMPOUND_HOME")
    if value:
        return _expand(value)
    return os.path.join(claude_dir(), "compound")


def events_path():
    return os.path.join(home_dir(), "events.jsonl")


def manifest_path():
    return os.path.join(home_dir(), "install.json")


def _walk_up_git(start):
    here = start
    while True:
        if os.path.exists(os.path.join(here, ".git")):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            return None
        here = parent


def project_root(fast=False):
    """COMPOUND_PROJECT, else the git top level, else the working directory.

    `fast` finds the top level by walking up to a `.git` entry instead of starting
    git; `check` uses it because it runs before every tool call.
    """
    pinned = os.environ.get("COMPOUND_PROJECT")
    if pinned:
        return _expand(pinned)
    cwd = os.getcwd()
    if fast:
        return _walk_up_git(cwd) or cwd
    import subprocess

    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return cwd
    top = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode == 0 and top:
        return top
    return cwd


def level_dirs(project):
    """[(level, lessons dir, skills dir)] in project, user, general order."""
    pkg = pkg_root()
    return [
        ("project", os.path.join(project, ".claude", "compound", "lessons"),
         os.path.join(project, ".claude", "skills")),
        ("user", os.path.join(home_dir(), "lessons"), os.path.join(claude_dir(), "skills")),
        ("general", os.path.join(pkg, "lessons"), os.path.join(pkg, "skills")),
    ]


def dirs_of(project, level):
    for name, lessons, skills in level_dirs(project):
        if name == level:
            return lessons, skills
    raise usage("unknown level %r" % level)


# ----------------------------------------------------------------------------- files


def atomic_write(path, text, mode=None):
    """Write `text` to `path` through a temp file in the same directory and a rename."""
    import tempfile

    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(path) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape", newline="") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_copy(src, dst):
    import shutil
    import tempfile

    directory = os.path.dirname(dst)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(dst) + ".", suffix=".tmp")
    os.close(fd)
    try:
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_text(path):
    """The file's text with its line endings as they are."""
    with open(path, "r", encoding="utf-8", errors="replace", newline="") as handle:
        return handle.read()


# ----------------------------------------------------------------------------- format


def one_line(value):
    return " ".join(str(value).split())


KEY_RE = re.compile(r"^([A-Za-z0-9_-]+):(?:[ \t]+(.*))?$")
BLOCK_RE = re.compile(r"^[>|][+-]?[0-9]?[+-]?$")
PLAIN_FIRST = "\"'[]{}>|#&*!%@`,"
YAML_WORDS = frozenset("true false null yes no on off y n ~".split())
UNSAFE_CHARS = re.compile("[\x00-\x1f\x7f-\x9f  ﻿\ud800-\udfff]")


def is_plain(value):
    """Whether `value` means itself, as a string, when written bare after `key: `."""
    if not value or value != value.strip():
        return False
    if value[0] in PLAIN_FIRST or value[:2] in ("- ", "? ", ": ") or value in ("-", "?", ":"):
        return False
    if ": " in value or " #" in value or value.endswith(":"):
        return False
    if UNSAFE_CHARS.search(value):
        return False
    if value.lower() in YAML_WORDS or value in ("=", "<<", "---", "..."):
        return False
    if re.match(r"^[-+.0-9]", value) and re.match(r"^[-+]?(\.?[0-9][0-9_.,:eExXoOa-fA-F+-]*|\.inf|\.nan)$", value, re.I):
        return False  # a number, a date or a time to a YAML reader
    return True


def yaml_string(value):
    """`value` as YAML: bare when that is safe, else a JSON string (which YAML reads as
    a double-quoted scalar)."""
    value = str(value)
    if is_plain(value):
        return value
    quoted = json.dumps(value, ensure_ascii=False)
    return UNSAFE_CHARS.sub(lambda found: "\\u%04x" % ord(found.group(0)), quoted)


def _unquote(value):
    """The string a frontmatter value stands for: a JSON or YAML double-quoted string,
    a YAML single-quoted one, or the bare text."""
    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
        try:
            decoded = json.loads(value)
        except ValueError:
            decoded = None
        if isinstance(decoded, str):
            return decoded
        if '"' not in value[1:-1]:
            return value[1:-1]
        return value
    if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
        inner = value[1:-1]
        if "'" not in inner.replace("''", ""):
            return inner.replace("''", "'")
    return value


def split_frontmatter(text):
    """(bom, lines with their endings, index of the closing `---` or None, problem)."""
    bom = ""
    if text.startswith("﻿"):
        bom, text = "﻿", text[1:]
    lines = text.splitlines(True)
    if not lines or lines[0].strip() != "---":
        return bom, lines, None, "no frontmatter"
    for index in range(1, len(lines)):
        if lines[index].strip() == "---":
            return bom, lines, index, None
    return bom, lines, None, "frontmatter is not closed"


def frontmatter_blocks(lines, end):
    """([(key or None, first line index, one past its last line)], problem). A key's
    block is its line and the continuation lines under it: indented lines, list items
    at column zero under a key with no value, and blank lines between those. A
    comment or a blank line at column zero belongs to no key."""
    blocks = []
    problem = None
    index = 1
    while index < end:
        line = lines[index].rstrip("\r\n")
        found = KEY_RE.match(line)
        if not found:
            if line.strip() and not line.lstrip().startswith("#"):
                problem = problem or "frontmatter line is not `key: value`: %r" % line
            blocks.append((None, index, index + 1))
            index += 1
            continue
        bare = not (found.group(2) or "").strip()
        stop = index + 1
        probe = index + 1
        while probe < end:
            nxt = lines[probe].rstrip("\r\n")
            if not nxt.strip():
                probe += 1
                continue
            if nxt[0] in " \t" or (bare and (nxt.startswith("- ") or nxt == "-")):
                probe += 1
                stop = probe
                continue
            break
        blocks.append((found.group(1), index, stop))
        index = stop
    return blocks, problem


def parse_skill(text):
    """(frontmatter dict in file order, body, problem). `problem` is None when the
    frontmatter block is well formed. A value spread over continuation lines (a folded
    or literal block, a nested mapping, a list) is those lines joined by one space."""
    bom, lines, end, problem = split_frontmatter(text)
    if end is None:
        return {}, text[len(bom):], problem
    blocks, problem = frontmatter_blocks(lines, end)
    fields = {}
    for key, start, stop in blocks:
        if key is None:
            continue
        value = (KEY_RE.match(lines[start].rstrip("\r\n")).group(2) or "").strip()
        if BLOCK_RE.match(value):
            value = ""
        rest = [lines[index].strip() for index in range(start + 1, stop)]
        rest = [part for part in rest if part and not part.startswith("#")]
        if rest:
            value = " ".join([value] + rest).strip()
        if key in fields:
            problem = problem or "frontmatter gives %r twice" % key
            continue
        fields[key] = value
    body = "".join(lines[end + 1:])
    return fields, body, problem


def edit_frontmatter(text, changes, removals=(), body=None, first=()):
    """`text` with the frontmatter keys in `changes` set to those (already rendered)
    values, the keys in `removals` gone and, when `body` is given, the body replaced.
    Every line it is not asked to change is kept byte for byte: a changed key's whole
    block becomes one line where the block was, a new key goes last (or first when it
    is named in `first`). Raises Fail(2) when that cannot be done safely."""
    bom, lines, end, problem = split_frontmatter(text)
    if end is None:
        raise usage("its frontmatter cannot be edited safely (%s); nothing was changed" % problem)
    blocks, problem = frontmatter_blocks(lines, end)
    if problem:
        raise usage("its frontmatter cannot be edited safely (%s); nothing was changed" % problem)
    keys = [key for key, _start, _stop in blocks if key is not None]
    for key in list(changes) + list(removals):
        if keys.count(key) > 1:
            raise usage("its frontmatter cannot be edited safely (%r is given %d times); "
                        "nothing was changed" % (key, keys.count(key)))
    eol = "\r\n" if lines[end].endswith("\r\n") else "\n"
    out = [lines[0]]
    out.extend("%s: %s%s" % (key, changes[key], eol) for key in first if key in changes and key not in keys)
    for key, start, stop in blocks:
        if key is not None and key in removals and key not in changes:
            continue
        if key is not None and key in changes:
            out.append("%s: %s%s" % (key, changes[key], eol))
            continue
        out.extend(lines[start:stop])
    if out and not out[-1].endswith("\n"):
        out[-1] += eol
    out.extend("%s: %s%s" % (key, value, eol) for key, value in changes.items()
               if key not in keys and key not in first)
    closing = lines[end] if lines[end].endswith("\n") else lines[end] + eol
    out.append(closing)
    if body is None:
        out.extend(lines[end + 1:])
    else:
        out.append(body.strip("\n").replace("\r\n", "\n").replace("\n", eol) + eol)
    return bom + "".join(out)


def parse_match(value):
    """(list of patterns, problem) from a frontmatter `match` value."""
    if value is None or value == "":
        return [], None
    try:
        data = json.loads(value)
    except ValueError:
        return [], "match is not a JSON array on one line"
    if not isinstance(data, list) or not all(isinstance(item, str) for item in data):
        return [], "match is not a JSON array of strings"
    return data, None


def parse_tools(value):
    """The tools a frontmatter `match-tools` value names: MATCH_TOOLS when the key is
    absent, empty, or not a JSON array of tool names."""
    if value is None or value == "":
        return list(MATCH_TOOLS)
    try:
        data = json.loads(value)
    except ValueError:
        return list(MATCH_TOOLS)
    if not isinstance(data, list) or not data or not all(isinstance(one, str) and TOOL_RE.match(one) for one in data):
        return list(MATCH_TOOLS)
    return data


def compile_match(pattern):
    """A guard pattern as every reader compiles it: `^` and `$` at every line."""
    return re.compile(pattern, re.MULTILINE)


def match_problem(pattern):
    """Why `pattern` cannot be a guard, or None."""
    try:
        compiled = compile_match(pattern)
    except re.error as exc:
        return "does not compile: %s" % exc
    if compiled.search("") is not None:
        return "matches the empty string, so it would refuse every tool call"
    if all(compiled.search(probe) is not None for probe in MATCH_PROBES):
        return "matches %s alike, so it would refuse nearly every tool call" % ", ".join(
            repr(probe) for probe in MATCH_PROBES)
    return None


def render_skill(fields, body):
    """A new SKILL.md. `fields` values are already rendered (see yaml_string)."""
    out = ["---"]
    for key, value in fields.items():
        out.append("%s: %s" % (key, value))
    out.append("---")
    return "\n".join(out) + "\n" + body.strip("\n") + "\n"


# ----------------------------------------------------------------------------- store


def _load_item(level, kind, directory, with_body):
    name = os.path.basename(directory)
    skill_md = os.path.join(directory, "SKILL.md")
    item = {
        "level": level, "kind": kind, "name": name, "description": "",
        "path": directory, "match": [], "_tools": list(MATCH_TOOLS),
        "_file": skill_md, "_problem": None, "_match_issue": None, "_fields": {}, "_body": "",
    }
    try:
        text = read_text(skill_md)
    except OSError as exc:
        item["_problem"] = "SKILL.md cannot be read: %s" % (exc.strerror or exc)
        return item
    fields, body, problem = parse_skill(text)
    item["_fields"] = fields
    item["_text"] = text
    if with_body:
        item["_body"] = body.strip("\r\n")
    item["description"] = one_line(_unquote(fields.get("description", "")))
    patterns, match_issue = parse_match(fields.get("match"))
    usable = []
    for pattern in patterns:
        issue = match_problem(pattern)
        if issue:
            match_issue = match_issue or "match %r %s" % (pattern, issue)
        else:
            usable.append(pattern)
    item["match"] = usable
    item["_tools"] = parse_tools(fields.get("match-tools"))
    if kind == "lesson":
        if problem is None and not fields.get("name"):
            problem = "frontmatter has no name"
        if problem is None and _unquote(fields.get("name", "")) != name:
            problem = "frontmatter name %r is not the directory name" % fields.get("name")
        if problem is None and not item["description"]:
            problem = "frontmatter has no description"
        if problem is None and not body.strip():
            problem = "the body is empty"
        item["_problem"] = problem
    item["_match_issue"] = match_issue
    return item


def scan(project, with_body=False):
    """(items, broken). Every lesson and skill at all three levels, one entry per real
    SKILL.md: a directory reachable from two levels (a skills symlink into the package,
    a project that is the home directory) is listed once, at the widest level."""
    found = {}
    broken = []
    reported = set()
    rank = {"project": 0, "user": 1, "general": 2}
    for level, lessons, skills in level_dirs(project):
        for kind, base in (("lesson", lessons), ("skill", skills)):
            try:
                names = sorted(os.listdir(base))
            except OSError:
                continue
            for name in names:
                if name.startswith("."):
                    continue
                directory = os.path.join(base, name)
                if not os.path.isdir(directory):
                    continue
                skill_md = os.path.join(directory, "SKILL.md")
                if not os.path.isfile(skill_md):
                    if kind == "lesson":
                        broken.append({"level": level, "kind": kind, "name": name, "path": directory,
                                       "problem": "no SKILL.md", "unparseable": True})
                    continue
                item = _load_item(level, kind, directory, with_body)
                real = os.path.realpath(skill_md)
                issue = item["_problem"] or (item["_match_issue"] if kind == "lesson" else None)
                if issue and real not in reported:
                    reported.add(real)
                    broken.append({"level": level, "kind": kind, "name": name, "path": directory,
                                   "problem": issue, "unparseable": bool(item["_problem"])})
                if item["_problem"]:
                    continue  # a lesson that does not read is reported, never listed
                previous = found.get(real)
                if previous is None or rank[level] > rank[previous["level"]]:
                    found[real] = item
    # A project lesson whose tree is the user-level lesson of its name, byte for byte, is
    # that lesson (a committed copy a move left in place), not a second one.
    lessons_by_name = {}
    for real, item in found.items():
        if item["kind"] == "lesson" and item["level"] in ("project", "user"):
            lessons_by_name.setdefault(item["name"], {})[item["level"]] = real
    for levels in lessons_by_name.values():
        if len(levels) == 2 and same_tree(found[levels["project"]]["path"], found[levels["user"]]["path"]):
            del found[levels["project"]]
    items = sorted(found.values(), key=lambda it: (rank[it["level"]], it["kind"], it["name"]))
    return items, broken


def find_item(project, name, with_body=True):
    items, _ = scan(project, with_body=with_body)
    hits = [item for item in items if item["name"] == name]
    if not hits:
        raise usage("no lesson or skill named %r (see `compound list`)" % one_line(name)[:80])
    if len(hits) > 1:
        sys.stderr.write("compound: %r exists at %s; using the %s one\n" % (
            name, ", ".join(h["level"] for h in hits), hits[0]["level"]))
    return hits[0]


def public(item, extra=None):
    out = {key: value for key, value in item.items() if not key.startswith("_")}
    if extra:
        out.update(extra)
    return out


def first_comment(path):
    """The first comment line of a script, else a Python docstring's first line."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            head = [handle.readline() for _ in range(40)]
    except OSError:
        return ""
    for line in head:
        text = line.strip()
        if text.startswith("#!"):
            continue
        if text.startswith("#"):
            text = text.lstrip("#").strip()
            if text and not text.startswith("-*-"):
                return one_line(text)
            continue
        if text.startswith("//"):
            text = text.lstrip("/").strip()
            if text:
                return one_line(text)
    joined = "".join(head)
    doc = re.search(r'^\s*(?:"""|\'\'\')\s*(.*)', joined, re.M)
    if doc:
        text = doc.group(1).strip().strip("\"'").strip()
        if text:
            return one_line(text)
    return ""


def scan_scripts(project):
    """Executable files and *.py / *.sh under the project's scripts/, bin/ and tools/,
    at most two levels down, at most SCRIPT_CAP of them."""
    out = []
    for top in SCRIPT_DIRS:
        base = os.path.join(project, top)
        if not os.path.isdir(base):
            continue
        for root, dirnames, filenames in os.walk(base):
            depth = 0 if root == base else os.path.relpath(root, base).count(os.sep) + 1
            dirnames[:] = sorted(d for d in dirnames
                                 if not d.startswith(".") and d != "__pycache__" and d != "node_modules")
            if depth >= 1:
                dirnames[:] = []
            for filename in sorted(filenames):
                if filename.startswith("."):
                    continue
                path = os.path.join(root, filename)
                if not os.path.isfile(path):
                    continue
                if not (filename.endswith((".py", ".sh")) or os.access(path, os.X_OK)):
                    continue
                out.append({
                    "level": "project", "kind": "script",
                    "name": os.path.relpath(path, project),
                    "description": first_comment(path), "path": path, "match": [],
                })
                if len(out) >= SCRIPT_CAP:
                    return out
    return out


# ----------------------------------------------------------------------------- events


def read_events():
    """(events, unparseable line count). A missing log is an empty one."""
    events = []
    bad = 0
    try:
        handle = open(events_path(), "r", encoding="utf-8", errors="replace")
    except OSError:
        return events, bad
    with handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if not isinstance(event, dict):
                bad += 1
                continue
            events.append(event)
    return events, bad


def clean_json(value, depth=0):
    """`value` with NaN and the infinities as strings, so what is printed is JSON every
    parser reads."""
    if isinstance(value, float):
        return value if _finite(value) is not None else str(value)
    if depth > 200:
        return str(value)[:200]
    if isinstance(value, dict):
        return {str(key): clean_json(item, depth + 1) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [clean_json(item, depth + 1) for item in value]
    return value


def dumps(data, **options):
    """JSON text that is strict JSON and encodes as UTF-8: non-ASCII is kept, a lone
    surrogate (which no UTF-8 stream can carry) makes the whole text ASCII-escaped."""
    try:
        text = json.dumps(data, ensure_ascii=False, allow_nan=False, **options)
    except ValueError:
        text = json.dumps(clean_json(data), ensure_ascii=False, allow_nan=False, **options)
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        text = json.dumps(clean_json(data), ensure_ascii=True, allow_nan=False, **options)
    return text


def append_event(event):
    """One event, one line, one write(). A log whose last line was cut short (no
    newline) gets one first, in that same write, so this event is not lost with it."""
    path = events_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    line = (dumps(event, separators=(",", ":")) + "\n").encode("utf-8")
    fd = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        # Held across the look and the write: on Linux a reader can see another writer's
        # append half made, and would take its unfinished last byte for a cut line.
        fcntl.flock(fd, fcntl.LOCK_EX)
        size = os.fstat(fd).st_size
        if size > 0 and os.pread(fd, 1, size - 1) != b"\n":
            line = b"\n" + line
        os.write(fd, line)
    finally:
        os.close(fd)


def events_problem():
    """Why the event log cannot take an append, or None."""
    path = events_path()
    home = os.path.dirname(path)
    if os.path.lexists(path):
        if not os.path.isfile(path):
            return "%s is not a regular file" % path
        if not os.access(path, os.W_OK | os.R_OK):
            return "%s is not readable and writable" % path
        return None
    if os.path.lexists(home):
        if not os.path.isdir(home):
            return "%s is not a directory, so %s cannot be written" % (home, path)
        if not os.access(home, os.W_OK | os.X_OK):
            return "%s is not writable, so %s cannot be written" % (home, path)
    return None


def log_soft(event_type, project, **fields):
    """log_event for a command whose work is already done: a log that cannot be
    appended to is a warning, never the command's failure."""
    try:
        return log_event(event_type, project, **fields)
    except OSError as exc:
        sys.stderr.write("compound: warning: the event log %s could not be written (%s); "
                         "the %s itself was done\n" % (events_path(), exc.strerror or exc, event_type))
        return None


def log_event(event_type, project, **fields):
    event = {
        "ts": iso(now()),
        "type": event_type,
        "session": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
        "project": project,
    }
    event.update(fields)
    append_event(event)
    return event


def _text(value):
    return value if isinstance(value, str) else ""


def event_names(event):
    names = []
    one = event.get("lesson")
    if isinstance(one, str) and one:
        names.append(one)
    many = event.get("lessons")
    if isinstance(many, list):
        for value in many:
            if isinstance(value, str) and value and value not in names:
                names.append(value)
    return names


def tally(events):
    """({name: {reuse, guard, recall, learn}}, {name: [recall epochs]})."""
    counts = {}
    recalls = {}
    guarded = set()
    for event in events:
        kind = event.get("type")
        if kind not in COUNT_TYPES:
            continue
        session = _text(event.get("session"))
        for name in event_names(event):
            row = counts.setdefault(name, dict.fromkeys(COUNT_TYPES, 0))
            row[kind] += 1
            if kind == "guard" and session:
                guarded.add((session, name))
            # See Ineffective: a recall after the lesson's guard refused in that session
            # is a recall, and is not a recurrence the lesson failed to prevent.
            if kind == "recall" and (session, name) not in guarded:
                stamp = parse_ts(event.get("ts"))
                if stamp is not None:
                    recalls.setdefault(name, []).append(stamp)
    return counts, recalls


def guarded_in(events, name, session):
    """Whether the guard of lesson `name` refused a call in `session`."""
    return bool(session) and any(
        event.get("type") == "guard" and event.get("session") == session and name in event_names(event)
        for event in events)


_settings_env = []


def setting(name):
    """(value, where) of a setting the CLI shares with the mod: the process environment
    first ("environment"), then `env` in <claude dir>/settings.json ("settings"), else
    ("", None) and the caller's default stands. A settings file that does not read
    sets nothing."""
    value = os.environ.get(name)
    if value:
        return value, "environment"
    if not _settings_env:
        env = {}
        try:
            data = json.loads(read_text(os.path.realpath(settings_path())))
            if isinstance(data, dict) and isinstance(data.get("env"), dict):
                env = data["env"]
        except (OSError, ValueError):
            pass
        _settings_env.append(env)
    value = _settings_env[0].get(name)
    if isinstance(value, (str, int)) and not isinstance(value, bool) and str(value):
        return str(value), "settings"
    return "", None


def recur_limit():
    value = setting("COMPOUND_RECUR_LIMIT")[0]
    if re.match(r"^\d{1,9}$", value) and int(value) >= 1:
        return int(value)
    return 2


def recalls_since(item, recalls):
    """How many recalls of `item` are later than its SKILL.md's modification time."""
    stamps = recalls.get(item["name"])
    if not stamps:
        return 0
    try:
        modified = int(os.stat(item["_file"]).st_mtime)
    except OSError:
        return 0
    return sum(1 for stamp in stamps if stamp > modified)


def is_ineffective(item, recalls, limit):
    return recalls_since(item, recalls) >= limit


def short_hash(text):
    """Eight hex digits that are the same for the same text on every run."""
    value = 5381
    for char in text:
        value = ((value << 5) + value + ord(char)) & 0xFFFFFFFF
    return "%08x" % value


def capture_id(event):
    """A capture's `id`, or the one `log` would have given it."""
    given = event.get("id")
    if isinstance(given, str) and given:
        return given
    return short_hash("\n".join(str(event.get(key) or "") for key in ("session", "call", "failed", "fixed")))


def settled_by(debt, event):
    """Whether `event`, later in the log than `debt`, settles it. THE definition of
    settled: every reader goes through `unsettled`, which asks this."""
    kind = event.get("type")
    session = _text(event.get("session"))
    same_session = bool(session) and session == debt.get("session")
    if debt.get("type") == "capture":
        if kind not in ("learn", "skip"):
            return False
        settles = _text(event.get("settles"))
        return same_session or (bool(settles) and settles == capture_id(debt))
    # A strengthening: an ineffective recall of a lesson.
    name = debt.get("lesson")
    if kind == "skip":
        return same_session
    if kind == "learn":
        return event.get("update") is True and event.get("lesson") == name
    if kind in ("rm", "skill", "promote"):
        return event.get("lesson") == name or event.get("was") == name
    return False


def unsettled(events, clock=None):
    """What is owed and nothing has settled, in log order: the `capture` events, and for
    each session and lesson the newest `recall` marked ineffective. With `clock`, only
    those of the last UNSETTLED_DAYS days."""
    owed = []
    for event in events:
        kind = event.get("type")
        if kind == "capture":
            owed.append(event)
        elif kind == "recall":
            name, session = _text(event.get("lesson")), _text(event.get("session"))
            if event.get("ineffective") is True and name and session:
                owed = [one for one in owed if not (one.get("type") == "recall" and one.get("lesson") == name
                                                    and one.get("session") == session)]
                owed.append(event)
        elif kind in ("learn", "skip", "rm", "skill", "promote") and owed:
            owed = [one for one in owed if not settled_by(one, event)]
    if clock is None:
        return owed
    out = []
    for one in owed:
        stamp = parse_ts(one.get("ts"))
        if stamp is not None and clock - stamp <= UNSETTLED_DAYS * 86400:
            out.append(one)
    return out


def unsettled_captures(events, clock=None):
    """The `capture` events nothing has settled, in log order."""
    return [one for one in unsettled(events, clock) if one.get("type") == "capture"]


def check_settles(value, events):
    """The id `--settles` names, or Fail(2) when no unsettled capture has it."""
    if value is None:
        return None
    owed = [capture_id(cap) for cap in unsettled_captures(events)]
    if value not in owed:
        raise usage("--settles %r names no unsettled capture (see `compound events --unsettled`%s)" % (
            one_line(value)[:40], "; unsettled: " + ", ".join(owed[-8:]) if owed else "; there is none"))
    return value


def _under(path, top):
    real, base = os.path.realpath(path), os.path.realpath(top)
    return real == base or real.startswith(base.rstrip(os.sep) + os.sep)


def holders_elsewhere(name, events, project, skip=()):
    """The directories `holders` finds, without their project roots."""
    return [directory for _root, directory in holders(name, events, project, skip)]


def promote_command(project, name, rename=False):
    """The command that moves `name` of `project` to the user level, as it is typed."""
    return "COMPOUND_PROJECT=%s compound promote %s --to user%s" % (project, name, " --as NEWNAME" if rename else "")


def holders(name, events, project, skip=()):
    """[(project root, directory)] of lessons or skills called `name` at the project
    level of every project the event log knows (the `project` of its `learn` events),
    leaving out the user level's own directories and the real paths in `skip`."""
    user_lessons, user_skills = dirs_of(project, "user")
    skipped = set(os.path.realpath(path) for path in skip)
    seen = []
    out = []
    for event in events:
        root = event.get("project")
        if event.get("type") != "learn" or not isinstance(root, str) or not root or root in seen:
            continue
        seen.append(root)
        for base in (os.path.join(root, ".claude", "compound", "lessons"), os.path.join(root, ".claude", "skills")):
            directory = os.path.join(base, name)
            if not os.path.isfile(os.path.join(directory, "SKILL.md")):
                continue
            real = os.path.realpath(directory)
            if real in skipped or _under(directory, user_lessons) or _under(directory, user_skills):
                continue
            skipped.add(real)
            out.append((root, directory))
    return out


def git_tracked(directory):
    """Whether git tracks anything under `directory` in the repository it sits in.
    Outside a repository nothing is tracked. Inside one where git cannot say, it is
    taken as tracked: the caller then leaves the directory where it is."""
    if _walk_up_git(os.path.realpath(directory)) is None:
        return False
    code, out, _err = _run(["git", "-C", directory, "ls-files", "--", "."], timeout=30)
    if code != 0:
        return True
    return bool(out.strip())


def path_line(directory):
    """The shell-profile line that puts `directory` on PATH."""
    home = os.path.expanduser("~").rstrip(os.sep)
    if home and directory.startswith(home + os.sep):
        return 'export PATH="$HOME/%s:$PATH"' % os.path.relpath(directory, home)
    return 'export PATH="%s:$PATH"' % directory


def on_path(directory):
    real = os.path.realpath(directory)
    return any(os.path.realpath(_expand(part)) == real
               for part in os.environ.get("PATH", "").split(os.pathsep) if part)


def annotate(items, events):
    """Public dicts carrying `counts` and `ineffective`."""
    counts, recalls = tally(events)
    limit = recur_limit()
    out = []
    for item in items:
        extra = {"counts": dict(counts.get(item["name"], dict.fromkeys(COUNT_TYPES, 0)))}
        if item["kind"] == "script":
            extra["ineffective"] = False
        else:
            extra["ineffective"] = is_ineffective(item, recalls, limit)
        out.append(public(item, extra))
    return out


def event_summary(event):
    kind = event.get("type")
    names = event_names(event)
    if kind in ("skip", "refuse"):
        return one_line(event.get("why", ""))
    if kind == "skill":
        return "%s (%s) -> %s" % (", ".join(names), one_line(event.get("level", "?")),
                                  one_line(event.get("path", "?")))
    if kind == "rm":
        return "%s (%s)" % (", ".join(names), one_line(event.get("level", "?")))
    if kind == "error":
        where = one_line(event.get("where", ""))
        message = one_line(event.get("message", ""))
        return (where + ": " + message) if where else message
    if kind == "candidate":
        return "%s stays in %s (seen in %s)" % (", ".join(names), one_line(event.get("from", "?")),
                                                one_line(event.get("seen_in", "?")))
    if kind == "remind":
        ids = event.get("captures")
        return ", ".join(str(one) for one in ids) if isinstance(ids, list) else ""
    if kind == "promote":
        text = "%s %s -> %s" % (", ".join(names), event.get("from", "?"), event.get("to", "?"))
        if event.get("url"):
            text += " " + str(event["url"])
        return text
    if kind == "learn":
        return "%s (%s%s)" % (", ".join(names), event.get("level", "?"),
                              ", updated" if event.get("update") else "")
    if kind == "nudge":
        return "%s calls" % event.get("calls", "?")
    if kind == "judge":
        named = event.get("named")
        named = ", ".join(str(one) for one in named) if isinstance(named, list) else ""
        return "%s: %s, %s ms%s" % (one_line(event.get("moment", "?")), one_line(event.get("verdict", "?")),
                                    event.get("ms", "?"), (" (%s)" % named) if named else "")
    if names:
        return ", ".join(names)
    if kind == "capture":
        return one_line(event.get("fixed", ""))[:80]
    return ""


def event_lines(events, clock, words=False, indent=""):
    """One line an event, in columns: how long ago, the type (or with `words` the word a
    person is shown for it), the session (not with `words`), the project and what the
    event was about, cut to the terminal's width when there is one."""
    width = term_width()
    rows = []
    for event in events:
        kind = one_line(event.get("type", "?"))[:32]
        cells = [when_text(parse_ts(event.get("ts")), clock), EVENT_WORDS.get(kind, kind) if words else kind]
        if not words:
            cells.append(str(event.get("session") or "")[:8] or "-")
        cells.append(os.path.basename(str(event.get("project") or "")) or "-")
        rows.append((cells, kind, event_summary(event)[:240 if kind == "skill" else 100]))
    if not rows:
        return []
    widths = [max(len(cells[index]) for cells, _, _ in rows) for index in range(len(rows[0][0]))]
    if width is not None:
        # A long project name gives way before the summary does.
        widths[-1] = min(widths[-1], max(8, width // 4))
    lines = []
    for cells, kind, summary in rows:
        cells = cells[:-1] + [clip(cells[-1], widths[-1])]
        head = [paint(cells[0].rjust(widths[0]), DIM), paint(cells[1].ljust(widths[1]), EVENT_COLOURS.get(kind))]
        head += [paint(cell.ljust(widths[index + 2]), DIM) for index, cell in enumerate(cells[2:])]
        used = len(indent) + sum(widths) + 2 * len(widths)
        if width is not None:
            summary = clip(summary, max(10, width - used))
        lines.append((indent + "  ".join(head) + "  " + summary).rstrip())
    return lines


# ----------------------------------------------------------------------------- output


def emit(data):
    sys.stdout.write(dumps(data, indent=2) + "\n")


def table(rows, header, style=None):
    """Rows in columns under `header`. `style(row, column, cell)` answers the colour codes
    of a cell, or nothing; the header is row -1 and is bold."""
    if not rows:
        return ""
    widths = [len(col) for col in header]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(str(cell)))
    lines = []
    for number, row in enumerate([header] + rows, -1):
        cells = []
        for index, cell in enumerate(row):
            text = str(cell).ljust(widths[index]) if index < len(row) - 1 else str(cell)
            codes = (BOLD,) if number < 0 else ((style(number, index, str(cell)) if style else None) or ())
            cells.append(paint(text, *codes) if text.strip() else text)
        lines.append("  ".join(cells).rstrip())
    return "\n".join(lines) + "\n"


# ----------------------------------------------------------------------------- add


def read_stdin():
    if sys.stdin is None or sys.stdin.isatty():
        return ""
    data = sys.stdin.buffer.read()
    return data.decode("utf-8", "replace")


def _stdin_fd():
    """stdin's descriptor, or None when there is no stdin to read or it is a terminal."""
    try:
        fd = sys.stdin.fileno()
        return None if os.isatty(fd) else fd
    except (AttributeError, ValueError, OSError):
        return None


def read_stdin_briefly():
    """stdin's text for a command nobody told to read it. A regular file is read whole.
    Anything else (a pipe, a socket) is waited on for STDIN_WAIT seconds at a time: one
    that neither speaks nor ends within that is Fail(2), never a hang."""
    import select
    import stat

    fd = _stdin_fd()
    if fd is None:
        return ""
    try:
        if stat.S_ISREG(os.fstat(fd).st_mode):
            return read_stdin()
    except OSError:
        return ""
    chunks = []
    while True:
        try:
            ready = select.select([fd], [], [], STDIN_WAIT)[0]
        except (OSError, ValueError):
            ready = []
        if not ready:
            raise usage("stdin %s within %d seconds, so no body was read from it. Pass the body with "
                        "--body TEXT or --body-file PATH" % (
                            "did not end" if chunks else "gave no body and did not end", STDIN_WAIT))
        piece = os.read(fd, 65536)
        if not piece:
            return b"".join(chunks).decode("utf-8", "replace")
        chunks.append(piece)


def stdin_waiting():
    """Whether text is waiting on stdin right now. Never waits."""
    import select
    import stat

    fd = _stdin_fd()
    if fd is None:
        return False
    try:
        if stat.S_ISREG(os.fstat(fd).st_mode):
            return os.fstat(fd).st_size > os.lseek(fd, 0, os.SEEK_CUR)
        if not select.select([fd], [], [], 0)[0]:
            return False
        return bool(os.read(fd, 1))
    except (OSError, ValueError):
        return False


def body_of(args):
    """(the body `add` was given, whether a flag gave it). `--body TEXT`, `--body-file
    PATH`, `--body -` for stdin to its end. With no flag a plain `add` reads stdin
    briefly, and `--update` reads nothing: it keeps the body the lesson has."""
    if args.body is not None and args.body_file is not None:
        raise usage("--body and --body-file cannot both be given")
    if args.body_file is not None:
        try:
            return read_text(args.body_file).replace("\r\n", "\n"), True
        except OSError as exc:
            raise usage("--body-file %s cannot be read: %s" % (args.body_file, exc.strerror or exc))
    if args.body == "-":
        return read_stdin(), True
    if args.body is not None:
        return args.body, True
    if not args.update:
        return read_stdin_briefly(), False
    if stdin_waiting():
        raise usage("text is waiting on stdin, and --update reads a new body only when asked to: pass --body - "
                    "to take it as the new body (or --body TEXT, or --body-file PATH). Nothing was changed")
    return "", False


def cmd_add(args):
    name = args.name
    if not SLUG_RE.match(name):
        raise usage("--name %r is not a slug: lowercase letters, digits and hyphens, "
                    "2 to 63 characters, starting with a letter or digit" % name)
    if args.level == "general":
        raise usage("a lesson reaches general only through `compound promote %s --to general`" % name)
    if args.match and args.no_match:
        raise usage("--match and --no-match cannot both be given")
    tools = []
    for tool in args.tool or []:
        if not TOOL_RE.match(tool):
            raise usage("--tool %r is not a tool name such as Bash, Edit or mcp__server__tool" % tool)
        if tool not in tools:
            tools.append(tool)
    if tools and args.no_match:
        raise usage("--tool and --no-match cannot both be given")
    for pattern in args.match or []:
        issue = match_problem(pattern)
        if issue:
            raise usage("--match %r %s" % (pattern, issue))
    attachments = []
    for source in args.attach or []:
        if not os.path.isfile(source):
            raise usage("--attach %s is not a file" % source)
        if os.path.basename(source) == "SKILL.md":
            raise usage("--attach cannot replace SKILL.md")
        attachments.append(os.path.abspath(source))
    names = [os.path.basename(path) for path in attachments]
    if len(set(names)) != len(names):
        raise usage("two --attach files share a file name")
    body, body_given = body_of(args)
    if body_given and not body.strip():
        raise usage("the body is empty: --body and --body-file take the text of the lesson")
    description = one_line(args.when) if args.when is not None else None

    project = project_root()
    items, _ = scan(project, with_body=True)
    existing = [item for item in items if item["name"] == name]
    events, _bad = read_events()
    settles = check_settles(args.settles, events)

    if args.update:
        if not existing:
            raise usage("no lesson named %r to update (drop --update to add it)" % name)
        item = existing[0]
        if item["level"] == "general":
            raise usage("%r is in the general pool, which changes through a pull request "
                        "(`compound promote`), not in place" % name)
        changes = {}
        if description is not None:
            if not description:
                raise usage("--when is empty")
            changes["description"] = yaml_string(description)
        elif not item["description"]:
            raise usage("--when is required: the lesson has no description")
        if "name" not in item["_fields"]:
            changes["name"] = yaml_string(name)
        removals = []
        guard = bool(item["_fields"].get("match"))
        if args.match:
            changes["match"] = json.dumps(args.match, ensure_ascii=False)
            guard = True
        elif args.no_match:
            removals.extend(["match", "match-tools"])
            guard = False
        if tools:
            if not guard:
                raise usage("--tool names the tools a --match pattern is tested against, and %r has no pattern: "
                            "pass --match too" % name)
            changes["match-tools"] = json.dumps(tools, ensure_ascii=False)
        if args.origin and one_line(args.origin):
            changes["origin"] = yaml_string(one_line(args.origin))
        if not body.strip() and not item["_body"].strip():
            raise usage("the body is empty: pass the lesson with --body TEXT, --body-file PATH, or --body - "
                        "and stdin")
        stamp = now()
        changes["updated"] = local_date(stamp)
        directory = item["path"]
        try:
            text = edit_frontmatter(item["_text"], changes, removals,
                                    body=body if body.strip() else None, first=("name",))
        except Fail as exc:
            raise usage("%s was not updated: %s" % (item["_file"], exc.message))
        atomic_write(item["_file"], text)
        for source in attachments:
            atomic_copy(source, os.path.join(directory, os.path.basename(source)))
        _pin_mtime(item["_file"], stamp)
        level, kind = item["level"], item["kind"]
    else:
        if existing:
            where = existing[0]
            raise usage("%r already exists at the %s level (%s). Use --update to rewrite it "
                        "where it is; a second copy is never added" % (name, where["level"], where["path"]))
        if description is None or not description:
            raise usage("--when is required and cannot be empty: it says when the lesson applies")
        if not body.strip():
            raise usage("the body is empty: write the lesson on stdin, or pass it with --body TEXT or "
                        "--body-file PATH")
        if args.level == "project":
            issue = project_level_problem(project)
            if issue:
                raise usage(issue)
        else:
            held = holders_elsewhere(name, events, project)
            if held:
                raise usage("%r is the name of a lesson in another project (%s). A user-level lesson is "
                            "seen from every project, so it needs a name none of them uses; choose another"
                            % (name, ", ".join(held)))
        stamp = now()
        fields = {"name": yaml_string(name), "description": yaml_string(description)}
        guard = bool(args.match)
        if tools and not guard:
            raise usage("--tool names the tools a --match pattern is tested against: pass --match too")
        if args.match:
            fields["match"] = json.dumps(args.match, ensure_ascii=False)
        if tools:
            fields["match-tools"] = json.dumps(tools, ensure_ascii=False)
        fields["created"] = local_date(stamp)
        session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        origin = one_line(args.origin or "") or "project %s%s" % (
            os.path.basename(project) or project, (", session " + session[:8]) if session else "")
        fields["origin"] = yaml_string(one_line(origin))
        lessons, _skills = dirs_of(project, args.level)
        directory = os.path.join(lessons, name)
        if os.path.lexists(directory):
            raise usage("%s exists and is not a lesson that reads (see `compound list`); remove it with "
                        "`compound rm %s` first" % (directory, name))
        _create_dir(lessons, name, render_skill(fields, body), attachments)
        _pin_mtime(os.path.join(directory, "SKILL.md"), stamp)
        level, kind = args.level, "lesson"

    extra = {"settles": settles} if settles else {}
    log_soft("learn", project, lesson=name, level=level, kind=kind, path=directory,
             guard=guard, update=bool(args.update), **extra)
    result = {"name": name, "level": level, "kind": kind, "path": directory,
              "updated": bool(args.update), "guard": guard}
    if args.json:
        emit(result)
    else:
        sys.stdout.write("%s %s %s (%s)\n  %s\n" % (
            "updated" if args.update else "recorded", "guard" if result["guard"] else kind,
            name, level, directory))
    return 0


def project_level_problem(project):
    """Why a NEW lesson must not be written at the project level of `project`, or None.
    From the home directory (or the directory the Claude directory sits in) the
    'project' store is <home>/.claude/compound/lessons, which is the user store under
    another name."""
    real = os.path.realpath(project)
    reserved = [(os.path.realpath(os.path.expanduser("~")), "the home directory"),
                (os.path.realpath(os.path.dirname(claude_dir())), "the directory that holds the Claude directory")]
    for path, label in reserved:
        if real == path:
            return ("the project root is %s (%s), not a project, so a project-level lesson would land in "
                    "the user's own .claude. Pass --level user, or run inside a project" % (label, project))
    return None


def _pin_mtime(path, stamp):
    """With the clock pinned, a file written 'now' carries the pinned time too, so
    'recalled since it was last modified' compares one clock with itself."""
    if os.environ.get("COMPOUND_NOW"):
        os.utime(path, (stamp, stamp))


def _create_dir(parent, name, text, attachments):
    """Build the lesson beside its final place and rename it in, so a half-written
    lesson is never visible and a name taken in the meantime is refused."""
    import shutil
    import tempfile

    os.makedirs(parent, exist_ok=True)
    final = os.path.join(parent, name)
    staging = tempfile.mkdtemp(dir=parent, prefix="." + name + ".", suffix=".tmp")
    try:
        os.chmod(staging, 0o755)
        with open(os.path.join(staging, "SKILL.md"), "w", encoding="utf-8") as handle:
            handle.write(text)
        for source in attachments:
            shutil.copy2(source, os.path.join(staging, os.path.basename(source)))
        if os.path.lexists(final):
            raise usage("%s appeared while the lesson was being written; nothing was changed" % final)
        os.rename(staging, final)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise


# ----------------------------------------------------------------------------- list, show, find


def cmd_list(args):
    project = project_root()
    items, broken = scan(project)
    if args.scripts:
        items = items + scan_scripts(project)
    unreadable = [row for row in broken if row.get("unparseable")]
    if args.level:
        items = [item for item in items if item["level"] == args.level]
        unreadable = [row for row in unreadable if row["level"] == args.level]
    events, _ = read_events()
    rows = annotate(items, events)
    if args.json:
        # The list stays a list of what reads; what does not is said on stderr.
        for row in unreadable:
            sys.stderr.write("compound: unparseable %s %s: %s (remove it with `compound rm %s`)\n" % (
                row["level"], row["path"], row["problem"], row["name"]))
        emit(rows)
        return 0
    if not rows and not unreadable:
        sys.stdout.write("nothing recorded yet\n")
        return 0
    lines = []
    for row in rows:
        counts = row["counts"]
        kind = "guard" if (row["kind"] == "lesson" and row["match"]) else row["kind"]
        flag = "ineffective" if row["ineffective"] else ""
        lines.append([row["level"], kind, row["name"], counts["reuse"], counts["guard"], counts["recall"],
                      flag, row["description"]])
    for row in unreadable:
        lines.append([row["level"], "unparseable", row["name"], "-", "-", "-", "",
                      "%s: %s" % (row["path"], one_line(row["problem"])[:120])])
    header = ["LEVEL", "KIND", "NAME", "REUSED", "GUARDED", "RECALLED", "FLAG", "WHEN"]
    # The description takes the room the terminal has left beside the columns; with too
    # little, it gets a line of its own under its row. Piped, it is cut at 70 characters.
    width = term_width()
    fixed = sum(max(len(str(row[index])) for row in lines + [header]) + 2 for index in range(len(header) - 1))
    room = 70 if width is None else width - fixed
    counters = {3: CYAN, 4: RED, 5: MAGENTA}

    def style(number, index, cell):
        if index in counters:
            return (counters[index],) if cell not in ("0", "-") else (DIM,)
        if index == 1 and cell in ("guard", "unparseable"):
            return (RED,)
        if index == 6:
            return (YELLOW,)
        if index == 7:
            return (DIM,)
        return None

    if room >= 24:
        # Piped, the path of a lesson that does not parse is never cut: it is what to fix.
        text = table([row[:-1] + [row[-1] if width is None and row[1] == "unparseable" else clip(row[-1], room)]
                      for row in lines], header, style)
    else:
        under = iter([row[-1] for row in lines])
        out = []
        for number, line in enumerate(table([row[:-1] for row in lines], header[:-1], style).splitlines()):
            out.append(line)
            if number > 0:
                out.append("    " + paint(clip(next(under), max(10, (width or 80) - 4)), DIM))
        text = "\n".join(out) + "\n"
    sys.stdout.write(text)
    return 0


def cmd_show(args):
    project = project_root()
    item = find_item(project, args.name)
    text = item.get("_text", "")
    files = sorted(name for name in os.listdir(item["path"]) if name != "SKILL.md" and not name.startswith("."))
    if args.json:
        events, _ = read_events()
        row = annotate([item], events)[0]
        row["recalls_since"] = recalls_since(item, tally(events)[1])
        row["guarded_in_session"] = guarded_in(events, item["name"], os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
        row["recur_limit"] = recur_limit()
        row["text"] = text
        # What the pane's lesson view draws: the body without its frontmatter, and the
        # newest reuse, guard or recall that names the lesson.
        row["body"] = item.get("_body", "")
        fired = [event for event in events
                 if event.get("type") in ("reuse", "guard", "recall") and item["name"] in event_names(event)]
        row["last"] = {"ts": fired[-1].get("ts"), "type": fired[-1].get("type")} if fired else None
        row["files"] = files
        emit(row)
        return 0
    sys.stdout.write("%s (%s %s)\n%s\n" % (item["name"], item["level"], item["kind"], item["path"]))
    for name in files:
        sys.stdout.write("  attached: %s\n" % name)
    sys.stdout.write("\n" + text)
    if not text.endswith("\n"):
        sys.stdout.write("\n")
    return 0


def words_of(text):
    return re.findall(r"[a-z0-9]+", text.lower())


def query_words(parts):
    seen = []
    for word in words_of(" ".join(parts)):
        if len(word) >= 2 and word not in seen:
            seen.append(word)
    kept = [word for word in seen if word not in STOPWORDS]
    return kept or seen


def surfer_bin():
    named = os.environ.get("COMPOUND_SURFER")
    if named:
        return named if (os.path.isfile(named) and os.access(named, os.X_OK)) else None
    import shutil

    return shutil.which("surfer")


def prompt_hits(words, project, cap=5):
    """(hits, state). Prompt-log matches for the current project first, then for every
    project, de-duplicated, best word overlap first within each scope."""
    binary = surfer_bin()
    if not binary:
        return [], "missing"
    import subprocess

    pattern = "|".join(re.escape(word) for word in words)
    hits = []
    seen = set()
    state = "ok"
    for scope, extra in (("project", ["--project", project]), ("all", ["--all"])):
        if len(hits) >= cap:
            break
        try:
            proc = subprocess.run(
                [binary, "search", pattern, "--regex", "--json", "--limit", "200"] + extra,
                cwd=project if os.path.isdir(project) else None,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL, timeout=20)
            rows = json.loads(proc.stdout.decode("utf-8", "replace") or "[]") if proc.returncode == 0 else None
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            state = "error: %s" % one_line(exc)[:120]
            continue
        if not isinstance(rows, list):
            state = "error: surfer search exited %d" % proc.returncode
            continue
        ranked = []
        for row in rows:
            if not isinstance(row, dict) or row.get("is_command"):
                continue
            prompt = str(row.get("prompt") or "")
            if prompt.lstrip().startswith(NOT_TYPED):
                continue
            present = set(words_of(prompt))
            score = sum(1 for word in words if word in present)
            ranked.append((score, str(row.get("ts") or ""), row, prompt))
        ranked.sort(key=lambda entry: (entry[0], entry[1]), reverse=True)
        for score, _ts, row, prompt in ranked:
            key = str(row.get("id") or "") or prompt
            if key in seen or one_line(prompt) in seen:
                continue
            seen.add(key)
            seen.add(one_line(prompt))
            hits.append({"id": str(row.get("id") or ""), "ts": str(row.get("ts") or ""),
                         "session": str(row.get("session_id") or row.get("session") or ""),
                         "project": str(row.get("cwd") or ""), "scope": scope,
                         "score": score, "prompt": one_line(prompt)[:300]})
            if len(hits) >= cap:
                break
    return hits, state


def cmd_find(args):
    words = query_words(args.words)
    if not words:
        raise usage("give at least one word to search for")
    project = project_root()
    items, _ = scan(project, with_body=True)
    # The package's own procedures are how lessons are made and reused, not reusable work.
    items = [item for item in items
             if not (item["kind"] == "skill" and item["level"] == "general" and item["name"] in OWN_SKILLS)]
    candidates = items + scan_scripts(project)
    events, _ = read_events()
    scored = []
    for item, row in zip(candidates, annotate(candidates, events)):
        head = set(words_of(item["name"] + " " + item["description"]))
        everything = head | set(words_of(item.get("_body", "")))
        score = sum(1 for word in words if word in everything)
        if score == 0:
            continue
        row["score"] = score
        scored.append((score, sum(1 for word in words if word in head), row))
    scored.sort(key=lambda entry: (-entry[0], -entry[1], entry[2]["name"]))
    rows = [entry[2] for entry in scored[: args.limit]]
    prompts, state = prompt_hits(words, project)
    if args.json:
        emit({"words": words, "items": rows, "prompts": prompts, "surfer": state})
        return 0
    if rows:
        width = term_width()
        for row in rows:
            # How many of the words matched is said only when some did not.
            partial = "" if row["score"] == len(words) else ", matched %d of %d words" % (row["score"], len(words))
            head = "%s %s (%s)%s: " % (row["kind"], row["name"], row["level"], partial)
            text = row["description"] if width is None else clip(row["description"], max(10, width - len(head)))
            sys.stdout.write("%s %s (%s)%s: %s\n  %s\n" % (
                row["kind"], paint(row["name"], BOLD), row["level"], partial, text, paint("-> " + row["path"], DIM)))
    else:
        sys.stdout.write("no lesson, skill or script matches: %s\n" % " ".join(words))
    if state == "missing":
        sys.stdout.write("prompt log: not searched (history-surfer's `surfer` is not on PATH)\n")
    elif state != "ok":
        sys.stdout.write("prompt log: %s\n" % state)
    if prompts:
        sys.stdout.write("earlier requests:\n")
        for hit in prompts:
            sys.stdout.write("  %s %s %s: \"%s\"\n" % (
                hit["id"], hit["ts"][:10], os.path.basename(hit["project"]) or "-", hit["prompt"][:160]))
    elif state == "ok":
        sys.stdout.write("prompt log: no earlier request matches\n")
    return 0


# ----------------------------------------------------------------------------- check


def check_budget():
    value = os.environ.get("COMPOUND_CHECK_BUDGET_MS", "")
    if re.match(r"^\d{1,6}$", value) and int(value) >= 1:
        return int(value) / 1000.0
    return CHECK_BUDGET_MS / 1000.0


def _match_inline(guards, text, report):
    for index, patterns in enumerate(guards):
        report("S", index)
        hit = False
        for pattern in patterns:
            try:
                if compile_match(pattern).search(text):
                    hit = True
                    break
            except (re.error, RecursionError, MemoryError, OverflowError):
                continue
        report("H" if hit else "M", index)


def run_guards(guards, text, deadline):
    """(indexes that hit, indexes that did not finish, indexes never started).

    The matching runs in a forked child that reports each guard as it starts and as it
    ends; the parent waits until `deadline` (time.monotonic) and then kills it. A
    regular expression that backtracks without end cannot be interrupted from inside
    the process that runs it, so it is run in one that can be abandoned."""
    started, ended, hits = [], [], []

    def note(kind, index):
        (started if kind == "S" else ended).append(index)
        if kind == "H":
            hits.append(index)

    if not guards:
        return hits, [], []
    if not hasattr(os, "fork"):
        _match_inline(guards, text, note)
        return hits, [], []
    reader, writer = os.pipe()
    sys.stdout.flush()
    sys.stderr.flush()
    child = os.fork()
    if child == 0:
        code = 0
        try:
            os.close(reader)
            _match_inline(guards, text, lambda kind, index: os.write(writer, ("%s%d\n" % (kind, index)).encode()))
        except BaseException:
            code = 1
        finally:
            os._exit(code)
    os.close(writer)
    os.set_blocking(reader, False)
    pending = b""
    try:
        while True:
            try:
                chunk = os.read(reader, 65536)
            except BlockingIOError:
                chunk = None
            except InterruptedError:
                continue
            if chunk == b"":
                break
            if chunk:
                pending += chunk
                continue
            if time.monotonic() >= deadline:
                break
            time.sleep(0.001)
    finally:
        try:
            os.kill(child, 9)  # SIGKILL
        except OSError:
            pass
        try:
            os.waitpid(child, 0)
        except OSError:
            pass
        os.close(reader)
    for line in pending.decode("ascii", "replace").split("\n"):
        if line[:1] in ("S", "H", "M") and line[1:].isdigit() and int(line[1:]) < len(guards):
            note(line[0], int(line[1:]))
    unfinished = [index for index in started if index not in ended]
    never = [index for index in range(len(guards)) if index not in started]
    return hits, unfinished, never


def cmd_check(args=None, count=False):
    count = count or bool(getattr(args, "guards", False))
    began = time.monotonic()
    raw = read_stdin()
    try:
        call = json.loads(raw)
    except ValueError:
        raise usage("check reads one JSON object {\"tool\":...,\"input\":...} on stdin")
    if not isinstance(call, dict):
        raise usage("check reads one JSON object {\"tool\":...,\"input\":...} on stdin")
    payload = call.get("input")
    tool = call.get("tool") if isinstance(call.get("tool"), str) else ""
    if tool == "Bash" and isinstance(payload, dict) and isinstance(payload.get("command"), str):
        text = payload["command"]
    elif isinstance(payload, str):
        text = payload
    elif payload is None:
        text = ""
    else:
        text = json.dumps(payload, ensure_ascii=False)
    text = text[:CHECK_TEXT_CAP]
    result = {"hits": []}
    if text or count:
        budget = check_budget()
        project = project_root(fast=True)
        items, _ = scan(project, with_body=True)
        guarded = [item for item in items if item["match"]]
        if count:
            result["guards"] = len(guarded)
            result["tools"] = sorted(set(one for item in guarded for one in item["_tools"]))
        # A lesson's patterns are tested against the calls of the tools it names: Bash alone
        # unless its `match-tools` says otherwise.
        guarded = [item for item in guarded if tool in item["_tools"]]
    if text:
        hits, unfinished, never = run_guards([item["match"] for item in guarded], text, began + budget)
        for index in sorted(hits):
            item = guarded[index]
            result["hits"].append({"name": item["name"], "level": item["level"],
                                   "path": item["path"], "text": item["_body"].strip()})
        if unfinished or never:
            result["timed_out"] = [guarded[index]["name"] for index in unfinished]
            result["unchecked"] = [guarded[index]["name"] for index in never]
            for index in unfinished:
                try:
                    log_event("error", project, where="check", lesson=guarded[index]["name"],
                              message="the guard %s did not finish matching within %d ms and was abandoned; "
                                      "rewrite its match (%s)" % (guarded[index]["name"], int(budget * 1000),
                                                                  guarded[index]["path"]))
                except Exception:  # the log is the report of this failure; it cannot fail the check
                    pass
            if not unfinished:
                try:
                    log_event("error", project, where="check",
                              message="the %d ms budget ran out with %d guard(s) not yet tested: %s" % (
                                  int(budget * 1000), len(never), ", ".join(result["unchecked"])[:300]))
                except Exception:
                    pass
    sys.stdout.write(dumps(result) + "\n")
    return 0


# ----------------------------------------------------------------------------- skill, promote, rm


def _move(source, target):
    import shutil

    if os.path.lexists(target):
        raise usage("%s already exists; nothing was moved" % target)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    try:
        os.rename(source, target)
    except OSError:
        shutil.move(source, target)


def cmd_skill(args):
    project = project_root()
    item = find_item(project, args.name)
    if item["kind"] != "lesson":
        raise usage("%r is already a skill (%s)" % (args.name, item["path"]))
    if item["level"] == "general":
        raise usage("%r is in the general pool, which changes through a pull request" % args.name)
    _lessons, skills = dirs_of(project, item["level"])
    target = os.path.join(skills, item["name"])
    _move(item["path"], target)
    log_soft("skill", project, lesson=item["name"], level=item["level"], path=target)
    result = {"name": item["name"], "level": item["level"], "kind": "skill", "path": target}
    if args.json:
        emit(result)
    else:
        sys.stdout.write("%s is now a skill (%s)\n  %s\n" % (item["name"], item["level"], target))
    return 0


def _lesson_files(directory):
    """(relative paths to publish, relative paths left out). Dotfiles, dot-directories
    and symbolic links are left out and named; bytecode caches are left out silently."""
    out = []
    excluded = []
    for root, dirnames, filenames in os.walk(directory):
        keep = []
        for name in sorted(dirnames):
            path = os.path.join(root, name)
            if name == "__pycache__":
                continue
            if name.startswith(".") or os.path.islink(path):
                excluded.append(os.path.relpath(path, directory))
                continue
            keep.append(name)
        dirnames[:] = keep
        for filename in sorted(filenames):
            path = os.path.join(root, filename)
            if filename.endswith(".pyc"):
                continue
            if filename.startswith(".") or os.path.islink(path) or not os.path.isfile(path):
                excluded.append(os.path.relpath(path, directory))
                continue
            out.append(os.path.relpath(path, directory))
    return out, sorted(excluded)


def published_text(item):
    """The SKILL.md that is proposed: the local one without its `origin`, which names
    the project and session the lesson came from."""
    try:
        return edit_frontmatter(item.get("_text", ""), {}, removals=("origin",))
    except Fail as exc:
        raise usage("%s cannot be published: %s" % (item["_file"], exc.message))


def _run(argv, cwd=None, timeout=300):
    import subprocess

    try:
        proc = subprocess.run(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              stdin=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return 127, "", str(exc)
    return (proc.returncode, proc.stdout.decode("utf-8", "replace").strip(),
            proc.stderr.decode("utf-8", "replace").strip())


def _must(argv, cwd=None, what=None):
    code, out, err = _run(argv, cwd=cwd)
    if code != 0:
        raise failure("%s failed: %s" % (what or " ".join(argv[:3]), one_line(err or out)[:300]))
    return out


def cmd_promote(args):
    project = project_root()
    item = find_item(project, args.name)
    name = item["name"]
    if args.to != "user" and (args.auto or args.rename or args.seen_in):
        raise usage("--auto, --seen-in and --as go with --to user only")
    if args.to == "user":
        if item["level"] != "project":
            raise usage("%r is already at the %s level" % (name, item["level"]))
        new = args.rename or name
        events, _bad = read_events()
        text = None
        if new != name:
            if not SLUG_RE.match(new):
                raise usage("--as %r is not a slug: lowercase letters, digits and hyphens, 2 to 63 characters, "
                            "starting with a letter or digit" % new)
            items, _ = scan(project)
            taken = [other for other in items if other["name"] == new]
            if taken:
                raise usage("--as %r is already the name of a %s at the %s level (%s)" % (
                    new, taken[0]["kind"], taken[0]["level"], taken[0]["path"]))
            try:
                text = edit_frontmatter(item.get("_text", ""), {"name": yaml_string(new)}, first=("name",))
            except Fail as exc:
                raise usage("%s cannot be renamed: %s" % (item["_file"], exc.message))
        seen_in = _expand(args.seen_in) if args.seen_in else project

        def candidate(command, **extra):
            """An automatic move that was not made: logged once per pair of projects, so
            `status` lists it under Open."""
            known = any(event.get("type") == "candidate" and event.get("lesson") == name
                        and event.get("from") == project and event.get("seen_in") == seen_in for event in events)
            if not known:
                log_soft("candidate", seen_in, lesson=name, seen_in=seen_in, **{"from": project})
            if args.json:
                row = {"name": name, "moved": False, "candidate": True, "from": project, "seen_in": seen_in,
                       "kind": item["kind"], "path": item["path"], "command": command}
                row.update(extra)
                emit(row)

        # A copy of this lesson in another project, byte for byte, is this lesson. Any
        # other holder of the name is a different lesson, and the user level has one name.
        twins = [(root, directory) for root, directory in holders(name, events, project, skip=(item["path"],))
                 if same_tree(item["path"], directory)]
        twin_dirs = set(os.path.realpath(directory) for _root, directory in twins)
        held = [directory for directory in holders_elsewhere(new, events, project, skip=(item["path"],))
                if os.path.realpath(directory) not in twin_dirs]
        if held:
            command = promote_command(project, name, rename=True)
            message = ("%r is also the name of a different lesson in another project (%s). At the user level "
                       "it would be seen there too, under one name. Nothing was moved; give it another name "
                       "with: %s" % (new, ", ".join(held), command))
            if not args.auto:
                raise usage(message)
            candidate(command, conflict=held)
            sys.stderr.write("compound: %s\n" % message)
            return 2
        committed = [(root, directory) for root, directory in twins if git_tracked(directory)]
        loose = [pair for pair in twins if pair not in committed]
        source_root, source = project, item["path"]
        if args.auto and git_tracked(item["path"]):
            if not loose:
                command = promote_command(project, name)
                candidate(command)
                sys.stderr.write("compound: %s is tracked by git in %s, so it was left where it is. It is a "
                                 "candidate for the user level; when the user agrees, move it with: %s\n" % (
                                     name, project, command))
                return 3
            # The committed copy stays; an untracked copy of the same lesson is the one that moves.
            source_root, source = loose.pop(0)
            committed.insert(0, (project, item["path"]))
        lessons, skills = dirs_of(project, "user")
        target = os.path.join(lessons if item["kind"] == "lesson" else skills, new)
        _move(source, target)
        if text is not None:
            atomic_write(os.path.join(target, "SKILL.md"), text)
        merged = []
        for root, directory in loose:
            try:
                if os.path.islink(directory):
                    os.unlink(directory)
                else:
                    import shutil

                    shutil.rmtree(directory)
                merged.append(root)
            except OSError as exc:
                sys.stderr.write("compound: warning: the identical copy %s could not be removed (%s)\n" % (
                    directory, exc.strerror or exc))
        # Under a new name the committed copies are no longer this lesson's twins.
        also = [root for root, _directory in committed] if new == name else []
        fields = {"from": source_root if args.auto else "project"}
        if new != name:
            fields["was"] = name
        if args.auto:
            fields["auto"] = True
        if also:
            fields["also"] = also
        if merged:
            fields["merged"] = merged
        log_soft("promote", seen_in if args.auto else project, lesson=new, to="user", path=target, **fields)
        result = {"name": new, "from": "project", "to": "user", "kind": item["kind"], "path": target}
        if new != name:
            result["was"] = name
        if args.auto:
            result.update({"moved": True, "from": source_root, "seen_in": seen_in})
        if also:
            result["also"] = also
        if merged:
            result["merged"] = merged
        if args.json:
            emit(result)
        else:
            sys.stdout.write("moved %s from project to user%s\n  %s\n" % (
                name, " as %s" % new if new != name else "", target))
            for root in also:
                sys.stdout.write("  the same lesson stays committed in %s\n" % root)
            for root in merged:
                sys.stdout.write("  the identical untracked copy in %s was removed\n" % root)
        return 0

    if item["level"] == "general":
        raise usage("%r is already in the general pool" % name)
    upstream = os.environ.get("COMPOUND_UPSTREAM") or UPSTREAM_DEFAULT
    if not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", upstream):
        raise usage("COMPOUND_UPSTREAM is not owner/repo: %r" % upstream)
    subdir = "lessons" if item["kind"] == "lesson" else "skills"
    branch = "compound/%s-%s" % (item["kind"], name)
    files, excluded = _lesson_files(item["path"])
    skill_md = published_text(item)
    title = "Add %s: %s" % (item["kind"], name)
    body = "Proposes the %s `%s` for the general pool.\n\nWhen it applies: %s\n" % (
        item["kind"], name, item["description"])
    if item["match"]:
        body += "\nGuard patterns:\n" + "".join("- `%s`\n" % pattern for pattern in item["match"])
    body += "\nFiles:\n" + "".join("- `%s/%s/%s`\n" % (subdir, name, rel) for rel in files)
    body += "\nThe text:\n\n```\n%s\n```\n" % item["_body"].strip()
    plan = {
        "name": name, "from": item["level"], "to": "general", "upstream": upstream,
        "branch": branch, "files": ["%s/%s/%s" % (subdir, name, rel) for rel in files],
        "title": title, "body": body, "source": item["path"], "dry_run": not args.yes,
        "skill_md": skill_md, "excluded": excluded,
    }
    if not args.yes:
        if args.json:
            emit(plan)
        else:
            sys.stdout.write(
                "Plan (nothing has been written; run again with --yes to do it):\n"
                "  upstream : %s\n  branch   : %s\n  from     : %s (%s level)\n  files    :\n%s"
                "  excluded : %s\n%s"
                "  PR title : %s\n  PR body  :\n%s\n"
                "  SKILL.md as it will be published:\n%s\n" % (
                    upstream, branch, item["path"], item["level"],
                    "".join("    %s\n" % path for path in plan["files"]),
                    "dotfiles and links, never published" if excluded else "nothing",
                    "".join("    %s\n" % path for path in excluded), title,
                    "".join("    %s\n" % line for line in body.splitlines()),
                    "".join("    %s\n" % line for line in skill_md.splitlines())))
        return 0

    import shutil
    import tempfile

    gh = shutil.which("gh")
    if not gh:
        raise failure("`gh` is not on PATH; `promote --to general --yes` needs the GitHub CLI")
    if not shutil.which("git"):
        raise failure("`git` is not on PATH")
    code, _out, err = _run([gh, "auth", "status"], timeout=60)
    if code != 0:
        raise failure("`gh` is not authenticated (run `gh auth login`): %s" % one_line(err)[:200])
    code, can_push, err = _run([gh, "api", "repos/" + upstream, "--jq", ".permissions.push"], timeout=60)
    if code != 0:
        raise failure("cannot read %s: %s" % (upstream, one_line(err)[:200]))
    work = tempfile.mkdtemp(prefix="compound-promote-")
    try:
        clone = os.path.join(work, "repo")
        _must([gh, "repo", "clone", upstream, clone, "--", "--depth", "1"], what="cloning " + upstream)
        target = os.path.join(clone, subdir, name)
        if os.path.exists(target):
            raise failure("%s/%s already exists in %s" % (subdir, name, upstream))
        _must(["git", "checkout", "-b", branch], cwd=clone)
        for rel in files:
            os.makedirs(os.path.dirname(os.path.join(target, rel)), exist_ok=True)
            if rel == "SKILL.md":
                with open(os.path.join(target, rel), "w", encoding="utf-8", newline="") as handle:
                    handle.write(skill_md)
            else:
                shutil.copy2(os.path.join(item["path"], rel), os.path.join(target, rel))
        _must(["git", "add", "--", os.path.join(subdir, name)], cwd=clone)
        _must(["git", "commit", "-m", title], cwd=clone, what="git commit")
        helper = ["-c", "credential.helper=", "-c", "credential.helper=!%s auth git-credential" % gh]
        if can_push.strip() == "true":
            _must(["git"] + helper + ["push", "origin", branch], cwd=clone, what="git push")
            head = branch
        else:
            _must([gh, "repo", "fork", "--remote", "--remote-name", "fork"], cwd=clone, what="gh repo fork")
            login = _must([gh, "api", "user", "--jq", ".login"], what="gh api user")
            _must(["git"] + helper + ["push", "fork", branch], cwd=clone, what="git push")
            head = "%s:%s" % (login, branch)
        url = _must([gh, "pr", "create", "--repo", upstream, "--head", head,
                     "--title", title, "--body", body], cwd=clone, what="gh pr create")
        url = url.splitlines()[-1].strip() if url else ""
    finally:
        shutil.rmtree(work, ignore_errors=True)
    log_soft("promote", project, lesson=name, to="general", path=item["path"], url=url,
             **{"from": item["level"]})
    plan["url"] = url
    if args.json:
        emit(plan)
    else:
        sys.stdout.write("%s\n" % url)
    return 0


def cmd_rm(args):
    import shutil

    project = project_root()
    try:
        item = find_item(project, args.name)
    except Fail:
        # A directory whose SKILL.md does not parse is no item; it is removed by its
        # directory name, at the project and user levels only.
        _items, broken = scan(project)
        wrecks = [row for row in broken if row["name"] == args.name and row.get("unparseable")
                  and row["level"] != "general"]
        if not wrecks:
            raise
        item = wrecks[0]
    if item["level"] == "general":
        raise usage("%r is in the general pool and ships with the package; it is not removed here" % args.name)
    if item["kind"] != "lesson" and not args.force:
        raise usage("%r is a skill (%s); `compound rm` removes lessons. "
                    "Pass --force to remove a skill" % (args.name, item["path"]))
    path = item["path"]
    if os.path.islink(path):
        os.unlink(path)
    else:
        shutil.rmtree(path)
    log_soft("rm", project, lesson=item["name"], level=item["level"])
    result = {"name": item["name"], "level": item["level"], "kind": item["kind"], "removed": path}
    if args.json:
        emit(result)
    else:
        sys.stdout.write("removed %s (%s)\n  %s\n" % (item["name"], item["level"], path))
    return 0


# ----------------------------------------------------------------------------- skip, log, events


def cmd_skip(args):
    why = one_line(args.why)
    if not why:
        raise usage("--why cannot be empty: say why no lesson is being recorded")
    events, _bad = read_events()
    settles = check_settles(args.settles, events)
    project = project_root()
    if settles is None and not os.environ.get("CLAUDE_CODE_SESSION_ID"):
        # Outside a session nothing says which capture is meant: the project's one
        # unsettled capture is, and with several the caller names it.
        here = os.path.realpath(project)
        mine = [cap for cap in unsettled_captures(events, now())
                if _text(cap.get("project")) and os.path.realpath(cap["project"]) == here]
        if len(mine) > 1:
            raise usage("%d captures are unsettled in this project; name the one being declined with "
                        "--settles ID:\n%s" % (len(mine), "\n".join(
                            "  %s  `%s` worked" % (capture_id(cap), one_line(cap.get("fixed", ""))[:OPEN_TEXT])
                            for cap in mine)))
        if mine:
            settles = capture_id(mine[0])
    extra = {"settles": settles} if settles else {}
    event = log_event("skip", project, why=why, **extra)
    if args.json:
        emit(event)
    else:
        sys.stdout.write("declined: %s\n" % why)
        if settles:
            sys.stdout.write("  settles capture %s\n" % settles)
    return 0


def cmd_log(args):
    raw = read_stdin()
    try:
        event = json.loads(raw)
    except ValueError:
        raise usage("log reads one JSON object on stdin")
    if not isinstance(event, dict):
        raise usage("log reads one JSON object on stdin, not %s" % type(event).__name__)
    kind = event.get("type")
    if not isinstance(kind, str) or not re.match(r"^[a-z][a-z0-9_-]{0,31}$", kind):
        raise usage("the event needs a `type` (a lowercase name such as reuse, guard, recall)")
    if kind not in EVENT_TYPES:
        raise usage("%r is not an event type; the types are: %s" % (kind, ", ".join(EVENT_TYPES)))
    out = {"ts": event.get("ts") if isinstance(event.get("ts"), str) and parse_ts(event.get("ts")) is not None
           else iso(now()), "type": kind}
    session = event.get("session")
    out["session"] = session if isinstance(session, str) else os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    project = event.get("project")
    out["project"] = project if isinstance(project, str) and project else project_root()
    for key, value in event.items():
        if key not in out:
            out[key] = value
    if kind == "capture":
        out["id"] = capture_id(out)
    append_event(out)
    if args.json:
        emit(out)
    return 0


def cmd_events(args):
    since = None
    if args.since is not None:
        since = parse_ts(args.since)
        if since is None:
            raise usage("--since %r is neither epoch seconds nor an ISO 8601 time" % args.since)
    events, bad = read_events()
    if args.unsettled:
        events = [dict(event, id=capture_id(event)) if event.get("type") == "capture" else event
                  for event in unsettled(events, now())]
    wanted = os.path.realpath(_expand(args.project)) if args.project else None
    out = []
    for event in events:
        if args.type and event.get("type") != args.type:
            continue
        if wanted is not None and not (isinstance(event.get("project"), str) and event["project"]
                                       and os.path.realpath(event["project"]) == wanted):
            continue
        if args.session and event.get("session") != args.session:
            continue
        if since is not None:
            stamp = parse_ts(event.get("ts"))
            if stamp is None or stamp < since:
                continue
        out.append(event)
    if args.limit:
        out = out[-args.limit:]
    if bad:
        sys.stderr.write("compound: %d line(s) of %s do not parse and were skipped\n" % (bad, events_path()))
    if args.json:
        emit(out)
    else:
        for line in event_lines(out, now()):
            sys.stdout.write(line + "\n")
    return 0


# ----------------------------------------------------------------------------- settings


def settings_path(directory=None):
    return os.path.join(directory or claude_dir(), "settings.json")


def load_settings(path):
    """(settings dict, whether the file exists). Raises Fail(1) naming the problem on
    anything that is not a JSON object; the file is never touched in that case."""
    real = os.path.realpath(path)
    if not os.path.exists(real):
        return {}, False
    try:
        text = read_text(real)
    except OSError as exc:
        raise failure("%s cannot be read: %s" % (path, exc.strerror or exc))
    if not text.strip():
        return {}, True
    try:
        data = json.loads(text)
    except ValueError as exc:
        raise failure("%s is not valid JSON (%s); it was left untouched. Fix it and run again" % (path, exc))
    if not isinstance(data, dict):
        raise failure("%s holds a JSON %s, not an object; it was left untouched" % (path, type(data).__name__))
    env = data.get("env")
    if env is not None and not isinstance(env, dict):
        raise failure("%s: `env` is not an object; it was left untouched" % path)
    if env and PLUGIN_ENV in env and not isinstance(env[PLUGIN_ENV], str):
        raise failure("%s: `env.%s` is not a string; it was left untouched" % (path, PLUGIN_ENV))
    return data, True


def write_settings(path, data):
    """Atomically, and through the symlink when `path` is one."""
    real = os.path.realpath(path)
    issue = settings_write_problem(path)
    if issue:
        raise failure(issue)
    mode = None
    try:
        mode = os.stat(real).st_mode & 0o777
    except OSError:
        pass
    atomic_write(real, dumps(data, indent=2) + "\n", mode=mode)


def settings_write_problem(path):
    """Why the settings file must not be written, or None. A file its owner made
    read-only is refused: a rename over it would replace it all the same."""
    real = os.path.realpath(path)
    if os.path.lexists(real):
        if not os.path.isfile(real):
            return "%s is not a regular file; it was left untouched" % path
        if not os.access(real, os.W_OK):
            return "%s is read-only; it was left untouched. Make it writable and run again" % path
        return None
    return dir_problem(os.path.dirname(real), "the directory of %s" % path)


def dir_problem(path, label):
    """Why the directory `path` cannot be made or written into, or None: its nearest
    existing ancestor must be a directory that can be written."""
    here = path
    while not os.path.lexists(here):
        parent = os.path.dirname(here)
        if parent == here:
            break
        here = parent
    if not os.path.isdir(here):
        return "%s cannot be used: %s is not a directory" % (label, here)
    if not os.access(here, os.W_OK | os.X_OK):
        return "%s cannot be used: %s is not writable" % (label, here)
    return None


def plugin_dirs(settings):
    env = settings.get("env") or {}
    return [part for part in str(env.get(PLUGIN_ENV, "")).split(os.pathsep) if part]


def _same_path(left, right):
    return os.path.realpath(os.path.expanduser(left)) == os.path.realpath(os.path.expanduser(right))


def mod_enabled(settings, package):
    return any(_same_path(part, package) for part in plugin_dirs(settings))


# `... from './x'` (an import or a re-export, on one line or several) and `import './x'`.
IMPORT_RE = re.compile(r"""(?:^|[\s}])from\s+['"](\.{1,2}/[^'"\n]+)['"]|^\s*import\s+['"](\.{1,2}/[^'"\n]+)['"]""", re.M)
IMPORT_ENDS = ("", ".ts", ".tsx", ".d.ts", ".js", "/index.ts", "/index.tsx", "/index.d.ts")


def plugin_problem(package):
    """Why `package` cannot load as the plugin, or None: it needs its manifest, its
    hooks file, every module that file names, and every file those modules import by
    a relative path."""
    manifest = os.path.join(package, ".claude-plugin", "plugin.json")
    if not os.path.isfile(manifest):
        return "%s is missing" % manifest
    hooks = os.path.join(package, "hooks", "hooks.json")
    if not os.path.isfile(hooks):
        return "%s is missing" % hooks
    try:
        data = json.loads(read_text(hooks))
    except (OSError, ValueError) as exc:
        return "%s does not read as JSON (%s)" % (hooks, one_line(exc)[:120])
    modules = data.get("modules") if isinstance(data, dict) else None
    if not isinstance(modules, list) or not modules or not all(isinstance(one, str) for one in modules):
        return "%s names no module" % hooks
    waiting = []
    for one in modules:
        path = os.path.normpath(os.path.join(os.path.dirname(hooks), one))
        if not os.path.isfile(path):
            return "the module %s, named in %s, is missing" % (path, hooks)
        waiting.append(path)
    # Every relative import of those modules, and of what they import, is a file.
    seen = set()
    while waiting:
        path = waiting.pop()
        if path in seen:
            continue
        seen.add(path)
        try:
            source = read_text(path)
        except OSError as exc:
            return "the module %s cannot be read (%s)" % (path, exc.strerror or exc)
        for found in IMPORT_RE.finditer(source):
            spec = found.group(1) or found.group(2)
            base = os.path.normpath(os.path.join(os.path.dirname(path), spec))
            hit = [base + end for end in IMPORT_ENDS if os.path.isfile(base + end)]
            if not hit:
                return "the module %s.ts, which %s imports, is missing" % (base, path)
            if hit[0].endswith((".ts", ".tsx")) and not hit[0].endswith(".d.ts"):
                waiting.append(hit[0])
    return None


def read_manifest():
    try:
        data = json.loads(read_text(manifest_path()))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def is_our_manifest(data):
    """Whether `data` is an install record this tool wrote."""
    return (isinstance(data, dict) and isinstance(data.get("package"), str)
            and isinstance(data.get("settings"), str) and "plugin_dir_added" in data)


# ----------------------------------------------------------------------------- install


def pick_bin_dir():
    """The first of ~/.local/bin, ~/bin that is on PATH; ~/.local/bin when neither is."""
    for candidate in ("~/.local/bin", "~/bin"):
        full = _expand(candidate)
        if on_path(full):
            return full
    return _expand("~/.local/bin")


def claude_code():
    """(PASS | WARN | FAIL, detail) for the `claude` on PATH against CLAUDE_CODE_MIN.
    WARN when its version cannot be told, FAIL when it is older."""
    import shutil

    need = "%d.%d.%d" % CLAUDE_CODE_MIN
    found = shutil.which("claude")
    if not found:
        return "WARN", "`claude` is not on PATH, so its version was not checked; the mod needs Claude Code %s or later" % need
    code, out, err = _run([found, "--version"], timeout=5)
    version = re.search(r"(\d+)\.(\d+)\.(\d+)", out) if code == 0 else None
    if not version:
        return "WARN", "`%s --version` gave no version (%s); the mod needs Claude Code %s or later" % (
            found, one_line(err or out)[:120] or "exit %d" % code, need)
    if tuple(int(part) for part in version.groups()) < CLAUDE_CODE_MIN:
        return "FAIL", "%s is older than %s, which the mod needs; update Claude Code with: claude update" % (
            version.group(0), need)
    return "PASS", version.group(0)


def release_tags(names):
    """The release tags among `names`, oldest first: vX.Y.Z, compared as numbers, and
    never older than RELEASE_MIN. Sorted here: git's own version sort needs git 2.18."""
    found = []
    for name in names:
        hit = RELEASE_RE.match(name.strip())
        if hit and tuple(int(part) for part in hit.groups()) >= RELEASE_MIN:
            found.append((tuple(int(part) for part in hit.groups()), name.strip()))
    return [name for _version, name in sorted(found)]


def install_surfer(claude, bin_dir, previous):
    """Fetch history-surfer when it is absent. Returns a record; never raises."""
    import shutil

    if os.environ.get("COMPOUND_NO_SURFER"):
        return {"status": "skipped", "detail": "COMPOUND_NO_SURFER is set"}
    present = surfer_bin()
    if not present and bin_dir and os.path.exists(os.path.join(bin_dir, "surfer")):
        present = os.path.join(bin_dir, "surfer")
    if present:
        if previous and previous.get("status") == "installed":
            return previous
        return {"status": "present", "detail": present}
    if not bin_dir:
        return {"status": "skipped", "detail": "no bin directory to link `surfer` into"}
    if not shutil.which("git"):
        return {"status": "failed", "detail": "git is not on PATH"}
    home = os.path.join(home_dir(), "history-surfer")
    url = os.environ.get("COMPOUND_SURFER_URL") or SURFER_URL
    setup = os.path.join(home, "scripts", "setup.py")
    try:
        if not os.path.isfile(setup):
            if os.path.exists(home):
                return {"status": "failed", "detail": "%s exists and is not a history-surfer checkout" % home}
            os.makedirs(os.path.dirname(home), exist_ok=True)
            code, out, err = _run(["git", "clone", "--depth", "1", url, home], timeout=180)
            if code != 0:
                shutil.rmtree(home, ignore_errors=True)
                return {"status": "failed", "detail": "git clone %s: %s" % (url, one_line(err or out)[:200])}
        code, out, err = _run([sys.executable, setup, "--claude-dir", claude, "--bin-dir", bin_dir], timeout=180)
        if code != 0:
            return {"status": "failed", "home": home,
                    "detail": "its setup.py exited %d: %s" % (code, one_line(err or out)[:200])}
    except Exception as exc:  # never fails the install
        return {"status": "failed", "detail": one_line(exc)[:200]}
    return {"status": "installed", "home": home, "url": url, "claude_dir": claude, "bin_dir": bin_dir}


def cmd_install(args):
    if args.claude_dir:
        os.environ["COMPOUND_CLAUDE_DIR"] = _expand(args.claude_dir)
    claude = claude_dir()
    package = pkg_root()
    script = os.path.join(package, "bin", "compound")
    previous = read_manifest() or {}
    spath = settings_path(claude)

    # Everything that can refuse is checked before anything is written.
    settings, existed = load_settings(spath)
    bin_dir = _expand(args.bin_dir) if args.bin_dir else pick_bin_dir()
    link = os.path.join(bin_dir, "compound") if bin_dir else None
    if link and os.path.lexists(link):
        if not (os.path.islink(link) and _same_path(link, script)):
            raise failure("%s exists and is not a link to this package; it was left alone. "
                          "Remove it or pass --bin-dir" % link)
    home = home_dir()
    mpath = manifest_path()
    needs_settings = not mod_enabled(settings, package)
    needs_link = bool(link) and not os.path.lexists(link)
    for issue in (
        dir_problem(home, "COMPOUND_HOME (%s)" % home),
        "%s is not a regular file" % mpath if os.path.lexists(mpath) and not os.path.isfile(mpath) else None,
        settings_write_problem(spath) if needs_settings else None,
        dir_problem(bin_dir, "--bin-dir %s" % bin_dir) if needs_link else None,
    ):
        if issue:
            raise failure("nothing was installed: %s" % issue)

    same_target = previous.get("settings") == spath and previous.get("package") == package
    env_created = needs_settings and not isinstance(settings.get("env"), dict)
    manifest = {
        "package": package,
        "claude_dir": claude,
        "settings": spath,
        "plugin_dir_added": needs_settings or bool(same_target and previous.get("plugin_dir_added")),
        "settings_created": (needs_settings and not existed) or bool(same_target and previous.get("settings_created")),
        "env_created": env_created or bool(same_target and previous.get("env_created")),
        "link": link,
        "link_created": needs_link or bool(previous.get("link") == link and previous.get("link_created")),
        # Every directory an install made, so uninstall can remove the ones left empty.
        "dirs_created": [path for path in previous.get("dirs_created") or [] if isinstance(path, str)]
        if isinstance(previous.get("dirs_created"), list) else [],
        "surfer": previous.get("surfer") or {"status": "pending", "detail": "install did not finish"},
        "installed_at": previous.get("installed_at") or iso(now()),
    }

    def record():
        text = dumps(manifest, indent=2) + "\n"
        try:
            unchanged = read_text(mpath) == text
        except OSError:
            unchanged = False
        if not unchanged:
            atomic_write(mpath, text)

    # What a failure has to put back.
    undo = []
    made_dirs = []

    def make_dirs(path):
        missing = []
        here = path
        while here and not os.path.lexists(here):
            missing.append(here)
            here = os.path.dirname(here)
        made_dirs.extend(missing)
        manifest["dirs_created"].extend(one for one in missing if one not in manifest["dirs_created"])
        os.makedirs(path, exist_ok=True)

    try:
        old_manifest = read_text(mpath)
    except OSError:
        old_manifest = None
    real_settings = os.path.realpath(spath)
    try:
        with open(real_settings, "rb") as handle:
            old_settings = handle.read()
    except OSError:
        old_settings = None

    def restore(path, data):
        if data is None:
            if os.path.lexists(path):
                os.unlink(path)
        else:
            mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else None
            text = data if isinstance(data, str) else data.decode("utf-8", "surrogateescape")
            import tempfile

            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".restore.", suffix=".tmp")
            with os.fdopen(fd, "wb") as handle:
                handle.write(text.encode("utf-8", "surrogateescape"))
            if mode is not None:
                os.chmod(tmp, mode)
            os.replace(tmp, path)

    report = []
    try:
        # The record goes first: from here on, whatever is done is written down.
        make_dirs(home)
        undo.append(lambda: restore(mpath, old_manifest))
        record()

        if needs_settings:
            if not isinstance(settings.get("env"), dict):
                settings["env"] = {}
            parts = plugin_dirs(settings) + [package]
            settings["env"][PLUGIN_ENV] = os.pathsep.join(parts)
            make_dirs(os.path.dirname(real_settings))
            undo.append(lambda: restore(real_settings, old_settings))
            write_settings(spath, settings)
            report.append("mod      enabled: added %s to env.%s in %s" % (package, PLUGIN_ENV, spath))
        else:
            report.append("mod      already enabled in %s" % spath)

        if link:
            if os.path.lexists(link):
                report.append("cli      %s already links here" % link)
            else:
                make_dirs(bin_dir)
                os.symlink(script, link)
                undo.append(lambda: os.unlink(link))
                report.append("cli      linked %s" % link)
            if not on_path(bin_dir):
                report.append("cli      %s is not on PATH. Add this line to your shell profile "
                              "(~/.zshrc for zsh, ~/.bashrc for bash) and open a new shell:" % bin_dir)
                report.append("             %s" % path_line(bin_dir))
            import shutil

            first = shutil.which("compound")
            if first and not _same_path(first, script):
                report.append("cli      another `compound` comes first on PATH: %s. Typing `compound` runs that one; "
                              "remove or rename it, or put %s ahead of it on PATH" % (first, bin_dir))
        else:
            report.append("cli      not linked")

        surfer = install_surfer(claude, bin_dir, previous.get("surfer"))
        report.append("prompts  history-surfer %s%s" % (
            surfer["status"], (": " + surfer["detail"]) if surfer.get("detail") else
            (" at " + surfer["home"]) if surfer.get("home") else ""))
        manifest["surfer"] = surfer
        record()
    except BaseException as exc:
        left = []
        for step in reversed(undo):
            try:
                step()
            except Exception as problem:
                left.append(one_line(problem)[:200])
        for path in made_dirs:
            try:
                os.rmdir(path)
            except OSError:
                pass
        if not isinstance(exc, Exception):
            raise
        why = exc.message if isinstance(exc, Fail) else (
            "%s: %s" % (exc.strerror, exc.filename) if isinstance(exc, OSError) and exc.strerror
            else "%s: %s" % (type(exc).__name__, exc))
        raise failure("install failed and was rolled back: %s%s" % (
            one_line(why)[:300], ("; could not undo: " + "; ".join(left)) if left else ""))

    report.append("record   %s" % mpath)
    state, detail = claude_code()
    report.append("claude   %s" % (("Claude Code " + detail) if state == "PASS" else detail))
    if args.json:
        emit(manifest)
    else:
        sys.stdout.write("compound installed from %s\n" % package)
        for line in report:
            sys.stdout.write("  " + line + "\n")
        sys.stdout.write("Start a new Claude Code session: sessions that are already open do not load the mod.\n")
        sys.stdout.write("Check it with: %s status\n" % (link or script))
    return 0


def cmd_uninstall(args):
    import shutil

    if args.claude_dir:
        os.environ["COMPOUND_CLAUDE_DIR"] = _expand(args.claude_dir)
    manifest = read_manifest()
    recorded_here = is_our_manifest(manifest)
    report = []
    problems = []
    if manifest is None:
        report.append("no install record at %s; nothing to reverse" % manifest_path())
    else:
        package = manifest.get("package") if isinstance(manifest.get("package"), str) else pkg_root()
        spath = manifest.get("settings") if isinstance(manifest.get("settings"), str) else settings_path()
        # The element that names this package is ours whatever the record says about
        # who added it: a record written after a failed install said "not us" about an
        # element an earlier run had added, and the element then stayed for ever.
        ours = [package, pkg_root()]
        try:
            settings, existed = load_settings(spath)
            env = settings.get("env") if isinstance(settings.get("env"), dict) else None
            parts = plugin_dirs(settings)
            kept = [part for part in parts if not any(_same_path(part, mine) for mine in ours)]
            if existed and env is not None and len(kept) != len(parts):
                if kept:
                    env[PLUGIN_ENV] = os.pathsep.join(kept)
                else:
                    del env[PLUGIN_ENV]
                    if not env and manifest.get("env_created"):
                        del settings["env"]
                if not settings and manifest.get("settings_created"):
                    issue = settings_write_problem(spath)
                    if issue:
                        raise failure(issue)
                    os.unlink(os.path.realpath(spath))
                    report.append("mod      removed %s, which install had created" % spath)
                else:
                    write_settings(spath, settings)
                    report.append("mod      removed %s from env.%s in %s" % (package, PLUGIN_ENV, spath))
            else:
                report.append("mod      %s was not in %s" % (package, spath))
        except Fail as exc:
            problems.append("settings not edited: " + exc.message)
        link = manifest.get("link")
        if isinstance(link, str) and link and manifest.get("link_created") and not problems:
            script = os.path.join(package, "bin", "compound")
            if os.path.islink(link) and (_same_path(link, script) or os.readlink(link) == script):
                os.unlink(link)
                report.append("cli      removed %s" % link)
            elif os.path.lexists(link):
                report.append("cli      %s no longer links to this package; left alone" % link)
            else:
                report.append("cli      %s was already gone" % link)
        surfer = manifest.get("surfer") if isinstance(manifest.get("surfer"), dict) else {}
        if surfer.get("status") == "installed" and isinstance(surfer.get("home"), str) and surfer["home"]:
            setup = os.path.join(surfer["home"], "scripts", "setup.py")
            if args.purge and os.path.isfile(setup):
                code, out, err = _run([sys.executable, setup, "--uninstall",
                                       "--claude-dir", surfer.get("claude_dir") or claude_dir(),
                                       "--bin-dir", surfer.get("bin_dir") or ""], timeout=120)
                if code == 0:
                    report.append("prompts  history-surfer unwired (its prompt store was left in place)")
                else:
                    problems.append("history-surfer's uninstall exited %d: %s" % (code, one_line(err or out)[:200]))
            else:
                report.append("prompts  history-surfer left in place at %s (remove it with: python3 %s --uninstall)"
                              % (surfer["home"], setup))
        if not problems:
            try:
                os.unlink(manifest_path())
                report.append("record   removed %s" % manifest_path())
            except OSError:
                pass
    if args.purge and not problems:
        home = home_dir()
        real = os.path.realpath(home)
        protected = [os.path.realpath(p) for p in ("/", os.path.expanduser("~"), claude_dir())]
        if real in protected or any(p.startswith(real.rstrip(os.sep) + os.sep) for p in protected):
            problems.append("--purge refused: %s is not a directory of compound's own" % home)
        elif os.path.islink(home):
            problems.append("--purge refused: %s is a symbolic link; remove what it points at by hand" % home)
        elif os.path.isdir(home):
            # Ours when install's own record was in it, or when it holds nothing but
            # the names this tool and its mod put there.
            strangers = sorted(name for name in os.listdir(home) if name not in HOME_NAMES)
            if strangers and not recorded_here:
                problems.append(
                    "--purge refused: %s holds %s, which compound did not put there, and no install record "
                    "of compound's; nothing was removed" % (home, ", ".join(strangers[:8]) + (
                        " and %d more" % (len(strangers) - 8) if len(strangers) > 8 else "")))
            else:
                clone = os.path.isdir(os.path.join(home, "app"))
                shutil.rmtree(home)
                report.append("purged   %s (user lessons, the event log%s)" % (
                    home, " and the package clone" if clone else ""))
        else:
            report.append("purged   nothing: %s does not exist" % home)
    if not problems and isinstance(manifest, dict) and isinstance(manifest.get("dirs_created"), list):
        # The directories install made, deepest first, and only the ones that are empty
        # now: `rmdir` refuses any other.
        for path in sorted((one for one in manifest["dirs_created"] if isinstance(one, str) and one),
                           key=len, reverse=True):
            if os.path.isdir(path) and not os.path.islink(path):
                try:
                    os.rmdir(path)
                    report.append("removed  %s (empty; install had created it)" % path)
                except OSError:
                    pass
    if not args.purge and os.path.isdir(home_dir()):
        report.append("kept     %s (your lessons and the event log; --purge removes them)" % home_dir())
        clone = os.path.join(home_dir(), "app")
        if os.path.isdir(clone):
            report.append("kept     %s (the package clone; --purge removes it)" % clone)
        script = os.path.join(pkg_root(), "bin", "compound")
        report.append("To delete what was kept later, run: %s uninstall --purge" % (
            '"%s"' % script if " " in script else script))
    if args.json:
        emit({"report": report, "problems": problems})
    else:
        for line in report:
            sys.stdout.write(line + "\n")
    for line in problems:
        sys.stderr.write("compound: %s\n" % line)
    return 1 if problems else 0


def cmd_update(args):
    import shutil

    package = pkg_root()
    if args.ref is not None and not re.match(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$", args.ref):
        raise usage("--ref takes the name of a branch or a tag, not %r" % args.ref)
    if not shutil.which("git"):
        raise failure("`git` is not on PATH")
    code, old, err = _run(["git", "-C", package, "rev-parse", "--short", "HEAD"], timeout=30)
    if code != 0:
        raise failure("%s is not a git checkout: %s" % (package, one_line(err)[:200]))

    def git(*argv, **kw):
        return _run(["git", "-C", package, "-c", "advice.detachedHead=false"] + list(argv), timeout=kw.get("timeout", 60))

    # What the checkout follows: the branch it is on, or, on a detached HEAD, the
    # releases. `--ref` names a branch or a tag to move to instead.
    code, branch, _err = git("symbolic-ref", "-q", "--short", "HEAD")
    on_branch = code == 0 and bool(branch)
    if on_branch:
        old_ref = branch
    else:
        _code, here, _err = git("tag", "--points-at", "HEAD")
        old_ref = (release_tags(here.splitlines()) or [old])[-1]
    _code, changed, _err = git("status", "--porcelain", "--untracked-files=no")
    dirty = bool(changed.strip())
    if dirty and not args.json:
        sys.stdout.write("%s has uncommitted changes (%d file(s)); pulling anyway, and git stops if they are "
                         "in the way\n" % (package, len(changed.strip().splitlines())))
        sys.stdout.flush()
    target = args.ref
    newest = False
    if target or not on_branch:
        code, out, err = git("fetch", "--quiet", "--tags", "origin", timeout=300)
        if code != 0:
            raise failure("git fetch failed in %s: %s" % (package, one_line(err or out)[:300]))
        if not target:
            _code, names, _err = git("tag", "--list")
            releases = release_tags(names.splitlines())
            if not releases:
                raise failure("%s is on a detached HEAD (at %s), not on a branch, and its origin has no release "
                              "tag (v%d.%d.%d or later) to move to; follow a branch instead with: compound update "
                              "--ref main" % ((package, old) + RELEASE_MIN))
            target = releases[-1]
            newest = True
        code, _out, _err = git("show-ref", "--verify", "--quiet", "refs/remotes/origin/" + target)
        if code == 0:
            # A branch of origin: be on it, then pull.
            if not (on_branch and branch == target):
                code, out, err = git("checkout", "--quiet", target)
                if code != 0:
                    raise failure("cannot check out %s in %s: %s" % (target, package, one_line(err or out)[:300]))
            code, out, err = git("pull", "--ff-only", "origin", target, timeout=300)
            if code != 0:
                raise failure("git pull --ff-only failed in %s: %s" % (package, one_line(err or out)[:300]))
        else:
            code, _out, _err = git("rev-parse", "-q", "--verify", target + "^{commit}")
            if code != 0:
                raise failure("origin of %s has no branch or tag named %s; nothing was moved" % (package, target))
            code, out, err = git("checkout", "--quiet", "--detach", target)
            if code != 0:
                raise failure("cannot check out %s in %s: %s" % (target, package, one_line(err or out)[:300]))
        new_ref = target
    else:
        code, out, err = git("pull", "--ff-only", timeout=300)
        if code != 0:
            raise failure("git pull --ff-only failed in %s: %s" % (package, one_line(err or out)[:300]))
        new_ref = old_ref
    _code, new, _err = _run(["git", "-C", package, "rev-parse", "--short", "HEAD"], timeout=30)

    # Only a lesson under the user lessons directory is ever a candidate, and only
    # against the general LESSON of its name; nothing under <claude dir>/skills is
    # touched. It goes when its whole tree is the general one: same files, same bytes.
    removed = []
    differing = []
    user_lessons, _user_skills = dirs_of(project_root(), "user")
    try:
        names = sorted(os.listdir(user_lessons))
    except OSError:
        names = []
    for name in names:
        directory = os.path.join(user_lessons, name)
        theirs = os.path.join(package, "lessons", name)
        if name.startswith(".") or os.path.islink(directory) or not os.path.isdir(directory):
            continue
        if not os.path.isfile(os.path.join(theirs, "SKILL.md")):
            continue
        if os.path.realpath(directory) == os.path.realpath(theirs):
            continue
        if same_tree(directory, theirs):
            shutil.rmtree(directory)
            removed.append({"name": name, "path": directory})
        else:
            differing.append({"name": name, "path": directory, "general": theirs})
    moved = old != new or old_ref != new_ref
    result = {"package": package, "old": old, "new": new, "changed": moved, "dirty": dirty,
              "old_ref": old_ref, "ref": new_ref, "removed": removed, "differing": differing}
    if args.json:
        emit(result)
        return 0
    if on_branch and not args.ref:
        if old == new:
            sys.stdout.write("already up to date at %s\n" % new)
        else:
            sys.stdout.write("updated %s -> %s\n" % (old, new))
    elif not moved:
        sys.stdout.write("%s %s (%s)\n" % ("already the newest release:" if newest else "already at", new_ref, new))
    else:
        sys.stdout.write("updated %s -> %s (%s -> %s)\n" % (old_ref, new_ref, old, new))
    for row in removed:
        sys.stdout.write("removed user lesson %s: the general pool now carries the same files\n" % row["name"])
    for row in differing:
        sys.stdout.write("kept user lesson %s: the general pool has the name with different text or files "
                         "(%s vs %s)\n" % (row["name"], row["path"], row["general"]))
    return 0


def tree_of(top):
    """{relative path: ("dir",) | ("link", target) | ("file", bytes)} under `top`."""
    out = {}
    for root, dirnames, filenames in os.walk(top):
        for name in list(dirnames) + filenames:
            path = os.path.join(root, name)
            rel = os.path.relpath(path, top)
            if os.path.islink(path):
                out[rel] = ("link", os.readlink(path))
            elif os.path.isdir(path):
                out[rel] = ("dir",)
            else:
                with open(path, "rb") as handle:
                    out[rel] = ("file", handle.read())
    return out


def same_tree(left, right):
    try:
        return tree_of(left) == tree_of(right)
    except OSError:
        return False


# ----------------------------------------------------------------------------- status


def committed_copies(row, project, events):
    """The project roots that hold a byte-identical copy of the user-level lesson `row`:
    this project, and the ones a `promote` event recorded under `also`."""
    if row["level"] != "user" or row["kind"] != "lesson":
        return []
    roots = [project]
    for event in events:
        if event.get("type") == "promote" and event.get("lesson") == row["name"] and isinstance(event.get("also"), list):
            roots.extend(root for root in event["also"] if isinstance(root, str) and root)
    out = []
    for root in roots:
        directory = os.path.join(root, ".claude", "compound", "lessons", row["name"])
        if root in out or not os.path.isdir(directory) or _same_path(directory, row["path"]):
            continue
        if same_tree(directory, row["path"]):
            out.append(root)
    return out


def build_status():
    import shutil

    project = project_root()
    package = pkg_root()
    clock = now()
    items, broken = scan(project)
    events, bad_lines = read_events()
    rows = annotate(items, events)
    health = []

    def check(name, state, detail):
        health.append({"check": name, "status": state, "detail": detail})

    version = "%d.%d.%d" % sys.version_info[:3]
    unparseable = [{"name": row["name"], "level": row["level"], "path": row["path"], "problem": row["problem"]}
                   for row in broken if row.get("unparseable")]
    check("python", "PASS" if sys.version_info >= (3, 9) else "FAIL",
          version if sys.version_info >= (3, 9) else version + " is older than 3.9")
    check("claude code", *claude_code())

    spath = settings_path()
    try:
        settings, existed = load_settings(spath)
    except Fail as exc:
        check("mod", "FAIL", exc.message)
    else:
        broken_plugin = plugin_problem(package)
        off, off_where = setting("COMPOUND_OFF")
        if mod_enabled(settings, package) and broken_plugin:
            check("mod", "FAIL", "%s names %s, which cannot load as a plugin: %s" % (spath, package, broken_plugin))
        elif mod_enabled(settings, package) and off == "1" and off_where == "settings":
            check("mod", "WARN", "switched off: env.COMPOUND_OFF is 1 in %s" % spath)
        elif mod_enabled(settings, package) and off == "1":
            check("mod", "WARN", "switched off: COMPOUND_OFF is 1 in this environment")
        elif mod_enabled(settings, package):
            check("mod", "PASS", "enabled in %s" % spath)
        elif not existed:
            check("mod", "WARN", "%s does not exist; run `compound install` (or the package is loaded as a plugin)" % spath)
        else:
            check("mod", "WARN", "%s is not in env.%s of %s; run `compound install` "
                                 "(or the package is loaded as a plugin)" % (package, PLUGIN_ENV, spath))

    fired = [(parse_ts(event.get("ts")), event.get("type")) for event in events if event.get("type") in MOD_TYPES]
    fired = [pair for pair in fired if pair[0] is not None]
    if not fired:
        check("mod last fired", "WARN", "never: the event log holds no event the mod wrote (%s)" % ", ".join(MOD_TYPES))
    else:
        stamp, kind = max(fired, key=lambda pair: pair[0])
        text = "%s ago (%s)" % (age_text(clock - stamp), kind)
        if clock - stamp > WEEK:
            check("mod last fired", "WARN", "%s; nothing the mod wrote in the last 7 days" % text)
        else:
            check("mod last fired", "PASS", text)

    found = shutil.which("compound")
    script = os.path.join(package, "bin", "compound")
    manifest = read_manifest() or {}
    link = manifest.get("link") if isinstance(manifest.get("link"), str) else None
    if found and _same_path(found, script):
        check("cli", "PASS", "%s" % found)
    elif found:
        check("cli", "WARN", "`compound` on PATH is %s, not this package's (%s)" % (found, script))
    elif link and os.path.lexists(link) and not on_path(os.path.dirname(link)):
        check("cli", "WARN", "%s is linked, and %s is not on PATH. Add this line to your shell profile: %s" % (
            link, os.path.dirname(link), path_line(os.path.dirname(link))))
    else:
        check("cli", "WARN", "`compound` is not on PATH; the mod cannot call it by name")

    surfer = surfer_bin()
    if not surfer:
        check("prompt log", "WARN", "history-surfer's `surfer` is not on PATH; reuse checks see no earlier prompts")
    else:
        code, out, err = _run([surfer, "stats"], cwd=project if os.path.isdir(project) else None, timeout=20)
        if code == 0:
            # history-surfer prints "<N> prompt(s) across current project." on stderr and
            # one "<N>  <dates>  <project>" row on stdout.
            count = (re.search(r"(?m)^\s*(\d+)\s+prompt", err) or re.search(r"(?m)^\s*(\d+)\s+prompt", out)
                     or re.match(r"\s*(\d+)\s{2,}\S", out))
            check("prompt log", "PASS", "%d prompt%s in this project" % (
                int(count.group(1)), "" if int(count.group(1)) == 1 else "s") if count else "reachable")
        else:
            check("prompt log", "WARN", "`surfer stats` exited %d: %s" % (code, one_line(err or out)[:120]))

    stamps = [parse_ts(event.get("ts")) for event in events]
    stamps = [stamp for stamp in stamps if stamp is not None]
    log_issue = events_problem()
    if log_issue:
        check("last event", "FAIL", "the event log cannot be written: %s" % log_issue)
    elif bad_lines:
        check("last event", "WARN", "%d line(s) of %s do not parse and are skipped%s" % (
            bad_lines, events_path(),
            "; the last event that does was %s ago (%d events)" % (age_text(clock - max(stamps)), len(events))
            if stamps else ""))
    elif not stamps:
        check("last event", "WARN", "no events yet in %s" % events_path())
    else:
        check("last event", "PASS", "%s ago (%d events)" % (age_text(clock - max(stamps)), len(events)))

    by_name = {}
    for item in items:
        by_name.setdefault(item["name"], []).append(item)
    duplicates = []
    for name, group in sorted(by_name.items()):
        if len(group) > 1:
            duplicates.append({"name": name, "paths": [entry["path"] for entry in group],
                               "lesson": any(entry["kind"] == "lesson" for entry in group)})
    if not duplicates:
        check("duplicates", "PASS", "every name exists once")
    else:
        text = "; ".join("%s at %s" % (dup["name"], ", ".join(dup["paths"])) for dup in duplicates)
        check("duplicates", "FAIL" if any(dup["lesson"] for dup in duplicates) else "WARN", text)

    if broken:
        check("lessons parse", "FAIL", "; ".join("%s: %s" % (row["path"], row["problem"]) for row in broken))
    else:
        check("lessons parse", "PASS", "every lesson reads")

    errors = []
    for event in events:
        if event.get("type") != "error":
            continue
        stamp = parse_ts(event.get("ts"))
        if stamp is not None and clock - stamp <= WEEK:
            errors.append({"ts": event.get("ts"), "session": event.get("session", ""),
                           "where": one_line(event.get("where", "")),
                           "message": one_line(event.get("message", ""))})
    check("errors", "WARN" if errors else "PASS",
          "%d in the last 7 days" % len(errors) if errors else "none in the last 7 days")

    store = {}
    for level in LEVELS:
        mine = [row for row in rows if row["level"] == level]
        store[level] = {
            "lessons": sum(1 for row in mine if row["kind"] == "lesson"),
            "skills": sum(1 for row in mine if row["kind"] == "skill"),
            "guards": sum(1 for row in mine if row["match"]),
        }

    lessons = []
    for row in rows:
        counts = row["counts"]
        used = counts["reuse"] + counts["guard"] + counts["recall"]
        if row["kind"] == "skill" and used == 0 and not row["match"]:
            continue
        flag = "ineffective" if row["ineffective"] else ("never used" if used == 0 else "")
        lessons.append({"name": row["name"], "level": row["level"], "kind": row["kind"],
                        "guard": bool(row["match"]), "reuse": counts["reuse"], "guard_hits": counts["guard"],
                        "recall": counts["recall"], "flag": flag, "path": row["path"],
                        "also_in": committed_copies(row, project, events)})

    unsettled = []
    for cap in unsettled_captures(events, clock):
        unsettled.append({"id": capture_id(cap), "ts": cap.get("ts"), "age": age_text(clock - parse_ts(cap.get("ts"))),
                          "session": cap.get("session", ""), "project": cap.get("project", ""),
                          "failed": one_line(cap.get("failed", ""))[:OPEN_TEXT],
                          "fixed": one_line(cap.get("fixed", ""))[:OPEN_TEXT],
                          # What settles it, as the report prints it and the pane shows it.
                          "command": "/compound:learn settle %s" % capture_id(cap),
                          "decline": 'compound skip --settles %s --why "<reason>"' % capture_id(cap)})

    candidates = []
    for event in events:
        name, source, seen = event.get("lesson"), event.get("from"), event.get("seen_in")
        if event.get("type") != "candidate" or not all(isinstance(one, str) and one for one in (name, source, seen)):
            continue
        if not any(os.path.isfile(os.path.join(source, ".claude", sub, name, "SKILL.md"))
                   for sub in (os.path.join("compound", "lessons"), "skills")):
            continue  # moved or removed since: no longer a candidate
        row = [one for one in candidates if one["lesson"] == name and one["from"] == source]
        if row:
            if seen not in row[0]["seen_in"]:
                row[0]["seen_in"].append(seen)
            continue
        directory = [path for path in (os.path.join(source, ".claude", sub, name)
                                       for sub in (os.path.join("compound", "lessons"), "skills"))
                     if os.path.isfile(os.path.join(path, "SKILL.md"))][0]
        at_user = [path for path in (os.path.join(base, name) for base in dirs_of(project, "user"))
                   if os.path.isfile(os.path.join(path, "SKILL.md"))]
        if any(same_tree(directory, path) for path in at_user):
            continue  # the user level holds this very lesson: its committed copy, not a candidate
        conflict = [path for path in holders_elsewhere(name, events, source, skip=(directory,)) + at_user
                    if not same_tree(directory, path)]
        entry = {"lesson": name, "from": source, "seen_in": [seen],
                 "command": promote_command(source, name, rename=bool(conflict))}
        if conflict:
            entry["conflict"] = conflict
        elif not git_tracked(directory):
            entry["tracked"] = False
        candidates.append(entry)

    skips = [{"ts": event.get("ts"), "session": event.get("session", ""),
              "project": event.get("project", ""), "why": one_line(event.get("why", ""))}
             for event in events if event.get("type") == "skip"][-10:]
    # What the log holds of the mod helping: one per event. A rewrite records no new
    # lesson. The log holds no duration of a failed call or of its fix, so no time and no
    # tokens are claimed saved.
    kinds = [event.get("type") for event in events if not (event.get("type") == "learn" and event.get("update"))]
    totals = {"reused": kinds.count("reuse"), "guarded": kinds.count("guard"), "recalled": kinds.count("recall"),
              "recorded": kinds.count("learn"), "since": None}
    # Since the oldest event with a time a calendar holds.
    dated = [stamp for stamp in stamps if 0 <= stamp <= MAX_EPOCH]
    if dated:
        totals["since"] = iso(min(dated))
    return {
        "ok": not any(row["status"] == "FAIL" for row in health),
        "health": health,
        "totals": totals,
        "store": store,
        "lessons": lessons,
        "recent": [event for event in events if event.get("type") not in VERDICT_TYPES][-10:],
        "open": {
            "ineffective": [{"name": row["name"], "level": row["level"], "path": row["path"],
                             "recall": row["counts"]["recall"],
                             "command": "compound add --update --name %s --match RE" % row["name"]}
                            for row in rows if row["ineffective"]],
            "unsettled": unsettled,
            "candidates": candidates,
            "skips": skips,
            "errors": errors,
        },
        "unparseable": unparseable,
        "project": project,
        "package": package,
    }


def cmd_status(args):
    data = build_status()
    if args.json:
        emit(data)
        return 0 if data["ok"] else 1
    out = sys.stdout.write
    clock = now()
    width = term_width()

    def head(text):
        out(paint(text, BOLD) + "\n")

    def lines_of(text):
        return "".join("  " + line + "\n" for line in text.splitlines())

    head("Health")
    for row in data["health"]:
        out("  %s  %-14s  %s\n" % (paint("%-4s" % row["status"], STATUS_COLOURS.get(row["status"])), row["check"],
                                   row["detail"]))

    out("\n")
    head("Compound interest")
    totals = data["totals"]
    if totals["since"] is None:
        out("  nothing yet: the log holds no reuse, guard, recall or lesson\n")
    else:
        out("  %s \u00b7 %s \u00b7 %s \u00b7 %s \u00b7 %s\n" % (
            paint(plural(totals["reused"], "reuse") + " offered", CYAN),
            paint(plural(totals["guarded"], "call") + " stopped by a guard", RED),
            paint(plural(totals["recalled"], "lesson") + " recalled", MAGENTA),
            paint(plural(totals["recorded"], "lesson") + " recorded", GREEN),
            paint("since " + date_text(parse_ts(totals["since"]), clock), DIM)))

    out("\n")
    head("Levels")
    # The guards are among the lessons: a lesson that carries a pattern.
    digits = [max(len(str(data["store"][level][key])) for level in LEVELS) for key in ("lessons", "skills")]
    levels = [[level, plural(data["store"][level]["lessons"], "lesson").rjust(digits[0] + len(" lesson")
                                                                              + (data["store"][level]["lessons"] != 1)),
               "(%s)" % plural(data["store"][level]["guards"], "guard"),
               plural(data["store"][level]["skills"], "skill").rjust(digits[1] + len(" skill")
                                                                     + (data["store"][level]["skills"] != 1))]
              for level in LEVELS]
    wide = [max(len(row[index]) for row in levels) for index in range(4)]
    for row in levels:
        out(("  " + "  ".join(cell.ljust(wide[index]) for index, cell in enumerate(row))).rstrip() + "\n")

    out("\n")
    head("Lessons")
    used = [row for row in data["lessons"] if row["flag"] != "never used"]
    idle = len(data["lessons"]) - len(used)
    counters = {3: CYAN, 4: RED, 5: MAGENTA}
    if used:
        out(lines_of(table(
            [[row["name"], row["level"], "guard" if row["guard"] and row["kind"] == "lesson" else row["kind"],
              row["reuse"], row["guard_hits"], row["recall"], row["flag"]] for row in used],
            ["name", "level", "kind", "reused", "guarded", "recalled", "flag"],
            lambda number, index, cell: ((counters[index],) if cell != "0" else (DIM,)) if index in counters
            else ((YELLOW,) if index == 6 else None))))
    if idle:
        # One line for the lessons nothing has touched: `compound list` has every row.
        out("  %s\n" % paint("%s never used (`compound list` shows %s)" % (
            plural(idle, "lesson"), "it" if idle == 1 else "them"), DIM))
    if not data["lessons"]:
        out("  none recorded yet\n")
    for row in data["lessons"]:
        for root in row["also_in"]:
            out("  %s (%s) is also committed in %s\n" % (row["name"], row["level"], root))

    out("\n")
    head("Recent")
    if data["recent"]:
        for line in event_lines(data["recent"], clock, words=True, indent="  "):
            out(line + "\n")
    else:
        out("  no events yet\n")
    out("\n")
    head("Open")
    opened = data["open"]
    if not (opened["ineffective"] or opened["skips"] or opened["errors"] or data["unparseable"]
            or opened["unsettled"] or opened["candidates"]):
        out("  nothing open\n")
    for row in opened["unsettled"]:
        out("  owed         %s %s %s: `%s` failed, `%s` worked. Record it in a session there: "
            "%s  Or decline it: %s\n" % (
                row["id"], row["age"], os.path.basename(str(row["project"])) or "-", row["failed"], row["fixed"],
                row["command"], row["decline"]))
    for row in opened["candidates"]:
        if row.get("conflict"):
            why = ("%s holds a different lesson of that name, so it was not moved. Move it to the user level "
                   "under a new name with" % ", ".join(row["conflict"]))
        elif row.get("tracked") is False:
            why = "It was not moved. Move it to the user level with"
        else:
            why = "It is tracked by git there, so it was not moved. Move it to the user level with"
        out("  candidate    %s is a project lesson of %s that also applied in %s. %s: %s\n" % (
            row["lesson"], row["from"], ", ".join(row["seen_in"]), why, row["command"]))
    for row in data["unparseable"]:
        out("  unparseable  %s (%s): %s. Fix %s or remove it: compound rm %s\n" % (
            row["name"], row["level"], one_line(row["problem"])[:120], row["path"], row["name"]))
    for row in opened["ineffective"]:
        out("  ineffective  %s (%s): recalled %d times and the failure came back. Add a match "
            "(%s), attach a script or rewrite the description\n"
            % (row["name"], row["level"], row["recall"], row["command"]))
    for row in opened["skips"]:
        out("  declined     %s %s: %s\n" % (when_text(parse_ts(row["ts"]), clock), str(row["session"])[:8] or "-",
                                             row["why"]))
    for row in opened["errors"]:
        out("  %s        %s %s%s\n" % (paint("error", RED), when_text(parse_ts(row["ts"]), clock),
                                        (row["where"] + ": ") if row["where"] else "", row["message"]))
    return 0 if data["ok"] else 1


# ----------------------------------------------------------------------------- main


def build_parser():
    import argparse

    parser = argparse.ArgumentParser(
        prog="compound", description="Lessons, skills, the event log and the install of the compound mod.")
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    def command(name, func, text, json_flag=True):
        one = sub.add_parser(name, help=text, description=text)
        one.set_defaults(func=func)
        if json_flag:
            one.add_argument("--json", action="store_true", help="print JSON")
        return one

    one = command("add", cmd_add, "Write a lesson; the body is --body, --body-file, or stdin.")
    one.add_argument("--name", required=True)
    one.add_argument("--when", help="when the lesson applies (its description)")
    one.add_argument("--level", choices=LEVELS, default="project")
    one.add_argument("--match", action="append", metavar="RE", help="a guard pattern; repeatable")
    one.add_argument("--no-match", action="store_true", help="with --update: drop the guard patterns")
    one.add_argument("--tool", action="append", metavar="TOOL",
                     help="a tool whose calls the patterns are tested against (default Bash); repeatable")
    one.add_argument("--attach", action="append", metavar="FILE", help="a file to keep beside the lesson; repeatable")
    one.add_argument("--origin")
    one.add_argument("--update", action="store_true",
                     help="rewrite the lesson where it is; flags left out keep their value")
    one.add_argument("--settles", metavar="ID", help="the id of the unsettled capture this lesson settles")
    one.add_argument("--body", metavar="TEXT", help="the lesson's text; `-` reads stdin to its end")
    one.add_argument("--body-file", metavar="PATH", help="a file holding the lesson's text")

    one = command("list", cmd_list, "Lessons and skills at every level.")
    one.add_argument("--level", choices=LEVELS)
    one.add_argument("--scripts", action="store_true", help="add the project's scripts")

    one = command("show", cmd_show, "One lesson's path and text.")
    one.add_argument("name")

    one = command("find", cmd_find, "Lessons, skills and scripts by word overlap, then prompt-log hits.")
    one.add_argument("words", nargs="+")
    one.add_argument("--limit", type=int, default=10)

    one = command("check", cmd_check, "Test a tool call (JSON on stdin) against every guard.", json_flag=False)
    one.add_argument("--json", action="store_true", help="accepted; the output is always JSON")
    one.add_argument("--guards", action="store_true", help="add \"guards\": how many lessons carry a pattern")

    one = command("skill", cmd_skill, "Move a lesson to the skills directory of its level.")
    one.add_argument("name")

    one = command("promote", cmd_promote, "Move a lesson to the user level, or propose it to the general pool.")
    one.add_argument("name")
    one.add_argument("--to", required=True, choices=("user", "general"))
    one.add_argument("--yes", action="store_true", help="with --to general: open the pull request")
    one.add_argument("--as", dest="rename", metavar="NEWNAME", help="with --to user: rename while moving")
    one.add_argument("--auto", action="store_true",
                     help="with --to user: leave a lesson git tracks where it is (exit 3) and log a candidate")
    one.add_argument("--seen-in", metavar="PROJECT", help="with --auto: the project the lesson applied in")

    one = command("rm", cmd_rm, "Remove a lesson.")
    one.add_argument("name")
    one.add_argument("--force", action="store_true", help="remove a skill too")

    one = command("skip", cmd_skip, "Decline an owed lesson.")
    one.add_argument("--why", required=True)
    one.add_argument("--settles", metavar="ID", help="the id of the unsettled capture being declined")

    command("log", cmd_log, "Append one event (a JSON object on stdin).")

    one = command("events", cmd_events, "Read the event log.")
    one.add_argument("--since", metavar="TS")
    one.add_argument("--type")
    one.add_argument("--session")
    one.add_argument("--project", metavar="P", help="only events of this project root")
    one.add_argument("--unsettled", action="store_true",
                     help="only what is owed and unsettled in the last 14 days: captures, and ineffective recalls")
    one.add_argument("--limit", type=int, default=0)

    command("status", cmd_status, "Health, totals, counts per level, per-lesson use, recent events, what is open.")

    one = command("install", cmd_install, "Enable the mod, link the CLI, fetch history-surfer.")
    one.add_argument("--claude-dir")
    one.add_argument("--bin-dir")

    one = command("update", cmd_update, "Move the package to its newest version and drop user lessons the general pool now carries.")
    one.add_argument("--ref", metavar="REF", help="the branch or tag to move the checkout to and follow from then on")

    one = command("uninstall", cmd_uninstall, "Reverse what install recorded.")
    one.add_argument("--claude-dir")
    one.add_argument("--purge", action="store_true", help="also remove COMPOUND_HOME")
    return parser


def main(argv):
    checking = argv[:1] == ["check"]
    for stream in (sys.stdout, sys.stderr):
        try:
            # UTF-8 whatever the locale, and a character that cannot be encoded (a lone
            # surrogate out of the event log) is escaped instead of raising.
            stream.reconfigure(encoding="utf-8", errors="backslashreplace")
        except (AttributeError, ValueError, OSError):
            pass
    try:
        if checking and argv[1:] in ([], ["--guards"]):
            return cmd_check(count=len(argv) == 2)
        parser = build_parser()
        args = parser.parse_args(argv)
        if not getattr(args, "func", None):
            parser.print_usage(sys.stderr)
            return 2
        return args.func(args)
    except Fail as exc:
        sys.stderr.write("compound: %s\n" % exc.message)
        return exc.code
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 1
    except Exception as exc:  # no command ends in a traceback
        detail = "%s: %s" % (type(exc).__name__, one_line(exc)[:300])
        if checking:
            # check runs before every tool call: failing closed would block them all.
            try:
                sys.stdout.write(json.dumps({"hits": [], "error": detail}) + "\n")
            except Exception:
                pass
            return 0
        if isinstance(exc, OSError):
            sys.stderr.write("compound: %s\n" % exc)
        else:
            sys.stderr.write("compound: internal error: %s\n" % detail)
        return 1


def run(argv):
    """main(), with everything written out before the interpreter exits. A reader that
    has gone away (`compound list | head -1`) is not an error: the rest of the output
    has nowhere to go, and the exit status is the command's own."""
    try:
        code = main(argv)
    except SystemExit as exc:  # argparse: --help, or a usage error
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 2)
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        # Nothing more can be written: point stdout at the null device, so the flush
        # at exit has somewhere to go.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except (OSError, ValueError):
            pass
    except (OSError, ValueError):
        pass
    return code


if __name__ == "__main__":
    sys.exit(run(sys.argv[1:]))
