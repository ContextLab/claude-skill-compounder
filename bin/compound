class Fail(Exception):
    """An error with the exit status it should end the process on."""

    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code
        self.message = message


def usage(message):
    return Fail(2, message)


def failure(message):
    return Fail(1, message)


# ----------------------------------------------------------------------------- clock


def parse_ts(value):
    """Epoch seconds for an epoch number or an ISO 8601 string, else None."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        try:
            return _finite(float(value))
        except OverflowError:
            return None
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    if re.match(r"^\d+(\.\d+)?$", text):
        return _finite(float(text))
    import datetime

    iso = text
    if iso.endswith("Z") or iso.endswith("z"):
        iso = iso[:-1] + "+00:00"
    iso = re.sub(r"(\.\d{6})\d+", r"\1", iso)
    try:
        dt = datetime.datetime.fromisoformat(iso)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return _finite(dt.timestamp())
    except (ValueError, OverflowError):
        return None


def _finite(number):
    """`number`, or None for NaN and the infinities."""
    if number != number or number in (float("inf"), float("-inf")):
        return None
    return number


def now():
    pinned = os.environ.get("COMPOUND_NOW")
    if pinned:
        value = parse_ts(pinned)
        if value is None:
            raise usage("COMPOUND_NOW is neither epoch seconds nor an ISO 8601 time: %r" % pinned[:80])
        if not 0 <= value <= MAX_EPOCH:
            raise usage("COMPOUND_NOW is outside the years 1970 to 9999: %r" % pinned[:80])
        return value
    return time.time()


def iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def local_date(epoch):
    return time.strftime("%Y-%m-%d", time.localtime(epoch))


def age_text(seconds):
    seconds = int(seconds)
    if seconds < 0:
        return "in the future"
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")


def date_text(stamp, clock):
    """The local day of `stamp`: "3 Oct", with the year when it is not `clock`'s. "?" for
    a time no calendar holds."""
    try:
        then, today = time.localtime(stamp), time.localtime(clock)
    except (ValueError, OverflowError, OSError):
        return "?"
    text = "%d %s" % (then.tm_mday, MONTHS[then.tm_mon - 1])
    return text if then.tm_year == today.tm_year else "%s %d" % (text, then.tm_year)


def when_text(stamp, clock):
    """How long ago `stamp` was, for a person: 5s, 2m, 3h, then "yesterday" for the
    calendar day before, then the date. `--json` output carries the stamp itself."""
    if stamp is None or not 0 <= stamp <= MAX_EPOCH:
        return "?"
    seconds = int(clock - stamp)
    if 0 <= seconds < 86400:
        return age_text(seconds)
    if seconds >= 0:
        import datetime

        try:
            then, today = time.localtime(stamp), time.localtime(clock)
            days = (datetime.date(today.tm_year, today.tm_mon, today.tm_mday)
                    - datetime.date(then.tm_year, then.tm_mon, then.tm_mday)).days
        except (ValueError, OverflowError, OSError):
            return "?"
        if days == 1:
            return "yesterday"
    return date_text(stamp, clock)


