#!/usr/bin/env python3
"""compound: the store, the event log and the install of the compound mod.

This file is the only code that reads or writes lessons, skills, the event log and the
install record. The mod (hooks/) calls it for every store operation. Standard library
only; runs on Python 3.9 and later.

LEVELS
    project   <repo>/.claude/compound/lessons/<name>/   <repo>/.claude/skills/<name>/
    user      <COMPOUND_HOME>/lessons/<name>/           <COMPOUND_CLAUDE_DIR>/skills/<name>/
    general   <package>/lessons/<name>/                 <package>/skills/<name>/

    <repo> is COMPOUND_PROJECT when set, else `git rev-parse --show-toplevel` of the
    working directory, else the working directory. <package> is the checkout this file
    really lives in (the installed `compound` is a symlink to it).

LESSON FORMAT
    <dir>/SKILL.md: a `---` line, `key: value` lines, a `---` line, the body.
    Keys written here: name, description, match, match-tools, created, updated, origin. A string
    value that is not a plain YAML scalar is written as a JSON string, which is a
    valid YAML double-quoted one; both forms, YAML single quotes and a folded or
    literal block (`description: >`) are read. `--update` edits only the keys it
    changes and leaves every other frontmatter line as it is. `match` is a JSON array
    of Python regular expressions on ONE line; each is compiled with re.MULTILINE (so
    `^` and `$` match at the start and end of every line of a command) and tested with
    search() against the first 20000 characters of the text of a tool call (the
    `command` for Bash, otherwise the JSON of the input). A lesson with `match` is a
    guard. `match-tools` is a JSON array of tool names on ONE line: the tools whose
    calls the patterns are tested against. Without it the patterns are tested against
    Bash calls only, so text that is not a command (a file's content, an agent's
    prompt) is never guarded by accident.
    `created` and `updated` are local dates.

EVENT LOG
    <COMPOUND_HOME>/events.jsonl, append-only, one JSON object per line, one write()
    per line. `compound log` reads ONE object on stdin and appends it. It fills three
    fields when they are absent: `ts`, `session` (from CLAUDE_CODE_SESSION_ID) and
    `project` (the project root). `type` is required.

    Fields every event carries:
        ts        string  UTC, "YYYY-MM-DDTHH:MM:SSZ"
        type      string  one of the names below
        session   string  Claude Code session id, "" when unknown
        project   string  absolute path of the project root

    Fields per type. A name marked * is READ by this CLI; the others are stored and
    shown as they are.

        type      written by        fields
        reuse     mod               lessons* [string]  names of the inventory items
                                                       offered, exactly as `compound
                                                       list --json` names them (a
                                                       script's name is its path
                                                       relative to the project)
                                    prompts  [string]  prompt-log ids offered
                                    keywords [string]  the search words
        guard     mod               lesson*  string    the lesson whose match hit
                                    tool     string    tool name
                                    text     string    the text that was tested
        recall    mod               lesson*  string    the lesson returned beside a
                                                       failure (one recurrence)
                                    tool     string
                                    call     string    the call that failed
                                    error    string    the failure's text
                                    at       string    failure | fix: when it was met
                                    guard    bool      the lesson has a match
                                    after_guard bool   the lesson's guard had refused
                                                       a call in this session before
                                                       (see Ineffective); the CLI
                                                       works this out from the
                                                       `guard` events and does not
                                                       read the field
                                    ms       int       milliseconds the judge took
                                    ineffective bool   this recurrence made or found
                                                       the lesson ineffective, and
                                                       the session can rewrite it
                                                       (never set for a lesson left
                                                       in another project)
        capture   mod               id*      string    a short stable hash; `log` fills
                                                       it in when it is absent
                                    tool     string
                                    failed*  string    the failing call
                                    error    string
                                    fixed*   string    the working call
        remind    mod               captures [string]  ids of the unsettled captures a
                                                       session was told about at its
                                                       first prompt
        learn     CLI `add`         lesson*  string
                                    level    string    project | user | general
                                    kind     string    lesson | skill
                                    path     string    the lesson's directory
                                    guard    bool      it has a match
                                    update   bool      --update rewrote it
                                    settles* string    --settles: the capture it settles
        skill     CLI `skill`       lesson*  string
                                    level    string    project | user
                                    path     string    the skill's directory
        rm        CLI `rm`          lesson*  string
                                    level    string    project | user
        skip      CLI `skip`        why*     string
                                    settles* string    --settles: the capture it settles
        refuse    mod               why*     string    debt | strengthen | nudge: why a
                                                       stop was refused
        judge     mod               moment   string    reuse | recall | fix: which of
                                                       the three questions was asked
                                    verdict  string    what the model answered. reuse:
                                                       named | nothing | not-substantial.
                                                       recall: named | none. fix:
                                                       fix | known | none. Any of
                                                       them: unanswered (no reply in
                                                       time) | unreadable
                                    ms       int       milliseconds the model call
                                                       took. THE one definition of
                                                       `ms` for a verdict: `recall`
                                                       and `capture` carry the same
                                                       number for theirs
                                    named    [string]  the lessons, skills or earlier
                                                       requests the answer named
                                    reason   string    for none, unanswered and
                                                       unreadable: why, a few words
                                    tool     string    recall, fix: the tool whose
                                                       call was judged
                                    prompt_id string   reuse: the digest of the prompt
        nudge     mod               calls    int       tool calls in the turn
        promote   CLI `promote`     lesson*  string
                                    from     string    level it left; for an automatic
                                                       move (--auto), the project root
                                                       it left
                                    to       string    user | general
                                    path     string    where it is now
                                    url      string    the pull request (general only)
                                    was      string    --as: the name it had
                                    auto     bool      --auto: the mod asked for it;
                                                       `project` is then the project
                                                       of the session that met it
                                    also*    [string]  project roots that keep a
                                                       committed, byte-identical copy
                                                       of the lesson
                                    merged   [string]  project roots whose untracked,
                                                       byte-identical copy was removed
        candidate CLI `promote`     lesson*  string    a lesson --auto left in place:
                                                       git tracks it, or another
                                                       project holds a different
                                                       lesson of its name
                                    from*    string    the project root that holds it
                                    seen_in* string    the project root it applied in
        error     mod, `check`      where*   string    hook or step that failed
                                    message* string
                                    lesson   string    `check` only: the guard that
                                                       did not finish in the budget

    A line that does not parse is skipped by every reader and counted by `status`.
    An append to a log whose last line has no newline starts on a new line.

    Counting. `counts` for a name is {reuse, guard, recall, learn}: the number of
    events of that type whose `lesson` equals the name or whose `lessons` list
    contains it. Both fields are read on all four types, so a recall that matched two
    lessons may carry `lessons`. Events are selected by type NAME. `compound log`
    refuses a type that is not in the table above; a line of another type already in
    the log is shown by `events` and counted nowhere.

    Settling. There is one definition, in `unsettled`, and `status`, `events
    --unsettled`, a bare `skip` and the mod's stop check all read it.
    A `capture` is a lesson owed. It is settled by a later `learn` or `skip` event
    that carries `settles` equal to its `id` (from any session, or from none), or that
    comes from the same (non-empty) session.
    A `recall` with `ineffective: true` is a strengthening its session owes for that
    lesson (one per session and lesson: the newest). It is settled by a later `learn`
    with `update: true` for the lesson, by a later `skip` from the same session, or by
    a later `rm`, `skill` or `promote` event for the lesson (its `lesson`, or the
    `was` of a move under a new name): a lesson that is gone or renamed is not owed a
    rewrite.
    `events --unsettled` lists both kinds for the last 14 days, and `status` lists the
    captures under Open. `compound skip --why T` run outside a session (no
    CLAUDE_CODE_SESSION_ID) settles the project's one unsettled capture; with several
    it exits 2 and lists their ids.

    The body of a lesson. `add` takes it from `--body TEXT`, from `--body-file PATH`,
    or from stdin. `--body -` reads stdin to its end. Without a body flag a plain
    `add` reads stdin but never waits for it longer than 2 seconds at a time: a stdin
    that neither speaks nor ends (an open socket) is exit 2. `add --update` without a
    body flag keeps the body and does not read stdin at all; text that is already
    waiting there is exit 2, so a body is never dropped in silence.

    Totals. `status` counts, one per event: `reuse` (reuses offered), `guard` (calls a
    guard stopped), `recall` (lessons recalled) and `learn` without `update` (lessons
    recorded), with the time of the oldest event. No duration of a failed call or of its
    fix is logged, so no time or tokens saved is ever reported.

    Words. Text output shows a person a word for each type (EVENT_WORDS: `capture` is
    "owed", `learn` is "recorded", ...) and how long ago an event was; `events` prints
    the type names themselves, and `--json` the stored values.

    Last fired. The types the mod writes are reuse, guard, recall, capture, remind,
    refuse, nudge, judge and error; `status` reports the age of the newest of them.

    Verdicts. A `judge` event is written for every question put to the model, whatever
    the answer, so the rate of each verdict and the model's latency can be read from
    the log. They are many and say nothing by themselves: `status` leaves them out of
    Recent, and they are counted for no lesson.

    Ineffective. A lesson is ineffective when at least COMPOUND_RECUR_LIMIT (default
    2) `recall` events naming it have a `ts` later than its SKILL.md's modification
    time. Rewriting the lesson (`compound add --update`) clears the flag. A `recall`
    that follows a `guard` event of the same lesson in the same (non-empty) session
    is not one of them: a guard refuses once per session and the call sent again
    runs, so a failure after the refusal is not the lesson failing to prevent it.
    `show --json` says so for the caller's session as `guarded_in_session`.

    One lesson in two places. Two lesson directories of one name whose trees are byte
    for byte the same are one lesson. A project copy identical to the user-level
    lesson of its name is not listed; `status` names it as "also committed in".

ENVIRONMENT
    COMPOUND_HOME        user level root and the event log (default <claude dir>/compound)
    COMPOUND_CLAUDE_DIR  the Claude Code directory (default ~/.claude)
    COMPOUND_PROJECT     the project root, overriding git
    COMPOUND_NOW         pins the clock: epoch seconds or an ISO 8601 time
    COMPOUND_CHECK_BUDGET_MS  wall-clock budget of one `check`, default 500
    COMPOUND_RECUR_LIMIT recurrences before a lesson is ineffective (default 2)
    COMPOUND_OFF         1 switches the mod off; `status` reports it
    COMPOUND_UPSTREAM    owner/repo `promote --to general` proposes to
    COMPOUND_SURFER      the history-surfer executable (default: `surfer` on PATH)
    COMPOUND_NO_SURFER   install does not fetch history-surfer
    COMPOUND_SURFER_URL  where install clones history-surfer from
    CLAUDE_CODE_SESSION_ID  set by Claude Code; stamps `session` on events written here
    NO_COLOR, TERM       text output is coloured only when stdout is a terminal, NO_COLOR is
                         unset or empty and TERM is not "dumb"; `--json` never is
    COLUMNS              the width text output is fitted to; else the terminal's; piped
                         with neither, lines are not fitted

    COMPOUND_RECUR_LIMIT and COMPOUND_OFF are shared with the mod, which reads them in
    a session where Claude Code has applied the `env` block of its settings. Run from
    a terminal the CLI has no such environment, so it resolves each of the two from
    the process environment first, then from `env` in <claude dir>/settings.json,
    then the default (see `setting`).

EXIT STATUS
    0 success; 2 usage or validation error (an unknown lesson name included);
    1 any other failure; 3 from `promote --to user --auto` alone, when the lesson is
    tracked by git in its repository and was left where it is. Errors go to stderr. No command ends in a traceback: an
    unexpected exception is one line, `compound: internal error: <type>: <message>`,
    and exit 1. `check` is the exception: it runs before every tool call, so on any
    internal failure it prints {"hits": [], "error": "..."} and exits 0, and a guard
    that does not finish inside the budget is named in "timed_out".
"""

import fcntl
import json
import os
import re
import sys
import time

SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,62}$")
LEVELS = ("project", "user", "general")
COUNT_TYPES = ("reuse", "guard", "recall", "learn")
# Every type the table in the docstring names; `compound log` takes no other.
EVENT_TYPES = ("reuse", "guard", "recall", "capture", "remind", "learn", "skill", "rm", "skip", "refuse",
               "nudge", "judge", "promote", "candidate", "error")
# The types the mod writes: the newest of them is when the mod last fired.
MOD_TYPES = ("reuse", "guard", "recall", "capture", "remind", "refuse", "nudge", "judge", "error")
# Written for every question put to the model: left out of `status`'s Recent.
VERDICT_TYPES = ("judge",)
# The tools a lesson's patterns are tested against when it names none.
MATCH_TOOLS = ("Bash",)
TOOL_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.-]{0,127}$")
UNSETTLED_DAYS = 14
# How long a plain `add` waits for stdin to speak, or to go on, before it gives up.
STDIN_WAIT = 2
OPEN_TEXT = 100
UPSTREAM_DEFAULT = "ContextLab/claude-skill-compounder"
SURFER_URL = "https://github.com/ContextLab/claude-history-surfer.git"
PLUGIN_ENV = "CLAUDE_CODE_PLUGIN_DIRS"
# The oldest Claude Code the mod runs on; `install` and `status` check `claude --version`.
CLAUDE_CODE_MIN = (2, 1, 288)
# The oldest release `update` moves to: tags before it hold no bin/compound. install.sh
# carries the same number as `min_release`.
RELEASE_MIN = (0, 4, 0)
