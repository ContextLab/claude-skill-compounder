#!/usr/bin/env bash
# skillrepeat: read and retire what hooks/repeat-gate.sh has learned about broken calls.
#
#   skillrepeat list    [--json] [--tool <name>] [--all]
#   skillrepeat show    <sig> [--json]        (every row, tombstoned ones included)
#   skillrepeat forget  <sig> [--why <reason>]
#   skillrepeat dismiss <sig> [--why <reason>]
#   skillrepeat stats   [--json]
#   skillrepeat --help
#
# The store is <state>/repeats/index.jsonl, written by hooks/repeat-gate.sh:
#   {"t":"fail",    ts, sig, ck, ec, tool, norm, cmd, err, session, tuid}
#   {"t":"recover", ts, sig, ck, tool, norm, cmd, session, tuid[, cross_tool:true]}
#   {"t":"forget",  ts, sig, session, why}
#   {"t":"dismiss", ts, sig, session, why, actor}  <- written only by `dismiss`, below
#
# `cross_tool` marks a recovery bound because a DIFFERENT tool's call shared content
# tokens with the failed one, rather than because the tool matched. It is present only
# when true, so every reader that does not care about it goes on ignoring it.
#
# IT NO LONGER MEANS "THE WEAKER KIND", and rows written before 2026-09-03 are the ones it
# separates. Until then a same-tool `Bash` recovery was bound on the tool name alone, which
# for a universal shell is no evidence at all -- 52 of the 231 such bindings on the live
# store that day shared not one content token with the failure they were filed under. Since
# then a same-tool binding for a SHELL wants the same shared tokens the cross-tool rule
# wants (REPEAT_SAME_TOOL_MIN_TOKENS in hooks/repeat-gate.sh), so the two kinds now rest on
# comparable evidence and the flag says which RULE bound the row rather than how much it is
# worth. What it still separates is the tool: a cross-tool row names a fix found somewhere
# other than where the failure was.
#
# A `dismiss` IS NOT A TOMBSTONE, and the difference is the whole reason there are two
# row types rather than one with a flag. `forget` says "these observations no longer
# count" and suppresses rows; `dismiss` says "this was looked at and needs no lesson"
# and suppresses nothing -- every count on every surface here is identical before and
# after one. What it changes is the LESSON column and the lesson gate in
# hooks/repeat-gate.sh, which stops refusing once a lesson exists or a PERSON dismissed it.
#
# WHO DISMISSED IT, AND WHY THIS CLI HAS TO SAY. Every `dismiss` row carries `actor`:
# `model` when this command ran inside a Claude Code session (`CLAUDECODE` is exported
# into every Bash tool call, and `CLAUDE_CODE_SESSION_ID` into every process a session
# starts), and `human` otherwise. `session` is that same `CLAUDE_CODE_SESSION_ID` when
# there is one and the literal `cli` when there is not, so a dismissal can be traced to
# the session that wrote it rather than to a placeholder every row shared.
#
# THE GATE HONOURS ONLY `human`, AND THE REASON IS MEASURED. On 2026-09-04 both of two
# fresh sessions that the lesson gate refused answered by running `skillrepeat dismiss
# <sig> --why "<a reason they invented>"` and carrying on: the refusal named its own
# escape and the escape was free. A model may still write the row -- it is appended, it is
# printed by `show`, and the LESSON column reports it as `dismissed-by-model` -- because
# it is evidence of what that session wanted to do. What it no longer does is lift
# anything. Rows written before the field existed carry no `actor` and are read as human;
# they predate the model path and there is nothing in them to tell apart.
#
# `norm` -- printed as `shape` by `show` and as CALL by `list` -- IS A NORMALISED SHAPE AND
# NOT A LITERAL COMMAND. hooks/repeat-gate.sh masks ordinary quoted arguments, the directory
# part of an absolute path and bare numbers before hashing, so ONE ROW CAN COVER MORE THAN
# ONE COMMAND that was actually run. `cmd` is the one field that is literal, which is why
# `show` prints it verbatim under each row and why that section is worth reading before
# acting on a `forget`. The masking rules, and the residual collisions they leave, are
# in that script's CALLKEY NORMALISATION and WHAT STILL COLLIDES stanzas and are
# deliberately not restated here: a rule written down twice is a rule that disagrees with
# itself, the same reason the cost figures are not restated either.
#
# WHY `forget` APPENDS AND NEVER REWRITES. The store is the only record of which calls are
# broken and what fixed them, and it is written by a hook nobody watches. A subcommand
# that rewrote the file could lose an hour of observations to one bad jq expression, and
# nothing would say so afterwards. So forgetting is a TOMBSTONE: a `forget` row suppresses
# rows for that signature recorded BEFORE its timestamp, and only those. Three consequences
# worth knowing:
#   * every reader here and in the gate applies the same cutoff, so what `list` shows is
#     what the gate would refuse on;
#   * forgetting is RE-ARMABLE. A signature that starts failing again afterwards
#     accumulates fresh sessions past the tombstone and can refuse again, which is correct:
#     "I know about this, stop telling me" is a statement about today, not forever;
#   * the original rows are still there. `skillrepeat show <sig>` prints every row for a
#     signature whatever any tombstone says, so a forget can be audited and, if it was
#     wrong, understood.
# This is the same stance `skillinsight decline` takes and for the same reason: declining
# is visible, disregarding is what leaves the record standing.
#
# WHY THERE IS NO `skillrepeat add`. Every row in this store is a thing that was OBSERVED
# to happen, by a hook, from a real payload. A hand-written row would be indistinguishable
# from an observed one afterwards and would make the whole store testimony rather than
# measurement -- the same distinction hooks/claim-gate.sh is built on. If a call should be
# refused and the gate has not learned it, the honest fix is to let it be observed.
#
# ENV:
#   SKILL_COMPOUNDER_STATE   state root ($HOME/.claude/skill-compounder).
#   REPEAT_MIN_SESSIONS (2)  the gate's refusal threshold, used here only to report which
#                            signatures are over it. Read from the same variable the gate
#                            reads so the two cannot disagree. The GATE column counts it
#                            the repeat arm's way (distinct sessions, this one excluded);
#                            the `show` sentence about the lesson arm states that arm's
#                            way (distinct sessions, this one counted once), which is why
#                            the two sentences below spell the same number differently.
#   REPEAT_GATE_REFUSE  (0)  the gate's refusal switch, read here ONLY to say on the
#                            output whether the arm this CLI reports on is even armed.
#                            The GATE column answers "would this signature refuse if the
#                            arm were on", which is the question worth reporting; whether
#                            it is on is a second fact and is printed as one.
#   SKILLREPEAT_GATE         path to hooks/repeat-gate.sh. Resolved from this script's own
#                            location by default, symlinks followed. The head exemptions
#                            are ASKED OF THAT SCRIPT (`--eligible-of`) and never
#                            reimplemented here -- see THE GATE COLUMN below.
#   SKILLREPEAT_NOW          this CLI's clock, epoch seconds, falling back to
#                            REPEAT_GATE_NOW. It writes the tombstone and dismissal
#                            timestamps, and a tombstone that lands before the rows it is
#                            meant to suppress suppresses nothing -- which is why tests
#                            need to pin it.
#
# THE LEDGER, <state>/ledger.jsonl, IS READ HERE AND NEVER WRITTEN. bin/skillnote owns
# it; `skillnote add --lesson <sig>` puts a `note` row carrying `lesson_sig` into it, and
# that is the one fact the LESSON column below cannot get from this store. An absent or
# unreadable ledger means no lesson has been recorded, which is what a fresh install
# genuinely has, so it is reported as `open` rather than as an error.
#
# EXIT CODES: 0 success. 1 environment (no jq). 2 usage. 3 the named signature has no rows.
set -uo pipefail

# ------------------------------------------------------------------------------------
# THE ENTIRE BODY OF THIS SCRIPT IS ONE BRACE GROUP, AND THE `}` AT THE END OF THE FILE IS
# WHAT CLOSES IT. bash reads a script LAZILY, by byte offset, and resumes at that offset in
# whatever the file holds AT THAT MOMENT. This file is symlinked into the user's bin
# directory and runs out of the checkout, so the same `git pull` that rewrites a hook
# rewrites this. A brace group is a single compound command, so the whole file must parse
# in ONE pass before any of it runs. The `exit` before the closing `}` is load-bearing
# too: a group protects its body and nothing past it, and a script that falls off its end
# can have bash resume past `}` and run the body a SECOND time. It is a BARE `exit` so the
# `case` this ends in keeps the exit codes documented above; `exit 0` would erase them.
# tests/test_script_wrapping.py enforces both halves; docs/DESIGN.md has the reproduction.
# ------------------------------------------------------------------------------------
{

# HOME can be unset (cron, a stripped env, a container). Under `set -u` reading it aborts
# the script non-zero before it has printed anything.
: "${HOME:=/tmp}"
ROOT="${SKILL_COMPOUNDER_STATE:-$HOME/.claude/skill-compounder}"
DIR="$ROOT/repeats"
STORE="$DIR/index.jsonl"
LEDGER="$ROOT/ledger.jsonl"

MIN_SESSIONS="${REPEAT_MIN_SESSIONS:-2}"
case "$MIN_SESSIONS" in ''|*[!0-9]*) MIN_SESSIONS=2 ;; esac
[ "$MIN_SESSIONS" -lt 1 ] && MIN_SESSIONS=1

command -v jq >/dev/null 2>&1 || { echo "skillrepeat: jq is required" >&2; exit 1; }

# THE GATE COLUMN. `refuses` used to mean "this signature has reached the session
# threshold", and the gate's answer is not that: before it looks at any count it exempts a
# Bash command whose HEAD is on either of two lists (`allowlisted_head`, `runner_head`) and
# any command reaching for this CLI, and it never refuses a non-Bash call at all. On the
# live store of 2026-09-02 that was the whole difference: ten signatures at the threshold,
# ten printed here as `refuses`, and NONE of them denied by the real hook (issue #27).
#
# So the head rules are ASKED OF THE GATE, through its `--eligible-of` door, rather than
# copied into this file. A second copy would drift from the first invisibly, and the
# symptom is a number nobody can act on -- which is exactly the defect being repaired.
# Same argument, same shape, as `--norm-of` in bin/skillnote and hooks/remind.sh.
#
# Resolved from this script's own path with symlinks followed, because both install paths
# put a LINK in the user's bin directory and `dirname "$0"` on the link points at that
# directory, not at the checkout. `SKILLREPEAT_GATE` overrides, the way `SKILLUSE_FORGE`
# does for hooks/skill-use.sh.
GATE="${SKILLREPEAT_GATE:-}"
if [ -z "$GATE" ]; then
  gate_self="$0"; gate_hops=0
  while [ -L "$gate_self" ] && [ "$gate_hops" -lt 32 ]; do
    gate_link="$(readlink "$gate_self" 2>/dev/null)" || break
    case "$gate_link" in
      /*) gate_self="$gate_link" ;;
      *)  gate_self="$(dirname "$gate_self")/$gate_link" ;;
    esac
    gate_hops=$(( gate_hops + 1 ))
  done
  GATE="$(cd "$(dirname "$gate_self")/.." 2>/dev/null && pwd)/hooks/repeat-gate.sh"
fi
GATE_OK=0
[ -n "$GATE" ] && [ -x "$GATE" ] && GATE_OK=1

# US (0x1f), not a tab, between the fields the loop below reads: tab is IFS whitespace, so
# `read` collapses runs of it and one empty field shifts every field after it. Same trap,
# same fix, as the gate's pending file and this file's own awk formatter.
US="$(printf '\037')"

usage() {
  sed -n '2,10p' "$0" | sed -e 's/^# \{0,1\}//'
  echo
  echo "State: $DIR"
}

# Portable epoch -> date. GNU first, then BSD, and the RESULT is validated rather than the
# exit status trusted: `stat -f` and `date -d` both exist on both platforms and mean
# different things, so a chain that trusts exit codes never reaches its second branch
# (docs/DESIGN.md, "Six failures that produce no error"). Falls back to the raw epoch,
# which is ugly and correct, rather than to a wrong date.
fmt_ts() {
  case "${1:-}" in ''|*[!0-9]*) printf '%s' "${1:-?}"; return 0 ;; esac
  d="$(date -d "@$1" '+%Y-%m-%d' 2>/dev/null)"
  case "$d" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) printf '%s' "$d"; return 0 ;;
  esac
  d="$(date -r "$1" '+%Y-%m-%d' 2>/dev/null)"
  case "$d" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) printf '%s' "$d"; return 0 ;;
  esac
  printf '%s' "$1"
}

# Every malformed or foreign line is dropped HERE, once. A file that is not ours landing
# in the state directory, or a row half-written by a killed hook, must not take out the
# whole CLI -- so `fromjson? // empty` swallows it and the rest of the store still reads.
rows() {
  [ -f "$STORE" ] && [ -r "$STORE" ] || return 0
  jq -Rc 'fromjson? // empty | select(type=="object")' "$STORE" 2>/dev/null
}

# The signatures a lesson has been written for: one pass over bin/skillnote's ledger.
# Malformed lines are swallowed the same way `rows` swallows them, for the same reason --
# a ledger this CLI does not own must not be able to take it out.
# AN `add` WHOSE NOTE WAS LATER REMOVED IS NOT A LESSON. `skillnote remove <id>` appends
# `{"event":"note","action":"remove","id":...}` and deletes nothing -- the same append-only
# discipline `forget` and `dismiss` follow here -- so matching on `lesson_sig` alone would
# print `recorded` for a lesson that no longer exists in any CLAUDE.md. Adds minus removed
# ids. `.action // "add"` because rows written before that field existed carry no action.
noted_sigs() {
  [ -f "$LEDGER" ] && [ -r "$LEDGER" ] || { printf '[]'; return 0; }
  jq -R -s -c '[ split("\n")[] | select(length > 0) | (fromjson? // empty)
                 | select(type=="object") | select(.event == "note") ] as $n
               | ([ $n[] | select((.action // "add") == "remove")
                    | (.id? // "") | select(. != "") ] | unique) as $gone
               # BIND THE ID BEFORE THE LOOKUP: `$gone | index(.id)` evaluates `.id`
               # against $gone, which is an array and has none, so jq errors and drops
               # the row. The symptom is a removal that never takes effect.
               | [ $n[] | select((.action // "add") == "add")
                   | ((.id? // "")) as $rid
                   | select(($gone | index($rid)) == null)
                   | (.lesson_sig? // "") | select(. != "") ] | unique' \
    "$LEDGER" 2>/dev/null || printf '[]'
}

# THE SUMMARY QUERY. It and the gate's must AGREE about what refuses, and they do: the same
# per-signature tombstone cutoff, the same distinct-session counts, the same plurality rule
# for naming a recovery (a tie names nothing -- announcing one of two equally-supported
# commands as "what worked" would be an invention), and the same self-recovery rule (a
# success that normalises to the failing call is proof the failure was transient, so it is
# never named as the fix and its signature never refuses).
#
# THAT SENTENCE WAS FALSE FOR A YEAR OF THE FILE'S LIFE, and it is worth saying how: the
# list above is everything the two queries share, and the gate ALSO exempts a call on its
# head before it consults any of it. This query has no way to compute that -- the head
# rules are the gate's -- so it did not, and the claim of agreement was made against the
# clauses that had been copied rather than against the gate. It is now asked, per
# signature that clears the session rule, through `--eligible-of`; and
# tests/test_repeat_gate.py drives the REAL hook over a copy of a real store and asserts
# the two counts are equal, so the word AGREE above is a measurement rather than a
# restatement. It is asked only of the signatures that clear the session rule, because
# those are the only ones whose answer it can change, and that keeps the cost one fork per
# candidate rather than one per row.
#
# THEY ARE NOT THE SAME QUERY, AND MUST NOT BE. The gate cuts to ONE callkey and drops the
# current session BEFORE it groups, so what it walks is a handful of rows however large the
# store; this CLI reports the whole store and has no such cut available. Written the gate's
# way -- select every `fail` row, then rescan the whole set once per distinct signature --
# it is O(signatures x rows), and at the gate's own byte cap with every signature distinct
# -- the first of the two stores described below, whose size this stanza deliberately does
# not restate -- `list` and `stats` were both still running after 120 s and had to be
# killed. Scaling measured 4x per doubling of the signature count. So this groups ONCE, by
# signature, and looks the tombstones and recoveries up in objects built in the same pass.
# Those two figures are the ONLY ones in this file that cannot be reproduced by running
# something today: they describe a query that no longer exists here. Read them as history,
# not as a measurement, and do not carry them anywhere else.
#
# WHAT IT COSTS NOW, printed on this machine 2026-09-03 by TEN runs of
#   PYTHONPATH=$PWD python3 tests/test_repeat_gate.py CliCostTest -v
# which builds the store and PRINTS the time on every run, so none of this can quietly stop
# being true. Observed min to max over those ten, not a mean:
#   15831 rows, every signature distinct, 4190377 B:  stats 1.27-1.31 s   list 2.05-2.08 s
#   16446 rows, one signature,            4190440 B:  stats 0.68-0.71 s
#
# THEY ARE HIGHER THAN THE 2026-08-26 FIGURES THEY REPLACE -- stats 0.50-0.53, list
# 1.15-1.25, stats-one-signature 0.34-0.36 -- AND MOST OF THAT IS NOT THIS CODE. Four other
# agents were building in this same checkout while they were taken, which is the kind of
# thing a range cannot say about itself. So the two causes were separated by a CONTROL that
# was RUN rather than argued: `git show HEAD:bin/skillrepeat` and this file, ten interleaved
# rounds each against the identical two stores, SKILLREPEAT_GATE pinned to the same hook so
# only the CLI differed. Min to max:
#   list  distinct: old 1.68-1.74 s   new 1.98-2.03 s
#   stats distinct: old 1.12-1.15 s   new 1.22-1.26 s
#   stats one sig:  old 0.65-0.67 s   new 0.65-0.69 s
# The LESSON work costs roughly 18%, 10% and nothing of those three -- one more grouping
# pass over the rows for the dismissals, and one pass over the ledger, neither of which the
# one-signature store gives any work to do. The machine accounts for the rest. NEITHER HALF
# COULD BE READ OFF THE ABSOLUTE FIGURES, which is why the control is the part of this
# stanza worth repeating; the ranges above are what today's machine printed and will move
# again the next time it is busy.
# TEN RUNS AND NOT FIVE, AND RE-RUN WHENEVER THE CODE UNDER THEM CHANGES. A range from too
# few runs is narrower than the thing it describes and reads as a precision the data does
# not carry; a range measured on code this is no longer the code of is not a measurement of
# it at all. These are the ranges the shipped formatter printed -- the earlier ones were of
# the fixed-width one, and `list` moved. They are wall times on a laptop doing other work,
# noise-dominated at this width; what actually holds is the assertion, CliCostTest.LIMIT.
#
# THE GATE'S OWN FIGURE ON THE IDENTICAL STORES IS NOT RESTATED HERE. It is in the
# REPEAT_GATE_MAX_BYTES stanza of hooks/repeat-gate.sh, which is where to read it. This file
# carried its own copy until the two disagreed: a bare `0.31 s` here against `0.32-0.47 s`
# there, neither naming the run it came from, and independent timings matching neither.
# A measurement written down in two places is a measurement that disagrees with itself.
#
# `list` IS LOCALE-SENSITIVE AND `stats` IS NOT, so the figures above need their environment
# named. That harness pins a minimal environment with no locale variables, so what it prints
# is the C-LOCALE figure -- and the stanza above is the ONE place `list`'s wall time is
# written down. This stanza carried a second copy of it, measured its own way, and the two
# ranges did not contain each other. That is what a figure restated in a second place does,
# so the copy is deleted rather than re-measured; what stays here is the COMPARISON, which
# the stanza above cannot make. Twenty runs of each of
#   /usr/bin/time -p env -i PATH=<minimal> HOME=<tmp> SKILL_COMPOUNDER_STATE=<store> \
#     LC_ALL=$L bash bin/skillrepeat list >/dev/null
# with L=C and L=en_US.UTF-8, on that same store, two rounds of ten each so the two locales
# were interleaved rather than measured an hour apart -- and re-run against the SHIPPED
# formatter, not the fixed-width one: UTF-8 costs `list` ROUGHLY A THIRD AGAIN for the same
# work. `stats` over the same command, five runs each, moved by a hundredth of a second.
# That is the whole comparison: no absolute time is quoted here, because the stanza above
# is where `list`'s wall time lives. What `list` has and `stats` has not is the awk
# formatting stage, and multibyte-aware padding is not free. Quote a figure here WITH its
# locale, or not at all. It is also why the C-locale figure above is the LOW one: a user's
# own shell will usually be running this in a UTF-8 locale, and will see the higher number.
#
# One deliberate difference from the shape this replaced: where a signature is fully
# tombstoned, the fallback for `tool` and `call` is the last fail row OF THAT SIGNATURE. It
# used to be the last fail row of the whole store, which reported another signature's
# command against this one.
SUMMARY_JQ='
  . as $rows
  | ([ $rows[] | select(.t=="forget" and (.sig|type=="string")) ]
     | group_by(.sig)
     | map({key: .[0].sig, value: (map(.ts // 0) | max)})
     | from_entries) as $tomb
  | ([ $rows[] | select(.t=="recover" and (.sig|type=="string")) ]
     | group_by(.sig)
     | map({key: .[0].sig, value: .})
     | from_entries) as $recs
  # NOT cut by a tombstone, and the header says why: forgetting the observations does
  # not un-make the decision that they needed no lesson.
  #
  # SPLIT BY ACTOR, because the gate is. A row with no `actor` predates the field and is
  # read as human, which is the identical `(.actor // "human")` the gate applies -- the
  # two must agree or this column reports a refusal that is still happening as lifted.
  | ([ $rows[] | select(.t=="dismiss" and (.sig|type=="string"))
                | select((.actor // "human") == "human") | .sig ]
     | unique) as $dism
  | ([ $rows[] | select(.t=="dismiss" and (.sig|type=="string"))
                | select((.actor // "human") != "human") | .sig ]
     | unique) as $dism_model
  | [ [ $rows[] | select(.t=="fail" and (.sig|type=="string")) ]
      | group_by(.sig)[]
      | . as $fs
      | ($fs[0].sig) as $s
      | (($tomb[$s]) // -1) as $cut
      | [ $fs[] | select((.ts // 0) > $cut) ] as $rr
      | [ (($recs[$s]) // [])[] | select((.ts // 0) > $cut) ] as $rec
      | (($rr[-1].norm // $fs[-1].norm) // "") as $fn
      | [ $rec[] | select((.norm // "") == $fn) ] as $self
      | ([ [ $rec[] | select((.norm // "") != $fn) ] | group_by(.norm)[]
           | {cmd: (.[-1].cmd // .[-1].norm // ""), c: (map(.session) | unique | length)} ]
         | sort_by(-.c)) as $g
      | { sig: $s,
          tool: (($rr[-1].tool // $fs[-1].tool) // "?"),
          sessions: ($rr | map(.session) | unique | length),
          failures: ($rr | length),
          suppressed: ([ $fs[] | select((.ts // 0) <= $cut) ] | length),
          forgotten: ($cut >= 0),
          first: (($rr | map(.ts // 0) | min) // 0),
          last: (($rr | map(.ts // 0) | max) // 0),
          call: (($rr[-1].norm // $fs[-1].norm) // ""),
          # THE LITERAL command of the last surviving fail row, for `--eligible-of` to
          # judge a head on. `call` above is the masked SHAPE and cannot be used for it:
          # `<P>/run_tests.sh` and `./run_tests.sh` are one shape and the gate sees the
          # second. Falls back to the shape when a foreign row carries no `cmd` at all.
          raw: (($rr[-1].cmd // $fs[-1].cmd // $rr[-1].norm // $fs[-1].norm) // ""),
          error: (($rr[-1].ec // $rr[-1].err) // ""),
          recovery: (if ($g|length) == 0 then ""
                     elif ($g|length) == 1 then $g[0].cmd
                     elif $g[0].c > $g[1].c then $g[0].cmd
                     else "" end),
          recovery_sessions: (if ($g|length) == 0 then 0 else $g[0].c end),
          recovery_tied: (($g|length) > 1 and $g[0].c == $g[1].c),
          transient_sessions: ($self | map(.session) | unique | length),
          candidates: ($g | length),
          # A recovery of ANY kind was observed, self-recoveries included: that is what
          # makes a lesson owed at all. `candidates` cannot answer it -- it counts only
          # the recoveries that could be NAMED as the fix, so a signature whose every
          # recovery was a self-recovery has candidates 0 and is still a fail-then-fix.
          recovered: (($rec | length) > 0),
          cross_tool: ([ $rec[] | select(.cross_tool == true) ] | length),
          lesson_dismissed: (($dism | index($s)) != null),
          # A dismissal the gate does NOT honour. Reported separately rather than folded
          # into the line above, because "a decision was recorded" and "the refusal is
          # over" stopped being the same fact on 2026-09-04.
          lesson_dismissed_by_model: (($dism | index($s)) == null
                                      and ($dism_model | index($s)) != null) }
    ]
  | sort_by(-.sessions, .sig)
'

# The one place the refusal rule is spelled out for this CLI, so `list` and `stats` cannot
# drift apart from each other or from the gate. `$elig` is built by elig_map below and
# holds an entry for EVERY signature that clears the session rule, so `// false` here can
# only ever be reached by a signature that has already failed the first two clauses.
REFUSES_JQ='(.sessions >= $min and .transient_sessions == 0 and (($elig[.sig] // false) == true))'

summary() { rows | jq -s -c "$SUMMARY_JQ" 2>/dev/null; }

# {"<sig>": true|false} for the signatures that clear the session rule -- the only ones a
# head exemption can change the answer for. One `--eligible-of` fork per candidate, and
# candidates are what a store has a handful of: the cost stores in
# tests/test_repeat_gate.py::CliCostTest produce one and none respectively.
#
# WHEN THE GATE SCRIPT CANNOT BE FOUND every candidate is marked true and GATE_OK stays 0,
# which is the OLD behaviour, printed under a line that says the exemptions could not be
# applied. Silently reporting a different number because a path did not resolve is how an
# instrument starts lying; saying so is not.
# A NEWLINE BECOMES `;` AND NOT A SPACE, and that is a correctness fix rather than
# cosmetics. The record below is one line per candidate, so a raw command's newlines have
# to go before it is written -- but the gate's head rules now judge EVERY segment of a
# command, and a newline separates two commands exactly as a `;` does. Folded to a space,
# `cd build<newline>tar -xf x` reached the door as one command whose only head was `cd`
# and came back `exempt-allowlist`, while the real hook, reading the payload's own
# newlines, calls it eligible. `;` is the byte the gate folds a newline to itself, so the
# door sees the segmentation the hook sees. Tabs and carriage returns stay spaces: neither
# separates a command.
elig_map() {   # summary JSON on stdin -> the object on stdout
  em_lines="$(jq -r --argjson min "$MIN_SESSIONS" '
      .[] | select(.sessions >= $min and .transient_sessions == 0)
      | "\(.sig)\u001f\(.tool)\u001f\((.raw // "")
          | gsub("\\n"; ";") | gsub("[\\t\\r]"; " "))"' \
    2>/dev/null)"
  em_pairs=""
  if [ -n "$em_lines" ]; then
    while IFS="$US" read -r em_sig em_tool em_cmd; do
      [ -z "${em_sig:-}" ] && continue
      em_b=true
      if [ "$GATE_OK" = "1" ]; then
        # `REPEAT_GATE_DEBUG_DUMP=` blanked for the child: that variable makes the gate
        # APPEND its stdin to a file, and reading the store must not write to one.
        em_v="$(printf '%s' "${em_cmd:-}" \
          | REPEAT_GATE_DEBUG_DUMP="" "$GATE" --eligible-of "${em_tool:-Bash}" 2>/dev/null)"
        case "$em_v" in eligible) em_b=true ;; *) em_b=false ;; esac
      fi
      em_pairs="$em_pairs$em_sig$US$em_b
"
    done <<EOF
$em_lines
EOF
  fi
  printf '%s' "$em_pairs" | jq -R -s --arg us "$US" '
      [ split("\n")[] | select(length > 0) | split($us)
        | {key: .[0], value: (.[1] == "true")} ] | from_entries' 2>/dev/null \
    || printf '{}'
}

# ------------------------------------------------------------------------- list
cmd_list() {
  json=0; want_tool=""; show_all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --all) show_all=1 ;;
      --tool) shift; want_tool="${1:-}" ;;
      --tool=*) want_tool="${1#--tool=}" ;;
      *) echo "skillrepeat list: unknown argument $1" >&2; return 2 ;;
    esac
    shift
  done
  s="$(summary)"
  [ -z "$s" ] && s='[]'
  s="$(printf '%s' "$s" | jq -c --arg t "$want_tool" --argjson all "$show_all" '
        map(select($t == "" or .tool == $t))
        | map(select($all == 1 or .sessions > 0))' 2>/dev/null)"
  elig="$(printf '%s' "$s" | elig_map)"
  [ -z "$elig" ] && elig='{}'
  noted="$(noted_sigs)"
  [ -z "$noted" ] && noted='[]'
  # THE RULE IS APPLIED ONCE, HERE, and both consumers below read the field it writes.
  # Interpolating `$REFUSES_JQ` straight into the table's `if` chain worked and cost the
  # GATE column its DERIVATION: the alignment test reads the alternatives out of that
  # chain to find the widest value the column can print, and a shell-interpolated
  # expression reads as one of them. A column whose widest value can no longer be derived
  # is the fixed-width overflow waiting to happen a third time.
  s="$(printf '%s' "$s" | jq -c --argjson min "$MIN_SESSIONS" --argjson elig "$elig" \
        --argjson noted "$noted" \
        'map(. + {refuses: '"$REFUSES_JQ"',
                  lesson_recorded: (.sig as $ls
                                     | ($noted | index($ls)) != null)})' 2>/dev/null)"
  [ -z "$s" ] && s='[]'
  if [ "$json" = "1" ]; then
    printf '%s\n' "$s" | jq '.'
    return 0
  fi
  n="$(printf '%s' "$s" | jq -r 'length' 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -eq 0 ]; then
    echo "No repeated failures recorded. ($STORE)"
    return 0
  fi
  # NO COLUMN WIDTH IS WRITTEN DOWN HERE. Every padded column is widened to the widest
  # value it actually holds, the header is printed with those same widths in the same
  # pass, and so the header cannot stop being the ruler.
  #
  # It was written down twice and was wrong twice, for one reason: a width pinned by hand
  # is a fact about a producer, kept away from the producer, where nothing re-reads it.
  # GATE was `%-8s` against a nine-character `transient`. SIGNATURE was `%-30s` against
  # the thirty-one-character signatures hooks/repeat-gate.sh writes from ordinary input --
  # `c<crc32>x<bytes>-e<crc32>x<bytes>`, from its hashof(), whose byte counts reach three
  # digits well inside the normaliser's own caps. Three of the five producers are not
  # bounded even in principle: SIGNATURE and TOOL are read off a store any writer may
  # append to, and SESS counts distinct sessions. So there is no number to pin, and the
  # two columns that ARE closed sets are not pinned either -- one rule for the table is
  # what stops a third instance of this.
  #
  # awk does the MEASURING and the PADDING, both in its own `length()`, so the two agree
  # whatever the locale. jq's `length` counts codepoints and printf pads by bytes in the C
  # locale; measuring in one and padding in the other would put the bug straight back on
  # any non-ASCII value.
  # tests/test_repeat_gate.py::CliTest::test_no_column_can_overflow_its_header derives the
  # widest value each producer can emit and asserts CALL still begins where the header
  # says -- deriving it, rather than pinning it a third time.
  # THE COLUMNS ARE LAID OUT BY awk, NOT BY A `while IFS=$'\t' read` LOOP, AND THE REASON
  # IS CORRECTNESS. Tab is IFS WHITESPACE, so `read` COLLAPSES RUNS OF IT: one empty field
  # silently shifts every field after it left by a column. That is the identical trap that
  # made the pending file in hooks/repeat-gate.sh use US (0x1f) instead of tab. Measured on
  # a foreign row carrying an empty `tool` -- a row this CLI promises to survive, and one
  # the gate itself can never write -- the loop printed the RECOVERY value under TOOL and
  # started CALL left of the column its own header puts it in; awk -F'\t' did not.
  # tests/test_repeat_gate.py::CliTest::test_an_empty_column_does_not_shift_the_ones_after_it
  # is that row, and it FAILS with the loop restored. Verified by restoring it, not assumed.
  #
  # SPEED IS NOT WHY awk IS HERE, and this comment no longer quotes any. It used to carry
  # six timings for a `read` loop that no longer exists in this file -- four of them
  # sub-ranges that later re-measurement fell outside of, which is what a figure nothing
  # re-runs does. The loop is slower, by well under the 10 s bound CliCostTest asserts,
  # which is exactly why restoring it left the suite green and left this change uncovered
  # until the alignment test above was written. The argument above is a CORRECTNESS one
  # and needs no timings at all. If speed ever becomes the reason, measure it then.
  #
  # Fields arrive @tsv-escaped, so a tab or newline inside a command is `\t` / `\n` and
  # cannot break the field split.
  printf '%s' "$s" | jq -r --argjson min "$MIN_SESSIONS" '.[]
    | [ .sig, (.sessions|tostring), .tool,
        (if .recovery != "" then "agreed" elif .recovery_tied then "disputed"
         elif .candidates > 0 then "unclear" else "none" end),
        # `exempt` is a fourth value and not a variant of `-`: the difference between "not
        # enough sessions yet" and "enough sessions and the gate will still never refuse
        # it" is the whole finding of issue #27, and collapsing the two would hide it again.
        (if .transient_sessions > 0 then "transient"
         elif .refuses then "refuses"
         elif .sessions >= $min then "exempt" else "-" end),
        # LESSON, and `-` here means SOMETHING DIFFERENT from `open`: nothing has been
        # written down about either, but `-` is a signature no session has ever recovered
        # from, so there is no fix to write down and nothing is owed. `open` is a
        # fail-then-fix with the fix nowhere but this store.
        (if .lesson_dismissed then "dismissed"
         elif .lesson_recorded then "recorded"
         # AFTER `recorded`, not before it: a lesson lifts the gate and a dismissal
         # written by a model does not, so a signature carrying both is `recorded`.
         elif .lesson_dismissed_by_model then "dismissed-by-model"
         elif .recovered then "open" else "-" end),
        (.call | .[0:60]) ]
    | @tsv' 2>/dev/null \
  | awk -F'\t' '
      { n++; a[n] = $0
        for (i = 1; i <= 6; i++) if (length($i) > w[i]) w[i] = length($i) }
      END {
        h[1] = "SIGNATURE"; h[2] = "SESS"; h[3] = "TOOL"; h[4] = "RECOVERY"; h[5] = "GATE"
        h[6] = "LESSON"
        for (i = 1; i <= 6; i++) if (length(h[i]) > w[i]) w[i] = length(h[i])
        f = "%-" w[1] "s %" w[2] "s %-" w[3] "s %-" w[4] "s %-" w[5] "s %-" w[6] "s %s\n"
        printf f, h[1], h[2], h[3], h[4], h[5], h[6], "CALL"
        for (j = 1; j <= n; j++) {
          split(a[j], c, "\t")
          printf f, c[1], c[2], c[3], c[4], c[5], c[6], c[7]
        }
      }'
  echo
  echo "GATE refuses = denied once per session, from >= $MIN_SESSIONS distinct sessions,"
  echo "                 with a head the gate does not exempt."
  echo "     exempt    = at that count, and the gate still never refuses it: the command's"
  echo "                 head is on one of its two allowlists, or it reaches for this CLI,"
  echo "                 or the tool is not Bash. Asked of the gate itself, not decided"
  echo "                 here (\`hooks/repeat-gate.sh --eligible-of\`)."
  echo "     transient = an earlier session re-ran the identical call and it worked, so"
  echo "                 the gate never refuses this one, whatever the count."
  echo "LESSON open      = a session failed this way and then got it working, and nothing"
  echo "                   outside this store says what was learned. That is what the"
  echo "                   lesson arm of hooks/repeat-gate.sh declines a call over."
  echo "       recorded  = a note carries this signature (\`skillnote add --lesson <sig>\`)."
  echo "       dismissed = a PERSON ran \`skillrepeat dismiss <sig>\`: it needs none."
  echo "       dismissed-by-model = the dismissal was written from inside a Claude Code"
  echo "                   session (actor=model). It is on the record and it lifts NOTHING:"
  echo "                   the lesson gate goes on declining calls over this signature."
  echo "       -         = no recovery was ever observed, so there is no fix to write down."
  echo "       Lessons are read from $LEDGER"
  if [ "$GATE_OK" != "1" ]; then
    echo "     NOTE: $GATE is not executable, so the head exemptions could NOT be"
    echo "           applied. Every GATE value above is an upper bound."
  elif [ "${REPEAT_GATE_REFUSE:-0}" != "1" ]; then
    echo "     NOTE: the gate's refusal arm is OFF (REPEAT_GATE_REFUSE is not 1), so"
    echo "           nothing is being refused today whatever this column says. It reports"
    echo "           what would be refused with the arm switched on."
  fi
  echo 'CALL is the normalised SHAPE the gate matches on, not a literal command: quoted'
  echo '     arguments, the directory part of an absolute path and bare numbers are masked'
  echo '     out first, so one row can cover more than one command that really ran.'
  echo "     \`skillrepeat show <sig>\` prints those commands verbatim."
  return 0
}

# ------------------------------------------------------------------------- show
cmd_show() {
  json=0; sig=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      -*) echo "skillrepeat show: unknown argument $1" >&2; return 2 ;;
      *) [ -n "$sig" ] && { echo "skillrepeat show: one signature at a time" >&2; return 2; }
         sig="$1" ;;
    esac
    shift
  done
  [ -z "$sig" ] && { echo "usage: skillrepeat show <sig> [--json]" >&2; return 2; }

  all="$(rows | jq -s -c --arg s "$sig" 'map(select(.sig == $s))' 2>/dev/null)"
  [ -z "$all" ] && all='[]'
  cnt="$(printf '%s' "$all" | jq -r 'length' 2>/dev/null)"
  case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac
  if [ "$cnt" -eq 0 ]; then
    echo "skillrepeat: no rows for signature '$sig'" >&2
    return 3
  fi
  if [ "$json" = "1" ]; then
    printf '%s' "$all" | jq '.'
    return 0
  fi

  one="$(summary | jq -c --arg s "$sig" '.[] | select(.sig == $s)' 2>/dev/null)"
  echo "signature: $sig"
  if [ -n "$one" ]; then
    printf '%s' "$one" | jq -r '"tool:      " + .tool,
      "sessions:  " + (.sessions|tostring) + " distinct" +
        (if .suppressed > 0 then " (" + (.suppressed|tostring) + " rows suppressed by a forget)" else "" end),
      "shape:     " + .call,
      "error:     " + .error' 2>/dev/null
    fts="$(printf '%s' "$one" | jq -r '.first' 2>/dev/null)"
    lts="$(printf '%s' "$one" | jq -r '.last' 2>/dev/null)"
    echo "seen:      $(fmt_ts "$fts") .. $(fmt_ts "$lts")"
    rec="$(printf '%s' "$one" | jq -r '.recovery' 2>/dev/null)"
    tr_n="$(printf '%s' "$one" | jq -r '.transient_sessions' 2>/dev/null)"
    case "$tr_n" in ''|*[!0-9]*) tr_n=0 ;; esac
    if [ -n "$rec" ]; then
      echo "recovery:  $rec"
    elif [ "$(printf '%s' "$one" | jq -r '.recovery_tied' 2>/dev/null)" = "true" ]; then
      echo "recovery:  disputed -- sessions recorded different commands, none agreed"
    else
      echo "recovery:  none recorded"
    fi
    xn="$(printf '%s' "$one" | jq -r '.cross_tool' 2>/dev/null)"
    case "$xn" in ''|*[!0-9]*) xn=0 ;; esac
    if [ "$xn" -gt 0 ]; then
      echo "cross-tool: $xn of the recoveries were bound because a DIFFERENT tool's call"
      echo "           shared content tokens with the failed one, not because the tool"
      echo "           matched. The fix was found somewhere other than where the failure"
      echo "           was; for a shell both rules now want shared tokens."
    fi
    if [ "$(printf '%s' "$one" | jq -r '.lesson_dismissed' 2>/dev/null)" = "true" ]; then
      echo "lesson:    dismissed by a person -- see the dismiss row below for the reason."
    elif printf '%s' "$(noted_sigs)" \
         | jq -e --arg s "$sig" 'index($s) != null' >/dev/null 2>&1; then
      echo "lesson:    recorded in $LEDGER"
    elif [ "$(printf '%s' "$one" | jq -r '.lesson_dismissed_by_model' 2>/dev/null)" = "true" ]
    then
      echo "lesson:    dismissed from inside a session (actor=model), which lifts nothing."
      echo "           hooks/repeat-gate.sh goes on declining a call over this until a"
      echo "           lesson is written (\`skillnote add --lesson $sig\`)."
    elif [ "$(printf '%s' "$one" | jq -r '.recovered' 2>/dev/null)" = "true" ]; then
      echo "lesson:    none written. hooks/repeat-gate.sh declines a call over this once"
      echo "           the fail rows come from >= $MIN_SESSIONS distinct sessions counting"
      echo "           the one that recovered it -- at the default, this session plus one"
      echo "           earlier: the second occurrence."
    fi
    # A self-recovery is why the gate is silent about a signature that otherwise looks
    # well over the threshold, so `show` has to say it or the count reads as a bug.
    if [ "$tr_n" -gt 0 ]; then
      echo "transient: $tr_n session(s) re-ran this identical call and it worked, so the"
      echo "           gate does not refuse it -- see hooks/repeat-gate.sh, A SUCCESS OF"
      echo "           THE SAME CALL IS NOT A RECOVERY."
    fi
  fi
  echo
  echo "rows, oldest first (verbatim):"
  printf '%s' "$all" | jq -r 'sort_by(.ts)[]
    | "  [" + (.ts|tostring) + "] " + .t + "  session=" + (.session // "?")
      # ACTOR IS PRINTED ONLY WHERE IT DECIDES SOMETHING. A `dismiss` written from inside
      # a session lifts nothing, and a row that did not say so read exactly like one that
      # did. Absent means the row predates the field, which is read as human everywhere.
      + (if .t == "dismiss" then "  actor=" + (.actor // "human") else "" end)
      + (if .t == "fail" then
           "\n      call:  " + (.cmd // "")
           + "\n      error: " + ((.err // "") | gsub("\n"; "\n             "))
         elif .t == "recover" then
           "\n      ran:   " + (.cmd // "")
           + (if .cross_tool == true then "  (bound cross-tool, on shared tokens)"
              else "" end)
         else
           # `forget` and `dismiss` both land here and both carry a `why`. The `t` of
           # each row is printed on the line above, which is what tells the two apart.
           #
           # EMPTY AND ABSENT ARE THE SAME FACT HERE, and `//` alone does not say so:
           # it falls back on null and false and NOT on "", and `--why` is optional on
           # both subcommands, so the commonest row with no reason printed a bare label
           # and the placeholder branch could only ever be reached by a foreign row.
           "\n      why:   "
           + (if ((.why // "") | tostring) == "" then "(no reason given)"
              else .why end)
         end)' 2>/dev/null
  return 0
}

# ----------------------------------------------------------------------- forget
cmd_forget() {
  sig=""; why=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --why) shift; why="${1:-}" ;;
      --why=*) why="${1#--why=}" ;;
      -*) echo "skillrepeat forget: unknown argument $1" >&2; return 2 ;;
      *) [ -n "$sig" ] && { echo "skillrepeat forget: one signature at a time" >&2; return 2; }
         sig="$1" ;;
    esac
    shift
  done
  [ -z "$sig" ] && { echo "usage: skillrepeat forget <sig> [--why <reason>]" >&2; return 2; }

  cnt="$(rows | jq -s -r --arg s "$sig" 'map(select(.sig == $s)) | length' 2>/dev/null)"
  case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac
  # Refusing an unknown signature is the point: a mistyped signature that silently
  # appended a tombstone matching nothing would look exactly like a successful forget, and
  # the gate would go on refusing the call the user thought they had just cleared.
  if [ "$cnt" -eq 0 ]; then
    echo "skillrepeat: no rows for signature '$sig' -- nothing to forget" >&2
    return 3
  fi

  now="${SKILLREPEAT_NOW:-${REPEAT_GATE_NOW:-}}"
  case "$now" in ''|*[!0-9]*) now="$(date +%s 2>/dev/null)" ;; esac
  case "$now" in ''|*[!0-9]*) echo "skillrepeat: no usable clock" >&2; return 1 ;; esac

  mkdir -p "$DIR" 2>/dev/null || { echo "skillrepeat: cannot write $DIR" >&2; return 1; }
  row="$(jq -nc --arg ts "$now" --arg sig "$sig" --arg why "$why" \
    '{t:"forget", ts:($ts|tonumber), sig:$sig, session:"cli", why:$why}' 2>/dev/null)"
  [ -z "$row" ] && { echo "skillrepeat: could not build the tombstone" >&2; return 1; }
  printf '%s\n' "$row" >> "$STORE" 2>/dev/null || {
    echo "skillrepeat: cannot append to $STORE" >&2; return 1; }
  echo "forgot $sig -- its $cnt recorded row(s) no longer count, as of $(fmt_ts "$now")."
  echo "Nothing was deleted; \`skillrepeat show $sig\` still prints all of them."
  return 0
}

# ---------------------------------------------------------------------- dismiss
# THE OTHER HALF OF THE LESSON GATE, and the reason it is a row and not a deletion is the
# reason `forget` is one: this store is the only record of which calls are broken, it is
# written by a hook nobody watches, and a decision that leaves no trace is
# indistinguishable afterwards from a decision nobody made.
#
# IT IS NOT `forget`, AND CONFLATING THEM WOULD BE THE EASY MISTAKE. `forget` suppresses
# the observations -- every count drops, and the gate stops refusing the CALL. `dismiss`
# suppresses nothing: the call is as broken as it was, the counts are unchanged, and what
# ends is only the demand that the fix be written down. A session that dismisses when it
# meant to forget still gets the repeat refusal, which is the safe direction.
#
# AND WHO RAN IT IS RECORDED. See WHO DISMISSED IT in the header: `actor` is `model` when
# this runs inside a Claude Code session and `human` otherwise, the lesson gate honours
# only the second, and the row is written either way. The environment is read and nothing
# is asked, because a flag would be answered by whoever ran the command.
cmd_dismiss() {
  sig=""; why=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --why) shift; why="${1:-}" ;;
      --why=*) why="${1#--why=}" ;;
      -*) echo "skillrepeat dismiss: unknown argument $1" >&2; return 2 ;;
      *) [ -n "$sig" ] && { echo "skillrepeat dismiss: one signature at a time" >&2; return 2; }
         sig="$1" ;;
    esac
    shift
  done
  [ -z "$sig" ] && { echo "usage: skillrepeat dismiss <sig> [--why <reason>]" >&2; return 2; }

  cnt="$(rows | jq -s -r --arg s "$sig" 'map(select(.sig == $s)) | length' 2>/dev/null)"
  case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac
  # Same refusal as `forget`, same reason: a mistyped signature that silently appended a
  # row matching nothing would look exactly like a successful dismissal, and the gate
  # would go on declining calls over a signature the user believes they have cleared.
  if [ "$cnt" -eq 0 ]; then
    echo "skillrepeat: no rows for signature '$sig' -- nothing to dismiss" >&2
    return 3
  fi

  now="${SKILLREPEAT_NOW:-${REPEAT_GATE_NOW:-}}"
  case "$now" in ''|*[!0-9]*) now="$(date +%s 2>/dev/null)" ;; esac
  case "$now" in ''|*[!0-9]*) echo "skillrepeat: no usable clock" >&2; return 1 ;; esac

  # EITHER VARIABLE IS ENOUGH, AND THEY ARE SET BY DIFFERENT THINGS. Claude Code exports
  # `CLAUDECODE` into every Bash tool call and `CLAUDE_CODE_SESSION_ID` into the processes
  # a session starts, so a shell script a session launched still reads as `model` through
  # the second even where the first did not survive. Neither is ours to set.
  actor="human"
  if [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then actor="model"; fi
  # THE REAL SESSION ID, when there is one. `cli` was hardcoded, so every row said `cli`
  # and nothing recorded that a session had made the decision -- which is exactly the
  # column that was missing when this was measured.
  dsession="${CLAUDE_CODE_SESSION_ID:-cli}"

  mkdir -p "$DIR" 2>/dev/null || { echo "skillrepeat: cannot write $DIR" >&2; return 1; }
  row="$(jq -nc --arg ts "$now" --arg sig "$sig" --arg why "$why" \
    --arg session "$dsession" --arg actor "$actor" \
    '{t:"dismiss", ts:($ts|tonumber), sig:$sig, session:$session, why:$why,
      actor:$actor}' 2>/dev/null)"
  [ -z "$row" ] && { echo "skillrepeat: could not build the dismissal" >&2; return 1; }
  printf '%s\n' "$row" >> "$STORE" 2>/dev/null || {
    echo "skillrepeat: cannot append to $STORE" >&2; return 1; }
  if [ "$actor" = "human" ]; then
    echo "dismissed $sig as of $(fmt_ts "$now") -- no lesson is owed for it."
  else
    echo "recorded a dismissal of $sig as of $(fmt_ts "$now"), actor=model."
    echo "IT LIFTS NOTHING. The lesson gate honours a dismissal only from a person at a"
    echo "terminal; from inside a session the row is a record of the decision and the gate"
    echo "goes on declining the call. \`skillnote add --lesson $sig \"<what was learned>\"\`"
    echo "is what ends it."
  fi
  echo "Nothing was suppressed: its $cnt row(s) still count, and the repeat gate still"
  echo "refuses the call if it ever did. \`skillrepeat forget $sig\` is the other one."
  return 0
}

# ------------------------------------------------------------------------ stats
cmd_stats() {
  json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      *) echo "skillrepeat stats: unknown argument $1" >&2; return 2 ;;
    esac
    shift
  done
  # ONE jq over the store, and the rows never leave the pipe. Slurping them into a shell
  # variable and handing them back with `--argjson raw` was the earlier shape, and at the
  # gate's byte cap that argument is four megabytes -- past ARG_MAX on macOS, where it
  # fails as E2BIG rather than as anything a reader would recognise. `$sum` is derived
  # here from the same slurped array, so the summary is computed once.
  # TWO PASSES OVER THE STORE, and the second is not free: `elig_map` needs the summary
  # before the head rules can be asked about anything, and the query below needs the
  # answers before it can count. Measured under CliCostTest, which prints the wall time on
  # every run, so the cost of the second pass cannot go unnoticed.
  st_elig="$(summary | elig_map)"
  [ -z "$st_elig" ] && st_elig='{}'
  st="$(rows | jq -s -c --argjson min "$MIN_SESSIONS" --argjson elig "$st_elig" '
    ('"$SUMMARY_JQ"') as $sum
    | { rows: length,
        failures: ([.[] | select(.t=="fail" and (.sig|type=="string"))] | length),
        recoveries: ([.[] | select(.t=="recover")] | length),
        tombstones: ([.[] | select(.t=="forget")] | length),
        signatures: ($sum | length),
        sessions: ([.[] | .session // empty] | unique | length),
        tools: ([.[] | .tool // empty] | unique | length),
        refusing: ([$sum[] | select('"$REFUSES_JQ"')] | length),
        with_recovery: ([$sum[] | select(.recovery != "")] | length),
        threshold: $min }' 2>/dev/null)"
  [ -z "$st" ] && { echo "skillrepeat: could not summarise the store" >&2; return 1; }
  if [ "$json" = "1" ]; then
    printf '%s' "$st" | jq '.'
    return 0
  fi
  printf '%s' "$st" | jq -r --arg store "$STORE" '
    "store:        " + $store,
    "rows:         " + (.rows|tostring) + "  (" + (.failures|tostring) + " failures, "
      + (.recoveries|tostring) + " recoveries, " + (.tombstones|tostring) + " tombstones)",
    "signatures:   " + (.signatures|tostring),
    "sessions:     " + (.sessions|tostring),
    "refusing:     " + (.refusing|tostring) + "  (>= " + (.threshold|tostring) + " distinct sessions, head not exempt)",
    "with a fix:   " + (.with_recovery|tostring) + "  signatures name a recovery"'
  return 0
}

sub="${1:-}"
[ $# -gt 0 ] && shift
case "$sub" in
  list)   cmd_list "$@" ;;
  show)   cmd_show "$@" ;;
  forget) cmd_forget "$@" ;;
  dismiss) cmd_dismiss "$@" ;;
  stats)  cmd_stats "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "skillrepeat: unknown subcommand '$sub'" >&2; usage >&2; exit 2 ;;
esac
exit

}
