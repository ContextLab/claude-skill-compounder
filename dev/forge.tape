# dev/forge.tape — the README animation.
# Records dev/forge_demo.sh: one complete builder/red-team forge, with the bottom
# line painted by the real statusline/statusline.sh once a second.
Output docs/media/forge.gif
Set FontSize 16
Set Width 1280
Set Height 460
Set Padding 20
Set Framerate 12
Set TypingSpeed 40ms
Type "./dev/forge_demo.sh"
Enter
Sleep 32s
